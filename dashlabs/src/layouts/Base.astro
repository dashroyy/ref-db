---
// The page frame: the print chamber background, top bar, footer, and the
// site-wide motion: sections printing in, 3D product thumbnails, card tilt.
import '@fontsource/unbounded/400.css';
import '@fontsource/unbounded/500.css';
import '@fontsource/unbounded/600.css';
import '@fontsource/unbounded/700.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site.ts';
import { pageColor } from '../data/nav.ts';

interface Props {
  title?: string;
  description?: string;
  jsonld?: Record<string, unknown>; // extra structured data for this page (e.g. a Product)
}
const { title, description = SITE.description, jsonld } = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: new URL('/', site).href,
  logo: new URL('/favicon.svg', site).href,
  description: SITE.description,
};
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const tone = pageColor(Astro.url.pathname);
---

<!doctype html>
<html lang="en" style={`--tone:${tone}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={jsonld ? 'product' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld ?? org)} />
    <meta name="theme-color" content="#08070d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before first paint: enable print-in effects, restore Motion off. Storage can throw.
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('dashlabs-motion') === 'off') document.documentElement.classList.add('motion-off');
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="chamber" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { webglOK } from '../lib/three/support.ts';

      // Print-in: [data-print] sections build up layer by layer as they enter view.
      // (A position check, not IntersectionObserver: Chromium treats a fully
      // clip-path'd element as never intersecting, so it would never reveal.)
      let pending = [...document.querySelectorAll<HTMLElement>('[data-print]')];
      let queued = false;
      const check = () => {
        queued = false;
        const edge = innerHeight * 0.92;
        pending = pending.filter((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < edge && r.bottom > 0) {
            el.classList.add('printed');
            return false;
          }
          // anything already scrolled past is shown without the effect
          if (r.bottom <= 0) {
            el.classList.add('printed');
            return false;
          }
          return true;
        });
      };
      const queue = () => {
        if (!queued && pending.length) {
          queued = true;
          requestAnimationFrame(check);
        }
      };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      check();

      // 3D tilt on [data-tilt] cards: fine pointers only, never under Motion off
      const root = document.documentElement;
      const calm = () => root.classList.contains('motion-off') || matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            if (calm()) return;
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            el.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
            el.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
            el.style.setProperty('--rx', `${((0.5 - y) * 10).toFixed(2)}deg`);
            el.style.setProperty('--ry', `${((x - 0.5) * 12).toFixed(2)}deg`);
            el.classList.add('tilting');
          });
          el.addEventListener('pointerleave', () => {
            el.style.setProperty('--rx', '0deg');
            el.style.setProperty('--ry', '0deg');
            el.classList.remove('tilting');
          });
        });
      }

      // Real 3D renders for product thumbnails, generated in the browser once idle
      if (document.querySelector('[data-thumb]') && webglOK()) {
        const go = () => import('../lib/three/viewer.ts').then((m) => m.renderThumbs());
        'requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 300);
      }
    </script>
  </body>
</html>
