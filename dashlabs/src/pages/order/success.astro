---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.ts';
---

<Base cta={false} title="Order received" description="Thanks for your order." noindex>
  <section class="section wrap done">
    <div class="tick" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="88" height="88">
        <polygon points="20,4 35,12 20,20 5,12" fill="var(--hot)"></polygon>
        <polygon points="5,12 20,20 20,36 5,28" fill="#6c47d6"></polygon>
        <polygon points="20,20 35,12 35,28 20,36" fill="#4a2ca8"></polygon>
        <path d="M13 12.5 l5 3 l9-6" fill="none" stroke="#1d0f00" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
    <p class="kicker"><span class="dot"></span>Payment received · added to the queue</p>
    <h1 class="x3d">Your print is <span class="hot">queued</span>.</h1>
    <p class="lede">
      Thanks! Your receipt and invoice are on their way to your inbox. I'll email you when your order is printed and
      again when it ships.
    </p>
    <p class="ref" data-ref hidden>Order reference <b data-ref-val></b></p>
    <ol class="next" aria-label="What happens next">
      <li class="on"><b>Paid</b><span>Receipt and invoice emailed by Stripe</span></li>
      <li><b>Printing</b><span>Layer by layer, in the colours you picked</span></li>
      <li><b>Checked &amp; packed</b><span>Cleaned up and packed to survive the trip</span></li>
      <li><b>Shipped</b><span data-ships>I'll email you the tracking</span></li>
    </ol>
    <p class="muted small">
      Questions, or something to change? Reply to your receipt email, or write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <span data-ref-hint hidden> with your reference</span>.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="/shop/">Keep browsing</a>
      <a class="btn" href="/learn/">Read a guide while you wait</a>
    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../../lib/cart-store.ts';
  const q = new URLSearchParams(location.search);
  // only a real return from Stripe Checkout empties the cart (not someone opening this page by hand)
  if (q.get('session')?.startsWith('cs_')) clearCart();
  const ref = q.get('ref');
  if (ref && /^DL-\d{6}-[A-Z0-9]{4}$/.test(ref)) {
    document.querySelector<HTMLElement>('[data-ref-val]')!.textContent = ref;
    document.querySelector<HTMLElement>('[data-ref]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-ref-hint]')!.hidden = false;
  }
  try {
    const last = JSON.parse(sessionStorage.getItem('dashlabs.lastOrder') || 'null') as { ships?: string } | null;
    if (last?.ships && last.ships !== '—') document.querySelector<HTMLElement>('[data-ships]')!.textContent = `Expected to ship ${last.ships}`;
  } catch {
    /* nothing stored */
  }
</script>

<style>
  .done {
    min-height: 70vh;
    display: grid;
    align-content: center;
    justify-items: start;
  }
  .tick {
    margin-bottom: 20px;
    animation: pop 0.8s cubic-bezier(0.3, 1.6, 0.5, 1) both;
    filter: drop-shadow(0 0 24px rgba(255, 140, 30, 0.45));
  }
  @keyframes pop {
    from {
      transform: scale(0.3) rotate(-30deg);
      opacity: 0;
    }
  }
  .ref {
    font: 500 0.95rem var(--mono);
    color: var(--text-2);
  }
  .ref b {
    color: var(--hot);
  }
  .next {
    list-style: none;
    margin: 28px 0 18px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    width: min(860px, 100%);
    counter-reset: step;
  }
  .next li {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 14px 14px 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--panel);
    counter-increment: step;
  }
  .next li::before {
    content: '0' counter(step);
    font: 600 0.72rem var(--mono);
    color: var(--text-4);
  }
  .next li.on {
    border-color: color-mix(in srgb, var(--mint) 55%, transparent);
    background: color-mix(in srgb, var(--mint) 8%, var(--panel));
  }
  .next li.on::before {
    content: '✓ done';
    color: var(--mint);
  }
  .next b {
    color: var(--white);
  }
  .next span {
    font-size: 0.85rem;
    color: var(--text-3);
  }
  .small {
    font-size: 0.9rem;
  }
  @media (max-width: 720px) {
    .next {
      grid-template-columns: 1fr 1fr;
    }
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
</style>
