---
import Base from '../../layouts/Base.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import ProductCard from '../../components/ProductCard.astro';
import LaunchLab from '../../components/LaunchLab.astro';
import { GUIDES } from '../../data/guides.ts';
import { LAB_STATUS, leadTimeDays } from '../../data/lab.ts';
import { slower } from '../../lib/shipdate.ts';
import Reviews from '../../components/Reviews.astro';
import { reviewsFor, ratingSummary } from '../../data/reviews.ts';
import { PRODUCTS, categoryById, productCode, type Product } from '../../data/catalog.ts';
import { SITE } from '../../data/site.ts';
import { money } from '../../lib/money.ts';
import { existsSync } from 'node:fs';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const [lo, hi] = p.leadTimeDays ?? SITE.defaultLeadTimeDays;
const pz = p.personalise;
// search results: what it is, that it's made to order, and the price
const metaDescription = `${p.summary.replace(/\.$/, '')}. 3D printed to order by DashLabs, ${p.purchase === 'quote' ? 'from ' : ''}${money(p.price)}.`;
const site = Astro.site ?? new URL('http://localhost:4321');
// share card from `npm run og`; falls back to the site-wide card until it's rendered
const shareCard = existsSync(`public/og/${p.slug}.jpg`) ? `/og/${p.slug}.jpg` : '/og.png';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.summary,
  sku: `DL-${productCode(p)}`,
  category: categoryById(p.category).label,
  brand: { '@type': 'Brand', name: SITE.name },
  image: new URL(p.images?.[0] ?? shareCard, site).href,
  offers: {
    '@type': 'Offer',
    url: new URL(`/shop/${p.slug}/`, site).href,
    priceCurrency: SITE.currency,
    price: (p.price / 100).toFixed(2),
    availability: 'https://schema.org/MadeToOrder',
    itemCondition: 'https://schema.org/NewCondition',
  },
};
// star ratings in search results only once real reviews exist
const rating = ratingSummary(reviewsFor(p.id));
if (rating) Object.assign(productLd, { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating.average, reviewCount: rating.count } });
const guide = GUIDES.find((g) => g.slug === p.guide);
// the slower of this product's own lead time and the lab's current queue
const lead = slower([lo, hi], leadTimeDays(LAB_STATUS.queuedJobs, LAB_STATUS.printers));
const madeForYou = p.purchase === 'quote' || !!p.personalise;
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shop', item: new URL('/shop/', site).href },
    { '@type': 'ListItem', position: 2, name: categoryById(p.category).label, item: new URL(`/shop/?c=${p.category}`, site).href },
    { '@type': 'ListItem', position: 3, name: p.name },
  ],
};
const know = [
  {
    q: 'Made to order',
    a: p.purchase === 'quote'
      ? `Nothing is pre-made. After you approve the quote and the 3D preview, it takes about ${lo}–${hi} working days to sculpt, print and finish.`
      : `Nothing sits in stock. Yours is printed after you order, usually within ${lo}–${hi} working days, then checked and packed by hand.`,
  },
  {
    q: 'Materials & finish',
    a: 'Printed in the plastic that suits the part, PLA for most things: crisp detail and bright colour. Fine layer lines are part of the look. Need it tougher, flexible or outdoor-proof? Ask for PETG, TPU or ASA.',
    link: { href: '/learn/materials/', label: 'Choosing a material' },
  },
  {
    q: 'Care',
    a: 'Keep it out of hot cars and direct sun. Clean with lukewarm water and a soft brush; never the dishwasher.',
    link: { href: '/learn/where-prints-live/', label: 'Where your print can live' },
  },
  {
    q: 'Returns',
    a: madeForYou
      ? 'Made just for you, so it can’t be returned for a change of mind. If it arrives damaged or faulty, I’ll reprint or refund it.'
      : 'Arrived damaged or faulty? I’ll reprint or refund it. Changed your mind? Contact me within 14 days of delivery.',
    link: { href: '/policies/#returns', label: 'Returns policy' },
  },
  ...(p.source.kind === 'licensed'
    ? [{ q: 'Design & licence', a: `Designed by ${p.source.designer} and printed under licence (${p.source.licence}). The designer keeps all rights to the design.`, link: { href: p.source.url, label: 'Original design' } }]
    : []),
];
const cat = categoryById(p.category);
const siblings = PRODUCTS.filter((x) => x.category === p.category);
const pos = PRODUCTS.indexOf(p);
const next = PRODUCTS[(pos + 1) % PRODUCTS.length];
// "More like this": same category first, topped up from the rest (not the "next print" item below)
const sameCat = PRODUCTS.filter((x) => x.category === p.category && x.id !== p.id);
const others = PRODUCTS.filter((x) => x.category !== p.category && x.id !== next.id);
const related = [...sameCat, ...others].slice(0, 3);
const relatedTitle = sameCat.length >= 3 ? 'More like this' : 'You might also like';
const sourceLabel =
  p.source.kind === 'original'
    ? 'Designed by DashLabs'
    : p.source.kind === 'commission'
      ? 'Sculpted for you by DashLabs'
      : `Design by ${p.source.designer}`;
---

<Base title={p.name} description={metaDescription} image={shareCard} jsonld={[productLd, crumbsLd]}>
  <section class="section top">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/shop/">Shop</a>
        <span aria-hidden="true">/</span>
        <a href={`/shop/?c=${p.category}`} class="cat-chip"><i></i>{cat.label}</a>
        <span class="sku-sep" aria-hidden="true">/</span>
        <span class="sku">SKU DL-{productCode(p)}</span>
        {siblings.length > 1 && <span class="pos">{siblings.indexOf(p) + 1} of {siblings.length}</span>}
      </nav>

      <div class="layout">
        <div class="gallery">
          {/* photos first when there are some; the 3D model is always one tap away */}
          <div class="g-main" data-gallery>
            {(p.images ?? []).map((src, i) => <img class="photo" data-pane={`p${i}`} src={src} alt={`${p.name}, photo ${i + 1}`} hidden={i !== 0} />)}
            <div data-pane="3d" hidden={!!p.images?.length}><ModelViewer product={p} /></div>
          </div>
          {
            !!p.images?.length && (
              <div class="g-thumbs" role="group" aria-label="Product views">
                {p.images.map((src, i) => (
                  <button type="button" data-show={`p${i}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Photo ${i + 1}`}>
                    <img src={src} alt="" loading="lazy" />
                  </button>
                ))}
                <button type="button" class="g-3d" data-show="3d" aria-pressed="false">
                  <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true"><polygon points="20,4 35,12 20,20 5,12" fill="var(--hot-2)" /><polygon points="5,12 20,20 20,36 5,28" fill="#6c47d6" /><polygon points="20,20 35,12 35,28 20,36" fill="#4a2ca8" /></svg>
                  3D
                </button>
              </div>
            )
          }
        </div>

        <div class="info">
          <p class="tag tag--accent">{sourceLabel}</p>
          <div class="title-row">
            <h1 class="x3d title">{p.name}</h1>
            <button type="button" class="save-big" data-save={p.id} aria-pressed="false" aria-label={`Save ${p.name} for later`}>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4 7.4 4c2 0 3.6 1.1 4.6 2.7C13 5.1 14.6 4 16.6 4c3.5 0 5.8 3.6 4.6 7.1-1.7 4.8-9.2 9.4-9.2 9.4z"></path></svg>
              <span>Save</span>
            </button>
            <button type="button" class="save-big share" data-share aria-label={`Share ${p.name}`}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path></svg>
              <span>Share</span>
            </button>
          </div>
          <p class="price">
            {p.purchase === 'quote' && <small>from </small>}<span data-price>{money(p.price)}</span>
          </p>
          {p.description.map((para) => <p class="muted">{para}</p>)}

          <form
            class="buy"
            data-buy
            data-product={p.id}
            data-base={p.price}
            data-mode={p.purchase}
            data-deltas={JSON.stringify(
              Object.fromEntries(p.options.map((o) => [o.id, Object.fromEntries(o.choices.map((c) => [c.id, c.priceDelta ?? 0]))])),
            )}
          >
            {
              p.options.map((opt) => (
                <fieldset class="field">
                  <legend>{opt.label}</legend>
                  <div class="choices">
                    {opt.choices.map((c, i) => (
                      <label class="choice">
                        <input type="radio" name={opt.id} value={c.id} checked={i === 0} />
                        <span>
                          {c.hex && (
                            <b
                              class="sw"
                              style={`background:${c.hex === 'rainbow' ? 'conic-gradient(#ff5c7a,#ffd84d,#3dffc5,#2f7dff,#9b6bff,#ff5c7a)' : c.hex}`}
                            />
                          )}
                          {c.label}
                          {c.priceDelta ? <em>+{money(c.priceDelta)}</em> : null}
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))
            }

            {
              pz && (
                <div class="field personal">
                  <label for="note">{pz.label}</label>
                  <input
                    id="note"
                    name="note"
                    type="text"
                    maxlength={pz.max}
                    required={pz.required}
                    placeholder={pz.placeholder}
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <span class="hint">Up to {pz.max} characters · watch it appear on the model</span>
                </div>
              )
            }

            {
              p.purchase === 'cart' ? (
                <div class="row">
                  <div class="field qty">
                    <label for="quantity">Qty</label>
                    <input id="quantity" name="quantity" type="number" min="1" max="20" value="1" inputmode="numeric" />
                  </div>
                  <button class="btn btn--primary add" type="submit">
                    Add to cart
                  </button>
                </div>
              ) : (
                <button class="btn btn--primary btn--block" type="submit">
                  Request a quote
                </button>
              )
            }
            <p class="added" data-added role="status" hidden>
              Added to cart. <a href="/cart/">View cart →</a>
            </p>
          </form>

          <p class="ships" data-ships data-lead={JSON.stringify(lead)}>
            <span class="live-dot"></span>
            <span>
              Order today, ships <b data-ships-when>in {lead[0]}–{lead[1]} working days</b>
              {p.purchase === 'quote' && <span class="muted"> after you approve the preview</span>}
            </span>
          </p>

          <dl class="specs">
            <div><dt class="tag">Ships in</dt><dd>{lo}–{hi} days</dd></div>
            {
              p.specs.map((s) => (
                <div>
                  <dt class="tag">{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))
            }
            {
              p.source.kind === 'licensed' && (
                <div>
                  <dt class="tag">Licence</dt>
                  <dd>
                    <a href={p.source.url} rel="noopener">{p.source.licence}</a>
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  {
    p.tool === 'launch-lab' && (
      <section class="section tool">
        <div class="wrap">
          <p class="tag tag--accent">Try before you buy</p>
          <h2 class="h-rule">How far will it go?</h2>
          <p class="muted">Set the angle and pull-back and see where your pen lands.</p>
          <LaunchLab compact />
        </div>
      </section>
    )
  }

  {
    guide && (
      <section class="wrap">
        <a class="guide-link panel" href={`/learn/${guide.slug}/`}>
          <span class="tag">Guide</span>
          <strong>{guide.title} →</strong>
          <span class="muted">{guide.summary}</span>
        </a>
      </section>
    )
  }


  <section class="wrap know-wrap">
    <h2 class="h-rule" data-print>Good to know</h2>
    <div class="know">
      {
        know.map((k, i) => (
          <details open={i === 0}>
            <summary>{k.q}</summary>
            <p>
              {k.a} {k.link && <a href={k.link.href}>{k.link.label} →</a>}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <div class="buybar" data-buybar aria-hidden="true">
    <div>
      <b>{p.name}</b>
      <span data-buybar-price>{money(p.price)}</span>
    </div>
    <button type="button" class="btn btn--primary" data-buybar-btn tabindex="-1">{p.purchase === 'quote' ? 'Request a quote' : 'Add to cart'}</button>
  </div>

  <section class="wrap reviews-wrap">
    <Reviews product={p} />
  </section>

  {
    related.length > 0 && (
      <section class="section more">
        <div class="wrap">
          <h2 class="h-rule" data-print>{relatedTitle}</h2>
          <div class="grid">
            {related.map((r) => (
              <ProductCard product={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap next-wrap">
    <a class="next-print" href={`/shop/${next.slug}/`} style={`--c:${categoryById(next.category).color}`} data-print>
      <span class="tag">Next print in the queue</span>
      <strong>{next.name}</strong>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </section>
</Base>

<script>
  import { addToCart, announceCart } from '../../lib/cart-store.ts';
  import { flyToCart, toast } from '../../lib/fly.ts';
  import { wireSaveButtons } from '../../lib/saved-store.ts';
  import { shipWindow, formatWindow } from '../../lib/shipdate.ts';
  // real dates for "ships by", from today
  for (const el of document.querySelectorAll<HTMLElement>('[data-ships]')) {
    const when = el.querySelector('[data-ships-when]');
    if (when) when.textContent = formatWindow(shipWindow(new Date(), JSON.parse(el.dataset.lead!)));
  }
  wireSaveButtons();
  // gallery: swap between photos and the 3D model
  document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('[data-gallery] [data-pane]').forEach((pane) => (pane.hidden = pane.dataset.pane !== b.dataset.show));
      document.querySelectorAll('[data-show]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );
  import { money } from '../../lib/money.ts';

  const form = document.querySelector<HTMLFormElement>('[data-buy]')!;
  const priceEl = document.querySelector<HTMLElement>('[data-price]')!;
  const added = form.querySelector<HTMLElement>('[data-added]')!;
  const base = Number(form.dataset.base);
  const deltas: Record<string, Record<string, number>> = JSON.parse(form.dataset.deltas!);

  const chosen = () => {
    const out: Record<string, string> = {};
    for (const id of Object.keys(deltas)) {
      const el = form.querySelector<HTMLInputElement>(`input[name="${id}"]:checked`);
      if (el) out[id] = el.value;
    }
    return out;
  };

  const render = () => {
    const opts = chosen();
    priceEl.textContent = money(base + Object.entries(opts).reduce((s, [o, c]) => s + (deltas[o]?.[c] ?? 0), 0));
  };
  // Choices live in the address (?colour=blue&size=12cm), so a shared link or
  // the back button brings back exactly what was picked.
  const params = new URLSearchParams(location.search);
  for (const [name, value] of params) {
    const input = form.querySelector<HTMLInputElement>(`input[type="radio"][name="${CSS.escape(name)}"][value="${CSS.escape(value)}"]`);
    if (input) input.checked = true;
  }
  const noteInput = form.querySelector<HTMLInputElement>('#note');
  if (noteInput && params.get('text')) noteInput.value = params.get('text')!.slice(0, noteInput.maxLength > 0 ? noteInput.maxLength : 40);
  const syncUrl = () => {
    const q = new URLSearchParams(chosen());
    if (noteInput?.value.trim()) q.set('text', noteInput.value.trim());
    history.replaceState(null, '', `${location.pathname}${q.size ? `?${q}` : ''}`);
  };
  form.addEventListener('change', syncUrl);
  noteInput?.addEventListener('input', syncUrl);
  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    syncUrl();
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(location.href);
        toast('<span class="t-cube"></span><span><b>Link copied</b>, with your choices</span>');
      }
    } catch {
      /* share sheet dismissed */
    }
  });
  form.addEventListener('change', render);

  // Phones: whenever the buy button is off screen (not reached yet, or scrolled past), a slim bar keeps it in reach
  const bar = document.querySelector<HTMLElement>('[data-buybar]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  // (checked on scroll: jumping straight past the button never "intersects" it)
  let barQueued = false;
  const checkBar = () => {
    barQueued = false;
    const r = submit.getBoundingClientRect();
    bar.classList.toggle('show', r.bottom < 0 || r.top > innerHeight);
  };
  addEventListener('scroll', () => !barQueued && ((barQueued = true), requestAnimationFrame(checkBar)), { passive: true });
  checkBar();
  new MutationObserver(() => (bar.querySelector('[data-buybar-price]')!.textContent = priceEl.textContent)).observe(priceEl, { childList: true, characterData: true, subtree: true });
  bar.querySelector('[data-buybar-btn]')!.addEventListener('click', () => {
    if (form.reportValidity()) form.requestSubmit();
    else form.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  render();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const opts = chosen();
    if (form.dataset.mode === 'quote') {
      const q = new URLSearchParams({ product: form.dataset.product!, ...opts });
      location.href = `/custom/?${q}`;
      return;
    }
    const data = new FormData(form);
    const line = {
      productId: form.dataset.product!,
      options: opts,
      qty: Number(data.get('quantity')) || 1,
      note: (data.get('note') as string | null)?.trim() || undefined,
    };
    const button = form.querySelector('button[type="submit"]')!;
    const tone = getComputedStyle(document.documentElement).getPropertyValue('--tone').trim() || '#ffab2e';
    const name = document.querySelector('h1')?.textContent?.trim() ?? 'Item';
    // the cube lands, then the cart updates (and bumps)
    addToCart(line, { quiet: true });
    flyToCart(button, tone).then(() => {
      announceCart();
      added.hidden = false;
      toast(`<span class="t-cube"></span><span><b>${name.replace(/</g, '&lt;')}</b> added to your cart</span><a href="/cart/">View cart →</a>`);
    });
  });
</script>

<style>
  .top {
    padding-top: clamp(28px, 4vw, 48px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-bottom: 26px;
    font: 500 0.8rem var(--font);
    color: var(--text-3);
  }
  .crumbs a {
    text-decoration: none;
    color: var(--text-2);
  }
  .crumbs a:hover {
    color: var(--white);
  }
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent);
    background: color-mix(in srgb, var(--tone) 10%, transparent);
  }
  .cat-chip i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    transform: rotate(45deg);
    background: var(--tone);
    box-shadow: 0 0 8px var(--tone);
  }
  .sku {
    font: 600 0.72rem var(--mono);
    color: var(--tone);
  }
  .pos {
    margin-left: auto;
    font: 500 0.72rem var(--mono);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px 14px;
  }
  .save-big {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    padding: 9px 13px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--panel);
    color: var(--text-2);
    font: 700 0.85rem var(--font);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .save-big svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .save-big:hover,
  .save-big[aria-pressed='true'] {
    color: var(--pink);
    border-color: color-mix(in srgb, var(--pink) 60%, transparent);
  }
  .save-big[aria-pressed='true'] svg {
    fill: currentColor;
  }
  .save-big[aria-pressed='true'] span::after {
    content: 'd';
  }
  .title-row .title {
    flex: 1;
  }
  .share:hover {
    color: var(--uv-2);
    border-color: var(--uv-2);
  }
  .save-big:global(.pop) {
    animation: heart-pop 0.45s cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  @keyframes heart-pop {
    40% {
      transform: scale(1.15);
    }
  }
  .title {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    letter-spacing: -0.04em;
    margin: 10px 0 18px;
  }
  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
  }
  .g-main [hidden] {
    display: none;
  }
  .g-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }
  .g-thumbs button {
    width: 68px;
    height: 68px;
    padding: 0;
    border-radius: 12px;
    border: 2px solid var(--line-2);
    background: var(--panel);
    overflow: hidden;
    cursor: pointer;
    color: var(--text);
    font: 700 0.7rem var(--mono);
    display: grid;
    place-items: center;
  }
  .g-thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .g-thumbs button[aria-pressed='true'] {
    border-color: var(--hot);
    box-shadow: 0 0 14px -4px var(--hot);
  }
  .sw {
    width: 14px;
    height: 14px;
    border-radius: 50%;
