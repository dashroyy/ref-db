---
import Base from '../layouts/Base.astro';
import { PRODUCTS } from '../data/catalog.ts';
import { SITE } from '../data/site.ts';
import { money } from '../lib/money.ts';

const quoteable = PRODUCTS.filter((p) => p.purchase === 'quote');
---

<Base
  title="Custom orders"
  description="Custom 3D-printed figurines of people and pets, business cards and one-off prints."
>
  <section class="section top">
    <div class="wrap layout">
      <div class="intro">
        <p class="tag tag--accent">Custom orders</p>
        <h1 class="x3d">Tell me what you want printed.</h1>
        <p class="lede">
          A mini version of your best friend, your dog, your logo or something you sketched on a napkin. Describe it
          below and I'll reply with a quote, usually within a day or two.
        </p>

        <ul class="types">
          {
            quoteable.map((p) => (
              <li>
                <a href={`/shop/${p.slug}/`}>{p.name}</a>
                <span class="tag">from {money(p.price)}</span>
              </li>
            ))
          }
          <li><span>Something else</span><span class="tag">quoted per job</span></li>
        </ul>

        <p class="muted">Want a ballpark first? Try the <a href="/learn/pricing/">price estimator</a>.</p>

        <p class="notice">
          <strong>About photos:</strong> after you send this request, reply to my email with your photos attached. Clear,
          well-lit shots from the front, side and back work best.
        </p>
      </div>

      <form class="panel request" data-request>
        <div class="field">
          <label for="kind">What would you like?</label>
          <select id="kind" name="kind">
            {quoteable.map((p) => <option value={p.id}>{p.name}</option>)}
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="details">Describe it</label>
          <textarea
            id="details"
            name="details"
            required
            placeholder="Who or what it is, the pose, size, colours, any deadline…"></textarea>
        </div>
        <div class="two">
          <div class="field">
            <label for="rname">Your name</label>
            <input id="rname" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="remail">Email</label>
            <input id="remail" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="budget">Budget (optional)</label>
          <input id="budget" name="budget" type="text" placeholder="e.g. around $60" />
        </div>
        <input type="hidden" name="options" value="" />
        <button class="btn btn--primary btn--block" type="submit">Send request</button>
        <p class="muted small">Opens your email app with everything filled in, addressed to {SITE.email}.</p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { SITE } from '../data/site.ts';
  import { productById, describeOptions, normaliseOptions } from '../data/catalog.ts';

  const form = document.querySelector<HTMLFormElement>('[data-request]')!;
  const kind = form.querySelector<HTMLSelectElement>('#kind')!;
  const optionsField = form.querySelector<HTMLInputElement>('[name="options"]')!;

  // Prefill from a product page: /custom/?product=cust-pet&size=medium
  const params = new URLSearchParams(location.search);
  const fromId = params.get('product');
  const from = fromId ? productById(fromId) : undefined;
  if (from) {
    kind.value = from.id;
    params.delete('product');
    optionsField.value = describeOptions(from, normaliseOptions(from, Object.fromEntries(params)));
  }
  // Prefill from the price estimator: /custom/?details=...
  const details = new URLSearchParams(location.search).get('details');
  if (details && !from) {
    kind.value = 'other';
    form.querySelector<HTMLTextAreaElement>('#details')!.value = details.slice(0, 2000);
  }
  kind.addEventListener('change', () => (optionsField.value = ''));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const product = productById(String(d.get('kind')));
    const what = product?.name ?? 'Something else';
    const body = [
      `Custom request: ${what}`,
      d.get('options') ? `Options: ${d.get('options')}` : '',
      '',
      String(d.get('details')),
      '',
      d.get('budget') ? `Budget: ${d.get('budget')}` : '',
      `Name: ${d.get('name')}`,
      `Email: ${d.get('email')}`,
      '',
      '(Attach your photos to this email.)',
    ]
      .filter((l, i, a) => l !== '' || a[i - 1] !== '')
      .join('\n');
    location.href = `mailto:${SITE.email}?subject=${encodeURIComponent(`${SITE.name} custom request: ${what}`)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .top {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .intro h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-top: 12px;
  }
  .types {
    list-style: none;
    padding: 0;
    margin: 28px 0;
    border-top: 1px solid var(--line);
  }
  .types li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .types a {
    text-decoration: none;
  }
  .intro .muted a {
    color: var(--accent);
  }
  .types a:hover {
    color: var(--accent);
  }
  .request {
    padding: clamp(20px, 3vw, 32px);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .small {
    font-size: 0.85rem;
    margin: 12px 0 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 820px) {
    .layout,
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
