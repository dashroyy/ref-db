---
import Base from '../layouts/Base.astro';
import StlQuote from '../components/StlQuote.astro';
import { PRODUCTS } from '../data/catalog.ts';
import { SITE, ORDER_DELIVERY } from '../data/site.ts';
import { money } from '../lib/money.ts';
import { priceFor } from '../data/catalog.ts';

const quoteable = PRODUCTS.filter((p) => p.purchase === 'quote');
---

<Base cta={false}
  title="Custom orders"
  description="Custom 3D-printed figurines of people and pets, business cards and one-off prints."
>
  <section class="section top">
    <div class="wrap layout">
      <div class="intro">
        <p class="tag tag--accent">Custom orders</p>
        <h1 class="x3d">Tell me what you want printed.</h1>
        <p class="lede">
          A mini version of your best friend, your dog, your logo or something you sketched on a napkin. Describe it
          below and I'll reply with a quote, usually within a day or two.
        </p>

        <ul class="types">
          {
            quoteable.map((p) => (
              <li>
                <a href={`/shop/${p.slug}/`}>{p.name}</a>
                <span class="tag">from {money(p.price)}</span>
              </li>
            ))
          }
          <li><span>Something else</span><span class="tag">quoted per job</span></li>
        </ul>

        <p class="muted">Have a 3D file? <a href="#stl">Get an instant STL quote</a>. Just an idea? Try the <a href="/learn/pricing/">price estimator</a>.</p>

        <p class="notice">
          <strong>About photos:</strong> after you send this request, reply to my email with your photos attached. Clear,
          well-lit shots from the front, side and back work best.
        </p>
      </div>

      <form class="panel request" data-request id="request">
        <div class="picked" data-picked hidden>
          <span class="tag">Your choices</span>
          <p><b data-picked-name></b> <span data-picked-opts></span></p>
          <p class="picked-foot"><span data-picked-price></span> <a data-picked-back href="/shop/">Change</a></p>
        </div>
        <div class="field">
          <label for="kind">What would you like?</label>
          <select id="kind" name="kind">
            {quoteable.map((p) => <option value={p.id}>{p.name}</option>)}
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="details">Describe it <span class="draft-note" data-draft-note hidden>· draft restored <button type="button" data-draft-clear>clear</button></span></label>
          <textarea
            id="details"
            name="details"
            required
            placeholder="Who or what it is, the pose, size, colours, any deadline…"></textarea>
        </div>
        <div class="two">
          <div class="field">
            <label for="rname">Your name</label>
            <input id="rname" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="remail">Email</label>
            <input id="remail" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="budget">Budget (optional)</label>
          <input id="budget" name="budget" type="text" placeholder="e.g. around $60" />
        </div>
        <input type="hidden" name="options" value="" />
        <button class="btn btn--primary btn--block" type="submit">Send request</button>
        <p class="muted small">
          {
            ORDER_DELIVERY === 'netlify-form'
              ? "This sends your request straight to me. I'll reply by email, and you can send photos or files in your reply."
              : "Nothing is sent yet: you'll see your message ready to email, with a copy button if you use webmail."
          }
        </p>
      </form>
    </div>
  </section>

  <section class="section guide-sec">
    <div class="wrap">
      <div class="head" data-print>
        <h2 class="h-rule">Price guide</h2>
        <p class="muted">Starting prices. Your quote confirms the exact figure before any work begins.</p>
      </div>
      <div class="matrices">
        {
          quoteable.map((p) => {
            const [rows, cols] = [p.options[0], p.options[1]];
            return (
              <div class="matrix panel" data-print>
                <h3>
                  <a href={`/shop/${p.slug}/`}>{p.name}</a>
                </h3>
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{rows.label}</th>
                      {cols.choices.map((c) => (
                        <th scope="col">{c.label}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {rows.choices.map((r) => (
                      <tr>
                        <th scope="row">{r.label}</th>
                        {cols.choices.map((c) => (
                          <td>{money(priceFor(p, { [rows.id]: r.id, [cols.id]: c.id }))}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          })
        }
      </div>

      <ol class="next" data-print>
        <li><span>01</span><b>You send the request</b> with photos or a file.</li>
        <li><span>02</span><b>I reply with a quote</b> and a timeline, usually in a day or two.</li>
        <li><span>03</span><b>You approve a 3D preview</b>. One round of changes is included.</li>
        <li><span>04</span><b>It's printed, checked and shipped</b>, with tracking.</li>
      </ol>
      <p class="muted">
        Not sure what photos to send? Read <a class="inl" href="/learn/photos-for-figurines/">Photos for a custom figurine</a>.
      </p>
    </div>
  </section>

  <section class="section stl-sec" id="stl">
    <div class="wrap">
      <div class="head" data-print>
        <div>
          <p class="kicker"><span class="dot"></span>New · instant quote</p>
          <h2 class="h-rule">Got a 3D file already?</h2>
        </div>
        <p class="muted stl-note">
          Drop your STL to see it printed and get a price from its real volume. Nothing is uploaded: it's measured right
          here in your browser.
        </p>
      </div>
      <StlQuote />
    </div>
  </section>
</Base>

<script>
  import { SITE, ORDER_DELIVERY } from '../data/site.ts';
  import { sendRequest } from '../lib/send.ts';
  import { productById, describeOptions, normaliseOptions, priceFor } from '../data/catalog.ts';
  import { money } from '../lib/money.ts';

  const form = document.querySelector<HTMLFormElement>('[data-request]')!;
  const kind = form.querySelector<HTMLSelectElement>('#kind')!;
  const optionsField = form.querySelector<HTMLInputElement>('[name="options"]')!;

  const picked = form.querySelector<HTMLElement>('[data-picked]')!;
  const detailsBox = form.querySelector<HTMLTextAreaElement>('#details')!;
  /** The "Your choices" box at the top of the form, then the form brought into view. */
  function showPicked(name: string, opts: string, price: string, back: string, scroll = true) {
    picked.querySelector('[data-picked-name]')!.textContent = name;
    picked.querySelector('[data-picked-opts]')!.textContent = opts ? `· ${opts}` : '';
    picked.querySelector('[data-picked-price]')!.textContent = price;
    picked.querySelector<HTMLAnchorElement>('[data-picked-back]')!.href = back;
    picked.hidden = false;
    if (!scroll) return;
    requestAnimationFrame(() => {
      form.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
      // on touch screens, don't pop the keyboard up uninvited
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        detailsBox.focus({ preventScroll: true });
        detailsBox.setSelectionRange(detailsBox.value.length, detailsBox.value.length); // type after any summary
      }
    });
  }
  /** Read the summary the estimator / STL quote writes ("Title:\nline\nline\nEstimate shown: $13…"). */
  function showFromTool(text: string, back: string, scroll = true) {
    const lines = text.split('\n').map((l) => l.trim()).filter(Boolean);
    const est = lines.find((l) => l.startsWith('Estimate shown:'));
    const title = /^STL quote/.test(lines[0] ?? '') ? 'Instant STL quote' : 'Price estimate';
    const file = /^STL quote: (.+)$/.exec(lines[0] ?? '')?.[1];
    const opts = [file, ...lines.slice(1, 3)].filter(Boolean).join(' · ');
    const price = est ? `${est.replace('Estimate shown:', 'Estimate').replace(/ \(.*$/, '')}; your quote confirms it.` : 'Your quote confirms the price.';
    showPicked(title, opts, price, back, scroll);
  }
  document.addEventListener('dashlabs:prefill', (e) => showFromTool((e as CustomEvent<string>).detail, '#stl', false));

  // Prefill from a product page: /custom/?product=cust-pet&size=medium
  const params = new URLSearchParams(location.search);
  const fromId = params.get('product');
  const from = fromId ? productById(fromId) : undefined;
  if (from) {
    kind.value = from.id;
    params.delete('product');
    const chosen = normaliseOptions(from, Object.fromEntries(params));
    optionsField.value = describeOptions(from, chosen);
    showPicked(
      from.name,
      optionsField.value.replace(/^[^:]+: /, '').replace(/ · [^:]+: /g, ' · '),
      `From ${money(priceFor(from, chosen))}; your quote confirms it.`,
      `/shop/${from.slug}/?${params}`,
    );
    kind.addEventListener('change', () => (picked.hidden = kind.value !== from.id));
  }
  // Prefill from the price estimator: /custom/?details=...
  const details = new URLSearchParams(location.search).get('details');
  if (details && !from) {
    kind.value = 'other';
    detailsBox.value = details.slice(0, 2000);
    showFromTool(details, '/learn/pricing/#try-it');
  }
  kind.addEventListener('change', () => (optionsField.value = ''));

  // Unsent drafts survive leaving the page (Change, a link, a reloaded tab); cleared once sent.
  const DRAFT = 'dashlabs.customDraft.v1';
  const budget = form.querySelector<HTMLInputElement>('#budget')!;
  const note = form.querySelector<HTMLElement>('[data-draft-note]')!;
  try {
    const d = JSON.parse(localStorage.getItem(DRAFT) || 'null') as { details?: string; budget?: string } | null;
    // a summary just handed over by a tool wins; otherwise bring the draft back
    if (d?.details && !detailsBox.value) {
      detailsBox.value = d.details;
      note.hidden = false;
    }
    if (d?.budget && !budget.value) budget.value = d.budget;
  } catch {
    /* storage blocked */
  }
  let saveT = 0;
  const saveDraft = () => {
    clearTimeout(saveT);
    saveT = window.setTimeout(() => {
      try {
        if (detailsBox.value.trim() || budget.value.trim()) localStorage.setItem(DRAFT, JSON.stringify({ details: detailsBox.value, budget: budget.value }));
        else localStorage.removeItem(DRAFT);
      } catch {
        /* storage blocked */
      }
    }, 300);
  };
  detailsBox.addEventListener('input', saveDraft);
  budget.addEventListener('input', saveDraft);
  const clearDraft = () => {
    try {
      localStorage.removeItem(DRAFT);
    } catch {
      /* storage blocked */
    }
    note.hidden = true;
  };
  form.querySelector('[data-draft-clear]')!.addEventListener('click', () => {
    detailsBox.value = '';
    budget.value = '';
    clearDraft();
    detailsBox.focus();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const product = productById(String(d.get('kind')));
    const what = product?.name ?? 'Something else';
    const body = [
      `Custom request: ${what}`,
      d.get('options') ? `Options: ${d.get('options')}` : '',
      '',
      String(d.get('details')),
      '',
      d.get('budget') ? `Budget: ${d.get('budget')}` : '',
      `Name: ${d.get('name')}`,
      `Email: ${d.get('email')}`,
      '',
      ORDER_DELIVERY === 'netlify-form' ? '(Photos or files to follow by email.)' : '(Attach your photos to this email.)',
    ]
      .filter((l, i, a) => l !== '' || a[i - 1] !== '')
      .join('\n');
    const subject = `${SITE.name} custom request: ${what}`;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    await sendRequest(
      {
        title: 'Your request is ready',
        lead: 'One last step: send it to me by email, with your photos or 3D file attached. I usually reply within a day or two.',
        to: SITE.email,
        subject,
        text: body,
        onSent: { label: 'I’ve sent it', done: 'Request sent. Thank you!', run: () => (form.reset(), clearDraft()) },
      },
      ORDER_DELIVERY === 'netlify-form' ? { form: 'custom', name: String(d.get('name')), email: String(d.get('email')), subject, message: body } : undefined,
    );
    button.disabled = false;
  });
</script>

<style>
  .top {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .draft-note {
    text-transform: none;
    letter-spacing: 0;
    color: var(--mint);
  }
  .draft-note button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-2);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .picked {
    margin: -4px 0 18px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--tone) 50%, transparent);
    background: color-mix(in srgb, var(--tone) 9%, transparent);
  }
  .picked[hidden] {
    display: none;
  }
  .picked p {
    margin: 6px 0 0;
  }
  .picked b {
    color: var(--white);
  }
  .picked-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--text-3);
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .intro h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-top: 12px;
  }
  .types {
    list-style: none;
    padding: 0;
    margin: 28px 0;
    border-top: 1px solid var(--line);
  }
  .types li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .types a {
    text-decoration: none;
  }
  .stl-sec,
  .guide-sec {
    padding-top: 0;
  }
  .matrices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 22px;
  }
  .matrix {
    padding: 20px 22px;
    overflow-x: auto;
  }
  .matrix h3 a {
    text-decoration: none;
  }
  .matrix h3 a:hover {
    color: var(--hot);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th,
  td {
    padding: 10px 8px;
    text-align: right;
    border-bottom: 1px solid var(--line);
  }
  th:first-child {
    text-align: left;
  }
  thead th {
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  tbody th {
    font-weight: 600;
    color: var(--text);
  }
  td {
    font: 600 0.95rem var(--mono);
    color: var(--white);
  }
  tbody tr:last-child :is(th, td) {
    border-bottom: 0;
  }
  .next {
    list-style: none;
    margin: 34px 0 18px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .next li {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--panel);
    font-size: 0.92rem;
    color: var(--text-2);
  }
  .next span {
    display: block;
    font: 700 0.8rem var(--mono);
    color: var(--hot);
    margin-bottom: 6px;
  }
  .next b {
    color: var(--white);
  }
  .inl {
    color: var(--hot);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .next {
      grid-template-columns: 1fr 1fr;
    }
  }
  .stl-note {
    max-width: 30rem;
  }
  .intro .muted a {
    color: var(--accent);
  }
  .types a:hover {
    color: var(--accent);
  }
  .request {
    padding: clamp(20px, 3vw, 32px);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .small {
    font-size: 0.85rem;
    margin: 12px 0 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 820px) {
    .layout,
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
