---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductArt from '../components/ProductArt.astro';
import PrintHero from '../components/PrintHero.astro';
import ModelViewer from '../components/ModelViewer.astro';
import LabStatus from '../components/LabStatus.astro';
import { PRODUCTS, CATEGORIES, productById } from '../data/catalog.ts';
import { GUIDES } from '../data/guides.ts';
import { LAB_STATUS, leadTimeDays } from '../data/lab.ts';
import { MATERIALS } from '../data/materials.ts';
import { money } from '../lib/money.ts';

const featured = PRODUCTS.filter((p) => p.featured);
const launcher = productById('orig-pen-launcher')!;
const [lo, hi] = leadTimeDays(LAB_STATUS.queuedJobs, LAB_STATUS.printers);
const firstOf = (id: string) => PRODUCTS.find((p) => p.category === id)!;

const ticker = [
  `${LAB_STATUS.queuedJobs} jobs in the queue`,
  `Ships in ${lo}–${hi} days`,
  ...MATERIALS.map((m) => `${m.name} · ${m.short}`),
  'Preview before every custom print',
  'Printed layer by layer',
];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span class="dot"></span>Printers online · taking orders</p>
        <h1 class="hero-title x3d">Ideas,<br />printed <span class="hot">layer</span><br />by layer.</h1>
        <p class="lede">
          Custom figurines of the people and pets you love, business cards people actually keep, and original gadgets
          like the Pen Launcher. Designed and printed to order at DashLabs.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="/shop/">Browse the shop</a>
          <a class="btn" href="/custom/">Start a custom order</a>
        </div>
        <dl class="specs">
          <div><dt>Ships in</dt><dd>{lo}–{hi} days</dd></div>
          <div><dt>Materials</dt><dd>{MATERIALS.length} filaments</dd></div>
          <div><dt>Custom work</dt><dd>3D preview first</dd></div>
        </dl>
      </div>
      <div class="hero-stage">
        <PrintHero />
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => ticker.map((t) => <span>{t}<i /></span>))}
    </div>
  </div>

  <!-- CATEGORIES -->
  <section class="section">
    <div class="wrap">
      <div class="head" data-print>
        <h2 class="h-rule">What I print</h2>
        <a href="/shop/">See all {PRODUCTS.length} items →</a>
      </div>
      <div class="cats">
        {
          CATEGORIES.map((c, i) => {
            const p = firstOf(c.id);
            const n = PRODUCTS.filter((x) => x.category === c.id).length;
            return (
              <a class="cat" href={`/shop/?c=${c.id}`} style={`--c:${c.color}`} data-tilt data-print>
                <div class="cat-slab">
                  <div class="cat-art" data-thumb data-shape={p.art.shape} data-color={c.color}>
                    <ProductArt shape={p.art.shape} hue={p.art.hue} uid={`cat-${c.id}`} label={c.label} />
                  </div>
                  <div class="cat-txt">
                    <span class="tag">
                      0{i + 1} · {n} {n === 1 ? 'item' : 'items'}
                    </span>
                    <h3>{c.label}</h3>
                    <p>{c.blurb}</p>
                  </div>
                  <span class="cat-go" aria-hidden="true">
                    →
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section tight">
    <div class="wrap">
      <div class="head" data-print>
        <h2 class="h-rule">Off the print bed</h2>
        <a href="/shop/">Shop everything →</a>
      </div>
      <div class="grid">{featured.map((p) => <ProductCard product={p} />)}</div>
    </div>
  </section>

  <!-- PEN LAUNCHER -->
  <section class="section">
    <div class="wrap spot" style="--tone:#ffab2e">
      <div class="spot-3d">
        <ModelViewer product={launcher} />
      </div>
      <div class="spot-copy" data-print>
        <p class="kicker"><span class="dot"></span>DashLabs original</p>
        <h2 class="spot-title x3d">The Pen<br /><span class="hot">Launcher</span></h2>
        <p class="lede">
          Designed, prototyped and tested in the lab. Load a standard ballpoint, pull back, and send it across the room.
          Spin it, watch it print, then try the launch lab to see how far yours will fly.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href={`/shop/${launcher.slug}/`}>Get one · {money(launcher.price)}</a>
          <a class="btn" href="/learn/pen-launcher-physics/">Launch lab</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LAB STATUS -->
  <section class="section tight" id="lab-status">
    <div class="wrap">
      <div class="head" data-print>
        <h2 class="h-rule">Inside the lab right now</h2>
        <a href="/lab/">More from the lab →</a>
      </div>
      <div data-print><LabStatus /></div>
    </div>
  </section>

  <!-- HOW CUSTOM WORKS -->
  <section class="section">
    <div class="wrap">
      <div class="head" data-print>
        <h2 class="h-rule">From a photo to your shelf</h2>
        <a href="/custom/">Start a custom order →</a>
      </div>
      <ol class="timeline" data-print>
        <li style="--i:0"><span class="n">01</span><h3>Send photos</h3><p>A few angles of the person, pet or thing, plus the details that matter.</p></li>
        <li style="--i:1"><span class="n">02</span><h3>Get a quote</h3><p>A price and timeline by email. You pay through a secure invoice.</p></li>
        <li style="--i:2"><span class="n">03</span><h3>Approve the 3D preview</h3><p>You see the model before it prints. One round of tweaks included.</p></li>
        <li style="--i:3"><span class="n">04</span><h3>Printed &amp; shipped</h3><p>Printed, cleaned up, checked and packed to survive the trip.</p></li>
      </ol>
    </div>
  </section>

  <!-- LEARN -->
  <section class="section tight last">
    <div class="wrap">
      <div class="head" data-print>
        <h2 class="h-rule">Know before you order</h2>
        <a href="/learn/">All guides →</a>
      </div>
      <div class="learn">
        {
          GUIDES.map((g, i) => (
            <a class="guide" href={`/learn/${g.slug}/`} data-tilt data-print>
              <span class="gnum">0{i + 1}</span>
              <span class="tag">Tool · {g.tool}</span>
              <h3>{g.title}</h3>
              <p>{g.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero {
    position: relative;
    padding-block: clamp(20px, 4vw, 48px) clamp(24px, 4vw, 40px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }
  .hero-title {
    font: 700 clamp(2.7rem, 6.6vw, 5.4rem) / 0.98 var(--display);
    letter-spacing: -0.045em;
    margin: 0.2rem 0 1.3rem;
    animation: rise 0.9s cubic-bezier(0.2, 1, 0.3, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
      text-shadow: none;
    }
  }
  .hero-copy .lede {
    animation: rise 0.9s 0.12s cubic-bezier(0.2, 1, 0.3, 1) both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 34px;
    margin: 38px 0 0;
  }
  .specs dt {
    font: 500 0.66rem var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .specs dd {
    margin: 4px 0 0;
    font: 600 1rem var(--display);
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .hero-stage {
    position: relative;
    padding-bottom: 70px; /* room for the pick-the-next-print chips */
  }
  .hero-stage::before {
    /* glow under the printer */
    content: '';
    position: absolute;
    inset: 15% 5% 0;
    background: radial-gradient(closest-side, rgba(255, 140, 30, 0.22), transparent);
    filter: blur(20px);
    z-index: -1;
  }

  /* ticker */
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: rgba(13, 11, 21, 0.75);
    transform: rotate(-1.2deg) scale(1.02);
    margin-block: 8px 0;
  }
  .track {
    display: flex;
    width: max-content;
    animation: tick 42s linear infinite;
  }
  .track span {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 14px 0 14px 22px;
    font: 600 0.95rem var(--display);
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;
  }
  .track i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--hot);
    transform: rotate(45deg);
    box-shadow: 0 0 10px var(--hot);
  }
  .track span:nth-child(3n + 2) i {
    background: var(--uv);
    box-shadow: 0 0 10px var(--uv);
  }
  .track span:nth-child(3n) i {
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }

  .tight {
    padding-top: 0;
  }
  .last {
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  /* category tiles */
  .cats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .cat {
    display: block;
    text-decoration: none;
    perspective: 900px;
  }
  .cat-slab {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    overflow: hidden;
    background:
      radial-gradient(circle at var(--mx, 50%) var(--my, 30%), color-mix(in srgb, var(--c) 18%, transparent), transparent 60%),
      var(--panel);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s cubic-bezier(0.2, 1, 0.3, 1),
      border-color 0.3s;
    box-shadow:
      2px 2px 0 -1px color-mix(in srgb, var(--c) 35%, var(--panel-3)),
      4px 4px 0 -1px var(--panel-2),
      6px 6px 0 -1px color-mix(in srgb, var(--c) 25%, var(--panel-3)),
      8px 8px 0 -1px var(--ink-2),
      8px 8px 0 0 color-mix(in srgb, var(--c) 30%, transparent);
  }
  :global(.tilting) .cat-slab {
    transition: transform 0.08s linear;
  }
  .cat:hover .cat-slab {
    border-color: var(--c);
  }
  .cat-art {
    aspect-ratio: 4 / 3;
    position: relative;
  }
  .cat-art :global(svg) {
    width: 100%;
    height: 100%;
    transition: opacity 0.5s;
  }
  .cat-art:global(.thumb-ready) :global(svg) {
    opacity: 0;
  }
  .cat-art :global(.thumb-3d) {
    transform: translateZ(0);
    transition:
      opacity 0.5s,
      transform 0.6s cubic-bezier(0.2, 1, 0.3, 1) !important;
  }
  .cat:hover .cat-art :global(.thumb-3d) {
    transform: scale(1.1) rotate(-3deg);
  }
  .cat-txt {
    padding: 4px 20px 22px;
  }
  .cat-txt h3 {
    margin: 8px 0 6px;
    font-size: 1.1rem;
  }
  .cat-txt p {
    font-size: 0.9rem;
    color: var(--text-3);
    margin: 0;
  }
  .cat-go {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--c);
    color: #12091a;
    font-weight: 700;
    transform: scale(0.6);
    opacity: 0;
    transition:
      transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1),
      opacity 0.2s;
  }
  .cat:hover .cat-go {
    transform: scale(1);
    opacity: 1;
  }

  /* spotlight */
  .spot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }
  .spot-title {
    font: 700 clamp(2.4rem, 5.4vw, 4.2rem) / 0.98 var(--display);
    letter-spacing: -0.045em;
    margin: 0.2rem 0 1rem;
  }

  /* timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    position: relative;
  }
  .timeline::after {
    content: '';
    position: absolute;
    left: 24px;
    right: 24px;
    top: 26px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--uv), var(--hot), var(--mint), var(--pink));
    z-index: -1;
    opacity: 0.7;
  }
  .timeline li {
    padding: 0 4px;
  }
  .n {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    border: 1px solid var(--line-2);
    background: var(--panel-2);
    font: 700 1rem var(--display);
    color: var(--hot);
    box-shadow:
      2px 2px 0 -1px var(--panel-3),
      4px 4px 0 -1px var(--ink-2),
      4px 4px 0 0 var(--line);
    margin-bottom: 16px;
  }
  .timeline li:nth-child(2) .n {
    color: var(--uv-2);
  }
  .timeline li:nth-child(3) .n {
    color: var(--mint);
  }
  .timeline li:nth-child(4) .n {
    color: var(--pink);
  }
  .timeline h3 {
    margin-bottom: 6px;
  }
  .timeline p {
    font-size: 0.9rem;
    color: var(--text-3);
    margin: 0;
  }

  /* learn */
  .learn {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .guide {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 24px;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    text-decoration: none;
    overflow: hidden;
    background:
      radial-gradient(circle at var(--mx, 100%) var(--my, 0%), rgba(255, 225, 77, 0.12), transparent 55%),
      var(--panel);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s cubic-bezier(0.2, 1, 0.3, 1),
      border-color 0.3s;
  }
  .guide:hover {
    border-color: #ffe14d;
  }
  .gnum {
    position: absolute;
    right: 14px;
    top: 4px;
    font: 700 4.2rem/1 var(--display);
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 225, 77, 0.35);
  }
  .guide h3 {
    margin: 10px 0 4px;
    font-size: 1.12rem;
  }
  .guide p {
    font-size: 0.9rem;
    color: var(--text-3);
    margin: 0;
  }

  @media (max-width: 1080px) {
    .cats {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 900px) {
    .hero-grid,
    .spot {
      grid-template-columns: 1fr;
    }
    .hero-stage {
      max-width: 520px;
      margin-inline: auto;
      width: 100%;
      padding-bottom: 104px;
    }
    .timeline,
    .learn {
      grid-template-columns: 1fr 1fr;
    }
    .timeline::after {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .cats,
    .timeline,
    .learn {
      grid-template-columns: 1fr;
    }
  }
</style>
