---
import Base from '../layouts/Base.astro';
---

<Base cta={false} title="Not found">
  <section class="section wrap lost">
    <div class="copy">
      <p class="kicker"><span class="dot warn"></span>Error 404 · print failed</p>
      <h1 class="x3d">This page turned into <span class="hot">spaghetti</span>.</h1>
      <p class="lede">
        The nozzle lost its grip somewhere around layer 3. The page you wanted doesn't exist, or it moved. Let's get you
        back on the bed.
      </p>
      <p class="didyou" data-didyou hidden>Were you looking for <a href="/shop/">this</a>?</p>
      <div class="actions">
        <button type="button" class="btn btn--primary" data-search-open>Search the site</button>
        <a class="btn" href="/shop/">Go to the shop</a>
      </div>
      <nav class="popular" aria-label="Popular pages">
        <span class="tag">Or try</span>
        <a href="/custom/">Custom orders</a>
        <a href="/gifts/">Gift finder</a>
        <a href="/shop/pen-launcher/">Pen Launcher</a>
        <a href="/learn/">Guides</a>
        <a href="/">Home</a>
      </nav>
    </div>
    <div class="mess" data-mess>
      <canvas aria-label="A failed 3D print: a tangle of loose filament" role="img"></canvas>
      <span class="label tag">Layer 003 of 214 · bed adhesion lost</span>
    </div>
  </section>
</Base>

<script>
  // A mistyped product address? Suggest the closest real one.
  import { PRODUCTS } from '../data/catalog.ts';
  const words = location.pathname.toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length > 2);
  const best = PRODUCTS.map((p) => ({ p, n: words.filter((w) => `${p.slug} ${p.name}`.toLowerCase().includes(w)).length }))
    .filter((x) => x.n > 0)
    .sort((a, b) => b.n - a.n)[0];
  if (best) {
    const hint = document.querySelector<HTMLElement>('[data-didyou]')!;
    const a = hint.querySelector('a')!;
    a.href = `/shop/${best.p.slug}/`;
    a.textContent = best.p.name;
    hint.hidden = false;
  }

  import { webglOK } from '../lib/three/support.ts';
  const el = document.querySelector<HTMLElement>('[data-mess]');
  if (el && webglOK()) {
    import('../lib/three/viewer.ts').then(({ mountViewer }) => {
      const v = mountViewer(el.querySelector('canvas')!, 'spaghetti', '#ffab2e');
      v.reprint(4);
      el.classList.add('ready');
    });
  }
</script>

<style>
  .lost {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 70vh;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    letter-spacing: -0.04em;
  }
  .dot.warn {
    background: var(--warn);
    box-shadow: 0 0 10px var(--warn);
  }
  .didyou {
    font-size: 1.05rem;
    color: var(--text);
  }
  .didyou a {
    color: var(--hot);
    font-weight: 700;
  }
  .popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 26px;
  }
  .popular a {
    color: var(--text-2);
    font-weight: 600;
    text-decoration: none;
  }
  .popular a:hover {
    color: var(--hot);
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .mess {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background:
      radial-gradient(circle at 50% 60%, rgba(255, 140, 30, 0.18), transparent 60%),
      var(--ink-2);
    overflow: hidden;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  .label {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: var(--warn);
  }
  .mess:not(.ready) {
    display: none;
  }
  @media (max-width: 820px) {
    .lost {
      grid-template-columns: 1fr;
    }
  }
</style>
