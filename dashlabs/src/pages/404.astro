---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="section wrap">
    <p class="tag tag--accent">Error 404 · print failed</p>
    <h1 class="x3d">This page came off the bed.</h1>
    <p class="lede">The page you were looking for doesn't exist (or got spaghettified).</p>
    <a class="btn btn--primary" href="/shop/">Go to the shop</a>
  </section>
</Base>
