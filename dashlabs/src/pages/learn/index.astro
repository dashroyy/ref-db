---
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../data/guides.ts';
import GuideGlyph from '../../components/GuideGlyph.astro';
const minutes = GUIDES.reduce((n, g) => n + g.minutes, 0);
---

<Base title="Learn" description="Short 3D printing guides with tools: materials, pricing, photos for figurines, designing for printing, caring for prints and Pen Launcher physics.">
  <section class="section top">
    <div class="wrap">
      <p class="tag tag--accent">Learn</p>
      <h1 class="x3d">How it's made, and why.</h1>
      <p class="lede">
        Short guides that explain the idea first, then hand you a tool to play with. Read one before you order and
        you'll know exactly what to ask for.
      </p>
      <p class="meta tag">{GUIDES.length} guides · {GUIDES.length} tools · about {minutes} minutes in all</p>
      <ol class="guides">
        {
          GUIDES.map((g, i) => (
            <li>
              <a class="panel" href={`/learn/${g.slug}/`} data-tilt>
                <span class="art">
                  <GuideGlyph slug={g.slug} />
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                </span>
                <div>
                  <h2>{g.title}</h2>
                  <p class="muted">{g.summary}</p>
                  <span class="tag">Tool · {g.tool} · {g.minutes} min</span>
                </div>
                <span class="arrow">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .top {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .meta {
    margin-top: -4px;
  }
  .guides {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .guides li {
    display: flex;
  }
  .guides a {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s cubic-bezier(0.2, 1, 0.3, 1),
      border-color 0.2s;
  }
  :global(.tilting).panel {
    transition: transform 0.08s linear;
  }
  .guides a:hover {
    border-color: #ffe14d;
  }
  .art {
    position: relative;
    display: block;
    padding: 22px 34px 12px;
    background:
      radial-gradient(circle at var(--mx, 50%) var(--my, 40%), rgba(255, 225, 77, 0.12), transparent 60%),
      var(--ink-2);
    border-bottom: 1px solid var(--line);
  }
  .art :global(.glyph) {
    max-width: 200px;
    margin-inline: auto;
    transition: transform 0.5s cubic-bezier(0.2, 1.3, 0.4, 1);
  }
  .guides a:hover .art :global(.glyph) {
    transform: scale(1.08) rotate(-2deg);
  }
  .num {
    position: absolute;
    top: 10px;
    left: 14px;
    font: 700 0.8rem var(--mono);
    color: var(--hot);
  }
  .guides a > div {
    padding: 18px 20px 20px;
    display: grid;
    align-content: start;
  }
  h2 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  p {
    margin-bottom: 12px;
    font-size: 0.92rem;
  }
  .guides .tag {
    margin-top: auto;
  }
  .arrow {
    position: absolute;
    right: 16px;
    top: 10px;
    color: var(--hot);
    font-size: 1.2rem;
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .guides a:hover .arrow {
    transform: translateX(4px);
  }
  @media (max-width: 960px) {
    .guides {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .guides {
      grid-template-columns: 1fr;
    }
  }
</style>
