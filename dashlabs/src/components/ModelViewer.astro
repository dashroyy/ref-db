---
// 3D product viewer: drag to spin, recolours to the filament picked in the
// product form (input[name=colour]), and can replay the print layer by layer.
// The drawn artwork stays as the fallback without WebGL.
import ProductArt from './ProductArt.astro';
import type { Product } from '../data/catalog.ts';
import { categoryById } from '../data/catalog.ts';

interface Props {
  product: Product;
  color?: string; // starting filament colour (showcases); product pages start on the first option
}
const { product: p, color } = Astro.props;
const colours = p.options.find((o) => o.id === 'colour');
const hexes = Object.fromEntries((colours?.choices ?? []).map((c) => [c.id, c.hex ?? categoryById(p.category).color]));
const start = color ?? colours?.choices[0]?.hex ?? categoryById(p.category).color;
const textHexes = Object.fromEntries((p.options.find((o) => o.id === 'textColour')?.choices ?? []).map((c) => [c.id, c.hex]));
const firstText = Object.values(textHexes)[0] ?? '#ece6da';
const size = p.size;
---

<div
  class="viewer"
  data-viewer
  data-shape={p.art.shape}
  data-color={start}
  data-hexes={JSON.stringify(hexes)}
  data-personalise={p.personalise ? p.personalise.max : undefined}
  data-text-hexes={JSON.stringify(textHexes)}
  data-text-color={firstText}
  data-size={size ? JSON.stringify(size) : undefined}
>
  <canvas data-canvas aria-label={`3D model of ${p.name}. Drag to rotate.`} role="img"></canvas>
  <div class="fallback" data-fallback><ProductArt shape={p.art.shape} hue={p.art.hue} uid={`v-${p.id}`} label={p.name} /></div>
  <label class="scrub">
    <span class="scrub-lbl"><b>Layer</b> <span data-layer-read>all</span></span>
    <input type="range" min="1" max="100" value="100" data-layer-scrub aria-label="Scrub through the print layer by layer" />
  </label>
  <div class="controls">
    <span class="hint-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg>Drag to spin</span>
    {
      size && (
        <button type="button" class="reprint size-btn" data-size-btn aria-pressed="false" title={size.placeholder ? 'Approximate size' : undefined}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 17 17 3l4 4L7 21z"></path><path d="m7 13 2 2M10 10l2 2M13 7l2 2"></path></svg>
          <span data-size-label>Real size</span>
        </button>
      )
    }
    <button type="button" class="reprint" data-reprint>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>
      Watch it print
    </button>
  </div>
  <span class="label tag">Preview · not to scale · colours approximate</span>
</div>

<script>
  import { webglOK } from '../lib/three/support.ts';
  import type { Shape } from '../lib/three/print.ts';

  const el = document.querySelector<HTMLElement>('[data-viewer]');
  if (el && webglOK()) {
    import('../lib/three/viewer.ts').then(({ mountViewer }) => {
      const v = mountViewer(el.querySelector('canvas')!, el.dataset.shape as Shape, el.dataset.color!);
      el.classList.add('gl-ready');
      const hexes: Record<string, string> = JSON.parse(el.dataset.hexes || '{}');
      document.querySelectorAll<HTMLInputElement>('input[name="colour"]').forEach((input) =>
        input.addEventListener('change', () => input.checked && hexes[input.value] && v.setColor(hexes[input.value])),
      );
      el.querySelector('[data-reprint]')!.addEventListener('click', () => {
        scrub.value = '100';
        v.scrub({ cut: null, spin: true, lines: 0.14 });
        read.textContent = 'all';
        v.reprint();
      });

      // Real size: ruler + bank card beside the model, following the size option
      const sizeBtn = el.querySelector<HTMLButtonElement>('[data-size-btn]');
      if (sizeBtn && el.dataset.size) {
        const sz = JSON.parse(el.dataset.size) as { mm: number; axis: 'height' | 'length'; byOption?: { option: string; mm: Record<string, number> }; placeholder?: boolean };
        const label = el.querySelector<HTMLElement>('[data-size-label]')!;
        const currentMm = () => {
          if (!sz.byOption) return sz.mm;
          const chosen = document.querySelector<HTMLInputElement>(`input[name="${sz.byOption.option}"]:checked`);
          return (chosen && sz.byOption.mm[chosen.value]) || sz.mm;
        };
        let on = false;
        const apply = () => {
          const mm = currentMm();
          v.showScale(on ? { mm, axis: sz.axis } : null);
          sizeBtn.setAttribute('aria-pressed', String(on));
          const word = sz.axis === 'height' ? 'tall' : 'long';
          label.textContent = on ? `${sz.placeholder ? '≈' : ''}${mm} mm ${word}` : 'Real size';
          el.querySelector<HTMLElement>('.label')!.textContent = on
            ? `Real-size view · ruler in cm · bank card for scale${sz.placeholder ? ' · size approximate' : ''}`
            : 'Preview · not to scale · colours approximate';
        };
        sizeBtn.addEventListener('click', () => ((on = !on), apply()));
        if (sz.byOption) {
          document.querySelectorAll<HTMLInputElement>(`input[name="${sz.byOption.option}"]`).forEach((i) => i.addEventListener('change', () => on && apply()));
        }
      }

      // Layer scrubber: slice through the part like a slicer preview
      const scrub = el.querySelector<HTMLInputElement>('[data-layer-scrub]')!;
      const read = el.querySelector<HTMLElement>('[data-layer-read]')!;
      scrub.addEventListener('input', () => {
        const f = Number(scrub.value) / 100;
        const total = v.layers();
        const whole = f >= 0.999;
        v.scrub({ cut: whole ? null : f, spin: whole, lines: whole ? 0.14 : 0.45 });
        read.textContent = whole ? 'all' : `${Math.max(1, Math.round(f * total))} / ${total}`;
      });
      setTimeout(() => v.reprint(), 350);

      // Personalised products: the text field and text colour drive real 3D letters
      if (el.dataset.personalise) {
        const max = Number(el.dataset.personalise);
        const textHexes: Record<string, string> = JSON.parse(el.dataset.textHexes || '{}');
        let textColor = el.dataset.textColor!;
        const note = document.querySelector<HTMLInputElement>('#note');
        import('../lib/three/text.ts').then(({ applyText, setTextColor, cleanText }) => {
          let t = 0;
          const update = () => {
            v.face();
            return v.edit((m) => applyText(m, cleanText(note?.value ?? '', max), textColor));
          };
          note?.addEventListener('input', () => {
            clearTimeout(t);
            t = window.setTimeout(update, 120);
          });
          document.querySelectorAll<HTMLInputElement>('input[name="textColour"]').forEach((input) =>
            input.addEventListener('change', () => {
              if (!input.checked) return;
              textColor = textHexes[input.value] ?? textColor;
              v.face();
              v.edit((m) => setTextColor(m, textColor));
            }),
          );
          if (note?.value) update();
        });
      }
    });
  }
</script>

<style>
  .viewer {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 65%, color-mix(in srgb, var(--tone) 22%, transparent), transparent 60%),
      radial-gradient(circle at 80% 10%, rgba(155, 107, 255, 0.2), transparent 50%),
      var(--ink-2);
    box-shadow:
      2px 2px 0 -1px var(--panel-3),
      4px 4px 0 -1px var(--panel-2),
      6px 6px 0 -1px var(--panel-3),
      8px 8px 0 -1px var(--ink-2),
      8px 8px 0 0 var(--line);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }
  canvas:active {
    cursor: grabbing;
  }
  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.4s;
  }
  .fallback :global(svg) {
    width: 100%;
  }
  .gl-ready .fallback {
    opacity: 0;
    pointer-events: none;
  }
  .controls {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    pointer-events: none;
  }
  .hint-chip,
  .reprint {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    backdrop-filter: blur(6px);
    font: 600 0.78rem var(--font);
    color: var(--text-2);
  }
  .reprint {
    pointer-events: auto;
    cursor: pointer;
    color: var(--white);
  }
  .size-btn[aria-pressed='true'] {
    border-color: var(--mint);
    color: var(--mint);
  }
  .reprint:hover {
    border-color: var(--hot);
    color: var(--hot);
  }
  .viewer:not(.gl-ready) .controls,
  .viewer:not(.gl-ready) .scrub {
    display: none;
  }
  .scrub {
    position: absolute;
    top: 38px;
    right: 14px;
    display: grid;
    gap: 4px;
    width: min(210px, 50%);
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    backdrop-filter: blur(6px);
  }
  .scrub-lbl {
    display: flex;
    justify-content: space-between;
    font: 500 0.7rem var(--mono);
    color: var(--text-2);
  }
  .scrub-lbl b {
    color: var(--white);
    font-weight: 600;
  }
  .scrub input {
    width: 100%;
    accent-color: var(--hot);
    margin: 0;
  }
  .label {
    position: absolute;
    top: 14px;
    left: 16px;
    font-size: 0.62rem;
  }
</style>
