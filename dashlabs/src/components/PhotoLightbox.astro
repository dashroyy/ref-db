---
// Full-screen product photos. Opened by any [data-zoom="<index>"] button on the
// page. Arrow keys / swipe to move, Esc or the backdrop to close. The large
// versions only load when the viewer opens.
import ProductPhoto from './ProductPhoto.astro';
import type { ProductPhoto as Photo } from '../lib/product-photos.ts';

interface Props {
  photos: Photo[];
  name: string;
}
const { photos, name } = Astro.props;
---

{
  photos.length > 0 && (
    <dialog class="lightbox" data-lightbox aria-label={`${name} photos`}>
      <div class="lb-top">
        <span class="lb-count" aria-live="polite" data-lb-count />
        <button type="button" class="lb-btn" data-lb-close aria-label="Close photos">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <div class="lb-stage" data-lb-stage>
        {photos.map((ph, i) => (
          <figure class="lb-slide" data-lb-slide={i} hidden>
            <ProductPhoto photo={ph} widths={[960, 1400, 2000]} sizes="100vw" class="lb-img" />
            <figcaption>{ph.alt}</figcaption>
          </figure>
        ))}
      </div>
      {photos.length > 1 && (
        <>
          <button type="button" class="lb-btn lb-prev" data-lb-step="-1" aria-label="Previous photo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
          </button>
          <button type="button" class="lb-btn lb-next" data-lb-step="1" aria-label="Next photo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
          </button>
        </>
      )}
    </dialog>
  )
}

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dlg) {
    const slides = [...dlg.querySelectorAll<HTMLElement>('[data-lb-slide]')];
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    let at = 0;
    const show = (i: number) => {
      at = (i + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== at));
      count.textContent = `${at + 1} / ${slides.length}`;
      // the big image loads now (it was lazy and hidden)
      slides[at].querySelector('img')?.setAttribute('loading', 'eager');
    };
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(Number(b.dataset.zoom));
        dlg.showModal();
        dlg.querySelector<HTMLButtonElement>('[data-lb-close]')!.focus();
      }),
    );
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.lbStep))));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(at + 1);
      else if (e.key === 'ArrowLeft') show(at - 1);
    });
    // click outside the photo closes
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.matches('[data-lb-stage], .lb-slide')) dlg.close();
    });
    // swipe
    let x0: number | null = null;
    dlg.addEventListener('pointerdown', (e) => (x0 = e.pointerType === 'mouse' ? null : e.clientX));
    dlg.addEventListener('pointerup', (e) => {
      if (x0 === null || slides.length < 2) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1));
    });
    dlg.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(5, 4, 9, 0.94);
    color: var(--white);
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    background: rgba(5, 4, 9, 0.6);
    backdrop-filter: blur(6px);
  }
  .lb-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
  }
  .lb-count {
    font: 600 0.85rem var(--mono);
    color: var(--text-2);
  }
  .lb-stage {
    position: absolute;
    inset: 64px 16px 16px;
    display: grid;
    place-items: center;
  }
  .lb-slide {
    margin: 0;
    display: grid;
    gap: 10px;
    justify-items: center;
    max-height: 100%;
  }
  .lb-slide[hidden] {
    display: none;
  }
  .lb-slide :global(picture) {
    display: contents;
  }
  .lb-slide :global(.lb-img) {
    display: block;
    max-width: min(100%, 1400px);
    max-height: calc(100dvh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    touch-action: pan-y pinch-zoom;
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--text-3);
    text-align: center;
  }
  .lb-btn {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    color: var(--white);
    cursor: pointer;
  }
  .lb-btn:hover,
  .lb-btn:focus-visible {
    border-color: var(--hot);
    color: var(--hot);
  }
  .lb-prev,
  .lb-next {
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 16px;
  }
  .lb-next {
    right: 16px;
  }
  @media (max-width: 640px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 18px;
      transform: none;
    }
    .lb-stage {
      inset: 64px 8px 80px;
    }
  }
</style>
