---
// Instant STL quote: drop a 3D file, see it printed in the chamber, get a
// price from its real volume and surface area. Everything happens in the
// browser; the file is never uploaded. Maths in src/lib/mesh.ts and
// src/lib/estimate.ts (unit-tested).
import { MATERIALS } from '../data/materials.ts';
import { COLOURS } from '../data/catalog.ts';
import { QUALITIES } from '../lib/estimate.ts';
---

<div class="calc stlq" data-stl>
  <div class="calc-head"><span>Instant STL quote</span><span>your file stays on your device</span></div>
  <div class="calc-body">
    <div class="stage" data-stage>
      <canvas data-canvas aria-label="3D preview of your part. Drag to rotate." role="img"></canvas>
      <label class="drop" data-drop>
        <input type="file" accept=".stl,model/stl,application/sla" data-file hidden />
        <svg width="54" height="54" viewBox="0 0 40 40" aria-hidden="true">
          <polygon points="20,4 35,12 20,20 5,12" fill="var(--hot)"></polygon>
          <polygon points="5,12 20,20 20,36 5,28" fill="#6c47d6"></polygon>
          <polygon points="20,20 35,12 35,28 20,36" fill="#4a2ca8"></polygon>
        </svg>
        <strong>Drop an STL file here</strong>
        <span class="muted">or <u>choose a file</u>. Binary or ASCII, up to 80 MB.</span>
      </label>
      <div class="stage-bar">
        <span class="file-chip" data-file-name>Sample · twisted star</span>
        <span class="stage-actions">
          <button type="button" class="mini" data-pick>Load your STL</button>
          <button type="button" class="mini" data-reprint>▶ Print</button>
        </span>
      </div>
      <p class="loading" data-loading hidden>Slicing…</p>
    </div>

    <div class="calc-out">
      <form data-form onsubmit="return false">
        <div class="row2">
          <div class="field">
            <label for="sq-mat">Material</label>
            <select id="sq-mat" name="material">{MATERIALS.map((m) => <option value={m.id}>{m.name}</option>)}</select>
          </div>
          <div class="field">
            <label for="sq-q">Quality</label>
            <select id="sq-q" name="quality">{QUALITIES.map((q) => <option value={q.id} selected={q.id === 'standard'}>{q.label.split(' · ')[0]}</option>)}</select>
          </div>
        </div>
        <div class="field">
          <span class="lbl">Filament colour (preview)</span>
          <div class="swatches" role="radiogroup" aria-label="Filament colour">
            {
              COLOURS.choices.map((c, i) => (
                <label class="sw" title={c.label}>
                  <input type="radio" name="colour" value={c.hex} checked={i === 2} />
                  <i
                    style={`background:${c.hex === 'rainbow' ? 'conic-gradient(#ff5c7a,#ffd84d,#3dffc5,#2f7dff,#9b6bff,#ff5c7a)' : c.hex}`}
                  />
                  <span class="sr-only">{c.label}</span>
                </label>
              ))
            }
          </div>
        </div>
        <div class="row2">
          <div class="field">
            <label for="sq-inf">Infill <span class="range-val" data-inf-val>15%</span></label>
            <input id="sq-inf" name="infill" type="range" min="5" max="100" step="5" value="15" />
          </div>
          <div class="field">
            <label for="sq-sc">Scale <span class="range-val" data-sc-val>100%</span></label>
            <input id="sq-sc" name="scale" type="range" min="25" max="300" step="5" value="100" />
          </div>
        </div>
        <div class="field qty">
          <label for="sq-qty">Quantity</label>
          <input id="sq-qty" name="qty" type="number" min="1" max="100" value="1" />
        </div>
      </form>

      <div class="price-row">
        <div>
          <span class="tag">Estimated price</span>
          <div class="big" data-total>—</div>
        </div>
        <button type="button" class="btn btn--primary" data-use disabled>Use in my request</button>
      </div>
      <dl class="readout-grid">
        <div><dt>Size (mm)</dt><dd data-size>—</dd></div>
        <div><dt>Volume</dt><dd data-vol>—</dd></div>
        <div><dt>Plastic</dt><dd data-grams>—</dd></div>
        <div><dt>Print time</dt><dd data-hours>—</dd></div>
      </dl>
      <ul class="warns" data-warns></ul>
    </div>
  </div>
</div>

<script>
  import { webglOK } from '../lib/three/support.ts';
  import { estimateSolid, formatHours, QUALITIES } from '../lib/estimate.ts';
  import { fitsBed, type MeshStats } from '../lib/mesh.ts';
  import { materialById, type MaterialId } from '../data/materials.ts';

  const root = document.querySelector<HTMLElement>('[data-stl]');
  if (root) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const fileInput = root.querySelector<HTMLInputElement>('[data-file]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    let stats: MeshStats | null = null;
    let fileName = 'Sample · twisted star';
    type Viewer = { setColor(c: string): void; reprint(s?: number): void; replace(m: unknown): void };
    let viewer: Viewer | null = null;
    let lib: { stl: typeof import('../lib/three/stl.ts'); viewer: typeof import('../lib/three/viewer.ts') } | null = null;

    const gl = webglOK();
    if (!gl) root.classList.add('no-gl');

    const loadLib = async () =>
      (lib ??= { stl: await import('../lib/three/stl.ts'), viewer: await import('../lib/three/viewer.ts') });
    const colour = () => (new FormData(form).get('colour') as string) || '#ff8a1f';

    const show = async (part: import('../lib/three/stl.ts').LoadedPart, name: string) => {
      const L = await loadLib();
      stats = part.stats;
      fileName = name;
      $('[data-file-name]').textContent = name;
      const model = L.stl.partModel(part, colour());
      if (!viewer) viewer = L.viewer.mountModel(canvas, model) as Viewer;
      else viewer.replace(model);
      root.classList.add('has-part');
      viewer.reprint(2.4);
      render();
    };

    const loadFile = async (file: File) => {
      if (!/\.stl$/i.test(file.name)) return warn([`“${file.name}” isn't an STL file. Export your model as .stl and try again.`]);
      if (file.size > 80 * 1024 * 1024) return warn(['That file is over 80 MB. Send it with your request instead and I’ll quote by hand.']);
      $('[data-loading]').hidden = false;
      try {
        const L = await loadLib();
        const part = L.stl.parseStl(await file.arrayBuffer());
        if (!part.stats.triangles) throw new Error('empty');
        await show(part, file.name);
      } catch {
        warn(['Couldn’t read that STL. It may be damaged; try re-exporting it.']);
      } finally {
        $('[data-loading]').hidden = true;
      }
    };

    const warn = (list: string[]) => {
      $('[data-warns]').innerHTML = list.map((w) => `<li>${w.replace(/</g, '&lt;')}</li>`).join('');
    };

    const render = () => {
      const f = new FormData(form);
      const inf = Number(f.get('infill'));
      const k = Number(f.get('scale')) / 100;
      $('[data-inf-val]').textContent = `${inf}%`;
      $('[data-sc-val]').textContent = `${Math.round(k * 100)}%`;
      if (!stats) return;
      const size = { x: stats.size.x * k, y: stats.size.y * k, z: stats.size.z * k };
      const settings = {
        material: f.get('material') as MaterialId,
        infill: inf / 100,
        quality: f.get('quality') as (typeof QUALITIES)[number]['id'],
        qty: Number(f.get('qty')) || 1,
      };
      const r = estimateSolid({ volume: (stats.volumeMm3 * k ** 3) / 1000, area: (stats.areaMm2 * k ** 2) / 100 }, settings);
      $('[data-total]').textContent = `$${r.total}`;
      $('[data-size]').textContent = `${size.x.toFixed(0)}×${size.y.toFixed(0)}×${size.z.toFixed(0)}`;
      $('[data-vol]').textContent = `${r.volume.toFixed(1)} cm³`;
      $('[data-grams]').textContent = `${r.grams.toFixed(0)} g`;
      $('[data-hours]').textContent = formatHours(r.hours);
      const w: string[] = [];
      if (!stats.closed) w.push('This mesh isn’t watertight, so its volume (and the price) is approximate. I’ll check it before quoting.');
      if (!fitsBed(size)) w.push('It’s bigger than the 256 mm build plate. I can split it into parts; mention it in your request.');
      if (Math.min(size.x, size.y, size.z) < 2) w.push('Some of it is under 2 mm thick, which may be too fine to print well.');
      warn(w);
      ($('[data-use]') as HTMLButtonElement).disabled = false;
      root.dataset.summary =
        `STL quote: ${fileName}\n${settings.qty} × ${size.x.toFixed(0)}×${size.y.toFixed(0)}×${size.z.toFixed(0)} mm (${Math.round(k * 100)}% scale)\n` +
        `${materialById(settings.material)!.name}, ${QUALITIES.find((q) => q.id === settings.quality)!.label}, ${inf}% infill\n` +
        `Estimate shown: $${r.total} (${r.grams.toFixed(0)} g, ${formatHours(r.hours)})\n\n` +
        `I'll attach the STL file to this email.`;
    };

    form.addEventListener('input', (e) => {
      if ((e.target as HTMLInputElement).name === 'colour') viewer?.setColor(colour());
      render();
    });

    // file picking and drag-and-drop
    const drop = $('[data-drop]');
    fileInput.addEventListener('change', () => fileInput.files?.[0] && loadFile(fileInput.files[0]));
    root.querySelector('[data-pick]')!.addEventListener('click', () => fileInput.click());
    const stage = $('[data-stage]');
    stage.addEventListener('dragover', (e) => {
      e.preventDefault();
      stage.classList.add('dragging');
    });
    stage.addEventListener('dragleave', () => stage.classList.remove('dragging'));
    stage.addEventListener('drop', (e) => {
      e.preventDefault();
      stage.classList.remove('dragging');
      const file = e.dataTransfer?.files?.[0];
      if (file) loadFile(file);
    });
    drop.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && fileInput.click());
    root.querySelector('[data-reprint]')!.addEventListener('click', () => viewer?.reprint(2.4));

    // hand the numbers to the request form below
    root.querySelector('[data-use]')!.addEventListener('click', () => {
      const details = document.querySelector<HTMLTextAreaElement>('#details');
      const kind = document.querySelector<HTMLSelectElement>('#kind');
      if (!details) return;
      if (kind) kind.value = 'other';
      details.value = root.dataset.summary ?? '';
      details.closest('form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => details.focus({ preventScroll: true }), 500);
    });

    // show the sample when the tool scrolls into view (WebGL only)
    if (gl) {
      let started = false;
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting || started) return;
        started = true;
        io.disconnect();
        const L = await loadLib();
        if (!stats) show(L.stl.samplePart(), 'Sample · twisted star');
      });
      io.observe(root);
    }
    render();
  }
</script>

<style>
  .stlq .calc-body {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  .stage {
    position: relative;
    min-height: 380px;
    border-right: 1px solid var(--line);
    background:
      radial-gradient(circle at 50% 60%, rgba(255, 140, 30, 0.14), transparent 60%),
      radial-gradient(circle at 85% 10%, rgba(155, 107, 255, 0.18), transparent 50%),
      var(--ink-2);
    border-radius: 0 0 0 var(--r);
    overflow: hidden;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }
  .drop {
    position: absolute;
    inset: 16px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 10px;
    text-align: center;
    border: 2px dashed var(--line-2);
    border-radius: var(--r);
    cursor: pointer;
    padding: 20px;
    transition:
      border-color 0.2s,
      background 0.2s,
      opacity 0.3s;
  }
  .drop strong {
    font: 600 1.05rem var(--display);
    color: var(--white);
  }
  .drop svg {
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px) rotate(-6deg);
    }
  }
  .has-part .drop {
    opacity: 0;
    pointer-events: none;
  }
  .dragging .drop,
  .has-part.dragging .drop {
    opacity: 1;
    border-color: var(--hot);
    background: rgba(255, 140, 30, 0.12);
  }
  .stage-bar {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .stage-actions {
    display: flex;
    gap: 6px;
  }
  .file-chip,
  .mini {
    padding: 7px 11px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(13, 11, 21, 0.8);
    backdrop-filter: blur(6px);
    font: 600 0.76rem var(--font);
    color: var(--text-2);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mini {
    cursor: pointer;
    color: var(--white);
  }
  .mini:hover {
    border-color: var(--hot);
    color: var(--hot);
  }
  .stlq:not(.has-part) .stage-bar {
    display: none;
  }
  .loading {
    position: absolute;
    top: 14px;
    left: 16px;
    margin: 0;
    font: 600 0.8rem var(--mono);
    color: var(--hot);
  }
  .lbl {
    font: 500 0.7rem/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .swatches {
    display: flex;
    gap: 8px;
  }
  .sw input {
    position: absolute;
    opacity: 0;
  }
  .sw i {
    display: block;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 -3px 5px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .sw input:checked + i {
    border-color: var(--white);
    transform: scale(1.15);
    box-shadow:
      0 0 0 3px var(--ink),
      0 0 0 5px var(--hot);
  }
  .sw input:focus-visible + i {
    outline: 2px solid var(--hot);
    outline-offset: 3px;
  }
  .qty {
    max-width: 140px;
  }
  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .warns {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .warns :global(li) {
    font-size: 0.86rem;
    color: var(--warn);
    padding-left: 18px;
    position: relative;
  }
  .warns :global(li)::before {
    content: '!';
    position: absolute;
    left: 0;
    font: 700 0.8rem var(--mono);
  }
  .no-gl canvas,
  .no-gl .stage-bar {
    display: none;
  }
  @media (max-width: 760px) {
    .stlq .calc-body {
      grid-template-columns: 1fr;
    }
    .stage {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      aspect-ratio: 1 / 1;
      min-height: 0;
      border-radius: 0;
    }
  }
</style>
