---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/shop/', label: 'Shop' },
  { href: '/custom/', label: 'Custom orders' },
  { href: '/lab/', label: 'The lab' },
  { href: '/learn/', label: 'Learn' },
  { href: '/faq/', label: 'FAQ' },
];
const active = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="DashLabs home">
      <Logo />
      <span>Dash<b>Labs</b></span>
    </a>

    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>

    <a href="/cart/" class="cart" aria-label="Cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        ><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"></path><circle cx="10" cy="20.5" r="1.3"
        ></circle><circle cx="17" cy="20.5" r="1.3"></circle></svg
      >
      <span class="count" data-cart-count hidden>0</span>
    </a>
  </div>
</header>

<script>
  import { cartCount, onCartChange } from '../lib/cart-store.ts';
  const badge = document.querySelector<HTMLElement>('[data-cart-count]')!;
  const render = () => {
    const n = cartCount();
    badge.textContent = String(n);
    badge.hidden = n === 0;
  };
  render();
  onCartChange(render);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .brand b {
    font-weight: 600;
    color: var(--accent);
  }
  .nav {
    display: flex;
    justify-content: center;
    gap: 4px;
  }
  .nav a {
    padding: 8px 12px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav a[aria-current='page'] {
    color: var(--text);
    background: var(--panel-2);
  }
  .cart {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text);
  }
  .count {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 600 0.72rem/20px var(--mono);
    text-align: center;
  }
  .count[hidden] {
    display: none;
  }

  /* Phone: nav becomes a scrolling second row */
  @media (max-width: 720px) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-top: 10px;
    }
    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 8px;
      scrollbar-width: none;
    }
    .nav a {
      white-space: nowrap;
      font-size: 0.9rem;
    }
  }
</style>
