---
// "From file to shelf": a scroll-driven story. Scrolling through the section
// takes one model through design (wireframe), slicing (layer bands), printing
// (layer by layer with the hot edge) and finishing. Without WebGL the steps
// still read as a normal list.
const STEPS = [
  { n: '01', t: 'Design', d: 'It starts as a 3D model: measured, sketched, then built in CAD. Every wall thickness and tolerance is decided here.', c: '#c4a8ff' },
  { n: '02', t: 'Slice', d: 'The slicer cuts the model into hundreds of layers, 0.2 mm each, and plans the nozzle’s path through every one.', c: '#9b6bff' },
  { n: '03', t: 'Print', d: 'The printer lays molten plastic down one layer at a time, each fused to the one below. Hours of quiet work.', c: '#ffab2e' },
  { n: '04', t: 'Finish', d: 'Supports off, edges cleaned, checked against the design, then packed to survive the trip to you.', c: '#3dffc5' },
];
---

<section class="story" data-story aria-label="How a print is made">
  <div class="sticky">
    <div class="stage">
      <canvas data-canvas aria-hidden="true"></canvas>
      <div class="hud" aria-hidden="true">
        <span class="chip" data-stage-chip>01 · Design</span>
        <span class="chip mono" data-stage-read>CAD · wireframe</span>
      </div>
    </div>
    <div class="copy">
      <p class="kicker"><span class="dot"></span>From file to shelf</p>
      <h2 class="x3d">How a print<br /><span class="hot">gets made</span></h2>
      <ol class="steps">
        {
          STEPS.map((s, i) => (
            <li data-step={i} style={`--c:${s.c}`} class:list={[i === 0 && 'on']}>
              <span class="n">{s.n}</span>
              <div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="track" aria-hidden="true"><i data-progress></i></div>
    </div>
  </div>
</section>

<script>
  import { webglOK } from '../lib/three/support.ts';

  const root = document.querySelector<HTMLElement>('[data-story]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const chip = root.querySelector<HTMLElement>('[data-stage-chip]')!;
    const read = root.querySelector<HTMLElement>('[data-stage-read]')!;
    const bar = root.querySelector<HTMLElement>('[data-progress]')!;
    const NAMES = ['Design', 'Slice', 'Print', 'Finish'];
    // stage boundaries along the scroll (0..1)
    const B = [0, 0.22, 0.45, 0.8, 1];
    type V = { scrub(s: { cut?: number | null; wire?: boolean; lines?: number; spin?: boolean }): void; setColor(c: string): void; layers(): number };
    let v: V | null = null;
    let lastStage = -1;

    const progress = () => {
      const r = root.getBoundingClientRect();
      return Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
    };

    const update = () => {
      const t = progress();
      const stage = t < B[1] ? 0 : t < B[2] ? 1 : t < B[3] ? 2 : 3;
      bar.style.transform = `scaleX(${t})`;
      if (stage !== lastStage) {
        steps.forEach((s, i) => s.classList.toggle('on', i === stage));
        chip.textContent = `0${stage + 1} · ${NAMES[stage]}`;
        lastStage = stage;
      }
      if (!v) return;
      if (stage === 0) {
        v.scrub({ wire: true, lines: 0.14, cut: null, spin: true });
        read.textContent = 'CAD · wireframe';
      } else if (stage === 1) {
        v.scrub({ wire: false, lines: 0.7, cut: null, spin: true });
        read.textContent = `${v.layers()} layers · 0.20 mm`;
      } else if (stage === 2) {
        const p = (t - B[2]) / (B[3] - B[2]);
        v.scrub({ wire: false, lines: 0.14, cut: Math.max(0.02, p), spin: false });
        read.textContent = `Layer ${Math.max(1, Math.round(p * v.layers()))} / ${v.layers()}`;
      } else {
        v.scrub({ wire: false, lines: 0.14, cut: null, spin: true });
        read.textContent = 'Done · checked · packed';
      }
    };

    let queued = false;
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => ((queued = false), update()));
      },
      { passive: true },
    );
    update();

    if (webglOK()) {
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting || v) return;
        io.disconnect();
        const { mountViewer } = await import('../lib/three/viewer.ts');
        v = mountViewer(root.querySelector('canvas')!, 'launcher', '#ffab2e') as unknown as V;
        root.classList.add('gl');
        lastStage = -1;
        update();
      }, { rootMargin: '200px' });
      io.observe(root);
    }
  }
</script>

<style>
  .story {
    position: relative;
    height: 420vh;
  }
  .sticky {
    position: sticky;
    top: var(--nav-h);
    height: calc(100vh - var(--nav-h));
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }
  .stage {
    position: relative;
    height: min(76vh, 620px);
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 65%, rgba(255, 140, 30, 0.16), transparent 60%),
      radial-gradient(circle at 80% 10%, rgba(155, 107, 255, 0.22), transparent 50%),
      var(--ink-2);
  }
  .story:not(.gl) .stage {
    background:
      var(--layers),
      radial-gradient(circle at 50% 60%, rgba(155, 107, 255, 0.25), transparent 60%),
      var(--ink-2);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hud {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .chip {
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(13, 11, 21, 0.8);
    font: 600 0.76rem var(--font);
    color: var(--white);
  }
  .chip.mono {
    font: 500 0.74rem var(--mono);
    color: var(--hot);
  }
  .copy h2 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    letter-spacing: -0.04em;
    margin-bottom: 22px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid transparent;
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.4s cubic-bezier(0.2, 1.3, 0.4, 1);
  }
  .steps li:not(.on) h3 {
    color: var(--text-2);
  }
  .steps li:not(.on) .n {
    color: var(--text-3);
  }
  .steps li.on {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    background: color-mix(in srgb, var(--c) 9%, var(--panel));
    transform: translateX(6px);
  }
  .n {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--panel-2);
    border: 1px solid var(--line-2);
    font: 700 0.95rem var(--display);
    color: var(--c);
  }
  .steps h3 {
    margin: 2px 0 4px;
  }
  .steps p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-3);
  }
  .track {
    height: 4px;
    margin-top: 18px;
    border-radius: 4px;
    background: var(--panel-3);
    overflow: hidden;
  }
  .track i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #c4a8ff, var(--uv), var(--hot), var(--mint));
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @media (max-width: 900px) {
    .story {
      height: 380vh;
    }
    .sticky {
      grid-template-columns: 1fr;
      grid-template-rows: 46vh auto;
      align-content: start;
      gap: 14px;
      padding-top: 12px;
    }
    .stage {
      height: 46vh;
    }
    .copy h2,
    .copy .kicker {
      display: none;
    }
    .steps li:not(.on) {
      display: none;
    }
    .steps li.on {
      transform: none;
    }
  }
</style>
