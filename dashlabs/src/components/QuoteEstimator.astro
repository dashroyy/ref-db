---
// Print price estimator. Maths in src/lib/estimate.ts (unit-tested); UI only here.
import { SHAPES, QUALITIES, DEFAULT_INPUT as D } from '../lib/estimate.ts';
import { MATERIALS } from '../data/materials.ts';
---

<div class="calc estimator" data-estimator>
  <div class="calc-head"><span>Print price estimator</span><span>ballpark · ±30%</span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <div class="row3">
        <div class="field"><label for="e-w">Width cm</label><input id="e-w" name="w" type="number" min="0.5" max="30" step="0.5" value={D.w} /></div>
        <div class="field"><label for="e-d">Depth cm</label><input id="e-d" name="d" type="number" min="0.5" max="30" step="0.5" value={D.d} /></div>
        <div class="field"><label for="e-h">Height cm</label><input id="e-h" name="h" type="number" min="0.1" max="30" step="0.5" value={D.h} /></div>
      </div>
      <div class="field">
        <label for="e-shape">Shape</label>
        <select id="e-shape" name="shape">{SHAPES.map((s) => <option value={s.id} selected={s.id === D.shape}>{s.label}</option>)}</select>
      </div>
      <div class="row2">
        <div class="field">
          <label for="e-mat">Material</label>
          <select id="e-mat" name="material">{MATERIALS.map((m) => <option value={m.id} selected={m.id === D.material}>{m.name}</option>)}</select>
        </div>
        <div class="field">
          <label for="e-qty">Quantity</label>
          <input id="e-qty" name="qty" type="number" min="1" max="100" step="1" value={D.qty} />
        </div>
      </div>
      <div class="field">
        <label for="e-q">Quality</label>
        <select id="e-q" name="quality">{QUALITIES.map((q) => <option value={q.id} selected={q.id === D.quality}>{q.label}</option>)}</select>
      </div>
      <div class="field">
        <label for="e-inf">Infill <span class="range-val" data-infill-val></span></label>
        <input id="e-inf" name="infill" type="range" min="0" max="100" step="5" value={D.infill * 100} />
      </div>
      <p class="hint">Infill is how solid the inside is. 15% is plenty for display pieces; 40%+ for parts that take a beating.</p>
      <figure class="slice">
        <svg viewBox="0 0 200 200" data-slice role="img" aria-label="Top-down preview of one printed layer: walls and infill">
          <defs><clipPath id="slice-clip"><path data-clip></path></clipPath></defs>
          <g class="infill" clip-path="url(#slice-clip)" data-infill></g>
          <g data-walls></g>
          <circle r="4" class="nozzle" data-nozzle></circle>
        </svg>
        <figcaption>
          <span class="tag">Slicer preview</span>
          <span data-layer-info>—</span>
        </figcaption>
      </figure>
    </form>

    <div class="calc-out" aria-live="polite">
      <div>
        <span class="tag">Estimated price</span>
        <div class="big" data-total>—</div>
        <span class="hint" data-each></span>
      </div>
      <dl class="readout-grid">
        <div><dt class="tag">Plastic</dt><dd data-grams>—</dd></div>
        <div><dt class="tag">Print time</dt><dd data-hours>—</dd></div>
        <div><dt class="tag">Solid skin</dt><dd data-skin>—</dd></div>
      </dl>
      <div>
        <span class="tag">Where the money goes (per part)</span>
        <div class="bar" data-bar aria-hidden="true"></div>
        <ul class="legend" data-legend></ul>
      </div>
      <a class="btn btn--primary" data-request href="/custom/">Request this print</a>
      <p class="hint">Custom modelling (figurines from photos) is quoted separately.</p>
    </div>
  </div>
</div>

<script>
  import { estimate, formatHours, SHAPES, QUALITIES, type EstimateInput } from '../lib/estimate.ts';
  import { materialById, type MaterialId } from '../data/materials.ts';

  const COLORS = ['var(--accent)', 'var(--accent-2)', '#7b808c', '#4a4f5b'];

  // Slicer preview: the part outline for the chosen shape, three wall
  // perimeters, and grid infill whose spacing follows the infill density.
  const OUTLINES: Record<string, string> = {
    block: 'M34 40 H166 Q180 40 180 54 V146 Q180 160 166 160 H34 Q20 160 20 146 V54 Q20 40 34 40 Z',
    organic: 'M100 22 C150 22 180 60 176 100 C172 150 140 180 98 178 C52 176 22 146 24 100 C26 54 54 22 100 22 Z',
    thin: 'M80 18 H120 V80 H182 V120 H120 V182 H80 V120 H18 V80 H80 Z',
    flat: 'M22 62 H178 Q190 62 190 74 V126 Q190 138 178 138 H22 Q10 138 10 126 V74 Q10 62 22 62 Z',
  };
  const svgNS = 'http://www.w3.org/2000/svg';
  function drawSlice(shape: string, infill: number, quality: string, hCm: number) {
    for (const root of document.querySelectorAll<SVGSVGElement>('[data-slice]')) {
      const d = OUTLINES[shape] ?? OUTLINES.block;
      const walls = root.querySelector('[data-walls]')!;
      walls.innerHTML = '';
      [1, 0.94, 0.88].forEach((k, i) => {
        const p = document.createElementNS(svgNS, 'path');
        p.setAttribute('d', d);
        p.setAttribute('transform', `translate(${100 - 100 * k} ${100 - 100 * k}) scale(${k})`);
        p.setAttribute('class', i === 0 ? 'wall outer' : 'wall');
        walls.appendChild(p);
      });
      const clip = root.querySelector('[data-clip]')!;
      clip.setAttribute('d', d);
      clip.setAttribute('transform', 'translate(14 14) scale(0.86)');
      const g = root.querySelector('[data-infill]')!;
      g.innerHTML = '';
      if (infill >= 0.98) {
        const r = document.createElementNS(svgNS, 'rect');
        r.setAttribute('width', '200');
        r.setAttribute('height', '200');
        r.setAttribute('class', 'solid');
        g.appendChild(r);
      } else if (infill > 0) {
        const step = Math.max(4.4, (2 * 2.2) / infill); // grid: two line sets
        for (let o = -200; o < 400; o += step) {
          for (const dir of [1, -1]) {
            const l = document.createElementNS(svgNS, 'line');
            l.setAttribute('x1', String(o));
            l.setAttribute('y1', dir > 0 ? '0' : '200');
            l.setAttribute('x2', String(o + 200));
            l.setAttribute('y2', dir > 0 ? '200' : '0');
            g.appendChild(l);
          }
        }
      }
      const noz = root.querySelector<SVGCircleElement>('[data-nozzle]')!;
      noz.style.setProperty('offset-path', `path('${d}')`);
      const q = QUALITIES.find((x) => x.id === quality)!;
      const layers = Math.max(1, Math.round((hCm * 10) / q.layerMm));
      const info = root.closest('.slice')!.querySelector('[data-layer-info]')!;
      info.textContent = `Layer ${Math.round(layers / 2)} of ${layers} · ${q.layerMm.toFixed(2)} mm · ${Math.round(infill * 100)}% grid`;
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-estimator]')) {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const usd = (n: number) => `$${n.toFixed(2)}`;

    const render = () => {
      const f = new FormData(form);
      const input: EstimateInput = {
        w: Number(f.get('w')),
        d: Number(f.get('d')),
        h: Number(f.get('h')),
        shape: f.get('shape') as EstimateInput['shape'],
        material: f.get('material') as MaterialId,
        infill: Number(f.get('infill')) / 100,
        quality: f.get('quality') as EstimateInput['quality'],
        qty: Number(f.get('qty')),
      };
      const r = estimate(input);
      $('[data-infill-val]').textContent = `${Math.round(input.infill * 100)}%`;
      $('[data-total]').textContent = `$${r.total}`;
      $('[data-each]').textContent = input.qty > 1 ? `for ${input.qty} · about ${usd(r.total / input.qty)} each` : 'for one print';
      $('[data-grams]').textContent = `${r.grams.toFixed(0)} g`;
      $('[data-hours]').textContent = formatHours(r.hours);
      $('[data-skin]').textContent = r.volume ? `${Math.round((r.shell / r.material) * 100)}%` : '—';

      const parts = [
        ['Filament', r.cost.filament],
        ['Machine time', r.cost.machine],
        ['Handling', r.cost.handling],
        ['Margin', r.cost.margin],
      ] as const;
      const sum = parts.reduce((s, [, v]) => s + v, 0) || 1;
      $('[data-bar]').innerHTML = parts
        .map(([, v], i) => `<span style="width:${(v / sum) * 100}%;background:${COLORS[i]}"></span>`)
        .join('');
      $('[data-legend]').innerHTML = parts
        .map(([n, v], i) => `<li><i style="background:${COLORS[i]}"></i>${n}<b>${usd(v)}</b></li>`)
        .join('');

      drawSlice(input.shape, input.infill, input.quality, input.h);
      const shape = SHAPES.find((s) => s.id === input.shape)!.label;
      const q = QUALITIES.find((x) => x.id === input.quality)!.label;
      const details =
        `Print request from the estimator:\n${input.qty} × ${input.w}×${input.d}×${input.h} cm, ${shape}\n` +
        `${materialById(input.material)!.name}, ${q}, ${Math.round(input.infill * 100)}% infill\n` +
        `Estimate shown: $${r.total}\n\nWhat is it / link to the model:`;
      root.querySelector<HTMLAnchorElement>('[data-request]')!.href = `/custom/?${new URLSearchParams({ details })}`;
    };
    form.addEventListener('input', render);
    render();
  }
</script>

<style>
  .slice {
    margin: 14px 0 0;
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 14px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--ink-2);
  }
  .slice svg {
    width: 150px;
    height: 150px;
    overflow: visible;
  }
  .slice figcaption {
    display: grid;
    gap: 6px;
    font: 500 0.8rem var(--mono);
    color: var(--text-2);
  }
  .slice :global(.wall) {
    fill: none;
    stroke: var(--uv-2);
    stroke-width: 2.4;
    vector-effect: non-scaling-stroke;
  }
  .slice :global(.wall.outer) {
    stroke: var(--hot);
  }
  .slice :global(.infill line) {
    stroke: color-mix(in srgb, var(--hot) 70%, transparent);
    stroke-width: 1.6;
  }
  .slice :global(.infill .solid) {
    fill: color-mix(in srgb, var(--hot) 70%, transparent);
  }
  .nozzle {
    fill: #fff3d6;
    filter: drop-shadow(0 0 4px var(--hot)) drop-shadow(0 0 8px var(--hot));
    offset-rotate: 0deg;
    animation: trace 5s linear infinite;
  }
  @keyframes trace {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  @media (max-width: 420px) {
    .slice {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }
  .bar {
    display: flex;
    height: 14px;
    border-radius: 999px;
    overflow: hidden;
    margin: 8px 0 10px;
    background: var(--bg-2);
  }
  .bar :global(span) {
    display: block;
    height: 100%;
    transition: width 0.2s;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 16px;
    font-size: 0.88rem;
    color: var(--text-2);
  }
  .legend :global(li) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .legend :global(i) {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
  }
  .legend :global(b) {
    margin-left: auto;
    font: 500 0.85rem var(--mono);
    color: var(--text);
  }
</style>
