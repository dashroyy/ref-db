---
// Placeholder artwork: a stylised object sitting on a print bed, with layer
// lines. Replace with real photos by adding `images` to a product in the catalog.
import type { ArtShape } from '../data/catalog.ts';

interface Props {
  shape: ArtShape;
  hue: number;
  uid: string;
  label?: string;
}
const { shape, hue, uid, label } = Astro.props;
const fill = `hsl(${hue} 85% 58%)`;
const shade = `hsl(${hue} 70% 38%)`;
const pid = `ly-${uid}`;
const gid = `gl-${uid}`;
---

<svg viewBox="0 0 400 300" role="img" aria-label={label ?? 'Product illustration'} class="art">
  <defs>
    <pattern id={pid} width="4" height="4" patternUnits="userSpaceOnUse">
      <rect width="4" height="1" fill="rgb(0 0 0 / 0.16)"></rect>
    </pattern>
    <radialGradient id={gid} cx="50%" cy="38%" r="60%">
      <stop offset="0" stop-color={`hsl(${hue} 60% 50% / 0.22)`}></stop>
      <stop offset="1" stop-color="transparent"></stop>
    </radialGradient>
  </defs>

  <rect width="400" height="300" fill="#0d0b15"></rect>
  <rect width="400" height="300" fill={`url(#${gid})`}></rect>

  <!-- print bed -->
  <path d="M40 262 L360 262 L392 300 L8 300 Z" fill="#1a1628"></path>
  <path d="M40 262 L360 262" stroke="#9b6bff" stroke-opacity=".6" stroke-width="1.5"></path>
  <g stroke="#2a2440" stroke-width="1">
    <path d="M100 262 L84 300"></path><path d="M160 262 L154 300"></path><path d="M240 262 L246 300"></path><path
      d="M300 262 L316 300"></path>
  </g>
  <ellipse cx="200" cy="262" rx="110" ry="7" fill="rgb(0 0 0 / 0.35)"></ellipse>

  <g class="obj">
    {
      shape === 'bust' && (
        <g>
          <path d="M110 262 C112 214 150 198 200 198 C250 198 288 214 290 262 Z" fill={shade} />
          <rect x="182" y="168" width="36" height="36" fill={shade} />
          <ellipse cx="200" cy="128" rx="50" ry="58" fill={fill} />
          <path d="M150 116 C152 74 190 62 214 66 C244 70 256 96 252 120 C236 98 196 92 150 116 Z" fill={shade} />
        </g>
      )
    }
    {
      shape === 'paw' && (
        <g>
          <ellipse cx="200" cy="200" rx="66" ry="56" fill={fill} />
          <ellipse cx="128" cy="138" rx="24" ry="30" fill={fill} transform="rotate(-20 128 138)" />
          <ellipse cx="175" cy="104" rx="25" ry="32" fill={fill} transform="rotate(-6 175 104)" />
          <ellipse cx="227" cy="104" rx="25" ry="32" fill={fill} transform="rotate(6 227 104)" />
          <ellipse cx="273" cy="138" rx="24" ry="30" fill={fill} transform="rotate(20 273 138)" />
          <rect x="120" y="248" width="160" height="14" rx="3" fill={shade} />
        </g>
      )
    }
    {
      shape === 'card' && (
        <g transform="rotate(-8 200 180)">
          <rect x="96" y="112" width="212" height="134" rx="10" fill={shade} transform="translate(10 12)" />
          <rect x="96" y="112" width="212" height="134" rx="10" fill={fill} />
          <circle cx="132" cy="150" r="16" fill={shade} />
          <rect x="158" y="140" width="96" height="9" rx="4" fill={shade} />
          <rect x="158" y="156" width="64" height="7" rx="3" fill={shade} opacity="0.7" />
          <rect x="116" y="196" width="110" height="7" rx="3" fill={shade} opacity="0.7" />
          <rect x="116" y="210" width="84" height="7" rx="3" fill={shade} opacity="0.7" />
          <g fill={shade}>
            <rect x="248" y="186" width="40" height="40" rx="3" />
          </g>
          <g fill={fill}>
            <rect x="254" y="192" width="10" height="10" />
            <rect x="272" y="192" width="10" height="10" />
            <rect x="254" y="210" width="10" height="10" />
            <rect x="268" y="206" width="6" height="6" />
          </g>
        </g>
      )
    }
    {
      shape === 'launcher' && (
        <g>
          <rect x="110" y="222" width="190" height="40" rx="8" fill={shade} />
          <g transform="rotate(-24 150 222)">
            <rect x="130" y="176" width="210" height="46" rx="10" fill={fill} />
            <rect x="148" y="190" width="40" height="18" rx="4" fill={shade} />
            <rect x="300" y="186" width="74" height="10" rx="5" fill="#ecebe6" />
            <path d="M374 186 L392 191 L374 196 Z" fill="#7b808c" />
          </g>
          <rect x="226" y="236" width="44" height="14" rx="7" fill={fill} />
        </g>
      )
    }
    {
      shape === 'dragon' && (
        <g>
          {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => {
            const t = i / 8;
            const x = 92 + t * 220;
            const y = 214 - Math.sin(t * Math.PI * 1.6) * 52;
            const r = 26 - i * 1.8;
            return <circle cx={x} cy={y} r={r} fill={i % 2 ? shade : fill} />;
          })}
          <path d="M70 196 L104 178 L110 214 Z" fill={fill} />
          <circle cx="86" cy="196" r="4" fill="#111216" />
          <path d="M150 168 L176 120 L196 170 Z" fill={shade} />
          <path d="M226 160 L252 112 L268 166 Z" fill={shade} />
        </g>
      )
    }
    {
      shape === 'vase' && (
        <g>
          <path
            d="M160 262 C140 220 150 180 170 150 C182 132 176 104 168 72 L232 72 C224 104 218 132 230 150 C250 180 260 220 240 262 Z"
            fill={fill}
          />
          {[0, 1, 2, 3, 4].map((i) => (
            <path d={`M${160 + i * 18} 262 C${150 + i * 20} 190 ${200 + i * 10} 130 ${176 + i * 12} 72`} stroke={shade} stroke-width="5" fill="none" />
          ))}
          <ellipse cx="200" cy="72" rx="32" ry="6" fill={shade} />
        </g>
      )
    }
    {
      shape === 'organizer' && (
        <g>
          <rect x="110" y="196" width="180" height="66" rx="12" fill={fill} />
          {[0, 1, 2, 3, 4].map((i) => (
            <rect x={130 + i * 32} y="196" width="12" height="34" rx="6" fill={shade} />
          ))}
          {[0, 2, 4].map((i) => (
            <path d={`M${136 + i * 32} 198 C${136 + i * 32} 150 ${120 + i * 40} 130 ${110 + i * 46} 100`} stroke="#ecebe6" stroke-width="6" fill="none" stroke-linecap="round" />
          ))}
        </g>
      )
    }
    {
      shape === 'keychain' && (
        <g>
          <circle cx="146" cy="128" r="34" fill="none" stroke="#a9adb7" stroke-width="8" />
          <rect x="150" y="150" width="190" height="78" rx="18" fill={fill} transform="rotate(14 150 150)" />
          <circle cx="174" cy="170" r="10" fill="#0d0b15" />
          <g transform="rotate(14 150 150)" fill={shade}>
            <rect x="196" y="174" width="22" height="34" rx="4" />
            <rect x="226" y="174" width="22" height="34" rx="4" />
            <rect x="256" y="174" width="22" height="34" rx="4" />
            <rect x="286" y="174" width="22" height="34" rx="4" />
          </g>
        </g>
      )
    }
  </g>
  <!-- layer lines over the object only -->
  <rect width="400" height="262" fill={`url(#${pid})`} style="mix-blend-mode:multiply"></rect>
</svg>

<style>
  .art {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }
</style>
