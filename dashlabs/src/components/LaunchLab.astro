---
// Launch lab for the Pen Launcher. Maths in src/lib/launcher.ts (unit-tested); UI only here.
import { DEFAULT_LAUNCH as D } from '../lib/launcher.ts';
interface Props {
  compact?: boolean; // on the product page: hide the advanced inputs
}
const { compact = false } = Astro.props;
---

<div class="calc launchlab" data-launchlab>
  <div class="calc-head"><span>Launch lab</span><span>no air drag · real range is shorter</span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <div class="field">
        <label for="l-a">Launch angle <span class="range-val" data-angle-val></span></label>
        <input id="l-a" name="angleDeg" type="range" min="0" max="80" step="1" value={D.angleDeg} />
      </div>
      <div class="field">
        <label for="l-x">Pull-back <span class="range-val" data-draw-val></span></label>
        <input id="l-x" name="drawMm" type="range" min="5" max="60" step="1" value={D.drawMm} />
      </div>
      <div class="row2">
        <div class="field">
          <label for="l-m">Pen mass g</label>
          <input id="l-m" name="penGrams" type="number" min="1" max="50" step="0.5" value={D.penGrams} />
        </div>
        <div class="field">
          <label for="l-h">Launch height m</label>
          <input id="l-h" name="heightM" type="number" min="0" max="3" step="0.05" value={D.heightM} />
        </div>
      </div>
      <div class="row2" hidden={compact}>
        <div class="field">
          <label for="l-k">Spring k N/m</label>
          <input id="l-k" name="k" type="number" min="10" max="5000" step="10" value={D.k} />
        </div>
        <div class="field">
          <label for="l-e">Efficiency %</label>
          <input id="l-e" name="efficiency" type="number" min="5" max="100" step="5" value={D.efficiency * 100} />
        </div>
      </div>
      <p class="hint">
        Desk height is about 0.75 m. A plastic ballpoint weighs about 5–7 g.{' '}
        {compact ? <a href="/learn/pen-launcher-physics/">How this works →</a> : 'Spring and efficiency are illustrative.'}
      </p>
    </form>

    <div class="calc-out" aria-live="polite">
      <svg class="plot" viewBox="0 0 400 220" role="img" aria-label="Pen flight path" data-plot>
        <desc>Side view of the pen's flight path from the desk to the floor, with distance in metres.</desc>
      </svg>
      <dl class="readout-grid">
        <div><dt class="tag">Range</dt><dd data-range>—</dd></div>
        <div><dt class="tag">Launch speed</dt><dd data-speed>—</dd></div>
        <div><dt class="tag">Peak</dt><dd data-peak>—</dd></div>
        <div><dt class="tag">Best angle</dt><dd data-best>—</dd></div>
      </dl>
    </div>
  </div>
</div>

<script>
  import { launch, trajectory, bestAngle, type LaunchInput } from '../lib/launcher.ts';

  const W = 400, H = 220, PAD = { l: 34, r: 12, t: 12, b: 26 };

  for (const root of document.querySelectorAll<HTMLElement>('[data-launchlab]')) {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const desc = svg.querySelector('desc')!.outerHTML;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;

    const render = () => {
      const f = new FormData(form);
      const i: LaunchInput = {
        k: Number(f.get('k')),
        drawMm: Number(f.get('drawMm')),
        efficiency: Number(f.get('efficiency')) / 100,
        penGrams: Number(f.get('penGrams')),
        angleDeg: Number(f.get('angleDeg')),
        heightM: Number(f.get('heightM')),
      };
      const r = launch(i);
      const best = bestAngle(i);
      const pts = trajectory(i);
      const ghost = trajectory({ ...i, angleDeg: best });
      const bestRange = launch({ ...i, angleDeg: best }).range;

      // Same scale on both axes, so the arc's shape is true (to scale).
      const xMax = Math.max(1, bestRange, r.range) * 1.08;
      const yMax = Math.max(r.peak, i.heightM, 0.5) * 1.15;
      const s = Math.min((W - PAD.l - PAD.r) / xMax, (H - PAD.t - PAD.b) / yMax);
      const X = (x: number) => PAD.l + x * s;
      const Y = (y: number) => H - PAD.b - y * s;
      const path = (p: [number, number][]) => p.map(([x, y], k) => `${k ? 'L' : 'M'}${X(x).toFixed(1)} ${Y(y).toFixed(1)}`).join('');
      const step = xMax > 12 ? 5 : xMax > 5 ? 2 : 1;
      let ticks = '';
      for (let m = 0; m <= xMax; m += step) {
        ticks += `<line x1="${X(m)}" y1="${Y(0)}" x2="${X(m)}" y2="${Y(0) + 4}" stroke="var(--text-3)"/>` +
          `<text x="${X(m)}" y="${H - 8}" text-anchor="middle">${m} m</text>`;
      }
      svg.innerHTML = desc +
        `<line x1="${PAD.l}" y1="${Y(0)}" x2="${W - PAD.r}" y2="${Y(0)}" stroke="var(--line-2)"/>` + ticks +
        `<rect x="${PAD.l - 22}" y="${Y(i.heightM)}" width="24" height="${Math.max(0, Y(0) - Y(i.heightM))}" fill="var(--panel-2)" stroke="var(--line-2)"/>` +
        (best !== i.angleDeg ? `<path d="${path(ghost)}" fill="none" stroke="var(--text-3)" stroke-dasharray="3 4"/>` : '') +
        `<path d="${path(pts)}" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round"/>` +
        `<circle cx="${X(r.range)}" cy="${Y(0)}" r="4" fill="var(--accent)"/>` +
        `<text x="${Math.min(X(r.range), W - PAD.r - 4)}" y="${Y(0) - 12}" text-anchor="end" style="fill:var(--accent)">${r.range.toFixed(2)} m</text>`;

      $('[data-angle-val]').textContent = `${i.angleDeg}°`;
      $('[data-draw-val]').textContent = `${i.drawMm} mm`;
      $('[data-range]').textContent = `${r.range.toFixed(2)} m`;
      $('[data-speed]').textContent = `${r.speed.toFixed(1)} m/s`;
      $('[data-peak]').textContent = `${r.peak.toFixed(2)} m`;
      $('[data-best]').textContent = `${best}°`;
    };
    form.addEventListener('input', render);
    render();
  }
</script>

<style>
  .plot {
    width: 100%;
    height: auto;
    background: var(--bg-2) var(--layers);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }
  .plot :global(text) {
    font: 500 10px var(--mono);
    fill: var(--text-3);
  }
  [hidden] {
    display: none;
  }
</style>
