---
// Customer prints gallery (full screen via PhotoLightbox). Renders nothing until
// GALLERY (src/data/reviews.ts) has real photos.
import { GALLERY } from '../data/reviews.ts';
import { productById } from '../data/catalog.ts';
import ProductPhoto from './ProductPhoto.astro';
import PhotoLightbox from './PhotoLightbox.astro';
import { customerPhoto } from '../lib/writing.ts';

const shots = GALLERY.map((g) => ({ g, photo: customerPhoto(g.src, g.alt, g.caption) })).filter((s) => s.photo);
---

{
  shots.length > 0 && (
    <section class="section gallery">
      <div class="wrap">
        <div class="head" data-print>
          <h2 class="h-rule">Out in the wild</h2>
          <p class="muted">Real prints, in their new homes. Shared with permission.</p>
        </div>
        <ul class="shots">
          {shots.map(({ g, photo }, i) => {
            const p = g.productId ? productById(g.productId) : undefined;
            return (
              <li>
                <button type="button" data-zoom={i} aria-label={`Enlarge: ${g.alt}`}>
                  <ProductPhoto photo={photo!} widths={[320, 640, 960]} sizes="(max-width: 560px) 100vw, 33vw" />
                </button>
                <span class="cap">
                  {g.caption}
                  {p && <a href={`/shop/${p.slug}/`}>Get one →</a>}
                </span>
              </li>
            );
          })}
        </ul>
      </div>
      <PhotoLightbox photos={shots.map((s) => s.photo!)} name="Customer prints" />
    </section>
  )
}

<!-- full screen: PhotoLightbox (data-zoom buttons) -->

<style>
  .gallery {
    padding-top: 0;
  }
  .shots {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 240px;
    column-gap: 18px;
  }
  .shots li {
    break-inside: avoid;
    margin-bottom: 18px;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: var(--panel);
    overflow: hidden;
  }
  .shots button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .shots :global(picture),
  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  }
  .shots button:hover :global(img) {
    transform: scale(1.04);
  }
  .cap {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    font-size: 0.88rem;
    color: var(--text-2);
  }
  .cap a {
    color: var(--hot);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
