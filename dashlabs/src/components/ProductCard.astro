---
// Product card: an extruded slab that tilts in 3D toward the pointer, with a
// real 3D render of the product (rendered in the browser; the SVG drawing
// shows until it's ready, or if WebGL isn't available).
import ProductArt from './ProductArt.astro';
import { categoryById, productCode, type Product } from '../data/catalog.ts';
import { money } from '../lib/money.ts';
import { thumbSrc } from '../data/thumbs.ts';

interface Props {
  product: Product;
  level?: 2 | 3; // heading level for the title: 2 when cards sit directly under the page h1
}
const { product: p, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const cat = categoryById(p.category);
const image = p.images?.[0];
const filament = cat.color;
const thumb = image ? undefined : thumbSrc(p.art.shape, filament);
// one-tap add for items that need no choices typed in; it uses the first option of each
const quick = p.purchase === 'cart' && !p.personalise?.required;
---

<div class="card-wrap" data-category={p.category} data-product={p.id} data-price={p.price} data-name={p.name} style={`--c:${cat.color}`}>
<a href={`/shop/${p.slug}/`} class="card" data-tilt>
  <div class="slab">
    <div class="media" data-thumb={image || thumb ? undefined : ''} data-shape={p.art.shape} data-color={filament}>
      {
        image ? (
          <img src={image} alt={p.name} loading="lazy" />
        ) : thumb ? (
          <img class="thumb-3d thumb-static" src={thumb} alt="" width="640" height="480" loading="lazy" decoding="async" />
        ) : (
          <ProductArt shape={p.art.shape} hue={p.art.hue} uid={p.id} label={p.name} />
        )
      }
      <span class="sku">{productCode(p)}</span>
      {p.purchase === 'quote' && <span class="badge">Custom quote</span>}
    </div>
    <div class="body">
      <span class="kind"><i></i>{cat.label}</span>
      <H class="title">{p.name}</H>
      <p>{p.summary}</p>
      <div class="foot">
        <span class="price">{p.purchase === 'quote' && <small>from </small>}{money(p.price)}</span>
        {!quick && <span class="go" aria-hidden="true">→</span>}
      </div>
    </div>
    <span class="glare" aria-hidden="true"></span>
  </div>
</a>
{
  quick && (
    <button type="button" class="quick" data-quick-add={p.id} aria-label={`Add ${p.name} to cart`} title="Add to cart">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
    </button>
  )
}
<button type="button" class="save" data-save={p.id} aria-pressed="false" aria-label={`Save ${p.name} for later`}>
  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4 7.4 4c2 0 3.6 1.1 4.6 2.7C13 5.1 14.6 4 16.6 4c3.5 0 5.8 3.6 4.6 7.1-1.7 4.8-9.2 9.4-9.2 9.4z"></path></svg>
</button>
</div>

<script>
  import { wireSaveButtons } from '../lib/saved-store.ts';
  import { addToCart, announceCart } from '../lib/cart-store.ts';
  import { flyToCart, toast } from '../lib/fly.ts';
  wireSaveButtons();
  document.querySelectorAll<HTMLButtonElement>('[data-quick-add]').forEach((b) =>
    b.addEventListener('click', () => {
      const wrap = b.closest<HTMLElement>('.card-wrap')!;
      const color = getComputedStyle(wrap).getPropertyValue('--c').trim() || '#ffab2e';
      addToCart({ productId: b.dataset.quickAdd!, options: {}, qty: 1 }, { quiet: true });
      flyToCart(b, color).then(() => {
        announceCart();
        toast(`<span class="t-cube"></span><span><b>${wrap.dataset.name}</b> added</span><a href="/cart/">View cart →</a>`);
      });
    }),
  );
</script>

<style>
  .card-wrap {
    position: relative;
    display: flex; /* cards in a row share one height */
  }
  .save {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    backdrop-filter: blur(6px);
    color: var(--text-2);
    cursor: pointer;
    transition:
      transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1),
      color 0.2s,
      border-color 0.2s;
  }
  .quick {
    position: absolute;
    right: 18px;
    bottom: 16px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    border: 0;
    background: var(--c);
    color: #12091a;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .quick:hover {
    transform: scale(1.12) rotate(90deg);
  }
  .quick:active {
    transform: scale(0.92);
  }
  .save svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .save:hover {
    color: var(--pink);
    transform: scale(1.08);
  }
  .save[aria-pressed='true'] {
    color: var(--pink);
    border-color: color-mix(in srgb, var(--pink) 60%, transparent);
  }
  .save[aria-pressed='true'] svg {
    fill: currentColor;
  }
  .save:global(.pop) {
    animation: heart-pop 0.45s cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  @keyframes heart-pop {
    40% {
      transform: scale(1.35);
    }
  }
  .card {
    display: block;
    flex: 1;
    min-width: 0;
    text-decoration: none;
    perspective: 900px;
  }
  .slab {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: var(--panel);
    overflow: hidden;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s cubic-bezier(0.2, 1, 0.3, 1),
      box-shadow 0.3s,
      border-color 0.3s;
    box-shadow:
      2px 2px 0 -1px var(--panel-3),
      4px 4px 0 -1px var(--panel-2),
      6px 6px 0 -1px var(--panel-3),
      8px 8px 0 -1px var(--ink-2),
      8px 8px 0 0 var(--line);
  }
  .card:hover .slab {
    border-color: color-mix(in srgb, var(--c) 70%, transparent);
    box-shadow:
      2px 2px 0 -1px var(--panel-3),
      4px 4px 0 -1px var(--panel-2),
      6px 6px 0 -1px var(--panel-3),
      8px 8px 0 -1px var(--panel-2),
      10px 10px 0 -1px var(--panel-3),
      12px 12px 0 -1px var(--ink-2),
      12px 12px 0 0 color-mix(in srgb, var(--c) 40%, transparent),
      0 24px 50px -24px var(--c);
  }
  :global(.tilting) .slab {
    transition:
      transform 0.08s linear,
      box-shadow 0.3s,
      border-color 0.3s;
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 50% 70%, color-mix(in srgb, var(--c) 22%, transparent), transparent 65%),
      var(--ink-2);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .media > :global(svg),
  .media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s;
  }
  .media:global(.thumb-ready) > :global(svg) {
    opacity: 0;
  }
  .media :global(.thumb-3d) {
    transition:
      opacity 0.5s,
      transform 0.6s cubic-bezier(0.2, 1, 0.3, 1) !important;
  }
  .card:hover .media :global(.thumb-3d) {
    transform: scale(1.07) translateY(-2%);
  }
  .sku,
  .badge {
    position: absolute;
    top: 12px;
    z-index: 2;
    font: 600 0.66rem/1 var(--mono);
    padding: 6px 8px;
    border-radius: 7px;
  }
  .sku {
    left: 12px;
    color: var(--c);
    background: var(--overlay);
    border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
  }
  .badge {
    top: auto;
    bottom: 12px;
    left: 12px;
    color: #12091a;
    background: var(--c);
    letter-spacing: 0.04em;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 18px 16px;
  }
  .kind {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c);
  }
  .kind i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    transform: rotate(45deg);
    background: var(--c);
    box-shadow: 0 0 8px var(--c);
  }
  .title {
    margin: 9px 0 6px;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .body p {
    font-size: 0.9rem;
    color: var(--text-3);
    flex: 1;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .price {
    font: 700 1.05rem/1 var(--display);
    color: var(--white);
    letter-spacing: -0.02em;
  }
  .price small {
    font: 500 0.72rem var(--font);
    color: var(--text-3);
    letter-spacing: 0;
  }
  .go {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--panel-3);
    color: var(--white);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .card:hover .go {
    background: var(--c);
    color: #12091a;
    transform: translateX(3px);
  }
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 0%), rgba(255, 255, 255, 0.12), transparent 45%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .card:hover .glare {
    opacity: 1;
  }
</style>
