---
import ProductArt from './ProductArt.astro';
import { categoryById, productCode, type Product } from '../data/catalog.ts';
import { money } from '../lib/money.ts';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const cat = categoryById(p.category);
const image = p.images?.[0];
---

<a href={`/shop/${p.slug}/`} class="card" data-category={p.category} style={`--c:${cat.color}`}>
  <div class="media">
    {image ? <img src={image} alt={p.name} loading="lazy" /> : <ProductArt shape={p.art.shape} hue={p.art.hue} uid={p.id} label={p.name} />}
    <span class="code">{productCode(p)}</span>
    {p.purchase === 'quote' && <span class="badge">QUOTE</span>}
  </div>
  <div class="body">
    <span class="kind"><i></i>{cat.short}</span>
    <h3>{p.name}</h3>
    <p>{p.summary}</p>
    <div class="foot">
      <span class="price">{p.purchase === 'quote' && <small>FROM </small>}{money(p.price)}</span>
      <span class="go">{p.purchase === 'quote' ? 'REQUEST' : 'VIEW'} ›</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--line-2);
    border-top: 2px solid var(--c);
    background: rgba(3, 5, 11, 0.55);
    overflow: hidden;
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .card:hover {
    border-color: var(--c);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -18px var(--c);
  }
  .media {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .code,
  .badge {
    position: absolute;
    top: 10px;
    font: 500 0.64rem/1 var(--mono);
    letter-spacing: 0.1em;
    padding: 4px 6px;
    border-radius: 2px;
  }
  .code {
    left: 10px;
    color: var(--c);
    border: 1px solid var(--c);
    background: rgba(3, 5, 11, 0.7);
  }
  .badge {
    right: 10px;
    color: #05080f;
    background: var(--c);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 14px 14px 12px;
  }
  .kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 0.64rem var(--mono);
    letter-spacing: 0.14em;
    color: var(--c);
  }
  .kind i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 6px var(--c);
  }
  h3 {
    margin: 8px 0 6px;
  }
  .body p {
    font-size: 0.9rem;
    color: var(--text-3);
    flex: 1;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  .price {
    font: 600 1rem/1 var(--mono);
    color: var(--white);
  }
  .price small {
    font-size: 0.62rem;
    color: var(--text-3);
    font-weight: 400;
    letter-spacing: 0.1em;
  }
  .go {
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.12em;
    color: var(--c);
  }
</style>
