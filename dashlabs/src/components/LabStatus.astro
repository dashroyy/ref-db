---
// Home-page status board — REF·DB's mission-control board, for a print farm.
// Data in src/data/lab.ts, updated by hand.
import { LAB_STATUS as S, leadTimeDays } from '../data/lab.ts';
const [lo, hi] = leadTimeDays(S.queuedJobs, S.printers);
const updated = new Date(S.updated + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const LABEL = { printing: 'Printing', idle: 'Ready', maintenance: 'Maintenance' };
---

<section class="board" aria-label="Lab status">
  <div class="cell status">
    <span class="tag">Lab status</span>
    <strong class:list={['state', S.acceptingOrders ? 'open' : 'closed']}>
      <i></i>{S.acceptingOrders ? 'Taking orders' : 'Orders paused'}
    </strong>
  </div>
  <div class="cell">
    <span class="tag">In the queue</span>
    <strong>{S.queuedJobs} {S.queuedJobs === 1 ? 'job' : 'jobs'}</strong>
  </div>
  <div class="cell">
    <span class="tag">Ships in</span>
    <strong>{lo}–{hi} days</strong>
  </div>
  <div class="cell printers">
    <span class="tag">Printers</span>
    <ul>
      {
        S.printers.map((p) => (
          <li>
            <i class={p.state} />
            {p.name} <span>{LABEL[p.state]}{p.job ? ` · ${p.job}` : ''}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="foot tag">{S.note} · Updated {updated}</p>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: 1.1fr 0.8fr 0.8fr 1.6fr;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--panel) var(--layers);
    overflow: hidden;
  }
  .cell {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 18px 20px;
    border-right: 1px solid var(--line);
  }
  .cell:nth-child(4) {
    border-right: 0;
  }
  .cell strong {
    font: 600 1.15rem var(--mono);
  }
  .state {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .state i,
  .printers i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
  }
  .open i {
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent);
    animation: pulse 2.4s infinite;
  }
  .closed i {
    background: var(--warn);
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--ok) 0%, transparent);
    }
  }
  .printers ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .printers li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    flex-wrap: wrap;
  }
  .printers li span {
    color: var(--text-3);
    font-size: 0.85rem;
  }
  i.printing {
    background: var(--accent);
  }
  i.idle {
    background: var(--ok);
  }
  i.maintenance {
    background: var(--warn);
  }
  .foot {
    grid-column: 1 / -1;
    margin: 0;
    padding: 10px 20px;
    border-top: 1px solid var(--line);
    line-height: 1.5;
  }
  @media (max-width: 860px) {
    .board {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .cell:nth-child(3) {
      border-right: 0;
    }
    .printers {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 520px) {
    .board {
      grid-template-columns: 1fr 1fr;
    }
    .status {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
