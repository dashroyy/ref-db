---
// Deep-field sky — copied from REF·DB (src/components/hud/SpaceSky.astro), grown from v1 (#cxSky): drifting stars and star clusters, particle galaxies of
// several kinds, distant galaxy clusters, nebulae and the Milky Way, in depth.
// Decoration, governed hard: nothing in light theme, under PAUSE MOTION or with the
// tab hidden; reduced motion gets one still frame; 30 fps and ≤1.5× device pixels;
// pure canvas 2D, no libraries, no network; any failure removes it.
---

<canvas id="cxSky" aria-hidden="true"></canvas>

<script is:inline>
/* eslint-disable */
(function(){
  "use strict";
  const doc = document.documentElement;
  const cv = document.getElementById("cxSky");
  if(!cv) return;
  const ctx = cv.getContext && cv.getContext("2d");
  /* Probe real capability, not just presence: test harnesses hand back stub
     contexts whose methods return nothing. Decoration must never throw. */
  const capable = (() => { try{ const g = ctx && ctx.createRadialGradient(0,0,0,0,0,1);
    return !!(g && typeof g.addColorStop === "function" && typeof ctx.ellipse === "function"); }catch(e){ return false; } })();
  if(!capable){ cv.remove(); return; }
  doc.classList.add("cx-sky");
  let dead = false;
  const kill = err => { dead = true; doc.classList.remove("cx-sky"); cv.remove();
    try{ console.warn("Deep field disabled:", err && err.message); }catch(e){} };

  const reduce = () => { try{ return matchMedia("(prefers-reduced-motion: reduce)").matches; }catch(e){ return false; } };
  const paused = () => doc.classList.contains("motion-off") || reduce();
  const dark   = () => doc.getAttribute("data-theme") !== "light";
  const labOpen = () => { const o = document.getElementById("labOverlay"); return o && !o.hidden; };

  /* deterministic random so the sky is the same every visit */
  let seed = 20260814;
  const rnd = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; };
  const gauss = () => { let u = 0; while(!u) u = rnd(); return Math.sqrt(-2*Math.log(u)) * Math.cos(2*Math.PI*rnd()); };

  let W = 0, H = 0, DPR = 1, F = 600;
  let stars = [], nebula = null, backdrop = null, layerVer = 0, rects = null;

  /* ---------- camera ---------- */
  /* the camera turns (yaw, pitch) and also moves (px, py): moving gives real depth parallax — near stars slide, far ones barely */
  const cam = {yaw:0, pitch:0, tYaw:0, tPitch:0, px:0, py:0, tPx:0, tPy:0};
  function project(x, y, z){
    x -= cam.px; y -= cam.py;
    const cy = Math.cos(cam.yaw), sy = Math.sin(cam.yaw), cp = Math.cos(cam.pitch), sp = Math.sin(cam.pitch);
    const x1 = x*cy - z*sy, z1 = x*sy + z*cy;
    const y1 = y*cp - z1*sp, z2 = y*sp + z1*cp;
    if(z2 < 0.2) return null;
    return {x: W/2 + F*x1/z2, y: H/2 + F*y1/z2, z: z2, s: F/z2};
  }

  /* ---------- star colours by temperature ---------- */
  const STAR_COL = ["#9bb4ff","#aabfff","#cad7ff","#f8f7ff","#fff4ea","#ffd2a1","#ffcc6f"];
  const rgba = (hex, a) => `rgba(${parseInt(hex.slice(1,3),16)},${parseInt(hex.slice(3,5),16)},${parseInt(hex.slice(5,7),16)},${a})`;

  /* glow sprites with diffraction spikes for the bright stars, one per colour */
  let SPRITES = [];
  function makeSprites(){
    SPRITES = STAR_COL.map(col => {
      const s = 64, c = document.createElement("canvas"); c.width = c.height = s;
      const g = c.getContext("2d"), m = s/2;
      const r = g.createRadialGradient(m, m, 0, m, m, m);
      r.addColorStop(0, "rgba(255,255,255,1)"); r.addColorStop(0.06, rgba(col, 0.95)); r.addColorStop(0.18, rgba(col, 0.28));
      r.addColorStop(0.45, rgba(col, 0.06)); r.addColorStop(1, rgba(col, 0));
      g.fillStyle = r; g.fillRect(0, 0, s, s);
      g.globalCompositeOperation = "lighter";
      for(const [w, a] of [[1.2, 0.55], [3, 0.12]]){
        const h = g.createLinearGradient(0, m, s, m); h.addColorStop(0, rgba(col, 0)); h.addColorStop(0.5, rgba(col, a)); h.addColorStop(1, rgba(col, 0));
        g.fillStyle = h; g.fillRect(0, m - w/2, s, w);
        const v = g.createLinearGradient(m, 0, m, s); v.addColorStop(0, rgba(col, 0)); v.addColorStop(0.5, rgba(col, a)); v.addColorStop(1, rgba(col, 0));
        g.fillStyle = v; g.fillRect(m - w/2, 0, w, s);
      }
      return c;
    });
  }

  /* ---------- value noise for the nebulae and the Milky Way (built only on resize) ---------- */
  const NG = 256; let NV = null;
  function vnoise(x, y){
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const u = xf*xf*(3 - 2*xf), v = yf*yf*(3 - 2*yf);
    const i0 = xi & (NG-1), i1 = (xi + 1) & (NG-1), j0 = (yi & (NG-1))*NG, j1 = ((yi + 1) & (NG-1))*NG;
    const a = NV[j0+i0], b = NV[j0+i1], c = NV[j1+i0], d = NV[j1+i1];
    return a + (b - a)*u + (c - a)*v + (a - b - c + d)*u*v;
  }
  function fbm(x, y, o){ let s = 0, a = 0.5, f = 1, n = 0; for(let i = 0; i < o; i++){ s += a*vnoise(x*f, y*f); n += a; f *= 2.03; a *= 0.5; } return s/n; }
  const smooth = (e0, e1, x) => { const k = Math.min(1, Math.max(0, (x - e0)/(e1 - e0))); return k*k*(3 - 2*k); };
  /* paint a low-resolution field, fn(fx, fy) → [r, g, b, a] in 0..1, to be scaled up smoothly */
  function field(w, h, fn){
    const c = document.createElement("canvas"); c.width = w; c.height = h;
    const g = c.getContext("2d"), img = g.createImageData(w, h), D = img.data;
    for(let y = 0; y < h; y++) for(let x = 0; x < w; x++){
      const p = fn(x/w, y/h), i = (y*w + x)*4;
      D[i] = 255*p[0]; D[i+1] = 255*p[1]; D[i+2] = 255*p[2]; D[i+3] = 255*p[3];
    }
    g.putImageData(img, 0, 0); return c;
  }

  /* galaxy palettes, rgb: core, disk, arms */
  const PALS = [
    ["255,240,215", "150,180,255", "190,210,255"],   /* blue spiral */
    ["255,232,190", "255,175,110", "255,205,150"],   /* golden */
    ["255,236,246", "255,110,185", "255,160,215"],   /* pink starburst */
    ["230,255,250", "80,210,200", "140,235,225"],    /* teal */
    ["245,235,255", "165,125,255", "200,170,255"],   /* violet */
    ["255,225,200", "255,120,90", "255,170,130"]     /* red-orange */
  ];
  /* small distant galaxies: 0 elliptical, 1 spiral, 2 edge-on with a dust lane, 3 irregular starburst, 4 ring, 5 barred, 6 interacting pair */
  function smallGalaxy(g, x, y, size, kind, ang, pal){
    const [core, disk, arm] = PALS[pal];
    g.save(); g.translate(x, y); g.rotate(ang); g.globalCompositeOperation = "lighter";
    const blob = (r, a0, a1) => {
      const gr = g.createRadialGradient(0, 0, 0, 0, 0, r);
      gr.addColorStop(0, `rgba(${core},${a0})`); gr.addColorStop(0.18, `rgba(${disk},${a1})`);
      gr.addColorStop(0.6, `rgba(${disk},${a1*0.3})`); gr.addColorStop(1, `rgba(${disk},0)`);
      g.fillStyle = gr; g.beginPath(); g.arc(0, 0, r, 0, 6.2832); g.fill();
    };
    if(kind === 0){ g.scale(1, 0.5 + rnd()*0.45); blob(size, 0.9, 0.4); }
    else if(kind === 1){
      g.scale(1, 0.3 + rnd()*0.65); blob(size, 0.95, 0.35);
      g.strokeStyle = `rgba(${arm},.45)`; g.lineWidth = Math.max(0.6, size*0.09);
      for(const a0 of [0, Math.PI]){
        g.beginPath();
        for(let k = 0; k <= 24; k++){
          const th = a0 + k*0.16, rr = size*0.12*Math.exp(0.42*k*0.16);
          if(k) g.lineTo(rr*Math.cos(th), rr*Math.sin(th)); else g.moveTo(rr*Math.cos(th), rr*Math.sin(th));
        }
        g.stroke();
      }
      if(size > 8) for(let k = 0; k < 8; k++){                    /* knots of star formation along the arms */
        const th = rnd()*6.283, rr = size*(0.3 + rnd()*0.5);
        g.fillStyle = "rgba(255,160,215,.6)"; g.fillRect(rr*Math.cos(th), rr*Math.sin(th), 1.2, 1.2);
      }
    } else if(kind === 2){
      g.scale(1, 0.14); blob(size, 0.9, 0.35);
      g.globalCompositeOperation = "source-over"; g.fillStyle = "rgba(10,8,16,.55)"; g.fillRect(-size*0.8, -size*0.12, size*1.6, size*0.24);
    } else if(kind === 3){                                        /* irregular starburst */
      for(let k = 0; k < 6; k++){ g.save(); g.translate(gauss()*size*0.35, gauss()*size*0.25); blob(size*(0.25 + rnd()*0.3), 0.8, 0.45); g.restore(); }
    } else if(kind === 4){                                        /* ring galaxy */
      g.scale(1, 0.4 + rnd()*0.55); blob(size*0.35, 0.95, 0.5);
      g.strokeStyle = `rgba(${arm},.55)`; g.lineWidth = Math.max(0.8, size*0.16);
      g.beginPath(); g.arc(0, 0, size*0.85, 0, 6.2832); g.stroke();
    } else if(kind === 5){                                        /* barred spiral */
      g.scale(1, 0.4 + rnd()*0.55); blob(size*0.7, 0.95, 0.35);
      g.fillStyle = `rgba(${core},.45)`; g.fillRect(-size*0.45, -size*0.07, size*0.9, size*0.14);
      g.strokeStyle = `rgba(${arm},.45)`; g.lineWidth = Math.max(0.6, size*0.09);
      for(const sg of [1, -1]){ g.beginPath(); g.moveTo(sg*size*0.45, 0); g.quadraticCurveTo(sg*size*0.95, sg*size*0.55, -sg*size*0.1, sg*size*0.85); g.stroke(); }
    } else {                                                      /* interacting pair with tidal tails */
      g.save(); g.translate(-size*0.45, 0); blob(size*0.55, 0.9, 0.4); g.restore();
      g.save(); g.translate(size*0.5, size*0.15); blob(size*0.4, 0.85, 0.4); g.restore();
      g.strokeStyle = `rgba(${arm},.3)`; g.lineWidth = Math.max(0.6, size*0.12);
      g.beginPath(); g.moveTo(-size*0.45, 0); g.quadraticCurveTo(-size*1.4, -size*0.9, -size*0.2, -size*1.5); g.stroke();
      g.beginPath(); g.moveTo(size*0.5, size*0.15); g.quadraticCurveTo(size*1.5, size*0.6, size*1.1, size*1.3); g.stroke();
    }
    g.restore();
  }

  function build(){
    DPR = Math.min(1.5, window.devicePixelRatio || 1);
    W = innerWidth; H = innerHeight; F = Math.max(W, H) * 0.9;
    cv.width = Math.round(W*DPR); cv.height = Math.round(H*DPR);
    cv.style.width = W + "px"; cv.style.height = H + "px";
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    seed = 20260814;
    NV = new Float32Array(NG*NG); for(let i = 0; i < NV.length; i++) NV[i] = rnd();
    if(!SPRITES.length) makeSprites();
    const n = Math.round(Math.min(6000, 1600 + W*H/450));
    stars = Array.from({length:n}, () => {
      const ci = Math.floor(Math.pow(rnd(),1.6)*STAR_COL.length);
      return {x:(rnd()*2-1)*60, y:(rnd()*2-1)*36, z:2 + rnd()*58, ci, c:STAR_COL[ci], tw:rnd()*6.283, m:0.4 + rnd()*0.9, big:rnd() < 0.06};
    });
    /* particle galaxies of several kinds, each with its own palette; w is how fast each part turns */
    for(const G of GALS){
      G.parts = [];
      const N = Math.round(Math.min(3400, 1400 + W*H/800) * G.n), P = G.pal;
      for(let i = 0; i < N; i++){
        let r, th, h, core = false, hot = false, w;
        const u = rnd();
        if(G.type === "elliptical"){                          /* a smooth, warm swarm, densest at the centre */
          r = Math.abs(gauss())*1.4 + Math.abs(gauss())*0.6; th = rnd()*6.283; h = gauss()*r*0.55; core = r < 0.7; w = 0.5;
        } else if(G.type === "ring"){                         /* a bright core and a clean outer ring, nothing between */
          core = u < 0.32; r = core ? Math.abs(gauss())*0.55 : 4.2 + gauss()*0.32; th = rnd()*6.283;
          h = gauss()*(core ? 0.3 : 0.06); hot = !core && rnd() < 0.12; w = 0.7;
        } else if(G.type === "barred"){                       /* a straight bar turning as one, arms trailing from its ends */
          core = u < 0.16;
          if(core){ r = Math.abs(gauss())*0.6; th = rnd()*6.283; w = 0.7; }
          else if(u < 0.4){ r = Math.pow(rnd(), 0.7)*2.1; th = (rnd() < 0.5 ? 0 : Math.PI) + gauss()*0.09/(r + 0.25); w = 0.7; }
          else { r = 2.1 + Math.pow(rnd(), 0.8)*4.6; th = (i & 1)*Math.PI + Math.log(r/2.1)*2.4 + gauss()*0.2; w = 1.6/(0.6 + r*0.35); hot = rnd() < 0.08; }
          h = gauss()*(core ? 0.3 : 0.1);
        } else {                                              /* grand-design spiral */
          core = u < 0.22;
          r = core ? Math.abs(gauss())*0.9 : 0.6 + Math.pow(rnd(), 0.75)*6.4;
          th = core ? rnd()*6.283 : (i & 1)*Math.PI + Math.log(r + 1)*2.6 + gauss()*0.28;
          h = gauss()*(core ? 0.35 : 0.12)*(1.2 - r/8); hot = !core && rnd() < 0.06; w = 1.6/(0.6 + r*0.35);
        }
        G.parts.push({r: r*G.k, th, h: h*G.k, w, c: core ? P.core[rnd() < .5 ? 0 : 1] : hot ? P.hot : P.arm[rnd() < .6 ? 0 : 1],
          a: core ? 0.55 : hot ? 0.9 : 0.35 + rnd()*0.4, sz: core ? 1.1 : hot ? 1.4 : 0.6 + rnd()*0.8});
      }
    }
    /* static backdrop: the Milky Way with dust lanes, faint stars too far to move, and distant galaxy clusters */
    backdrop = document.createElement("canvas");
    backdrop.width = Math.round(W*1.2); backdrop.height = Math.round(H*1.2);
    const b2 = backdrop.getContext("2d"), BW = backdrop.width, BH2 = backdrop.height;
    const band = (x) => BH2*(0.78 - 0.55*x/BW);                       /* diagonal band */
    const cosB = Math.cos(Math.atan2(0.55*BH2, BW));
    const milky = field(Math.round(BW/4), Math.round(BH2/4), (fx, fy) => {
      const d = (fy*BH2 - band(fx*BW))*cosB/BH2;                       /* distance across the band */
      const m = Math.exp(-d*d/0.024);
      const bulge = Math.exp(-(fx - 0.73)*(fx - 0.73)/0.010 - d*d/0.007); /* the bright core, just beside the black hole: lensed into an arc */
      if(m < 0.01 && bulge < 0.01) return [0, 0, 0, 0];
      const asp = BH2/BW, nz = fbm(fx*7, fy*7*asp, 5), lane = fbm(fx*11 + 20, fy*11*asp + 7, 4), knots = fbm(fx*19 + 3, fy*19*asp + 9, 3);
      const dust = smooth(0.52, 0.70, lane)*Math.exp(-d*d/0.004);
      const hii = smooth(0.66, 0.82, knots)*m;                          /* pink star-forming knots */
      const b = (m*(0.4 + 0.9*nz*nz) + bulge*0.65)*(1 - 0.8*dust), warm = Math.min(1, Math.exp(-d*d/0.006) + bulge);
      const c = v => Math.max(0, Math.min(1, v));
      return [c(0.78 + 0.2*warm + 0.2*hii), c(0.74 + 0.1*warm - 0.25*hii), c(0.95 - 0.25*warm - 0.05*hii), Math.min(0.75, b*0.6 + hii*0.25)];
    });
    b2.drawImage(milky, 0, 0, BW, BH2);
    for(let i = 0; i < Math.round(BW*BH2/70); i++){
      const inBand = rnd() < 0.62, x = rnd()*BW;
      const y = inBand ? band(x) + gauss()*BH2*0.07 : rnd()*BH2;
      b2.globalAlpha = (inBand ? 0.18 : 0.28) + rnd()*0.45;
      b2.fillStyle = STAR_COL[Math.floor(rnd()*STAR_COL.length)];
      const s = rnd() < 0.04 ? 1.6 : rnd() < 0.3 ? 1.0 : 0.7;
      b2.fillRect(x, y, s, s);
    }
    b2.globalAlpha = 1;
    /* star clusters: dense warm globulars, and loose blue open clusters (two still in their birth nebula) */
    for(let c = 0; c < 9; c++){
      const x0 = rnd()*BW, y0 = rnd()*BH2, R = 3 + rnd()*6, n = 120 + Math.floor(rnd()*180);
      const g = b2.createRadialGradient(x0, y0, 0, x0, y0, R*3);
      g.addColorStop(0, "rgba(255,236,200,.22)"); g.addColorStop(1, "rgba(255,236,200,0)");
      b2.fillStyle = g; b2.fillRect(x0 - R*3, y0 - R*3, R*6, R*6);
      for(let i = 0; i < n; i++){
        const rr = R*Math.abs(gauss())*Math.pow(rnd(), 0.4), a = rnd()*6.283;
        b2.globalAlpha = 0.35 + rnd()*0.5; b2.fillStyle = rnd() < 0.7 ? "#ffe8c4" : "#fff7ec";
        b2.fillRect(x0 + rr*Math.cos(a), y0 + rr*Math.sin(a), 0.8, 0.8);
      }
      b2.globalAlpha = 1;
    }
    for(let c = 0; c < 7; c++){
      const x0 = rnd()*BW, y0 = rnd()*BH2, R = 14 + rnd()*24, n = 14 + Math.floor(rnd()*26);
      if(c < 2){
        const g = b2.createRadialGradient(x0, y0, 0, x0, y0, R*1.6);
        g.addColorStop(0, "rgba(120,170,255,.18)"); g.addColorStop(1, "rgba(120,170,255,0)");
        b2.fillStyle = g; b2.fillRect(x0 - R*1.6, y0 - R*1.6, R*3.2, R*3.2);
      }
      b2.globalCompositeOperation = "lighter";
      for(let i = 0; i < n; i++){
        const rr = R*Math.sqrt(rnd()), a = rnd()*6.283, x = x0 + rr*Math.cos(a), y = y0 + rr*Math.sin(a);
        if(rnd() < 0.25){ b2.globalAlpha = 0.9; b2.drawImage(SPRITES[1], x - 7, y - 7, 14, 14); }
        else { b2.globalAlpha = 0.6 + rnd()*0.4; b2.fillStyle = rnd() < 0.75 ? "#bcd2ff" : "#ffffff"; b2.fillRect(x, y, 1.2, 1.2); }
      }
      b2.globalCompositeOperation = "source-over"; b2.globalAlpha = 1;
    }
    /* galaxy clusters, field galaxies in every colour, and a few close enough to show their shape */
    const kind = () => { const u = rnd(); return u < 0.3 ? 0 : u < 0.58 ? 1 : u < 0.68 ? 2 : u < 0.76 ? 3 : u < 0.84 ? 4 : u < 0.94 ? 5 : 6; };
    const pick = k => k === 0 ? (rnd() < 0.7 ? 1 : 5) : Math.floor(rnd()*PALS.length);
    const at = (sx, sy) => [(sx + 0.1)/1.2*BW, (sy + 0.1)/1.2*BH2];          /* screen fraction → backdrop */
    for(const [sx, sy, spread, count] of [[0.26, 0.55, 0.045, 40], [0.93, 0.92, 0.03, 16], [0.31, 0.10, 0.028, 14]]){
      const [x0, y0] = at(sx, sy), R = spread*BW*1.8, g = b2.createRadialGradient(x0, y0, 0, x0, y0, R);
      g.addColorStop(0, "rgba(255,225,190,.10)"); g.addColorStop(1, "rgba(255,225,190,0)");      /* intracluster light */
      b2.fillStyle = g; b2.fillRect(x0 - R, y0 - R, 2*R, 2*R);
      for(let i = 0; i < count; i++){
        const k = i === 0 ? 0 : kind();
        smallGalaxy(b2, x0 + gauss()*spread*BW, y0 + gauss()*spread*BW*0.8, i === 0 ? 9 + rnd()*4 : 2.2 + Math.pow(rnd(), 2)*6, k, rnd()*3.1416, pick(k));
      }
    }
    for(let i = 0; i < 90; i++){ const k = kind(); smallGalaxy(b2, rnd()*BW, rnd()*BH2, 2 + Math.pow(rnd(), 3)*7, k, rnd()*3.1416, pick(k)); }
    for(const [sx, sy, size, k, pal] of [[0.22, 0.68, 18, 6, 2], [0.95, 0.70, 19, 5, 3], [0.30, 0.42, 14, 4, 4], [0.97, 0.10, 16, 1, 4],
        [0.18, 0.95, 14, 2, 5], [0.84, 0.97, 13, 3, 2], [0.36, 0.06, 12, 0, 1], [0.24, 0.20, 15, 5, 0], [0.90, 0.55, 12, 4, 3]]){
      const [x, y] = at(sx, sy); smallGalaxy(b2, x, y, size, k, rnd()*3.1416, pal);
    }
    /* nebulae: glowing clouds shaped by noise, cut by dark filaments */
    const asp = W/H;
    const CLOUDS = [
      {x:0.22, y:0.80, r:0.32, a:[1.0,0.30,0.48], b:[1.0,0.62,0.36], k:0.95},   /* emission nebula, lower left */
      {x:0.20, y:0.18, r:0.28, a:[0.27,0.67,0.82], b:[0.47,0.36,1.0], k:0.80},  /* blue-teal cloud, upper left */
      {x:0.60, y:0.97, r:0.34, a:[0.47,0.35,1.0], b:[1.0,0.35,0.24], k:0.60},   /* violet, along the bottom */
      {x:0.93, y:0.64, r:0.30, a:[0.35,0.47,1.0], b:[0.63,0.35,0.86], k:0.55},  /* right, below the black hole */
      {x:0.08, y:0.50, r:0.22, a:[0.95,0.45,0.25], b:[1.0,0.25,0.55], k:0.60},  /* orange-red, far left */
      {x:0.97, y:0.20, r:0.22, a:[0.30,0.85,0.75], b:[0.40,0.55,1.0], k:0.50},  /* teal, top right */
      {x:0.45, y:0.05, r:0.30, a:[0.55,0.40,1.0], b:[0.95,0.45,0.75], k:0.45}   /* magenta-violet, across the top */
    ];
    nebula = field(Math.max(160, Math.round(W/4)), Math.max(100, Math.round(H/4)), (fx, fy) => {
      const X = fx*6*asp, Y = fy*6;
      const nz = fbm(X, Y, 5), tint = fbm(X*1.9 + 17, Y*1.9 + 5, 3), lane = fbm(X*3.1 + 40, Y*3.1 + 11, 4);
      let r = 0, g = 0, b = 0;
      for(const c of CLOUDS){
        const dx = (fx - c.x)*asp, dy = fy - c.y, m = Math.exp(-(dx*dx + dy*dy)/(c.r*c.r));
        if(m < 0.01) continue;
        const d = m*smooth(0.30, 0.85, nz + 0.3*m - 0.15)*(1 - 0.75*smooth(0.55, 0.78, lane))*c.k;
        r += d*(c.a[0] + (c.b[0] - c.a[0])*tint); g += d*(c.a[1] + (c.b[1] - c.a[1])*tint); b += d*(c.a[2] + (c.b[2] - c.a[2])*tint);
      }
      const a = Math.min(1, Math.max(r, g, b));
      return a < 0.004 ? [0, 0, 0, 0] : [r/a, g/a, b/a, a*0.68];
    });
    layerVer++;                                       /* tells the black hole to re-read the far sky */
  }

  /* ---------- scene objects (world units; camera looks down +z) ---------- */
  const BH = {x:15.1, y:-5.8, z:40, r:1.05};
  /* particle galaxies: kind, position, orientation, size (k), share of particles (n) and palette */
  const GALS = [
    {type:"spiral", x:-12.3, y:-7.8, z:48, tilt:1.05, roll:0.35, k:0.75, n:0.85, glow:"255,236,200",            /* blue grand design */
      pal:{core:["#ffe9c4","#fff6e0"], arm:["#a9c3ff","#dfe8ff"], hot:"#ff8fb4"}},
    {type:"spiral", x:26.2, y:12.4, z:62, tilt:0.7, roll:-0.55, k:0.55, n:0.4, glow:"235,215,255",           /* teal and violet */
      pal:{core:["#fff0f8","#ffe0f0"], arm:["#8ff0e2","#c3b2ff"], hot:"#ff6fd8"}},
    {type:"barred", x:-15.6, y:11.9, z:56, tilt:0.55, roll:0.9, k:0.7, n:0.55, glow:"255,214,160",            /* golden barred spiral, blue knots */
      pal:{core:["#ffe2b0","#fff1d6"], arm:["#ffc48a","#ffdcae"], hot:"#7fd7ff"}},
    {type:"ring", x:-13.2, y:2.6, z:70, tilt:0.9, roll:-0.3, k:0.55, n:0.25, glow:"255,210,140",               /* gold core, blue ring */
      pal:{core:["#ffd28a","#ffe7bf"], arm:["#8fb8ff","#b9d0ff"], hot:"#ff8fd0"}},
    {type:"spiral", x:-29.9, y:2.6, z:84, tilt:0.07, roll:0.18, k:0.6, n:0.22, glow:"230,235,255",           /* edge-on */
      pal:{core:["#ffe9c4","#fff6e0"], arm:["#c7d4ff","#e6ecff"], hot:"#ffb08f"}},
    {type:"elliptical", x:39.5, y:22.2, z:74, tilt:0.4, roll:0.6, k:0.6, n:0.3, glow:"255,200,150",           /* giant elliptical, red-gold */
      pal:{core:["#ffd6a0","#ffe4c0"], arm:["#ffb98a","#ffcfa3"], hot:"#ffb98a"}}
  ];

  function drawBlackHole(t){
    if(window.REFDB_HOLE_GL) return;                        /* the ray-traced one is running */
    const c = project(BH.x, BH.y, BH.z); if(!c) return;
    const R = BH.r * c.s; if(R < 1) return;
    const tilt = 0.24, spin = t*0.35;
    /* faint lensing halo darkens and bends the field around it */
    const halo = ctx.createRadialGradient(c.x, c.y, R*1.2, c.x, c.y, R*6);
    halo.addColorStop(0, "rgba(0,0,0,.55)"); halo.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = halo; ctx.beginPath(); ctx.arc(c.x, c.y, R*6, 0, 6.2832); ctx.fill();
    ctx.save(); ctx.globalCompositeOperation = "lighter";
    const disk = (front) => {
      const segs = 72;
      for(let ring = 0; ring < 9; ring++){
        const rr = R*(1.9 + ring*0.42);
        for(let i = 0; i < segs; i++){
          const a0 = i/segs*6.2832, a1 = (i+1)/segs*6.2832, mid = (a0 + a1)/2;
          const isFront = Math.sin(mid) > 0;
          if(isFront !== front) continue;
          /* Doppler beaming: the side moving toward us is brighter */
          const beam = 0.55 + 0.45*Math.cos(mid + 0.3);
          const clump = 0.75 + 0.25*Math.sin(mid*5 - spin*(3.2 - ring*0.22) + ring);
          const heat = 1 - ring/9;
          const r = Math.round(255), gC = Math.round(150 + 90*heat), b = Math.round(70 + 150*heat*heat);
          ctx.beginPath(); ctx.ellipse(c.x, c.y, rr, rr*tilt, 0, a0, a1);
          ctx.strokeStyle = `rgba(${r},${gC},${b},${(0.10 + 0.32*heat) * beam * clump})`;
          ctx.lineWidth = R*0.36; ctx.stroke();
        }
      }
    };
    disk(false);
    /* lensed far side of the disk, bent up over the shadow */
    for(let k = 0; k < 6; k++){
      ctx.beginPath(); ctx.ellipse(c.x, c.y - R*0.08, R*(1.55 + k*0.14), R*(1.35 + k*0.16), 0, Math.PI*1.05, Math.PI*1.95);
      ctx.strokeStyle = `rgba(255,${200 - k*14},${150 - k*15},${0.20 - k*0.025})`; ctx.lineWidth = R*0.16; ctx.stroke();
    }
    ctx.restore();
    /* shadow + photon ring */
    ctx.beginPath(); ctx.arc(c.x, c.y, R*1.35, 0, 6.2832); ctx.fillStyle = "#000"; ctx.fill();
    ctx.beginPath(); ctx.arc(c.x, c.y, R*1.42, 0, 6.2832);
    ctx.strokeStyle = "rgba(255,226,180,.85)"; ctx.lineWidth = Math.max(0.8, R*0.07); ctx.stroke();
    ctx.save(); ctx.globalCompositeOperation = "lighter"; disk(true); ctx.restore();
  }

  function drawGalaxy(G, t){
    const ct = Math.cos(G.tilt), st = Math.sin(G.tilt), cr = Math.cos(G.roll), sr = Math.sin(G.roll);
    const rot = t * 0.018;
    const cc = project(G.x, G.y, G.z);
    if(cc){
      const R = cc.s*2.6*G.k, g = ctx.createRadialGradient(cc.x, cc.y, 0, cc.x, cc.y, R);
      g.addColorStop(0, `rgba(${G.glow},.55)`); g.addColorStop(0.25, `rgba(${G.glow},.18)`); g.addColorStop(1, `rgba(${G.glow},0)`);
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cc.x, cc.y, R, 0, 6.2832); ctx.fill();
    }
    ctx.save(); ctx.globalCompositeOperation = "lighter";
    for(const p of G.parts){
      const th = p.th + rot * p.w;                           /* differential rotation; bars and rings turn as one */
      let x = p.r*Math.cos(th), z = p.r*Math.sin(th), y = p.h;
      const y2 = y*ct - z*st, z2 = y*st + z*ct;               /* tilt */
      const x3 = x*cr - y2*sr, y3 = x*sr + y2*cr;              /* roll */
      const q = project(G.x + x3, G.y + y3, G.z + z2); if(!q) continue;
      const s = p.sz * Math.min(1.8, q.s/F*55);
      ctx.fillStyle = p.c;
      ctx.globalAlpha = p.a * 0.10; ctx.fillRect(q.x - s*2, q.y - s*2, s*5, s*5);   /* soft glow */
      ctx.globalAlpha = p.a; ctx.fillRect(q.x, q.y, s, s);
    }
    ctx.restore(); ctx.globalAlpha = 1;
  }

  /* ---------- comets and meteors (screen space, they cross the view) ---------- */
  let comets = [], meteors = [], nextComet = 6, nextMeteor = 2;
  function spawnComet(){
    const fromLeft = rnd() < 0.5, y0 = H*(0.08 + rnd()*0.4);
    const sp = 38 + rnd()*30;
    comets.push({x: fromLeft ? -60 : W + 60, y: y0, vx: (fromLeft ? 1 : -1)*sp, vy: sp*(0.12 + rnd()*0.25), life:0, len: 140 + rnd()*120});
  }
  function spawnMeteor(){
    const x = W*(0.1 + rnd()*0.8), y = H*(rnd()*0.35), sp = 700 + rnd()*500, ang = 0.5 + rnd()*0.6;
    meteors.push({x, y, vx: Math.cos(ang)*sp*(rnd()<.5?-1:1), vy: Math.sin(ang)*sp, life:0, max:0.5 + rnd()*0.5});
  }
  function drawComet(c){
    const v = Math.hypot(c.vx, c.vy), ux = -c.vx/v, uy = -c.vy/v;
    ctx.save(); ctx.globalCompositeOperation = "lighter";
    /* dust tail: broad, curved, warm */
    const tx = c.x + ux*c.len, ty = c.y + uy*c.len + c.len*0.18;
    const gd = ctx.createLinearGradient(c.x, c.y, tx, ty);
    gd.addColorStop(0, "rgba(255,236,200,.45)"); gd.addColorStop(1, "rgba(255,220,180,0)");
    ctx.strokeStyle = gd; ctx.lineWidth = 7; ctx.lineCap = "round";
    ctx.beginPath(); ctx.moveTo(c.x, c.y); ctx.quadraticCurveTo(c.x + ux*c.len*0.5, c.y + uy*c.len*0.5, tx, ty); ctx.stroke();
    /* ion tail: thin, straight, blue */
    const gi = ctx.createLinearGradient(c.x, c.y, c.x + ux*c.len*1.4, c.y + uy*c.len*1.4);
    gi.addColorStop(0, "rgba(140,200,255,.7)"); gi.addColorStop(1, "rgba(140,200,255,0)");
    ctx.strokeStyle = gi; ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.moveTo(c.x, c.y); ctx.lineTo(c.x + ux*c.len*1.4, c.y + uy*c.len*1.4); ctx.stroke();
    /* coma */
    const g = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, 14);
    g.addColorStop(0, "rgba(255,255,255,.95)"); g.addColorStop(0.3, "rgba(190,230,255,.5)"); g.addColorStop(1, "rgba(150,210,255,0)");
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(c.x, c.y, 14, 0, 6.2832); ctx.fill();
    ctx.restore();
  }
  function drawMeteor(m){
    const k = m.life / m.max, a = Math.sin(Math.PI*Math.min(1,k));
    const len = 90, v = Math.hypot(m.vx, m.vy);
    const ex = m.x - m.vx/v*len, ey = m.y - m.vy/v*len;
    const g = ctx.createLinearGradient(m.x, m.y, ex, ey);
    g.addColorStop(0, `rgba(255,255,255,${0.9*a})`); g.addColorStop(1, "rgba(255,255,255,0)");
    ctx.strokeStyle = g; ctx.lineWidth = 1.4; ctx.beginPath(); ctx.moveTo(m.x, m.y); ctx.lineTo(ex, ey); ctx.stroke();
  }

  /* ---------- frame ---------- */
  let last = 0, t = 0, raf = 0, scrollPitch = 0, scrollShift = 0;
  function frame(now, still){
    const dt = still ? 0 : Math.min(0.1, (now - last)/1000 || 0);
    last = now; t += dt;
    cam.yaw += (cam.tYaw + Math.sin(t*0.02)*0.04 - cam.yaw) * Math.min(1, dt*2.2);
    cam.pitch += (cam.tPitch + scrollPitch - cam.pitch) * Math.min(1, dt*2.2);
    cam.px += (cam.tPx - cam.px) * Math.min(1, dt*2.2);
    cam.py += (cam.tPy + scrollShift - cam.py) * Math.min(1, dt*2.2);
    ctx.clearRect(0, 0, W, H);
    /* deep space gradient */
    const bg = ctx.createRadialGradient(W*0.5, H*0.35, 0, W*0.5, H*0.5, Math.max(W,H)*0.8);
    bg.addColorStop(0, "#0b1324"); bg.addColorStop(1, "#03050b");
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    const bx = -W*0.1 - cam.yaw*W*0.25 - cam.px*4, by = -H*0.1 - cam.pitch*H*0.25 - cam.py*4;
    const nx = -W*0.05 - cam.yaw*W*0.6 - cam.px*12, ny = -H*0.05 - cam.pitch*H*0.6 - cam.py*12;
    rects = {bx, by, bw: W*1.2, bh: H*1.2, nx, ny, nw: W*1.1, nh: H*1.1, W, H};   /* the black hole lenses these */
    if(backdrop) ctx.drawImage(backdrop, bx, by, W*1.2, H*1.2);
    if(nebula){ ctx.globalCompositeOperation = "lighter"; ctx.drawImage(nebula, nx, ny, W*1.1, H*1.1); ctx.globalCompositeOperation = "source-over"; }
    GALS.forEach(G => drawGalaxy(G, t));
    /* stars: drift toward the camera — a slow cruise, not a warp */
    for(const s of stars){
      if(!still){ s.z -= dt*0.55; if(s.z < 1.5){ s.z += 58; s.x = (rnd()*2-1)*60; s.y = (rnd()*2-1)*36; } }
      const q = project(s.x, s.y, s.z); if(!q || q.x < -4 || q.x > W+4 || q.y < -4 || q.y > H+4) continue;
      const near = 1 - s.z/60;
      const tw = still ? 1 : 0.75 + 0.25*Math.sin(s.tw + t*(1.5 + s.m));
      if(s.big){                                             /* bright star: glow and diffraction spikes */
        const S2 = (12 + near*30) * s.m * (0.85 + 0.15*tw);
        ctx.globalCompositeOperation = "lighter"; ctx.globalAlpha = Math.min(1, 0.55 + near*0.6);
        ctx.drawImage(SPRITES[s.ci], q.x - S2/2, q.y - S2/2, S2, S2);
        ctx.globalCompositeOperation = "source-over"; continue;
      }
      ctx.globalAlpha = Math.min(1, (0.45 + near*0.9) * s.m * tw);
      const sz = 0.9 + near*2.1*s.m;
      ctx.fillStyle = s.c;
      if(sz > 1.8){ ctx.beginPath(); ctx.arc(q.x, q.y, sz*0.6, 0, 6.2832); ctx.fill(); }
      else ctx.fillRect(q.x, q.y, sz, sz);
    }
    ctx.globalAlpha = 1;
    /* DashLabs: no black hole (REF·DB pairs this with its BlackHole overlay; alone it is just a dark disc) */
    if(window.DASHLABS_HOLE) drawBlackHole(t);
    if(!still){
      nextComet -= dt; nextMeteor -= dt;
      if(nextComet <= 0){ spawnComet(); nextComet = 18 + rnd()*20; }
      if(nextMeteor <= 0){ spawnMeteor(); nextMeteor = 3 + rnd()*6; }
      comets = comets.filter(c => { c.x += c.vx*dt; c.y += c.vy*dt; drawComet(c); return c.x > -400 && c.x < W + 400 && c.y < H + 300; });
      meteors = meteors.filter(m => { m.life += dt; m.x += m.vx*dt; m.y += m.vy*dt; drawMeteor(m); return m.life < m.max; });
    }
    /* vignette keeps the edges calm behind text */
    const vg = ctx.createRadialGradient(W/2, H/2, Math.min(W,H)*0.35, W/2, H/2, Math.max(W,H)*0.75);
    vg.addColorStop(0, "rgba(0,0,0,0)"); vg.addColorStop(1, "rgba(0,0,0,.45)");
    ctx.fillStyle = vg; ctx.fillRect(0, 0, W, H);
  }

  const STEP = 1000/30;
  let acc = 0, prev = 0;
  function loop(now){
    if(dead) return;
    raf = requestAnimationFrame(loop);
    if(document.hidden || !dark() || labOpen() || paused()) { prev = now; return; }
    acc += now - (prev || now); prev = now;
    if(acc < STEP) return;
    acc = 0; try{ frame(now, false); }catch(e){ kill(e); }
  }
  function still(){ if(dead || !dark()) return; try{ frame(performance.now(), true); }catch(e){ kill(e); } }

  /* ---------- inputs ---------- */
  addEventListener("pointermove", e => {
    cam.tYaw = (e.clientX/W - 0.5) * 0.10;
    cam.tPitch = (e.clientY/H - 0.5) * 0.06;
    cam.tPx = (e.clientX/W - 0.5) * 0.9;
    cam.tPy = (e.clientY/H - 0.5) * 0.6;
  }, {passive:true});
  addEventListener("scroll", () => {
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    scrollPitch = (scrollY/max - 0.5) * 0.08;
    scrollShift = (scrollY/max - 0.5) * 2.0;            /* scrolling flies the camera down through the field */
    if(paused()) still();
  }, {passive:true});
  let rt; addEventListener("resize", () => { clearTimeout(rt); rt = setTimeout(() => { if(dead) return; try{ build(); }catch(e){ return kill(e); } still(); }, 150); });
  new MutationObserver(() => { if(paused()) still(); }).observe(doc, {attributes:true, attributeFilter:["class","data-theme"]});

  try{ build(); }catch(e){ kill(e); return; }
  still();
  raf = requestAnimationFrame(loop);
  window.REFDB_SKY = {still, rebuild: () => { build(); still(); },
    layers: () => ({back: backdrop, neb: nebula, ver: layerVer}), rects: () => rects};
})();
</script>

<style is:global>
  #cxSky { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;
    opacity: 0; transition: opacity 0.8s ease; display: block; }
  :root[data-theme='dark'] #cxSky { opacity: 1; }
  @media print { #cxSky { display: none !important; } }
</style>
