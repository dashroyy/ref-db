---
// A station planet: lit sphere with a tilted ring, in the station colour (REF·DB style).
interface Props {
  color: string;
  id: string;
  size?: number;
  ring?: boolean;
}
const { color, id, size = 40, ring = true } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" class="planet">
  <defs>
    <radialGradient id={`pl-${id}`} cx=".35" cy=".35" r=".75">
      <stop offset="0" stop-color="#fff" stop-opacity=".9"></stop>
      <stop offset=".38" stop-color={color}></stop>
      <stop offset="1" stop-color="#000"></stop>
    </radialGradient>
  </defs>
  {ring && <ellipse cx="24" cy="24" rx="22" ry="7" fill="none" stroke={color} stroke-width="1" opacity=".55" transform="rotate(-18 24 24)" />}
  <circle cx="24" cy="24" r="13" fill={`url(#pl-${id})`}></circle>
</svg>
