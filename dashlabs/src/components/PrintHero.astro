---
import { HERO_QUEUE } from '../lib/three/hero.ts';
const swatch = (c: string) => (c === 'rainbow' ? 'conic-gradient(#ff5c7a,#ffd84d,#3dffc5,#2f7dff,#9b6bff,#ff5c7a)' : c);
// The hero printer: a live Three.js scene printing models layer by layer, with
// a slicer-style readout. Falls back to the drawn printer if WebGL is missing.
---

<div class="hero-printer" data-hero-printer>
  <canvas data-canvas aria-label="A 3D printer printing models layer by layer" role="img"></canvas>
  <div class="hud" aria-hidden="true">
    <div class="hud-top">
      <span class="chip"><span class="live-dot"></span><span data-phase>Heating</span></span>
      <span class="chip mono" data-temp>215°C</span>
    </div>
    <div class="hud-bottom">
      <div>
        <span class="k">Now printing</span>
        <span class="v" data-model>Spiral vase</span>
      </div>
      <div class="right">
        <span class="k">Layer</span>
        <span class="v mono"><span data-layer>000</span>/<span data-layers>000</span></span>
      </div>
      <div class="progress"><i data-progress></i></div>
    </div>
  </div>
  <div class="queue-pick" data-pick hidden>
    <span class="tag">Pick the next print</span>
    <div class="chips">
      {
        HERO_QUEUE.map((q, i) => (
          <button type="button" data-job={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <i style={`background:${swatch(q.color)}`} />
            {q.name}
          </button>
        ))
      }
    </div>
  </div>
  <div class="fallback" data-fallback hidden>
    <svg viewBox="0 0 200 160"><rect x="20" y="120" width="160" height="8" rx="2" fill="#2a2540"></rect>{
      Array.from({ length: 10 }, (_, i) => <rect x={70 - i} y={112 - i * 8} width={60 + i * 2} height="7" rx="2" fill={i % 2 ? '#ffab2e' : '#ffc766'} />)
    }</svg>
  </div>
</div>

<script>
  import { webglOK } from '../lib/three/support.ts';

  const el = document.querySelector<HTMLElement>('[data-hero-printer]');
  if (el) {
    const $ = (s: string) => el.querySelector<HTMLElement>(s)!;
    const PH = { heating: 'Heating nozzle', printing: 'Printing', done: 'Print complete', ejecting: 'Ejecting part' };
    if (!webglOK()) {
      $('[data-fallback]').hidden = false;
      el.classList.add('no-gl');
    } else {
      // start once the page itself has loaded and the browser has a quiet moment
      const start = () => import('../lib/three/hero.ts').then(({ mountHero }) => {
        const jobs = [...el.querySelectorAll<HTMLButtonElement>('[data-job]')];
        const hero = mountHero(el.querySelector('canvas')!, (s) => {
          jobs.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.job) === s.index)));
          $('[data-phase]').textContent = PH[s.phase];
          $('[data-temp]').textContent = `${s.temp}°C`;
          $('[data-model]').textContent = s.model;
          $('[data-layer]').textContent = String(s.layer).padStart(3, '0');
          $('[data-layers]').textContent = String(s.layers).padStart(3, '0');
          $('[data-progress]').style.transform = `scaleX(${s.layers ? s.layer / s.layers : 0})`;
          el.dataset.state = s.phase;
        });
        jobs.forEach((b) => b.addEventListener('click', () => hero.printNow(Number(b.dataset.job))));
        $('[data-pick]').hidden = false;
      });
      const whenIdle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 300));
      if (document.readyState === 'complete') whenIdle();
      else addEventListener('load', whenIdle, { once: true });
    }
  }
</script>

<style>
  .hero-printer {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
  }
  canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  .hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 6%;
  }
  .hud-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    backdrop-filter: blur(6px);
    font: 600 0.72rem var(--font);
    color: var(--white);
  }
  .mono,
  .chip.mono {
    font-family: var(--mono);
    font-weight: 500;
  }
  [data-state='printing'] .chip.mono {
    color: var(--hot);
    border-color: color-mix(in srgb, var(--hot) 50%, transparent);
  }
  .hud-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px 16px;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    backdrop-filter: blur(8px);
  }
  .hud-bottom div {
    display: grid;
    gap: 2px;
  }
  .right {
    text-align: right;
  }
  .k {
    font: 500 0.64rem var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .v {
    font: 600 0.95rem var(--display);
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .v.mono {
    font: 600 0.95rem var(--mono);
    letter-spacing: 0;
  }
  .progress {
    grid-column: 1 / -1;
    height: 5px;
    border-radius: 5px;
    background: var(--panel-3);
    overflow: hidden;
  }
  .progress i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--uv), var(--hot));
    transform-origin: 0 50%;
    transform: scaleX(0);
    box-shadow: 0 0 12px var(--hot);
  }
  .fallback {
    position: absolute;
    inset: 15%;
  }
  .queue-pick {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 6px;
    display: grid;
    gap: 8px;
    justify-items: center;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .chips button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--overlay);
    color: var(--text-2);
    font: 600 0.76rem var(--font);
    cursor: pointer;
    transition:
      transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1),
      border-color 0.2s,
      color 0.2s;
  }
  .chips button:hover {
    transform: translateY(-2px);
    color: var(--white);
  }
  .chips button[aria-pressed='true'] {
    color: var(--white);
    border-color: var(--hot);
    box-shadow: 0 0 14px -6px var(--hot);
  }
  .chips i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .no-gl canvas {
    display: none;
  }
</style>
