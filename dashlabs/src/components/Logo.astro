---
// The DashLabs mark: a "D" built from a nozzle path, with a filled print inside.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7" fill="var(--panel-2)"></rect>
  <path d="M9 8h7a8 8 0 0 1 0 16H9z" fill="none" stroke="var(--accent)" stroke-width="3"></path>
  <path d="M13 13h3a3 3 0 0 1 0 6h-3z" fill="var(--accent)"></path>
</svg>
