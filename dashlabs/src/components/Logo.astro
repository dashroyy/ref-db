---
// The DashLabs mark, drawn like REF·DB's: an accent outline with a cyan stroke.
// A print nozzle over a layer line.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" class="mark">
  <path d="M20 10 H44 V28 L36 38 H28 L20 28 Z" fill="none" stroke="var(--accent)" stroke-width="4" stroke-linejoin="round"></path>
  <path d="M29 38 L32 45 L35 38" fill="var(--accent)"></path>
  <path d="M10 52 H54" stroke="var(--blue)" stroke-width="4" stroke-linecap="round"></path>
  <path d="M26 20 H38" stroke="var(--blue)" stroke-width="4" stroke-linecap="round"></path>
</svg>
