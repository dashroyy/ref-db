---
// A small drawing of each guide's tool, for the Learn index.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<svg viewBox="0 0 120 90" class="glyph" aria-hidden="true">
  {
    slug === 'materials' && (
      <g>
        {['#ffab2e', '#3dffc5', '#ff6ec7'].map((c, i) => (
          <g transform={`translate(${14 + i * 32} ${16 + (i === 1 ? -4 : 4)})`}>
            {/* a filament spool, side on: two flanges and the winding between */}
            <rect x="0" y="0" width="6" height="58" rx="3" fill="var(--panel-3)" />
            <rect x="24" y="0" width="6" height="58" rx="3" fill="var(--panel-3)" />
            <rect x="5" y="8" width="20" height="42" rx="2" fill={c} />
            {[14, 22, 30, 38].map((y) => (
              <line x1="5" y1={y} x2="25" y2={y} stroke="rgba(0,0,0,.18)" stroke-width="1.2" />
            ))}
          </g>
        ))}
      </g>
    )
  }
  {
    slug === 'pricing' && (
      <g>
        <rect x="22" y="12" width="66" height="66" rx="8" fill="none" stroke="var(--hot)" stroke-width="3" />
        <rect x="28" y="18" width="54" height="54" rx="4" fill="none" stroke="var(--uv-2)" stroke-width="2" />
        <clipPath id="gg-clip">
          <rect x="31" y="21" width="48" height="48" />
        </clipPath>
        <g clip-path="url(#gg-clip)" stroke="var(--hot)" stroke-width="1.6" opacity=".75">
          {[-40, -28, -16, -4, 8, 20, 32, 44].map((o) => (
            <>
              <line x1={31 + o} y1="21" x2={79 + o} y2="69" />
              <line x1={79 - o} y1="21" x2={31 - o} y2="69" />
            </>
          ))}
        </g>
        <text x="96" y="52" class="gt">$</text>
      </g>
    )
  }
  {
    slug === 'pen-launcher-physics' && (
      <g>
        <line x1="8" y1="78" x2="114" y2="78" stroke="var(--line-2)" />
        <rect x="8" y="58" width="22" height="20" rx="2" fill="var(--panel-3)" />
        <path d="M24 56 Q62 -8 108 76" fill="none" stroke="var(--hot)" stroke-width="3" stroke-dasharray="5 5" />
        <circle cx="108" cy="76" r="4" fill="var(--hot)" />
        <rect x="14" y="48" width="24" height="6" rx="3" fill="#ece6da" transform="rotate(-38 26 51)" />
      </g>
    )
  }
  {
    slug === 'photos-for-figurines' && (
      <g>
        <circle cx="60" cy="45" r="30" fill="none" stroke="var(--line-2)" stroke-dasharray="3 5" />
        <circle cx="60" cy="45" r="9" fill="var(--pink)" />
        {[
          [60, 9],
          [96, 45],
          [60, 81],
          [85, 20],
        ].map(([x, y], i) => (
          <g>
            <rect x={x - 8} y={y - 6} width="16" height="12" rx="3" fill={i < 3 ? 'var(--hot)' : 'var(--panel-3)'} />
            <circle cx={x} cy={y} r="3" fill="var(--ink)" />
          </g>
        ))}
      </g>
    )
  }
  {
    slug === 'design-for-printing' && (
      <g>
        <line x1="8" y1="78" x2="114" y2="78" stroke="var(--line-2)" />
        <path d="M14 78 h12 l22 -40 h-12 z" fill="var(--hot)" />
        <path d="M30 78 a26 26 0 0 1 -6 -40" fill="none" stroke="var(--uv-2)" stroke-width="1.5" stroke-dasharray="2 3" />
        <text x="34" y="66" class="gs">45°</text>
        <rect x="66" y="40" width="8" height="38" fill="var(--hot)" />
        <rect x="104" y="40" width="8" height="38" fill="var(--hot)" />
        <path d="M70 40 Q89 47 108 40" fill="none" stroke="var(--hot)" stroke-width="6" stroke-linecap="round" />
      </g>
    )
  }
  {
    slug === 'where-prints-live' && (
      <g>
        <circle cx="34" cy="30" r="12" fill="var(--hot)" />
        {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
          <line x1={34 + 16 * Math.cos((a * Math.PI) / 180)} y1={30 + 16 * Math.sin((a * Math.PI) / 180)} x2={34 + 22 * Math.cos((a * Math.PI) / 180)} y2={30 + 22 * Math.sin((a * Math.PI) / 180)} stroke="var(--hot)" stroke-width="2.5" stroke-linecap="round" />
        ))}
        <rect x="76" y="14" width="12" height="52" rx="6" fill="none" stroke="var(--text-3)" stroke-width="2.5" />
        <circle cx="82" cy="72" r="10" fill="var(--danger)" />
        <rect x="79" y="36" width="6" height="34" rx="3" fill="var(--danger)" />
      </g>
    )
  }
</svg>

<style>
  .glyph {
    width: 100%;
    height: auto;
  }
  .gt {
    font: 700 22px var(--display);
    fill: var(--hot);
  }
  .gs {
    font: 700 10px var(--mono);
    fill: var(--uv-2);
  }
</style>
