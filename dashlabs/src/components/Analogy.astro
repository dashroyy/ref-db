---
// "Think of it like…" — every guide opens its hard idea with one.
// An analogy must be physically faithful; say where it breaks down if that matters.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<aside class="analogy" aria-label={`Analogy: ${title}`}>
  <p class="label">
    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"></path>
    </svg>
    Think of it like…
  </p>
  <p class="title">{title}</p>
  <slot />
</aside>

<style>
  .analogy {
    margin: 24px 0;
    padding: 18px 20px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--accent) 7%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
  }
  .label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 6px;
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    margin: 0 0 8px;
  }
  .analogy :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
