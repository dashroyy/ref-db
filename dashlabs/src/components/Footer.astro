---
import Logo from './Logo.astro';
import { SITE } from '../data/site.ts';
import { STATIONS } from '../data/nav.ts';
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, url]) => url);
---

<footer class="site-footer">
  <div class="cols">
    <div>
      <a href="/" class="brand"><Logo size={24} /> DASH<span class="stamp">·</span>LABS</a>
      <p class="muted small">{SITE.tagline}</p>
    </div>
    <nav aria-label="Stations">
      <span class="tag">Stations</span>
      {STATIONS.map((s) => <a href={s.href} style={`--c:${s.color}`}><i></i>{s.short}</a>)}
    </nav>
    <nav aria-label="Info">
      <span class="tag">Info</span>
      <a href="/custom/">Custom order</a>
      <a href="/lab/">The lab</a>
      <a href="/faq/">FAQ &amp; policies</a>
      <a href="/cart/">Cart</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {socials.map(([name, url]) => <a href={url}>{name}</a>)}
    </nav>
  </div>
  <p class="legal">
    <span>© {year} DASHLABS</span><span>PRINTED LAYER BY LAYER</span><span
      >SISTER SITE <a href="https://rocketengdatabase.com/">REF·DB</a></span
    >
  </p>
</footer>

<style>
  .site-footer {
    padding: 28px var(--gutter) 24px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 28px;
  }
  .brand {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    text-decoration: none;
    font: 600 1.05rem var(--mono);
    letter-spacing: 0.08em;
    color: var(--white);
    margin-bottom: 8px;
  }
  .stamp {
    color: var(--accent);
  }
  .small {
    font-size: 0.88rem;
  }
  nav {
    display: grid;
    gap: 7px;
    align-content: start;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  nav a i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 6px var(--c);
  }
  nav a[style] {
    font: 400 0.74rem var(--mono);
    letter-spacing: 0.1em;
  }
  nav a:hover {
    color: var(--white);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 18px;
    margin: 24px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font: 400 0.66rem var(--mono);
    letter-spacing: 0.12em;
    color: var(--text-3);
  }
  .legal a {
    color: var(--blue);
  }
  @media (max-width: 720px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .cols > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
