---
// Station banner (REF·DB zone banner): planet, "STATION 2 OF 5 · ORIGINALS ·
// ITEM 1 OF 2 · O01", step dashes for every item at this station, PREV/NEXT
// through the whole route.
import Planet from './hud/Planet.astro';
import { STATIONS, locate } from '../data/nav.ts';

const { station, item, index } = locate(Astro.url.pathname);
const route = STATIONS.flatMap((s) => s.items.map((it) => ({ it, s })));
const pos = item ? route.findIndex((r) => r.it === item) : -1;
const prev = pos > 0 ? route[pos - 1] : undefined;
const next = pos >= 0 && pos < route.length - 1 ? route[pos + 1] : undefined;
const sIdx = station ? STATIONS.indexOf(station) : -1;
---

{
  station && (
    <div class="zone-banner" style={`--c:${station.color}`}>
      <Planet color={station.color} id={`zb-${station.id}`} />
      <div class="zb-txt">
        <span class="zb-phase">
          STATION {sIdx + 1} OF {STATIONS.length} · {station.short}
          {item && ` · ITEM ${index + 1} OF ${station.items.length} · ${item.code}`}
        </span>
        <span class="zb-sub">{station.sub}</span>
        {station.items.length > 1 && (
          <span class="zb-steps">
            {station.items.map((it) => (
              <a href={it.href} class:list={[it === item && 'here']} title={`${it.code} ${it.label}`}>
                <span class="sr-only">{it.label}</span>
              </a>
            ))}
          </span>
        )}
      </div>
      {item && (
        <nav class="zb-nav" aria-label="Previous and next">
          {prev ? (
            <a href={prev.it.href} title={prev.it.label}>
              ‹ PREV<small>{prev.it.code}</small>
            </a>
          ) : (
            <span class="off">‹ PREV</span>
          )}
          {next ? (
            <a href={next.it.href} title={next.it.label}>
              NEXT ›<small>{next.it.code}</small>
            </a>
          ) : (
            <span class="off">NEXT ›</span>
          )}
        </nav>
      )}
    </div>
  )
}

<style>
  .zone-banner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: center;
    margin: 0 0 1.2rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--c);
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 13%, transparent), transparent 60%);
    border-radius: 0 4px 4px 0;
  }
  .zb-txt {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .zb-phase {
    font: 500 0.7rem/1.5 var(--mono);
    letter-spacing: 0.16em;
    color: var(--c);
  }
  .zb-sub {
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .zb-steps {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }
  .zb-steps a {
    width: 22px;
    height: 7px;
    border: 1px solid var(--c);
    background: color-mix(in srgb, var(--c) 35%, transparent);
    opacity: 0.75;
  }
  .zb-steps a.here {
    background: var(--c);
    opacity: 1;
    box-shadow: 0 0 8px var(--c);
  }
  .zb-steps a:hover {
    opacity: 1;
  }
  .zb-nav {
    display: flex;
    gap: 0.4rem;
  }
  .zb-nav a,
  .zb-nav .off {
    display: grid;
    justify-items: center;
    font: 400 0.68rem/1.2 var(--mono);
    letter-spacing: 0.08em;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    text-decoration: none;
    color: var(--white);
  }
  .zb-nav small {
    font-size: 0.6rem;
    color: var(--text-3);
  }
  .zb-nav a:hover {
    border-color: var(--c);
    color: var(--c);
  }
  .zb-nav .off {
    opacity: 0.3;
  }
  @media (max-width: 40rem) {
    .zone-banner {
      grid-template-columns: auto 1fr;
    }
    .zb-nav {
      grid-column: 1 / -1;
    }
  }
</style>
