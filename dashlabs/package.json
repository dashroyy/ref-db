{
  "name": "dashlabs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "DashLabs — 3D printing portfolio and made-to-order shop.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.ts",
    "thumbs": "node scripts/render-thumbs.mjs",
    "og": "node scripts/render-og.ts",
    "smoke": "node scripts/smoke.mjs",
    "validate": "html-validate \"dist/**/*.html\"",
    "check": "npm test && tsc --noEmit -p . && astro build && npm run validate && echo \"All checks passed\"",
    "verify": "npm run check && npm run check:modes && npm run smoke",
    "check:modes": "node scripts/check-modes.mjs",
    "launch-check": "node scripts/launch-check.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.13",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "astro": "^7.4.7",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "html-validate": "^11.21.1",
    "playwright": "1.63.0"
  }
}
