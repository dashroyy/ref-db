---
// Limit, yield and ultimate load levels, and what each must show. Symbolic: no factor values are given.
const rows = [
  { label: 'Limit load', note: 'most severe load expected in service', f: 1.0, color: 'var(--rd-ink)', tag: 'reference', check: '' },
  { label: 'Yield design load', note: 'no detrimental permanent set', f: 1.16, color: 'var(--rd-blue)', tag: 'limit × k', sub: 'yield', check: 'vs yield allowable' },
  { label: 'Ultimate design load', note: 'no rupture or collapse', f: 1.34, color: 'var(--rd-accent)', tag: 'limit × k', sub: 'ultimate', check: 'vs ultimate allowable' },
  { label: 'Qualification test', note: 'shown on hardware', f: 1.34, color: 'var(--rd-accent)', tag: '≥ ultimate', check: 'design load', dashed: true },
];
const X0 = 4, S = 170, H = 66, W = 400;
---

<figure class="viz">
  <p class="viz-title">Load levels: schematic, not to scale</p>
  <svg viewBox={`0 0 ${W} ${rows.length * H + 6}`} role="img" aria-labelledby="ll-desc" style="max-width: 440px; display: block; margin: 0 auto;">
    <desc id="ll-desc">
      Four load levels in increasing order: limit load, the most severe load expected in service; the yield design load,
      limit times the yield factor, at which there must be no detrimental permanent deformation; the ultimate design
      load, limit times the ultimate factor, at which there must be no rupture or collapse; and the qualification test
      load, at least the ultimate design load.
    </desc>
    <line x1={X0 + S} y1="20" x2={X0 + S} y2={rows.length * H} stroke="var(--rd-line)" stroke-dasharray="4 4"></line>
    {rows.map((r, i) => {
      const y = i * H;
      const end = X0 + r.f * S;
      return (
        <g>
          <text x={X0} y={y + 16} font-size="15" font-weight="600" fill="var(--rd-ink)">{r.label}<tspan dx="10" font-size="13" font-weight="400" fill="var(--rd-muted)">{r.note}</tspan></text>
          <rect x={X0} y={y + 26} width={r.f * S} height="26" rx="3" fill={r.dashed ? 'none' : r.color} fill-opacity={r.dashed ? 0 : 0.85}
            stroke={r.color} stroke-width="2" stroke-dasharray={r.dashed ? '6 4' : undefined}></rect>
          <text x={end + 10} y={y + 35} font-size="13" fill="var(--rd-ink)">{r.tag}{r.sub && <tspan dy="4" font-size="10">{r.sub}</tspan>}</text>
          {r.check && <text x={end + 10} y={y + 56} font-size="12" fill={r.dashed ? 'var(--rd-ink)' : r.color}>{r.check}</text>}
        </g>
      );
    })}
  </svg>
  <figcaption>
    Every check pairs one load level with its own allowable: yield design load with a yield allowable, ultimate design
    load with an ultimate allowable. The factors k<sub>yield</sub> and k<sub>ultimate</sub> come from your programme's
    requirements. Bar lengths show order only.
  </figcaption>
</figure>
