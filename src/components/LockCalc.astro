---
// Locking check: will the joint slip (and so self-loosen), what preload the torque really gives with a prevailing-
// torque feature, how the self-loosening moment compares with the feature, and whether the feature meets the
// NASA-STD-5020B rules. Maths in src/lib/locking.ts and src/lib/bolts.ts (unit-tested); UI only here.
import ThreadSelect from './ThreadSelect.astro';
import { FEATURES } from '../lib/locking';
---

<div class="calc lkcalc" data-lkcalc>
  <div class="calc-head"><span>Locking and slip: one bolt</span><span class="head-btns"><span>slip · self-loosening · feature</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Fastener and torque</legend>
        <div class="row2">
          <label>Thread<ThreadSelect name="th" selected="M6" /></label>
          <label>Bearing face ⌀ (mm)<input name="dw" type="number" min="1" step="any" value="10" /></label>
          <label>Torque, min (N·m)<input name="tmin" type="number" min="0" step="any" value="9.5" /></label>
          <label>Torque, max (N·m)<input name="tmax" type="number" min="0" step="any" value="10.5" /></label>
          <label>Running torque, max (N·m)<input name="run" type="number" min="0" step="any" value="0.4" /></label>
          <label>Breakaway, min (N·m)<input name="brk" type="number" min="0" step="any" value="0" /></label>
        </div>
        <label class="lk-check"><input name="above" type="checkbox" /> Torque is specified “above running torque”</label>
        <div class="row2">
          <label>Thread friction μ<sub>t</sub><input name="mut" type="number" min="0.02" max="0.5" step="0.01" value="0.12" /></label>
          <label>Head friction μ<sub>b</sub><input name="muh" type="number" min="0.02" max="0.5" step="0.01" value="0.12" /></label>
          <label>Hole ⌀ (mm)<input name="dh" type="number" min="1" step="any" value="6.6" /></label>
          <label>Preload scatter ± (%)<input name="gam" type="number" min="0" max="80" step="any" placeholder="your value" autocomplete="off" /></label>
        </div>
        <p class="hint">Running torque and breakaway come from the locking feature's part standard, measured at installation. Preload scatter for your tightening method comes from your programme's standard.</p>
      </fieldset>
      <fieldset>
        <legend>Loads per bolt</legend>
        <div class="row2">
          <label>Sideways (transverse) load (N)<input name="fq" type="number" min="0" step="any" value="284" /></label>
          <label>Axial load (N)<input name="pa" type="number" min="0" step="any" value="0" /></label>
          <label>Interface friction μ<input name="mui" type="number" min="0.02" max="0.8" step="0.01" value="0.15" /></label>
          <label>Slip planes<input name="q" type="number" min="1" step="1" value="1" /></label>
          <label>Load factor Φ<input name="phi" type="number" min="0" max="1" step="0.01" value="0.15" /></label>
          <label>Slip factor<input name="fs" type="number" min="1" step="0.01" placeholder="your value" autocomplete="off" /></label>
        </div>
        <p class="hint">Φ from the <a href="../bolted-joints/">Bolted joints</a> calculator. Interface friction depends strongly on the surfaces and any coating: use a measured or specified value.</p>
        <p class="hint example-note" data-example-note hidden></p>
      </fieldset>
      <fieldset>
        <legend>Locking feature</legend>
        <label>Feature<select name="ft">{(Object.keys(FEATURES) as (keyof typeof FEATURES)[]).map((k) => <option value={k} selected={k === 'prevailing'}>{FEATURES[k].name}</option>)}</select></label>
        <label class="lk-check"><input name="rot" type="checkbox" /> The bolt is an axis of rotation in operation</label>
      </fieldset>
    </form>
    <div>
      <dl class="readouts">
        <div class="readout primary"><dt>Preload</dt><dd data-r="pre">—</dd></div>
        <div class="readout"><dt>Effective torque</dt><dd data-r="eff">—</dd></div>
        <div class="readout"><dt>Slip capacity</dt><dd data-r="cap">—</dd></div>
        <div class="readout" data-cls="slip"><dt>Slip margin</dt><dd data-r="slip">—</dd></div>
        <div class="readout"><dt>Static hold</dt><dd data-r="hold">—</dd></div>
        <div class="readout" data-cls="feat"><dt>Locking feature</dt><dd data-r="feat">—</dd></div>
      </dl>
      <figure class="lk-fig">
        <svg viewBox="0 0 420 200" data-chart role="img" aria-label="Bars comparing the sideways load with the slip capacity, and the self-loosening moment with the locking feature's running torque"></svg>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Slip capacity = interface friction × minimum clamp force × slip planes, with the clamp reduced by (1 − Φ) of the axial
    load. Self-loosening moment once slipping: F·P/2π from the thread ramp; NASA-STD-5020B §4.6.1 gives the larger estimate F·P/2.
  </div>
</div>

<style is:global>
  .lkcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .lkcalc .lk-check { display: flex !important; align-items: center; gap: 0.45rem; }
  .lkcalc .lk-check input { width: auto; }
  .lk-fig { margin: 0.9rem 0 0 !important; }
  .lk-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .lkcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { THREADS, torquePreload } from '../lib/bolts';
  import { holdingTorque, rampTorque, standardLooseningEstimate, slipCapacity, slipMargin, effectiveTorque, FEATURES, type FeatureKey } from '../lib/locking';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const sgn = (v: number) => `${v >= 0 ? '+' : ''}${f(v, 2)}`;

  document.querySelectorAll<HTMLElement>('[data-lkcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const checked = (n: string) => (field(n) as HTMLInputElement).checked;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const cls = (k: string, c: string) => (root.querySelector(`[data-cls="${k}"]`)!.className = `readout ${c}`);
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };
    let last: Parameters<typeof chart> | null = null;

    field('th').addEventListener('change', () => { const t = THREADS.find((x) => x.name === field('th').value)!; field('dw').value = String(Math.round(1.6 * t.d)); field('dh').value = String(+(t.d * 1.1).toFixed(1)); });

    function run() {
      const notes: [string, string][] = [];
      const say = () => (root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join(''));
      const t = THREADS.find((x) => x.name === field('th').value)!;
      const dw = num('dw'), dh = num('dh'), mut = num('mut'), muh = num('muh');
      if (![dw, dh, mut, muh, num('tmin'), num('tmax')].every((v) => v > 0) || dw <= t.d || num('tmax') < num('tmin')) {
        notes.push(['bad', 'Fill in the torque range, friction and bearing face (larger than the thread).']); say(); return;
      }
      const above = checked('above'), run = Math.max(0, num('run') || 0), brk = Math.max(0, num('brk') || 0);
      const eff = effectiveTorque(num('tmin') * 1000, num('tmax') * 1000, above, run * 1000, brk * 1000);
      r('eff').innerHTML = `${f(eff.min / 1000, 1)}–${f(eff.max / 1000, 1)} N·m <small>${above ? 'specified above running torque' : `running torque ${f(run, 1)} N·m comes off the minimum`}</small>`;
      if (eff.min <= 0) { notes.push(['bad', 'The running torque uses up all of the minimum torque: no preload is guaranteed.']); say(); return; }

      const P = (T: number) => torquePreload(T, t, mut, muh, dw, dh).F;
      const gamRaw = field('gam').value.trim(), gam = gamRaw === '' ? null : Math.min(0.8, Math.max(0, +gamRaw / 100));
      const Fnom = P((eff.min + eff.max) / 2), Fmin = P(eff.min) * (1 - (gam ?? 0)), Fmax = P(eff.max) * (1 + (gam ?? 0));
      r('pre').innerHTML = `${f(Fnom / 1000, 2)} kN <small>${gam === null ? 'nominal: enter the scatter for the range' : `${f(Fmin / 1000, 2)}–${f(Fmax / 1000, 2)} kN with scatter`}</small>`;

      // slip
      const phi = Math.min(1, Math.max(0, num('phi') || 0)), clamp = Fmin - (1 - phi) * Math.max(0, num('pa') || 0);
      const mui = num('mui'), q = Math.max(1, Math.round(num('q') || 1)), FQ = Math.max(0, num('fq') || 0);
      const cap = slipCapacity(Math.max(0, clamp), mui, q);
      r('cap').innerHTML = `${f(cap, 0)} N <small>μ ${f(mui, 2)} × ${f(Math.max(0, clamp), 0)} N${q > 1 ? ` × ${q}` : ''}${gam === null ? ', nominal' : ', minimum clamp'}</small>`;
      const fs = readFactor(field('fs').value);
      const ms = gam === null ? null : slipMargin(Math.max(0, clamp), mui, q, FQ, fs);
      if (ms === null) { r('slip').innerHTML = FQ > 0 ? '<small>needs your factor and scatter</small>' : '<small>no sideways load</small>'; cls('slip', ''); }
      else { r('slip').innerHTML = `${sgn(ms)} <small>against ${f((fs ?? 1) * FQ, 0)} N factored</small>`; cls('slip', ms < 0 ? 'bad' : 'ok'); }
      const missing = [gam === null && 'preload scatter', FQ > 0 && fs === null && 'slip factor'].filter(Boolean) as string[];
      if (missing.length) notes.push(['warn', awaitingMessage(missing, 'the slip margin')]);
      if (ms !== null && ms < 0) notes.push(['bad', `The joint slips under the sideways load (MS ${sgn(ms)}), so it will self-loosen however it is locked. Raise the clamp force (torque, bolt size or number), add slip planes or friction, or take the shear on a dowel or shoulder.`]);
      if (clamp <= 0) notes.push(['bad', 'The axial load takes away all of the minimum clamp force: the joint opens and any sideways load slides it.']);

      // static hold and the self-loosening moment
      const hold = holdingTorque(Fnom, t, mut, muh, dw, dh), ramp = rampTorque(Fnom, t), est = standardLooseningEstimate(Fnom, t);
      r('hold').innerHTML = `${f(hold / ramp, 1)}× <small>friction ${f(hold / 1000, 1)} N·m holds against a ramp of ${f(ramp / 1000, 1)} N·m, while nothing slips</small>`;

      // the locking feature
      const key = field('ft').value as FeatureKey, F = FEATURES[key], rot = checked('rot');
      const okIndep = F.independent, okRot = !rot || F.mechanical;
      r('feat').innerHTML = `${okIndep && okRot ? 'meets' : 'does not meet'} <small>${okIndep ? 'preload-independent' : 'depends on preload'} · verify: ${F.verify}</small>`;
      cls('feat', okIndep && okRot ? 'ok' : 'bad');
      notes.push(['', `${F.name}: ${F.does}`]);
      if (!okIndep) notes.push(['bad', 'NASA-STD-5020B §4.6.1: every threaded fastening system in spaceflight hardware needs at least one locking feature that does not depend on preload.']);
      if (!okRot) notes.push(['bad', '§4.6.2: a bolt subject to rotation in operation needs a mechanical locking feature such as safety wire or a cotter pin; wire the nut and bolt to each other only.']);
      if (key === 'prevailing') {
        notes.push(['', `The feature's running torque, ${f(run, 1)} N·m, is far below the self-loosening moment once the joint slips (${f(ramp / 1000, 1)} N·m from the ramp, ${f(est / 1000, 1)} N·m by the standard's estimate): it keeps the fastener captive, while the preload depends on the joint never slipping. Fully formed threads must engage the feature (§4.7.4).`]);
        if (!above && run === 0) notes.push(['warn', 'A prevailing-torque feature with no running torque entered: measure it at installation, and either specify torque above running torque or subtract it (§4.6.4, Table 4).']);
      }
      if (key === 'adhesive') notes.push(['', '§4.6.3: develop and validate the installation process (cleaning, primer, cure) before use, and verify by torque tests on witness samples made alongside the hardware.']);
      if (key === 'wire') notes.push(['', 'Wire so that tension in the wire pulls the fastener in the tightening direction (NASM 33540, SAE AS567); check by inspection after installation.']);
      say();
      chart(FQ * (fs ?? 1), cap, ramp, est, key === 'prevailing' ? run * 1000 : NaN);
    }

    function chart(load: number, cap: number, ramp: number, est: number, running: number) {
      const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
      svg.replaceChildren();
      last = [load, cap, ramp, est, running];
      const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 200, L = 8, R = 12;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const halo = { stroke: 'var(--rd-panel)', 'stroke-width': 4, 'paint-order': 'stroke', 'stroke-linejoin': 'round' };
      const group = (y: number, title: string, bars: [string, number, string, string][], unit: string, div: number) => {
        const max = Math.max(...bars.map((b) => (Number.isFinite(b[1]) ? b[1] : 0))) * 1.05 || 1;
        svg.append(el('text', { x: L, y, 'font-size': 13, 'font-weight': 600, fill: 'var(--rd-ink)' }, title));
        bars.forEach(([name, v, color], i) => {
          if (!Number.isFinite(v)) return;
          const yy = y + 10 + i * 22, w = (v / max) * (W - L - R);
          svg.append(el('rect', { x: L, y: yy, width: Math.max(2, w), height: 16, rx: 2, fill: color, 'fill-opacity': 0.75 }));
          svg.append(el('text', { x: L + 6, y: yy + 12, 'font-size': 12, fill: 'var(--rd-ink)', ...halo }, `${name} ${f(v / div, div === 1 ? 0 : 1)} ${unit}`));
        });
      };
      group(18, 'Sideways: load against grip', [['load, factored', load, 'var(--rd-accent)', ''], ['slip capacity', cap, 'var(--rd-ok)', '']], 'N', 1);
      group(100, 'Unscrewing once it slips', [['ramp F·P/2π', ramp, 'var(--rd-warn)', ''], ['standard estimate F·P/2', est, 'var(--rd-warn)', ''], ['feature running torque', running, '#c79bff', '']], 'N·m', 1000);
    }

    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (last && Math.abs(nw - w) > 8) { w = nw; chart(...last); } }).observe(root.querySelector('[data-chart]')!);
    }
    wireWorkedExample({
      root, onLoad: run, factorFields: ['gam', 'fs'],
      note: 'Worked-example values loaded: preload scatter ±25%, slip factor 1.25',
      values: { gam: '25', fs: '1.25' },
    });
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 120); });
    form.addEventListener('change', run);
    run();
  });
</script>
