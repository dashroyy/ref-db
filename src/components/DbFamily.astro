---
// The double-base family for a hardware designer: the product forms and the modified types, and what each change does
// to the grain. Families and properties only: no compositions, proportions or processing.
const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', prop = 'var(--rd-propellant)', ok = 'var(--rd-ok)', warn = 'var(--rd-warn)';
const boxes = [
  { id: 'db', x: 90, y: 8, w: 180, t: 'Double-base (DB)', l: ['nitrocellulose with a', 'nitrate ester: one phase'] },
  { id: 'edb', x: 8, y: 98, w: 162, t: 'Extruded (EDB)', l: ['sticks and tubes', 'free-standing grain'] },
  { id: 'cdb', x: 190, y: 98, w: 162, t: 'Cast (CDB)', l: ['larger grains', 'free-standing or bonded'] },
  { id: 'cmdb', x: 8, y: 188, w: 162, t: 'CMDB', l: ['+ oxidiser, often Al', 'more energy; smoky if Al'] },
  { id: 'emcdb', x: 190, y: 188, w: 162, t: 'EMCDB', l: ['+ a crosslinked polymer', 'more strain when cold'] },
  { id: 'xl', x: 90, y: 278, w: 180, t: 'XLDB, NEPE', l: ['crosslinked binder with', 'nitrate esters: rubbery'] },
];
const H = 62;
const at = (id: string) => boxes.find((b) => b.id === id)!;
const arrow = (a: string, b: string, colour = muted) => {
  const p = at(a), q = at(b);
  const x1 = p.x + p.w / 2, y1 = p.y + H, x2 = q.x + q.w / 2, y2 = q.y;
  return { d: `M${x1},${y1} C${x1},${(y1 + y2) / 2} ${x2},${(y1 + y2) / 2} ${x2},${y2 - 4}`, colour };
};
const arrows = [arrow('db', 'edb'), arrow('db', 'cdb'), arrow('cdb', 'cmdb', warn), arrow('cdb', 'emcdb', ok), arrow('cmdb', 'xl'), arrow('emcdb', 'xl')];
---

<figure class="viz dbfam">
  <p class="viz-title">The double-base family</p>
  <svg viewBox="0 0 360 372" role="img" aria-labelledby="dbfam-desc" style="max-width: 560px; margin: 0 auto;">
    <desc id="dbfam-desc">
      A family tree. Double-base propellant is nitrocellulose with a nitrate-ester plasticiser, one homogeneous phase. It
      comes extruded, as sticks and tubes for free-standing grains, or cast, as larger grains that can be free-standing
      or bonded to the case. Composite-modified double-base adds oxidiser crystals and often aluminium: more energy, and
      smoke when aluminium is present. Elastomer-modified cast double-base adds a crosslinked polymer: more strain
      capability when cold. Crosslinked nitrate-ester propellants, XLDB and NEPE, have a crosslinked binder plasticised
      with nitrate esters and are rubbery, like a composite propellant.
    </desc>
    <defs>
      <marker id="dbf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="context-stroke"></path></marker>
    </defs>
    {arrows.map((a) => <path d={a.d} fill="none" stroke={a.colour} stroke-width="1.6" marker-end="url(#dbf-arr)"></path>)}
    {boxes.map((b) => (
      <g>
        <rect x={b.x} y={b.y} width={b.w} height={H} rx="7" fill="var(--rd-panel2)" stroke={prop} stroke-width="1.6"></rect>
        <text x={b.x + b.w / 2} y={b.y + 20} text-anchor="middle" font-size="12.5" font-weight="700" fill={ink}>{b.t}</text>
        {b.l.map((line, k) => <text x={b.x + b.w / 2} y={b.y + 37 + k * 14} text-anchor="middle" font-size="10.5" fill={muted}>{line}</text>)}
      </g>
    ))}
    <text x="180" y="364" text-anchor="middle" font-size="10.5" fill={ink}>Down the tree: more energy and more strain capability</text>
  </svg>
  <figcaption>
    The forms and the modified types that a hardware designer meets. Extruded and cast double-base have the same
    material; the form sets the size of the grain and how it goes in the case. The modified types move towards a
    composite propellant. Compositions and processing are outside the scope of this site.
  </figcaption>
</figure>
