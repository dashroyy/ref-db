      band(-0.3, 0.15, 'glassy', 'var(--rd-blue)'); band(0.65, 1.15, 'rubbery', 'var(--rd-ok)');
      for (let k = Math.ceil(y0); k <= y1; k++) s += `<line x1="${L}" x2="${W - R}" y1="${Y(k)}" y2="${Y(k)}" stroke="var(--rd-line)"/><text x="${L - 5}" y="${Y(k) + 3}" text-anchor="end" font-size="10" fill="var(--rd-muted)">${k >= 0 && k <= 3 ? 10 ** k : `10${supx(k)}`}</text>`;
      const ticks: [number, string][] = [[-6, '1 µs'], [-3, '1 ms'], [0, '1 s'], [Math.log10(3600), '1 h'], [Math.log10(86400 * 30), '1 mo'], [Math.log10(3.156e8), '10 y']];
      for (const [lt, lab] of ticks) s += `<line x1="${X(lt)}" x2="${X(lt)}" y1="${Tp}" y2="${H - Bt}" stroke="var(--rd-line)"/><text x="${X(lt)}" y="${H - Bt + 14}" text-anchor="middle" font-size="10" fill="var(--rd-muted)">${lab}</text>`;
      s += `<text x="${L}" y="10" font-size="10" fill="var(--rd-ink)">E (MPa)</text><text x="${(L + W - R) / 2}" y="${H - 4}" text-anchor="middle" font-size="10.5" fill="var(--rd-ink)">time you look</text>`;
      const path = (r: typeof A) => {
        if (!r.valid) return '';
        let d = '';
        for (let k = 0; k <= 160; k++) { const lt = x0 + ((x1 - x0) * k) / 160, le = Math.log10(relaxation(p, 10 ** lt / r.aT)); d += `${k ? 'L' : 'M'}${X(lt).toFixed(1)},${Y(Math.max(y0, Math.min(y1, le))).toFixed(1)}`; }
        return d;
      };
      const ca = 'var(--rd-blue)', cb = 'var(--rd-hot)';
      if (A.valid) s += `<path d="${path(A)}" fill="none" stroke="${ca}" stroke-width="2.4"/>`;
      if (B.valid) s += `<path d="${path(B)}" fill="none" stroke="${cb}" stroke-width="2.4"/>`;
      const lo = Math.log10(tObs);
      s += `<line x1="${X(lo)}" x2="${X(lo)}" y1="${Tp}" y2="${H - Bt}" stroke="var(--rd-ink)" stroke-width="1.4" stroke-dasharray="4 3"/>`;
      const dot = (r: typeof A, col: string, lab: string, dy: number) => {
        if (!r.valid || lo < x0 || lo > x1) return '';
        const y = Y(Math.log10(r.E)), anchor = X(lo) > W * 0.62 ? 'end' : 'start', dx = anchor === 'end' ? -8 : 8;
        return `<circle cx="${X(lo)}" cy="${y}" r="5" fill="${col}" stroke="var(--rd-panel)" stroke-width="1.5"/><text x="${X(lo) + dx}" y="${y + dy}" text-anchor="${anchor}" font-size="10.5" font-weight="600" fill="${col}">${lab}</text>`;
      };
      s += dot(A, ca, deg(ta), -7) + dot(B, cb, deg(tb), 14);
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = s;
      $('[data-curvecap]').textContent = `Relaxation modulus at the two temperatures (Prony series of the Viscoelasticity page, WLF shift from Tg = ${f(tg, 0)} °C). The dashed line is the time you look. The cold curve is the warm curve moved to the right: every process is slower.`;
    }

    function tframe(ts: number) {
      traf = 0;
      if (!visible || document.hidden || tab !== 'temps' || calm()) return;
      const dt = tlast ? Math.min(50, ts - tlast) : 16.7; tlast = ts;
      tclock += dt / 1000;
      twinDraw('a'); twinDraw('b');
      tkick();
    }
    const tkick = () => { if (!traf && visible && tab === 'temps' && !calm()) { tlast = 0; traf = requestAnimationFrame(tframe); } };
    for (const n of ['vm', 'ta', 'tb', 'obs', 'vol']) field(n).addEventListener(n === 'vm' || n === 'vol' ? 'change' : 'input', tempsRun);
    root.querySelectorAll<HTMLCanvasElement>('[data-twin]').forEach((c) => {
      c.addEventListener('pointerdown', (e) => { try { c.setPointerCapture(e.pointerId); } catch { /* gone */ } tdrag = { x: e.clientX, y: e.clientY }; });
      c.addEventListener('pointermove', (e) => {
        if (!tdrag) return;
        tview.ry += (e.clientX - tdrag.x) * 0.01; tview.rx = Math.max(-1.45, Math.min(1.45, tview.rx + (e.clientY - tdrag.y) * 0.01));
        tdrag = { x: e.clientX, y: e.clientY }; twinDraw('a'); twinDraw('b');
      });
      const up = () => (tdrag = null);
      c.addEventListener('pointerup', up); c.addEventListener('pointercancel', up);
    });

    // ================= tabs, visibility, theme =================
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    tabs.forEach((b) => b.addEventListener('click', () => {
      tab = b.dataset.tab as 'live' | 'temps';
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== tab));
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== tab));
      if (tab === 'live') { draw(); kick(); } else tempsRun();
    }));
    if ('IntersectionObserver' in window) new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (visible) { kick(); tkick(); } }).observe(root);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { kick(); tkick(); } });
    new MutationObserver(() => {
      pal = palette(); sprites.clear();
      if (calm() && running) { running = false; runLabel(); notes(); }
      if (tab === 'live') { draw(); hud(); } else { twinDraw('a'); twinDraw('b'); tkick(); }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
    if ('ResizeObserver' in window) {
      let wd = 0;
      new ResizeObserver(([en]) => { const nw = Math.round(en.contentRect.width); if (Math.abs(nw - wd) > 4) { wd = nw; if (tab === 'live') draw(); else tempsRun(); } }).observe(root);
    }

    cv.className = mode();
    runLabel(); stretchBtn();
    reset();
  });
</script>
