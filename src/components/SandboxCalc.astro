---
// Molecular sandbox: a live bead-spring polymer model in 3D (src/lib/sandbox.ts: Langevin dynamics, unit-tested), and
// one chain network at two temperatures with its Deborah number from the Prony series of the Viscoelasticity page
// (src/lib/visco.ts). The model starts paused when motion is paused for the site.
import { PRESETS } from '../lib/sandbox';
import { VISCO_PRESETS } from '../lib/visco';
---

<div class="calc sbcalc" data-sbcalc>
  <div class="calc-head">
    <span>Molecular sandbox</span>
    <span class="head-btns"><span>bead-spring chains · Langevin dynamics</span></span>
  </div>
  <div class="hc-tabs" role="tablist" aria-label="View">
    <button type="button" role="tab" class="chip" data-tab="live" aria-selected="true">Live model</button>
    <button type="button" role="tab" class="chip" data-tab="temps" aria-selected="false">Two temperatures</button>
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="live">
        <div class="sb-ctl">
          <label>Material<select name="pre">{PRESETS.map((p) => <option value={p.key} selected={p.key === 'entangled'}>{p.name}</option>)}</select></label>
          <label>Temperature <output data-tval>0.60</output><input name="T" type="range" min="0.05" max="1.6" step="0.05" value="0.6" /></label>
          <div class="sb-mode">
            <span class="sb-lbl">Drag to</span>
            <div class="sb-seg" role="radiogroup" aria-label="Drag to">
              <label><input type="radio" name="mode" value="rotate" checked /><span>Rotate</span></label>
              <label><input type="radio" name="mode" value="push" /><span>Push</span></label>
              <label><input type="radio" name="mode" value="pull" /><span>Pull a bead</span></label>
            </div>
          </div>
        </div>
        <div class="sb-row">
          <button type="button" class="chip" data-run aria-pressed="true">Pause</button>
          <button type="button" class="chip" data-heat>Heat pulse</button>
          <button type="button" class="chip" data-stretch>Stretch 40%</button>
          <button type="button" class="chip" data-reset>Reset</button>
          <label class="inline"><input type="checkbox" name="bonds" checked /> Bonds</label>
          <label class="inline"><input type="checkbox" name="trails" /> Trails</label>
        </div>
      </fieldset>
      <fieldset data-panel="temps" hidden>
        <div class="sb-ctl sb-ctl4">
          <label>Material<select name="vm">{Object.entries(VISCO_PRESETS).map(([k, p]) => <option value={k}>{p.label}</option>)}</select></label>
          <label>Cold (°C)<input name="ta" type="number" step="any" value="-40" /></label>
          <label>Warm (°C)<input name="tb" type="number" step="any" value="20" /></label>
          <label>Time you look <output data-oval>0.1 s</output><input name="obs" type="range" min="-3" max="8.5" step="0.1" value="-1" /></label>
        </div>
        <label class="inline"><input type="checkbox" name="vol" checked /> Show how far each segment can move</label>
      </fieldset>
    </form>
    <div class="sb-out">
      <div class="sb-pane" data-pane="live">
        <div class="sb-stage">
          <canvas data-canvas tabindex="0" role="img" aria-label="Three-dimensional bead-spring model of polymer chains. Drag to rotate, push or pull. Arrow keys rotate; the space bar runs or pauses the model."></canvas>
          <div class="sb-hud" data-hud aria-live="polite"></div>
        </div>
        <dl class="readouts" data-live></dl>
        <ul class="pv-notes" data-notes></ul>
      </div>
      <div class="sb-pane" data-pane="temps" hidden>
        <div class="sb-twin">
          <figure><canvas data-twin="a" role="img" aria-label="The chain network at the cold temperature"></canvas><figcaption data-twincap="a"></figcaption></figure>
          <figure><canvas data-twin="b" role="img" aria-label="The same chain network at the warm temperature"></canvas><figcaption data-twincap="b"></figcaption></figure>
        </div>
        <dl class="readouts" data-temps></dl>
        <figure class="sb-fig"><svg data-curve role="img" aria-label="Relaxation modulus against time at the two temperatures"></svg><figcaption data-curvecap></figcaption></figure>
        <ul class="pv-notes" data-tnotes></ul>
      </div>
    </div>
  </div>
  <div class="calc-foot">
    Live model: beads joined by springs, with a weak bending stiffness and soft excluded volume, in reduced units (bond
    length 1, bead mass 1, k<sub>B</sub>T = 1 at temperature 1). Langevin dynamics, BAOAB splitting. Bonds to particles
    break under a sustained overload. Stretch holds each chain bead where the average stretch puts it (affine). Two
    temperatures: the Prony series and WLF shift of the Viscoelasticity page; Deborah number = the time at the middle
    of the transition, shifted to the temperature, divided by the time you look. A teaching model, not a material model.
  </div>
</div>

<style is:global>
  .sl-markdown-content .calc.sbcalc .calc-body { grid-template-columns: minmax(0, 1fr) !important; }
  .sbcalc .calc-body > * { min-width: 0; }
  .sbcalc fieldset { margin-bottom: 0 !important; }
  .sb-ctl { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.65rem 1rem; align-items: end; }
  .sb-ctl > * { margin: 0 !important; }
  .sbcalc output { font-family: var(--sl-font-mono); color: var(--rd-ink); font-weight: 600; margin-left: 0.3rem; }
  .sbcalc input[type='range'] { display: block; width: 100%; margin-top: 0.45rem !important; }
  .sb-lbl { display: block; font-size: 0.8rem; color: var(--rd-muted); margin-bottom: 0.2rem; }
  .sb-seg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--rd-line); border-radius: 6px; overflow: hidden; }
  .sb-seg label { margin: 0 !important; position: relative; }
  .sb-seg input { position: absolute; opacity: 0; pointer-events: none; }
  .sb-seg span { display: block; text-align: center; padding: 0.42rem 0.2rem; font-size: 0.76rem; color: var(--rd-muted); cursor: pointer; border-right: 1px solid var(--rd-line); white-space: nowrap; }
  .sb-seg label:last-child span { border-right: 0; }
  .sb-seg input:checked + span { background: color-mix(in srgb, var(--rd-accent) 16%, transparent); color: var(--rd-ink); font-weight: 600; }
  .sb-seg input:focus-visible + span { outline: 2px solid var(--rd-accent); outline-offset: -2px; }
  .sb-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem 0.6rem; margin-top: 0.2rem !important; }
  .sb-row > * { margin: 0 !important; }
  .sbcalc label.inline { display: inline-flex; align-items: center; gap: 0.35rem; justify-self: start; }
  .sbcalc input[type='checkbox'] { width: auto; margin: 0 !important; }
  .sb-ctl4 { grid-template-columns: minmax(12rem, 1.4fr) repeat(2, minmax(6rem, 0.7fr)) minmax(12rem, 1.4fr); }
  @container (max-width: 44rem) { .sb-ctl4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sbcalc [data-run][aria-pressed='false'] { border-color: color-mix(in srgb, var(--rd-ok) 70%, var(--rd-line)); color: var(--rd-ok); }
  .sbcalc [data-stretch].on { border-color: color-mix(in srgb, var(--rd-warn) 70%, var(--rd-line)); color: var(--rd-warn); }
  .sb-pane { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.85rem; }
  .sb-pane > * { margin: 0 !important; min-width: 0; }
  .sb-stage {
    position: relative; border: 1px solid var(--rd-line); border-radius: 8px; overflow: hidden;
    background: radial-gradient(ellipse at 50% 42%, color-mix(in srgb, var(--rd-blue) 9%, var(--rd-panel2)), var(--rd-panel2) 70%);
  }
  .sb-stage canvas { display: block; width: 100%; touch-action: none; cursor: grab; outline: none; }
  .sb-stage canvas:focus-visible { box-shadow: inset 0 0 0 2px var(--rd-accent); }
  .sb-stage canvas.push { cursor: crosshair; } .sb-stage canvas.pull { cursor: pointer; }
  .sb-hud { position: absolute; left: 0.55rem; top: 0.5rem; right: 0.55rem; display: flex; flex-wrap: wrap; gap: 0.3rem; pointer-events: none; }
  .sb-hud > span {
    margin: 0 !important; padding: 0.12rem 0.45rem; border-radius: 4px; border: 1px solid var(--rd-line);
    background: color-mix(in srgb, var(--rd-panel) 90%, transparent); font: 600 0.66rem var(--sl-font-mono); letter-spacing: 0.05em; color: var(--rd-ink);
  }
  .sb-hud > span.run { color: var(--rd-ok); } .sb-hud > span.hot { color: var(--rd-hot); } .sb-hud > span.str { color: var(--rd-warn); } .sb-hud > span.mu { color: var(--rd-muted); font-weight: 500; }
  .sb-twin { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.6rem; }
  .sb-twin figure { margin: 0 !important; border: 1px solid var(--rd-line); border-radius: 8px; overflow: hidden; background: var(--rd-panel2); padding: 0 !important; }
  .sb-twin canvas { display: block; width: 100%; touch-action: none; cursor: grab; }
  .sb-twin figcaption { margin: 0 !important; padding: 0.4rem 0.6rem 0.5rem !important; border-top: 1px solid var(--rd-line) !important; font-size: 0.78rem !important; color: var(--rd-ink) !important; }
  .sb-twin figcaption b { font-family: var(--sl-font-mono); }
  .sb-fig svg { width: 100%; height: auto; display: block; font-family: var(--sl-font-mono); }
  .sbcalc .lc { text-transform: none; }
  .sl-markdown-content .sbcalc .readout.sb-g { border-left-color: var(--rd-blue); }
  .sl-markdown-content .sbcalc .readout.sb-t { border-left-color: var(--rd-warn); }
  .sl-markdown-content .sbcalc .readout.sb-r { border-left-color: var(--rd-ok); }
  .sl-markdown-content .sbcalc .readout.sb-x { border-left-color: var(--rd-accent); }
  .sl-markdown-content .sbcalc .readout.sb-g dd { color: var(--rd-blue); }
  .sl-markdown-content .sbcalc .readout.sb-t dd { color: var(--rd-warn); }
  .sl-markdown-content .sbcalc .readout.sb-r dd { color: var(--rd-ok); }
</style>

<script>
  import {
    PRESETS, build, step, gaussian, mulberry32, kineticTemperature, rmsDisplacement, dewetting,
    beginStretch, setStrain, endStretch, BEAD, PLAST, FILLER, CRYST, type System, type Preset,
  } from '../lib/sandbox';
  import { VISCO_PRESETS, pronyOf, wlfFromTg, lookAt, stateOf, relaxation, instantaneous } from '../lib/visco';

  type V3 = [number, number, number];
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }).replace(/^-/, '−') : '—');
  const supx = (e: number) => String(e).replace('-', '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d]);
  const sci = (v: number) => {
    if (!Number.isFinite(v)) return '—';
    if (v >= 0.01 && v < 1000) return f(v, v < 1 ? 3 : v < 10 ? 2 : 0);
    const e = Math.floor(Math.log10(v)); return `${f(v / 10 ** e, 1)}×10${supx(e)}`;
  };
  const deg = (c: number) => `${f(c, 0)} °C`;
  const when = (s: number) => s < 1e-3 ? `${f(s * 1e6, 0)} µs` : s < 1 ? `${f(s * 1e3, s < 0.01 ? 1 : 0)} ms` : s < 60 ? `${f(s, s < 10 ? 1 : 0)} s`
    : s < 3600 ? `${f(s / 60, 0)} min` : s < 86400 ? `${f(s / 3600, 1)} h` : s < 3.156e7 ? `${f(s / 86400, 0)} days` : `${f(s / 3.156e7, 1)} years`;
  const calm = () => document.documentElement.classList.contains('motion-off') || matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // ---------- drawing helpers shared by both views ----------
  interface Palette { chains: string[]; plast: string; filler: string; cryst: string; cross: string; anchor: string; line: string; muted: string; ink: string; hot: string; panel: string }
  function palette(): Palette {
    const cs = getComputedStyle(document.documentElement), v = (n: string, d: string) => cs.getPropertyValue(n).trim() || d;
    return {
      chains: [v('--rd-blue', '#5aa9e6'), v('--ph-detail', '#e0a94e'), v('--ph-make', '#b98bd9'), v('--ph-verify', '#3ec5d3'), v('--ph-feature', '#c77baa'), v('--ph-orient', '#7ba7c7'), v('--rd-warn', '#e0a94e'), v('--ph-spec', '#8ca0ac')],
      plast: v('--rd-ink', '#e6e6e6'), filler: v('--rd-steel', '#9aa3ad'), cryst: v('--rd-insul', '#7d6a8c'), cross: v('--rd-accent', '#fc3d21'),
      anchor: v('--rd-ok', '#5bc48a'), line: v('--rd-line', '#333'), muted: v('--rd-muted', '#888'), ink: v('--rd-ink', '#eee'), hot: v('--rd-hot', '#d1561a'), panel: v('--rd-panel', '#111'),
    };
  }
  const sprites = new Map<string, HTMLCanvasElement>();
  function sphere(color: string) {
    let c = sprites.get(color);
    if (c) return c;
    c = document.createElement('canvas'); c.width = c.height = 96;
    const g = c.getContext('2d')!;
    g.beginPath(); g.arc(48, 48, 46, 0, Math.PI * 2); g.fillStyle = color; g.fill();
    const gr = g.createRadialGradient(36, 32, 3, 48, 48, 47);
    gr.addColorStop(0, 'rgba(255,255,255,0.85)'); gr.addColorStop(0.22, 'rgba(255,255,255,0.18)');
    gr.addColorStop(0.62, 'rgba(0,0,0,0)'); gr.addColorStop(1, 'rgba(0,0,0,0.5)');
    g.fillStyle = gr; g.beginPath(); g.arc(48, 48, 46, 0, Math.PI * 2); g.fill();
    sprites.set(color, c);
    return c;
  }
  interface View { rx: number; ry: number }
  /** A camera; with `box` (half sizes) and no k, the scale fits that box's corners in the frame at this view. */
  function camera(view: View, W: number, H: number, reach: number, kGiven?: number, box?: number[]) {
    const cyw = Math.cos(view.ry), syw = Math.sin(view.ry), cxp = Math.cos(view.rx), sxp = Math.sin(view.rx);
    const D = reach * 4.2;
    let k = kGiven ?? (Math.min(W, H) / 2) * 0.94 / (reach * (D / (D - reach)));
    if (kGiven === undefined && box) {
      let mx = 1e-9, my = 1e-9;
      for (const a of [-1, 1]) for (const b of [-1, 1]) for (const c of [-1, 1]) {
        const px = a * box[0], py = b * box[1], pz = c * box[2];
        const x1 = cyw * px + syw * pz, z1 = -syw * px + cyw * pz, y2 = cxp * py - sxp * z1, z2 = sxp * py + cxp * z1, p = D / (D - z2);
        mx = Math.max(mx, Math.abs(x1) * p); my = Math.max(my, Math.abs(y2) * p);
      }
      k = 0.9 * Math.min(W / 2 / mx, H / 2 / my);
    }
    const toView = (px: number, py: number, pz: number): V3 => {
      const x1 = cyw * px + syw * pz, z1 = -syw * px + cyw * pz;
      return [x1, cxp * py - sxp * z1, sxp * py + cxp * z1];
    };
    const persp = (z: number) => D / (D - z);
    const project = (px: number, py: number, pz: number) => {
      const [x, y, z] = toView(px, py, pz), s = k * persp(z);
      return { x: W / 2 + x * s, y: H / 2 - y * s, z, s };
    };
    const unproject = (sx: number, sy: number, z: number): V3 => {
      const s = k * persp(z), x = (sx - W / 2) / s, y = -(sy - H / 2) / s;
      const py = cxp * y + sxp * z, z1 = -sxp * y + cxp * z;
      return [cyw * x - syw * z1, py, syw * x + cyw * z1];
    };
    return { project, unproject, k, persp, D };
  }
  function sizeCanvas(cv: HTMLCanvasElement, aspect: number, minH: number, maxH: number) {
    const W = Math.max(240, Math.round(cv.clientWidth || 600)), H = Math.round(Math.max(minH, Math.min(maxH, W * aspect)));
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    if (cv.width !== Math.round(W * dpr) || cv.height !== Math.round(H * dpr)) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); cv.style.height = `${H}px`; }
    const g = cv.getContext('2d')!; g.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { g, W, H };
  }

  document.querySelectorAll<HTMLElement>('[data-sbcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const cv = $<HTMLCanvasElement>('[data-canvas]');
    let pal = palette();
    let tab: 'live' | 'temps' = 'live';
    let visible = true;

    // ================= live model =================
    let preset: Preset = PRESETS.find((p) => p.key === field('pre').value) ?? PRESETS[1];
    let sys: System = build(preset, 1);
    let noise = gaussian(mulberry32(17));
    let running = !calm(), heatUntil = 0, stretch: 'none' | 'loading' | 'held' | 'unloading' = 'none';
    const view: View = { rx: -0.38, ry: 0.62 };
    let probe: { sx: number; sy: number } | null = null, grab: { i: number; sx: number; sy: number; z: number } | null = null;
    let drag: { x: number; y: number } | null = null;
    let snaps: { t: number; x: Float64Array }[] = [], lastSnap = -1;
    let trails: { i: number; pts: number[] }[] = [];
    const breaks = new Map<number, number>(); // anchor index → time it broke (ms)
    let lastShown = 0, raf = 0, last = 0, zoom = 0;

    const T = () => +field('T').value;
    const mode = () => (form.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value ?? 'rotate') as 'rotate' | 'push' | 'pull';

    function reset() {
      preset = PRESETS.find((p) => p.key === field('pre').value) ?? PRESETS[1];
      sys = build(preset, 1);
      noise = gaussian(mulberry32(17));
      stretch = 'none'; heatUntil = 0; grab = null; breaks.clear(); zoom = 0;
      snaps = []; lastSnap = -1;
      // trails: the middle bead of each chain, and a few plasticiser beads
      trails = sys.chains.map((c) => ({ i: c[Math.floor(c.length / 2)], pts: [] }));
      let p = 0; for (let i = 0; i < sys.n && p < 4; i++) if (sys.kind[i] === PLAST) { trails.push({ i, pts: [] }); p++; }
      notes();
      update(true);
      draw();
      kick();
    }

    function notes() {
      const items: [string, string][] = [
        ['', `<b>What it is.</b> ${esc(preset.what)}`],
        ['', `<b>What to look for.</b> ${esc(preset.see)}`],
        ['', `<b>Where you meet it.</b> ${esc(preset.where)}`],
      ];
      if (!running && calm()) items.unshift(['warn', 'Motion is paused for this site, so the model starts paused. Push <b>Run</b> to start it.']);
      $('[data-notes]').innerHTML = items.map(([c, t]) => `<li class="${c}">${t}</li>`).join('');
    }

    function hud() {
      const s = stretch !== 'none' ? `<span class="str">STRETCH ${f(sys.strain * 100, 0)}%</span>` : '';
      const h = performance.now() < heatUntil ? '<span class="hot">HEAT PULSE</span>' : '';
      const m = mode(), hint = m === 'rotate' ? 'drag to rotate' : m === 'push' ? 'move over the model to push' : 'drag a bead to pull it';
      $('[data-hud]').innerHTML = `<span class="${running ? 'run' : ''}">${running ? 'RUNNING' : 'PAUSED'}</span><span>T ${f(T(), 2)}</span>${s}${h}<span class="mu">${hint}</span>`;
    }

    // live readouts, four times a second
    function update(force = false) {
      const now = performance.now();
      if (!force && now - lastShown < 250) return;
      lastShown = now;
      const ref = snaps.length ? snaps.reduce((a, b) => (Math.abs(b.t - (sys.t - 2)) < Math.abs(a.t - (sys.t - 2)) ? b : a)) : null;
      const span = ref ? sys.t - ref.t : 0;
      const rms = (kind: number) => (ref && span > 0.5 ? rmsDisplacement(sys, ref.x, kind) : NaN);
      const chain = rms(BEAD), plast = rms(PLAST), part = rms(FILLER);
      const ro = (cls: string, dt: string, dd: string, small = '') => `<div class="readout ${cls}"><dt>${dt}</dt><dd>${dd}${small ? ` <small>${small}</small>` : ''}</dd></div>`;
      let h = ro('', 'Temperature', f(T() + (now < heatUntil ? 1 : 0), 2), `measured ${f(kineticTemperature(sys), 2)} (k<sub>B</sub>T units)`);
      h += ro('', 'Chain segments move', Number.isFinite(chain) ? f(chain, 2) : '—', `bond lengths in the last ${f(Math.max(span, 0), 1)} time units`);
      if (preset.plast) h += ro('', 'Plasticiser moves', Number.isFinite(plast) ? f(plast, 2) : '—', Number.isFinite(plast) && chain > 0 ? `${f(plast / chain, 1)} times the chains` : 'free small molecules');
      if (preset.filler) {
        const d = dewetting(sys), cls = d.broken ? 'sb-t' : 'sb-r';
        h += ro(cls, 'Binder bonded to particles', `${d.total - d.broken} of ${d.total}`, d.broken ? `${d.broken} broke (dewetting), ${d.poles} of them at the poles` : 'all bonds hold');
        h += ro('', 'Particles move', Number.isFinite(part) ? f(part, 2) : '—', 'large, heavy particles');
      }
      if (preset.cross) h += ro('', 'Crosslinks', String(sys.cross.length / 2), 'permanent links between chains');
      if (preset.cryst) h += ro('', 'Crystalline blocks', String(preset.cryst), 'fixed: they hold the chains that pass them');
      if (stretch !== 'none') h += ro('', 'Stretch', `${f(sys.strain * 100, 0)}%`, stretch === 'held' ? 'held: push Release to unload' : stretch);
      $('[data-live]').innerHTML = h;
      hud();
    }

    function draw() {
      if (tab !== 'live') return;
      const { g, W, H } = sizeCanvas(cv, 0.62, 260, 470);
      g.clearRect(0, 0, W, H);
      const b = sys.box, reach = Math.hypot(b[0], b[1], b[2]);
      // fit the box at this view, easing the zoom so that it does not jump while the view turns or the box stretches
      const kFit = camera(view, W, H, reach, undefined, [b[0], b[1], b[2]]).k;
      zoom = zoom && Math.abs(zoom / kFit - 1) < 0.6 ? zoom + (kFit - zoom) * 0.25 : kFit;
      const cam = camera(view, W, H, reach, zoom);
      // box edges
      g.lineWidth = 1; g.strokeStyle = pal.line; g.globalAlpha = 0.9;
      const corners: { x: number; y: number }[] = [];
      for (const sx of [-1, 1]) for (const sy of [-1, 1]) for (const sz of [-1, 1]) corners.push(cam.project(sx * b[0], sy * b[1], sz * b[2]));
      g.beginPath();
