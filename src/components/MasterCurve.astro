---
// Time–temperature superposition explorer: where each load case sits on an illustrative propellant master curve.
// Maths in src/lib/propellant.ts (unit-tested); this file is UI only.
const PRESETS = [
  { k: 'cool', n: 1, label: 'Cool-down to −40 °C, 8 h', T: -40, t: 8 * 3600 },
  { k: 'ignc', n: 2, label: 'Ignition at −40 °C', T: -40, t: 0.05 },
  { k: 'ignw', n: 3, label: 'Ignition at +20 °C', T: 20, t: 0.05 },
  { k: 'ignh', n: 4, label: 'Ignition at +60 °C', T: 60, t: 0.05 },
  { k: 'vib', n: 5, label: 'Vibration at +20 °C, 100 Hz', T: 20, t: 0.01 },
  { k: 'store', n: 6, label: 'Storage at +20 °C, 10 years', T: 20, t: 10 * 3.156e7 },
];
---

<div class="calc mccalc" data-mccalc>
  <div class="calc-head"><span>Master-curve explorer</span><span>WLF shift · illustrative HTPB-like propellant</span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Load case</legend>
        <div class="mc-presets">
          {PRESETS.map((p) => <button type="button" class="chip" data-preset={p.k}><b>{p.n}</b> {p.label}</button>)}
        </div>
        <label>Temperature: <output data-o="T"></output>
          <input name="T" type="range" min="-65" max="70" step="1" value="-40" />
        </label>
        <label>Load duration: <output data-o="t"></output>
          <input name="lt" type="range" min="-3" max="9.6" step="0.05" value="-1.3" />
        </label>
      </fieldset>
      <details class="mc-consts">
        <summary>Material constants (illustrative)</summary>
        <div class="row2">
          <label>WLF reference T<sub>s</sub> (°C)<input name="ts" type="number" step="any" value="-20" /></label>
          <label>C<sub>1</sub><input name="c1" type="number" step="any" value="8.86" /></label>
          <label>C<sub>2</sub> (K)<input name="c2" type="number" step="any" value="101.6" /></label>
          <label>E<sub>eq</sub>, fully relaxed (MPa)<input name="ee" type="number" step="any" value="3" /></label>
          <label>E<sub>1</sub> at ξ = 1 s (MPa)<input name="e1" type="number" step="any" value="5" /></label>
          <label>Slope m<input name="m" type="number" step="0.01" value="0.3" /></label>
        </div>
        <p class="hint">C<sub>1</sub> = 8.86 and C<sub>2</sub> = 101.6 K are Williams, Landel and Ferry's general constants with T<sub>s</sub> ≈ T<sub>g</sub> + 50 K. The power-law curve and its constants are illustrative, not data for any real propellant.</p>
      </details>
    </form>
    <div>
      <dl class="readouts">
        <div class="readout primary"><dt>Relaxation modulus E</dt><dd data-r="E">—</dd></div>
        <div class="readout"><dt>Stiffer than fully relaxed</dt><dd data-r="ratio">—</dd></div>
        <div class="readout"><dt>Shift factor a<sub>T</sub></dt><dd data-r="aT">—</dd></div>
        <div class="readout"><dt>Equivalent time at T<sub>s</sub></dt><dd data-r="xi">—</dd></div>
      </dl>
      <figure class="mc-fig">
        <svg viewBox="0 0 480 250" data-chart role="img" aria-label="Relaxation modulus master curve with load cases marked"></svg>
        <figcaption>Modulus against reduced time ξ = t / a<sub>T</sub>, both on log scales. Numbers are the load cases; the ring is the one selected.</figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Time–temperature superposition with the WLF equation, which applies from about the glass transition to some 100 K
    above it. Real propellants need measured relaxation data, their own shift factors, and separate treatment of
    dewetting, ageing and pressure.
  </div>
  <script type="application/json" data-presets set:html={JSON.stringify(PRESETS)}></script>
</div>

<style is:global>
  .mccalc .mc-presets { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0 0 0.75rem !important; }
  .mccalc .mc-presets > * { margin: 0 !important; }
  .mccalc .mc-presets .chip { text-transform: none; letter-spacing: 0.02em; }
  .mccalc .mc-presets .chip b { color: var(--pc, var(--sl-color-accent)); }
  .mccalc .mc-presets .chip.on { border-color: var(--pc, var(--sl-color-accent)); background: color-mix(in srgb, var(--pc, var(--sl-color-accent)) 18%, transparent); }
  .mccalc .mc-consts { margin-top: 0.75rem !important; font-size: var(--sl-text-sm); }
  .mccalc .mc-consts summary { cursor: pointer; color: var(--rd-muted); }
  .mccalc output { color: var(--rd-ink); font-family: var(--sl-font-mono); }
  .mc-fig { margin: 0.9rem 0 0 !important; }
  .mc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .mc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .mccalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { wlfLogShift, reducedTime, relaxModulus } from '../lib/propellant';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 1) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const sci = (v: number) => { const e = Math.floor(Math.log10(v)); const m = v / 10 ** e; return Math.abs(e) <= 2 ? f(v, Math.max(0, 2 - e)) : `${f(m, 1)}×10${String(e).replace(/-/, '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])}`; };
  const deg = (T: number) => `${String(T).replace('-', '−')} °C`;
  const dur = (s: number) => s < 1 ? `${f(s * 1000, s < 0.01 ? 1 : 0)} ms` : s < 120 ? `${f(s, s < 10 ? 1 : 0)} s` : s < 7200 ? `${f(s / 60, 0)} min` : s < 2 * 86400 ? `${f(s / 3600, 1)} h` : s < 3.156e7 ? `${f(s / 86400, 0)} days` : `${f(s / 3.156e7, s < 3.156e9 ? 1 : 0)} years`;

  document.querySelectorAll<HTMLElement>('[data-mccalc]').forEach((root) => {
    const PRESETS: { k: string; n: number; label: string; T: number; t: number }[] = JSON.parse(root.querySelector('[data-presets]')!.textContent!);
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const num = (n: string) => +field(n).value;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const o = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };

    function run() {
      const Ts = num('ts'), C1 = num('c1'), C2 = num('c2');
      const curve = { eEq: num('ee'), e1: num('e1'), m: num('m'), eGlass: 2500 };
      const T = num('T'), t = 10 ** num('lt');
      o('T').textContent = deg(T);
      o('t').textContent = dur(t);
      root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
        const p = PRESETS.find((x) => x.k === b.dataset.preset)!;
        b.classList.toggle('on', p.T === T && Math.abs(Math.log10(p.t) - num('lt')) < 0.03);
      });
      const notes = root.querySelector('[data-notes]')!;
      if (!(C2 + T - Ts > 5) || !(curve.eEq > 0 && curve.e1 >= 0 && curve.m >= 0)) {
        notes.innerHTML = '<li class="bad">Outside the range of this WLF fit (C₂ + T − T<sub>s</sub> must stay positive), or a material constant is invalid.</li>';
        return;
      }
      const logA = wlfLogShift(T, Ts, C1, C2), xi = reducedTime(t, T, Ts, C1, C2), E = relaxModulus(xi, curve);
      r('E').innerHTML = `${f(E, E < 10 ? 2 : E < 100 ? 1 : 0)} <small>MPa</small>`;
      r('ratio').textContent = `${f(E / curve.eEq, 1)}×`;
      r('aT').textContent = sci(10 ** logA);
      r('xi').textContent = dur(xi);

      const at = (p: { T: number; t: number }) => relaxModulus(reducedTime(p.t, p.T, Ts, C1, C2), curve);
      const eCool = at(PRESETS[0]), eIgn = at(PRESETS[1]);
      const out: [string, string][] = [];
      out.push(['', `Cold is slow: at ${deg(T)} every process runs ${logA >= 0 ? `${sci(10 ** logA)}× slower` : `${sci(10 ** -logA)}× faster`} than at T<sub>s</sub> = ${deg(Ts)}, so ${dur(t)} here acts like ${dur(xi)} there.`]);
      out.push(['', `The same propellant is ${f(eIgn / eCool, 0)}× stiffer at a −40 °C ignition (${f(eIgn, 0)} MPa) than during the cool-down to −40 °C (${f(eCool, 1)} MPa). That is why thermal strain analyses use the relaxed modulus, and why strain capability is measured at the rate and temperature of each load case.`]);
      if (T < Ts - 45) out.push(['warn', 'Close to the glass transition: the binder is turning glassy, stiffness rises steeply and strain capability collapses. The lowest firing temperature normally sits well above it.']);
      notes.innerHTML = out.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      chart(curve, Ts, C1, C2, xi, E);
    }

    function chart(curve: { eEq: number; e1: number; m: number; eGlass: number }, Ts: number, C1: number, C2: number, xi0: number, e0: number) {
      const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
      svg.replaceChildren();
      const W = 480, H = 250, L = 50, R = 12, T = 12, B = 36, x1 = -10, x2 = 12, y1 = 0, y2 = Math.log10(curve.eGlass) + 0.2;
      const X = (lx: number) => L + ((lx - x1) / (x2 - x1)) * (W - L - R);
      const Y = (ly: number) => H - B - ((ly - y1) / (y2 - y1)) * (H - T - B);
      for (let e = Math.ceil(y1); e <= y2; e++) {
        svg.append(el('line', { x1: L, x2: W - R, y1: Y(e), y2: Y(e), stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: L - 6, y: Y(e) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, String(10 ** e)));
      }
      for (let e = x1; e <= x2; e += 2) {
        svg.append(el('line', { x1: X(e), x2: X(e), y1: T, y2: H - B, stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: X(e), y: H - B + 14, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, `10${String(e).replace(/-/, '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])}`));
      }
      svg.append(el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, `reduced time ξ at ${deg(Ts)}, s`));
      svg.append(el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, 'E, MPa'));
      const pts = Array.from({ length: 221 }, (_, i) => x1 + (i / 220) * (x2 - x1));
      svg.append(el('path', { d: pts.map((lx, i) => `${i ? 'L' : 'M'}${X(lx).toFixed(1)},${Y(Math.log10(relaxModulus(10 ** lx, curve))).toFixed(1)}`).join(''), fill: 'none', stroke: 'var(--rd-ok)', 'stroke-width': 2.5 }));
      // below the plateau when there is room, so the load-case tags above the curve stay clear
      const yEq = Y(Math.log10(curve.eEq)), below = yEq + 15 < H - B - 2;
      svg.append(el('text', { x: X(x2) - 4, y: below ? yEq + 15 : yEq - 6, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, 'rubbery, fully relaxed'));
      svg.append(el('text', { x: X(x1) + 4, y: Y(Math.log10(curve.eGlass)) + 14, 'font-size': 10, fill: 'var(--rd-muted)' }, 'glassy'));
      // Load cases: a dot on the curve and a numbered tag above it, nudged up where tags would collide.
      const placed: { x: number; y: number }[] = [];
      const marks = PRESETS.map((p) => {
        const xi = reducedTime(p.t, p.T, Ts, C1, C2);
        const lx = Math.min(x2, Math.max(x1, Math.log10(xi)));
        return { n: p.n, x: X(lx), y: Y(Math.log10(relaxModulus(xi, curve))) };
      }).filter((m) => Number.isFinite(m.x) && Number.isFinite(m.y)).sort((a, b) => a.x - b.x);
      for (const m of marks) {
        let ty = m.y - 16;
        while (placed.some((q) => Math.abs(q.x - m.x) < 17 && Math.abs(q.y - ty) < 15)) ty -= 15;
        placed.push({ x: m.x, y: ty });
        svg.append(el('line', { x1: m.x, x2: m.x, y1: m.y - 3, y2: ty + 7, stroke: 'var(--rd-muted)', 'stroke-width': 0.8 }));
        svg.append(el('circle', { cx: m.x, cy: m.y, r: 3.2, fill: 'var(--rd-ink)' }));
        svg.append(el('circle', { cx: m.x, cy: ty, r: 7.5, fill: 'var(--rd-panel)', stroke: 'var(--rd-muted)', 'stroke-width': 1.2 }));
        svg.append(el('text', { x: m.x, y: ty + 3.5, 'text-anchor': 'middle', 'font-size': 9.5, 'font-weight': 700, fill: 'var(--rd-ink)' }, String(m.n)));
      }
      const lx0 = Math.min(x2, Math.max(x1, Math.log10(xi0)));
      svg.append(el('circle', { cx: X(lx0), cy: Y(Math.log10(e0)), r: 12, fill: 'none', stroke: 'var(--pc, var(--sl-color-accent))', 'stroke-width': 2.5 }));
    }

    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const p = PRESETS.find((x) => x.k === b.dataset.preset)!;
      field('T').value = String(p.T);
      field('lt').value = String(Math.log10(p.t));
      run();
    }));
    form.addEventListener('input', run);
    run();
  });
</script>
