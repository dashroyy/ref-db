---
// The life of a single-use motor from manufacture to flight, on three strips: pressure, temperature, and shock and
// vibration. Not to scale in time.
const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', accent = 'var(--rd-accent)', blue = 'var(--rd-blue)', warn = 'var(--rd-warn)', ok = 'var(--rd-ok)';
const phases: [number, number, string][] = [[36, 72, 'make'], [72, 124, 'proof'], [124, 176, 'tests'], [176, 286, 'storage, years'], [286, 318, 'move'], [318, 352, 'flight']];
// pressure strip: zero at y 112, MEOP at y 56
const P = (mpa: number) => 112 - mpa * 5.6;
const pres: [number, number][] = [[36, 0], [80, 0], [82, 11], [90, 11], [92, 0], [100, 0], [101, 0.7], [107, 0.7], [108, 0], [112, 0], [113, 0.7], [119, 0.7], [120, 0], [162, 0], [163, 0.7], [169, 0.7], [170, 0], [292, 0], [293, 0.7], [299, 0.7], [300, 0], [326, 0], [328, 10.4], [331, 9.6], [334, 10], [346, 10], [348, 0], [352, 0]];
// temperature strip around y 152: thermal cycling in tests, daily and seasonal swings in storage
const temp: [number, number][] = [];
for (let x = 36; x <= 352; x += 1) {
  let d = 0;
  if (x >= 128 && x < 172) d = Math.sign(Math.sin(((x - 128) / 11) * Math.PI)) * 13;
  else if (x >= 176 && x < 286) d = 8 * Math.sin(((x - 176) / 55) * Math.PI) + 4 * Math.sin(((x - 176) / 2.2) * Math.PI);
  else if (x >= 286 && x < 318) d = 3 * Math.sin(((x - 286) / 4) * Math.PI);
  temp.push([x, 152 - d]);
}
const vib = Array.from({ length: 34 }, (_, k) => [138 + k, 10 * Math.sin(k * 2.3) * Math.cos(k * 0.7)]);
const shocks: [number, number][] = [[54, 9], [180, 7], [284, 8], [292, 14], [300, 11], [309, 16], [315, 9], [322, 12]];
const pts = (a: [number, number][]) => a.map(([x, y]) => `${x},${y.toFixed(1)}`).join(' ');
---

<figure class="viz lifetimeline">
  <p class="viz-title">The life before the one flight</p>
  <svg viewBox="0 0 360 240" role="img" aria-labelledby="lifetimeline-desc" style="max-width: 600px; margin: 0 auto;">
    <desc id="lifetimeline-desc">
      A timeline of a single-use motor, not to scale, in six phases: make, proof, tests, storage for years, move, and
      flight. The pressure strip shows the proof test at 1.1 times MEOP, four low-pressure leak checks and the flight
      at MEOP with an ignition peak. The temperature strip shows thermal cycling in the tests, daily and seasonal swings
      during years of storage, and small swings in transport. The shock and vibration strip shows vibration testing,
      handling shocks and transport shocks.
    </desc>
    {phases.map(([a, b, n], k) => (
      <g>
        {k % 2 === 1 && <rect x={a} y="30" width={b - a} height="196" fill={muted} fill-opacity="0.08"></rect>}
        <text x={(a + b) / 2} y="24" text-anchor="middle" font-size="9" fill={ink}>{n}</text>
      </g>
    ))}
    <text x="38" y="44" font-size="9" fill={muted}>pressure</text>
    <line x1="36" x2="352" y1={P(10)} y2={P(10)} stroke={muted} stroke-dasharray="2 3"></line>
    <text x="34" y={P(10) + 3} text-anchor="end" font-size="9" fill={muted}>MEOP</text>
    <polyline points={pts(pres.map(([x, p]) => [x, P(p)]))} fill="none" stroke={accent} stroke-width="1.8"></polyline>
    <text x="94" y={P(11) + 2} font-size="9" fill={accent}>1.1 ×</text>
    <text x="232" y={P(0) - 6} text-anchor="middle" font-size="9" fill={muted}>leak checks at 0.07 × MEOP</text>
    <text x="38" y="132" font-size="9" fill={muted}>temperature</text>
    <polyline points={pts(temp)} fill="none" stroke={blue} stroke-width="1.4"></polyline>
    <text x="231" y="174" text-anchor="middle" font-size="9" fill={muted}>daily and seasonal</text>
    <text x="38" y="196" font-size="9" fill={muted}>shock, vibration</text>
    <line x1="36" x2="352" y1="214" y2="214" stroke="var(--rd-line)"></line>
    <polyline points={pts(vib.map(([x, a]) => [x, 214 - a]))} fill="none" stroke={warn} stroke-width="1"></polyline>
    {shocks.map(([x, a]) => <line x1={x} x2={x} y1="214" y2={214 - a} stroke={ok} stroke-width="2"></line>)}
  </svg>
  <figcaption>
    Not to scale in time. The proof test is the highest pressure the case will see, and each leak check, reassembly,
    environment test, day in storage and transport adds cycles. Write each of them on the duty-cycle sheet with its
    level and count.
  </figcaption>
</figure>
