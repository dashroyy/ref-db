---
// Tolerance stacks in four tabs: a linear stack built row by row as the drawing gives each dimension (any tolerance
// format, GD&T controls with the MMC bonus, distributions, correlated groups, thermal growth from the material library),
// tolerance allocation to meet a target, a radial stack of offsets that add as vectors, and fastener checks. Process
// capability, limits, targets and coverage are the programme's and start blank. Maths in src/lib/stack.ts and
// src/lib/gdt.ts (unit-tested); UI only here.
import { TOL_FORMATS, GDT_CONTROLS } from '../lib/stack';
import { withProps, grouped } from '../lib/materials';

const TABS = [{ key: 'lin', name: 'Linear stack' }, { key: 'alloc', name: 'Allocate' }, { key: 'rad', name: 'Radial stack' }, { key: 'fast', name: 'Fasteners' }];
const NOZZLE = `Case flange bore to case axis, 0.05, zone
Case flange face squareness, 0.05/300, zone
Closure pilot clearance, 0.125, shift
Nozzle bore position in closure, 0.05, zone
Nozzle seat squareness, 0.03/180, zone
Nozzle pilot clearance, 0.1015, shift
Throat to nozzle pilot, 0.05, zone`;
// materials for thermal growth: every library entry with an expansion coefficient
const MATS = grouped(withProps(['alpha'])).map((g) => ({ label: g.label, items: g.items.map((m) => ({ key: m.key, name: m.name, alpha: m.alpha })) }));
---

<div class="calc stcalc" data-stcalc>
  <div class="calc-head"><span>Tolerance stack</span><span class="head-btns"><span>worst case · RSS · Monte Carlo</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Kind of stack">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="lin">
        <legend>The loop: one row for each arrow</legend>
        <div class="sk-rows" data-rows></div>
        <div class="sk-btns">
          <button type="button" class="chip" data-act="add">+ Add a row</button>
          <button type="button" class="chip" data-act="seal">Seal example</button>
          <button type="button" class="chip" data-act="clear">Clear</button>
        </div>
        <details class="sk-text">
          <summary>Rows as text: copy, or paste a table</summary>
          <textarea name="l_text" rows="6" spellcheck="false" wrap="off" aria-label="Rows as text"></textarea>
          <div class="sk-btns"><button type="button" class="chip" data-act="import">Use this text</button></div>
          <p class="hint">One line for each row: name, sensitivity, low limit, high limit, and “, u” for a uniform part. A spreadsheet can make these lines.</p>
        </details>
        <div class="row2">
          <label>Process Cpk of the parts<input name="l_cpk" type="number" min="0" step="any" placeholder="your process data" autocomplete="off" /></label>
          <label>Lower limit on the result<input name="l_lsl" type="number" step="any" placeholder="your requirement" autocomplete="off" /></label>
          <label>Upper limit on the result<input name="l_usl" type="number" step="any" placeholder="your requirement" autocomplete="off" /></label>
          <label>Monte Carlo assemblies<select name="l_n"><option value="20000">20,000</option><option value="100000" selected>100,000</option><option value="500000">500,000</option></select></label>
        </div>
        <label class="sk-check"><input type="checkbox" name="l_th" /> Include thermal growth (select a material on each row)</label>
        <div class="row2" data-thermal hidden>
          <label>Assembly temperature (°C)<input name="l_t0" type="number" step="any" value="20" /></label>
          <label>Coldest (°C)<input name="l_tc" type="number" step="any" value="-40" /></label>
          <label>Hottest (°C)<input name="l_th2" type="number" step="any" value="60" /></label>
        </div>
        <label>Chart<select name="l_chart"><option value="dist">Distribution of the result</option><option value="share">Contribution of each row</option></select></label>
        <p class="hint">Direction: + if the arrow points in the positive direction of the loop. × is the sensitivity: ½ for a diameter whose radius is in the loop, cos θ for a dimension at an angle. A <b>group</b> letter puts rows that change together (one setup, one tool, one batch) into a worst-case group. <b>Fixed</b> keeps a bought part's tolerance in the Allocate tab.</p>
      </fieldset>

      <fieldset data-panel="alloc" hidden>
        <legend>Share a target among the rows of the linear stack</legend>
        <div class="row2">
          <label>Target on the result, ± (mm)<input name="a_t" type="number" min="0" step="any" placeholder="your requirement" autocomplete="off" /></label>
          <label>Basis<select name="a_b"><option value="wc">Worst case</option><option value="rss">RSS</option></select></label>
          <label>Method<select name="a_m">
            <option value="scale">Scale: keep the present proportions</option>
            <option value="size">By size: the same IT grade on each row</option>
            <option value="equal">Equal effect on the result</option>
          </select></label>
        </div>
        <p class="hint">If the target is blank, the tab uses the limits of the linear tab: the smaller distance from the nominal to a limit. Rows marked “fixed” keep their tolerance and use their part of the target first.</p>
        <div class="sk-btns"><button type="button" class="chip" data-act="apply">Apply to the rows</button></div>
      </fieldset>

      <fieldset data-panel="rad" hidden>
        <legend>Offsets: name, largest offset, kind</legend>
        <textarea name="r_rows" rows="8" spellcheck="false" wrap="off">{NOZZLE}</textarea>
        <div class="row2">
          <label>Lever arm for tilts (mm)<input name="r_lever" type="number" min="0" step="any" value="700" /></label>
          <label>Thrust (kN)<input name="r_force" type="number" min="0" step="any" value="29.5" /></label>
          <label>Assemblies to cover (%)<input name="r_p" type="number" min="0" max="100" step="any" placeholder="your requirement" autocomplete="off" /></label>
          <label>Limit on the offset (mm)<input name="r_lim" type="number" min="0" step="any" placeholder="your requirement" autocomplete="off" /></label>
        </div>
        <p class="hint">Offsets at the plane that matters: here the thrust line at the centre of gravity. Kind: <b>zone</b>, anywhere in a position or coaxiality zone of that radius; <b>shift</b>, a clearance fully taken up in a random direction; <b>fixed</b>, a clearance taken up the same way every time. Write a tilt as “t/l”, a tolerance over the length it acts on; it is carried to the lever arm.</p>
      </fieldset>

      <fieldset data-panel="fast" hidden>
        <legend>Fasteners and pins in clearance holes</legend>
        <div class="row2">
          <label>Case<select name="f_case">
            <option value="float">Floating: clearance holes in both parts</option>
            <option value="fixed">Fixed: one part threaded or pressed, projected zone</option>
            <option value="noproj">Fixed, without a projected zone</option>
          </select></label>
          <label>Clearance hole at MMC, H (mm)<input name="f_h" type="number" min="0" step="any" value="11" /></label>
          <label>Fastener at MMC, F (mm)<input name="f_f" type="number" min="0" step="any" value="10" /></label>
          <label data-fx>Position of the clearance holes, T₁ (mm)<input name="f_t1" type="number" min="0" step="any" placeholder="optional" /></label>
          <label data-np>Position of the threaded holes, T₂ (mm)<input name="f_t2" type="number" min="0" step="any" value="0.4" /></label>
          <label data-np>Projection: clamped thickness, P (mm)<input name="f_p" type="number" min="0" step="any" value="15" /></label>
          <label data-np>Thread engagement, D (mm)<input name="f_d" type="number" min="0" step="any" value="15" /></label>
        </div>
        <p class="hint">Position tolerances at MMC, ASME Y14.5 formulae. Defaults: the 30 × M10 aft-closure bolts in 11 mm clearance holes.</p>
      </fieldset>
      <p class="hint example-note" data-example-note hidden></p>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <div class="sk-table" data-table></div>
      <figure class="hc-fig" data-fig>
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected stack"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <script type="application/json" data-mats set:html={JSON.stringify(MATS)}></script>
  <script type="application/json" data-opts set:html={JSON.stringify({ formats: TOL_FORMATS, gdt: GDT_CONTROLS })}></script>
  <div class="calc-foot">
    Each row converted to its limits and then to a mean ± an equal half. Worst case by adding the half tolerances; RSS with
    each normal part centred and its tolerance at ±3σ (±3·Cpk σ when a Cpk is entered), uniform parts at the half tolerance
    over √3; groups added worst case inside and statistically outside; Monte Carlo with a fixed seed. Radial stacks: vector
    sums. Fasteners: ASME Y14.5 floating and fixed fastener formulae.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .stcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .stcalc .nc { text-transform: none; }
  .stcalc textarea { width: 100%; font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); background: var(--rd-panel2, var(--rd-panel)); color: var(--rd-ink); border: 1px solid var(--rd-line); border-radius: 4px; padding: 0.4rem; resize: vertical; }
  .stcalc fieldset { min-width: 0; }
  .sk-rows { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; margin: 0 0 0.5rem !important; min-width: 0; }
  .sk-row { border: 1px solid var(--rd-line); border-radius: 6px; padding: 0.45rem; display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 0.35rem; margin: 0 !important; background: color-mix(in srgb, var(--rd-panel) 85%, transparent); }
  .sk-row.off { opacity: 0.55; }
  .sk-row > * { margin: 0 !important; }
  .stcalc .sk-l { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; }
  .stcalc .sk-l > * { margin: 0 !important; min-width: 0; }
  .stcalc .sk-l input, .stcalc .sk-l select { width: auto; min-width: 0; padding: 0.3rem 0.4rem; }
  .stcalc .sk-l input[type='checkbox'] { flex: 0 0 auto; width: auto; }
  .stcalc .sk-l input[type='text'] { flex: 1 1 5rem; }
  .stcalc .sk-l input[type='number'] { flex: 1 1 4.6rem; width: 4.6rem; }
  .stcalc .sk-l select { flex: 1 1 8rem; }
  .stcalc .sk-l .sk-narrow { flex: 0 0 3.4rem !important; width: 3.4rem !important; }
  .stcalc .sk-l .sk-grp { flex: 0 1 4.4rem; width: 4.4rem; }
  .stcalc .sk-l .sk-mat { flex: 1 1 9rem; }
  .stcalc .sk-l label { display: inline-flex; align-items: center; gap: 0.25rem; font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .stcalc .sk-l label > input { margin: 0 !important; display: inline-block; }
  .stcalc .sk-pm { color: var(--rd-muted); }
  .sk-ibtn { padding: 0.1rem 0.3rem !important; min-width: 1.6rem; }
  .sk-conv { font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .sk-conv b { color: var(--rd-ink); font-weight: 600; }
  .sk-conv .w { color: var(--rd-warn); }
  .sk-btns { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.4rem 0 !important; }
  .sk-btns > * { margin: 0 !important; }
  .sk-check { display: flex !important; align-items: center; gap: 0.4rem; margin: 0.4rem 0 !important; }
  .sk-check input { width: auto; }
  .sk-text { margin: 0.5rem 0 !important; }
  .sk-text summary { cursor: pointer; font-size: var(--sl-text-sm); color: var(--rd-muted); }
  .sk-table { overflow-x: auto; margin: 0.6rem 0 0 !important; }
  .sk-table table { width: 100%; font-size: var(--sl-text-xs); border-collapse: collapse; display: table; }
  .sk-table th, .sk-table td { padding: 0.25rem 0.4rem; border-bottom: 1px solid var(--rd-line); text-align: right; white-space: nowrap; }
  .sk-table th:first-child, .sk-table td:first-child { text-align: left; white-space: normal; }
  .sk-table td.hi { color: var(--rd-accent); font-weight: 600; }
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .stcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import {
    capability, radialStack, parseOffsets, rowLimits, toContributors, groupedStack, groupedMonteCarlo, thermalShift,
    allocate, itGrade, rowsToText, rowsFromText, type StackRow, type TolFormat, type GdtKey, type AllocMethod,
  } from '../lib/stack';
  import { floatingTolerance, fixedTotal, holeWithoutProjection } from '../lib/gdt';
  import { itValue } from '../lib/fits';
  import { wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 3) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const g4 = (v: number) => String(Number(v.toPrecision(6)));
  const pct = (v: number) => (v <= 0 ? '0%' : v < 1e-7 ? 'under 0.1 ppm' : v < 1e-4 ? `${f(1e6 * v, v < 1e-5 ? 1 : 0)} ppm` : v < 0.01 ? `${f(100 * v, 2)}%` : `${f(100 * v, 1)}%`);
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };
  type Mat = { key: string; name: string; alpha: number };
  const shares = (s: [string, number][]) => {
    const top = s.slice(0, 3).map(([n, v], i) => `${i === 0 ? '<b>' : ''}${esc(n)} ${f(100 * v, 0)}%${i === 0 ? '</b>' : ''}`), rest = s.slice(3);
    return `<small>${top.join(' · ')}${rest.length ? ` · ${rest.length} more, ${f(100 * rest.reduce((a, [, v]) => a + v, 0), 0)}% together` : ''}</small>`;
  };
  // the O-ring page's nozzle seal, as the drawing gives each dimension
  const SEAL: StackRow[] = [
    { name: 'O-ring section', on: true, dir: 1, format: 'limits', max: 5.46, min: 5.2, nom: 5.33, locked: true },
    { name: 'Case bore ⌀ (H8)', on: true, dir: -1, format: 'limits', max: 150.063, min: 150, nom: 150 },
    { name: 'Plug pilot ⌀', on: true, dir: 1, sens: 0.5, format: 'limits', max: 149.9, min: 149.86, nom: 149.88 },
    { name: 'Groove root ⌀', on: true, dir: 1, sens: 0.5, format: 'limits', max: 141.55, min: 141.45, nom: 141.5 },
    { name: 'Root runout to pilot', on: true, dir: -1, format: 'gdt', gdt: 'runout', zone: 0.05, nom: 0 },
  ];

  document.querySelectorAll<HTMLElement>('[data-stcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const fig = root.querySelector<HTMLElement>('[data-fig]')!, table = root.querySelector<HTMLElement>('[data-table]')!;
    const box = root.querySelector<HTMLElement>('[data-rows]')!;
    const MATS: { label: string; items: Mat[] }[] = JSON.parse(root.querySelector('[data-mats]')!.textContent!);
    const OPTS = JSON.parse(root.querySelector('[data-opts]')!.textContent!) as { formats: { key: TolFormat; name: string }[]; gdt: { key: GdtKey; name: string; mmc: boolean }[] };
    const alphaOf = (k: string) => MATS.flatMap((g) => g.items).find((m) => m.key === k)?.alpha;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const halo = { stroke: 'var(--rd-panel)', 'stroke-width': 4, 'paint-order': 'stroke', 'stroke-linejoin': 'round' };
    const criterion = (name: string, what: string) => `<small>Enter your programme's ${name} to ${what}. It comes from your governing requirement, not from this site. Or press “Load worked example”.</small>`;
    let mode = 'lin';
    let draw: (() => void) | null = null;
    let rows: StackRow[] = SEAL.map((r) => ({ ...r }));

    // ---- the row editor ----
    const sel = (k: string, opts: [string, string][], v: string, label: string, cls = '') =>
      `<select data-k="${k}" aria-label="${label}"${cls ? ` class="${cls}"` : ''}>${opts.map(([a, b]) => `<option value="${a}"${a === v ? ' selected' : ''}>${esc(b)}</option>`).join('')}</select>`;
    const inp = (k: string, v: number | undefined, label: string, ph = '', cls = '') =>
      `<input type="number" step="any" data-k="${k}" value="${Number.isFinite(v) ? g4(v as number) : ''}" placeholder="${ph}" aria-label="${label}"${cls ? ` class="${cls}"` : ''} />`;
    const matSel = (v: string | undefined) =>
      `<select data-k="mat" class="sk-mat" aria-label="Material for thermal growth"><option value="">no material</option>${MATS.map((g) => `<optgroup label="${esc(g.label)}">${g.items.map((m) => `<option value="${m.key}"${m.key === v ? ' selected' : ''}>${esc(m.name)}</option>`).join('')}</optgroup>`).join('')}</select>`;
    function fieldsFor(r: StackRow) {
      switch (r.format) {
        case 'uneq': return inp('nom', r.nom, 'Nominal', 'nominal') + inp('plus', r.plus, 'Plus tolerance', '+a') + inp('minus', r.minus, 'Minus tolerance', '−b');
        case 'limits': return inp('max', r.max, 'Upper limit', 'max') + inp('min', r.min, 'Lower limit', 'min');
        case 'gdt': {
          const g = OPTS.gdt.find((x) => x.key === r.gdt) ?? OPTS.gdt[0];
          return sel('gdt', OPTS.gdt.map((x) => [x.key, x.name]), g.key, 'Geometric control') + inp('zone', r.zone, 'Tolerance zone', 'zone') + (g.mmc ? inp('bonus', r.bonus, 'MMC bonus', 'bonus') : '') + inp('nom', r.nom, 'Basic position in the loop', 'basic');
        }
        default: return inp('nom', r.nom, 'Nominal', 'nominal') + `<span class="sk-pm">${r.format === 'uniPlus' ? '+' : r.format === 'uniMin' ? '−' : '±'}</span>` + inp('tol', r.tol, 'Tolerance', 't');
      }
    }
    function conv(r: StackRow) {
      const l = rowLimits(r);
      return `→ <b>${g4(l.mean)} ± ${g4(l.half)}</b> × ${r.dir < 0 ? '−' : '+'}${g4(r.sens ?? 1)}${l.note ? ` · <span class="${Math.abs(l.shift) > 1e-12 ? 'w' : ''}">${esc(l.note)}</span>` : ''}`;
    }
    function rowHtml(r: StackRow, i: number) {
      return `<div class="sk-row${r.on === false ? ' off' : ''}" data-i="${i}">
        <div class="sk-l"><input type="checkbox" data-k="on"${r.on !== false ? ' checked' : ''} aria-label="Include this row" />
          <input type="text" data-k="name" value="${esc(r.name)}" aria-label="Name" />
          ${sel('dir', [['1', '+'], ['-1', '−']], String(r.dir), 'Direction in the loop', 'sk-narrow')}
          <button type="button" class="chip sk-ibtn" data-act="up" aria-label="Move up">↑</button><button type="button" class="chip sk-ibtn" data-act="down" aria-label="Move down">↓</button><button type="button" class="chip sk-ibtn" data-act="del" aria-label="Remove row">×</button></div>
        <div class="sk-l">${sel('format', OPTS.formats.map((x) => [x.key, x.name]), r.format, 'Tolerance format')}${fieldsFor(r)}</div>
        <div class="sk-l"><label>×${inp('sens', r.sens ?? 1, 'Sensitivity', '1', 'sk-narrow')}</label>
          ${sel('dist', [['normal', 'normal'], ['uniform', 'uniform']], r.dist ?? 'normal', 'Distribution')}
          <input type="text" data-k="group" class="sk-grp" value="${esc(r.group ?? '')}" placeholder="group" aria-label="Correlation group" />
          <label><input type="checkbox" data-k="locked"${r.locked ? ' checked' : ''} /> fixed</label>${matSel(r.mat)}</div>
        <div class="sk-conv" data-conv>${conv(r)}</div></div>`;
    }
    const render = () => { box.innerHTML = rows.map(rowHtml).join('') || '<p class="hint">No rows. Add a row, or load the seal example.</p>'; };
    const rowOf = (e: Element) => e.closest<HTMLElement>('[data-i]');
    function readField(e: HTMLInputElement | HTMLSelectElement) {
      const host = rowOf(e); if (!host) return false;
      const r = rows[+host.dataset.i!], k = e.dataset.k!;
      if (e instanceof HTMLInputElement && e.type === 'checkbox') (r as any)[k] = e.checked;
      else if (k === 'name' || k === 'group' || k === 'mat' || k === 'gdt' || k === 'dist') (r as any)[k] = e.value;
      else if (k === 'dir') r.dir = e.value === '-1' ? -1 : 1;
      else if (k === 'format') {
        const l = rowLimits(r), nf = e.value as TolFormat;
        Object.assign(r, nf === 'limits' ? { max: l.hi, min: l.lo } : nf === 'eq' ? { nom: l.mean, tol: l.half } : nf === 'uneq' ? { nom: l.mean, plus: l.half, minus: l.half } : nf === 'gdt' ? { zone: 2 * l.half, nom: l.mean, gdt: r.gdt ?? 'pos' } : { nom: nf === 'uniPlus' ? l.lo : l.hi, tol: 2 * l.half });
        r.format = nf;
        return true; // structure changed
      } else (r as any)[k] = e.value.trim() === '' ? undefined : +e.value;
      host.classList.toggle('off', r.on === false);
      const c = host.querySelector('[data-conv]'); if (c) c.innerHTML = conv(r);
      return k === 'gdt';
    }
    box.addEventListener('input', (ev) => { const t = ev.target as HTMLInputElement; if (t.dataset.k && t.type !== 'checkbox' && t.tagName !== 'SELECT') readField(t); });
    box.addEventListener('change', (ev) => { const t = ev.target as HTMLInputElement; if (t.dataset.k && readField(t)) render(); });
    root.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-act]'); if (!b || !root.contains(b)) return;
      const act = b.dataset.act!, host = rowOf(b), i = host ? +host.dataset.i! : -1;
      if (act === 'add') rows.push({ name: `Row ${rows.length + 1}`, on: true, dir: 1, format: 'eq', nom: 10, tol: 0.05 });
      else if (act === 'seal') rows = SEAL.map((r) => ({ ...r }));
      else if (act === 'clear') rows = [];
      else if (act === 'del') rows.splice(i, 1);
      else if (act === 'up' && i > 0) [rows[i - 1], rows[i]] = [rows[i], rows[i - 1]];
      else if (act === 'down' && i >= 0 && i < rows.length - 1) [rows[i + 1], rows[i]] = [rows[i], rows[i + 1]];
      else if (act === 'import') {
        const p = rowsFromText(field('l_text').value);
        if (p.rows.length) rows = p.rows;
        if (p.bad.length) window.setTimeout(() => { root.querySelector('[data-notes]')!.insertAdjacentHTML('afterbegin', `<li class="bad">Not read: ${p.bad.map((x) => `“${esc(x)}”`).join(', ')}.</li>`); }, 0);
      } else if (act === 'apply') { applyAllocation(); }
      else return;
      render(); run();
    });
    root.querySelector('.sk-text')!.addEventListener('toggle', () => { field('l_text').value = rowsToText(rows); });

    // ---- chart helpers ----
    const nice = (span: number) => { const m = 10 ** Math.floor(Math.log10(span / 5)); return [1, 2, 2.5, 5, 10].map((x) => x * m).find((x) => span / x <= 6)!; };
    const width = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    function frame(o: { x0: number; x1: number; y0: number; y1: number; xl: string; yl: string }) {
      svg.replaceChildren();
      const W = width(), H = 250, L = 64, R = 20, T = 30, B = 40;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const X = (v: number) => L + ((v - o.x0) / (o.x1 - o.x0)) * (W - L - R), Y = (v: number) => T + ((o.y1 - v) / (o.y1 - o.y0)) * (H - T - B);
      let sx = nice(o.x1 - o.x0);
      while ((o.x1 - o.x0) / sx > (W - L - R) / 46) sx *= 2;
      const sy = nice(o.y1 - o.y0), dp = (s: number) => (s >= 1 ? 0 : s >= 0.1 ? 1 : s >= 0.01 ? 2 : 3);
      const z = (v: number) => (Math.abs(v) < 1e-12 ? 0 : v), xFirst = Math.ceil(o.x0 / sx - 1e-9) * sx;
      for (let v = xFirst; v <= o.x1 + 1e-9; v += sx) {
        el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: 'var(--rd-line)' });
        el('text', { x: X(v), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sx)));
      }
      for (let v = Math.ceil(o.y0 / sy - 1e-9) * sy; v <= o.y1 + 1e-9; v += sy) {
        if (Math.abs(v - o.y0) < 1e-9 && Math.abs(xFirst - o.x0) < 1e-9) continue;
        el('text', { x: L - 6, y: Y(v) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sy)));
      }
      el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, o.xl);
      el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, o.yl);
      return { X, Y, W, H, L, R, T, B };
    }
    const legend = (items: [string, string, string?][]) => {
      let x = 8;
      for (const [name, color, dash] of items) {
        el('line', { x1: x, x2: x + 18, y1: 13, y2: 13, stroke: color, 'stroke-width': 2.2, ...(dash ? { 'stroke-dasharray': dash } : {}) });
        el('text', { x: x + 23, y: 17, 'font-size': 12, fill: 'var(--rd-ink)' }, name);
        x += 37 + name.length * 7.2;
      }
    };
    const bars = (items: [string, number, number][], xl: string) => {
      svg.replaceChildren();
      const W = width(), H = 250, Lx = 112, R = 16, T = 28, B = 34, n = Math.max(1, items.length);
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const X = (v: number) => Lx + Math.min(1, v) * (W - Lx - R), row = (H - T - B) / n;
      for (const v of [0, 0.25, 0.5, 0.75, 1]) {
        el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: v === 0.5 ? 'var(--rd-warn)' : 'var(--rd-line)', 'stroke-dasharray': v === 0.5 ? '4 3' : '' });
        el('text', { x: X(v), y: H - B + 14, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, `${v * 100}%`);
      }
      items.forEach(([name, a, b], i) => {
        const y = T + i * row, h = Math.min(12, row * 0.36);
        el('rect', { x: Lx, y: y + row / 2 - h - 1, width: Math.max(1, X(a) - Lx), height: h, fill: 'var(--rd-accent)', 'fill-opacity': 0.85 });
        el('rect', { x: Lx, y: y + row / 2 + 1, width: Math.max(1, X(b) - Lx), height: h, fill: 'var(--rd-steel)', 'fill-opacity': 0.8 });
        el('text', { x: Lx - 6, y: y + row / 2 + 4, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--rd-ink)' }, name.length > 14 ? `${name.slice(0, 13)}…` : name);
      });
      el('rect', { x: 8, y: 8, width: 12, height: 8, fill: 'var(--rd-accent)' }); el('text', { x: 24, y: 16, 'font-size': 11, fill: 'var(--rd-ink)' }, 'variance');
      el('rect', { x: 100, y: 8, width: 12, height: 8, fill: 'var(--rd-steel)' }); el('text', { x: 116, y: 16, 'font-size': 11, fill: 'var(--rd-ink)' }, 'worst case');
      el('text', { x: (Lx + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, xl);
    };

    // ---- the linear stack ----
    function stackState() {
      const cs = toContributors(rows);
      const cpkIn = num('l_cpk'), hasCpk = cpkIn > 0, cpk = hasCpk ? cpkIn : 1;
      return { cs, cpk, hasCpk, st: cs.length ? groupedStack(cs, cpk) : null };
    }
    function runLin(out: Row[], notes: [string, string][]) {
      (root.querySelector('[data-thermal]') as HTMLElement).hidden = !(field('l_th') as HTMLInputElement).checked;
      const { cs, cpk, hasCpk, st } = stackState();
      if (!st) { notes.push(['bad', 'Add at least one row in the loop.']); return null; }
      const lsl = Number.isFinite(num('l_lsl')) ? num('l_lsl') : undefined, usl = Number.isFinite(num('l_usl')) ? num('l_usl') : undefined;
      const hasLim = lsl !== undefined || usl !== undefined, N = +field('l_n').value || 100000;
      const mc = groupedMonteCarlo(cs, { n: N, seed: 1, cpk });
      const inside = (a: number, b: number) => (lsl === undefined || a >= lsl - 1e-12) && (usl === undefined || b <= usl + 1e-12);
      const verdict = (a: number, b: number) => (hasLim ? (inside(a, b) ? 'ok' : 'bad') : '');
      const uniform = cs.some((c) => c.dist === 'uniform');
      out.push({ dt: 'Nominal', dd: `${f(st.nominal)} <small>every part at the middle of its limits</small>`, primary: true });
      out.push({ dt: 'Worst case', dd: `${f(st.wcMin)} to ${f(st.wcMax)} <small>± ${f(st.wc)}: every part at its worst limit at once</small>`, cls: verdict(st.wcMin, st.wcMax) });
      out.push({ dt: 'RSS', dd: `${f(st.rssMin)} to ${f(st.rssMax)} <small>± ${f(st.rss)} = √Σ(s·t)²${st.groups.length ? `, groups ${st.groups.map(esc).join(', ')} worst case inside` : ''}: each part normal, centred, its tolerance ±3σ</small>`, cls: verdict(st.rssMin, st.rssMax) });
      out.push({ dt: 'Bender (1.5 × RSS)', dd: `${f(st.nominal - st.bender)} to ${f(st.nominal + st.bender)} <small>an allowance for parts that are not centred, when you have no process data</small>`, cls: verdict(st.nominal - st.bender, st.nominal + st.bender) });
      if (hasCpk || uniform) {
        const c = capability(st.nominal, st.sigma, lsl, usl);
        out.push({ dt: hasCpk ? `Parts at Cpk ${f(cpk, 2)}` : 'With the uniform parts', dd: `${f(st.cpkMin)} to ${f(st.cpkMax)} <small>±3σ, σ = ${f(st.sigma, 4)}${hasLim ? ` · assembly Cpk ${f(c.cpk, 2)}, ${pct(c.below + c.above)} predicted outside` : ''}</small>`, cls: verdict(st.cpkMin, st.cpkMax) });
      } else out.push({ dt: 'Cpk-based', dd: '<small>Enter the parts’ process Cpk (from your suppliers’ measured process data, not from this site) to base the statistics on it. Or press “Load worked example”.</small>' });
      const outside = (lsl === undefined ? 0 : mc.below(lsl)) + (usl === undefined ? 0 : mc.above(usl));
      out.push({ dt: 'Monte Carlo', dd: `${f(mc.quantile(0.00135))} to ${f(mc.quantile(0.99865))} <small>middle 99.73% of ${N.toLocaleString('en-GB')} assemblies${hasCpk ? '' : ', normal parts at Cpk 1'}${hasLim ? (outside > 0 ? ` · ${pct(outside)} outside the limits (${Math.round(outside * N).toLocaleString('en-GB')})` : ' · none outside the limits') : ''}</small>`, cls: hasLim ? (outside > 0 ? 'warn' : 'ok') : '' });
      if (!hasLim) out.push({ dt: 'Requirement', dd: criterion('limit on the result', 'check each method against it') });

      // thermal growth at the two extremes
      if ((field('l_th') as HTMLInputElement).checked) {
        const t0 = num('l_t0'), withMat = rows.filter((r) => r.on !== false && r.mat).length;
        for (const [lbl, T] of [['Coldest', num('l_tc')], ['Hottest', num('l_th2')]] as const) {
          if (!Number.isFinite(T) || !Number.isFinite(t0)) continue;
          const th = thermalShift(rows, alphaOf, T - t0), a = st.wcMin + th.total, b = st.wcMax + th.total;
          out.push({ dt: `${lbl}, ${f(T, 0)} °C`, dd: `${th.total >= 0 ? '+' : ''}${f(th.total, 4)} <small>thermal shift of the result · worst case ${f(a)} to ${f(b)}${withMat ? '' : ' · select a material on the rows'}</small>`, cls: verdict(a, b) });
        }
        if (!withMat) notes.push(['warn', 'No row has a material. Select one on each row whose length changes with temperature; rows without a material do not grow.']);
        notes.push(['', 'Thermal growth moves the result; it is not a tolerance. Each row grows by L·α·ΔT from the assembly temperature, with α from the material library.']);
      }

      // contribution table
      const order = st.rows.map((r, i) => ({ ...r, c: cs[i] })).sort((a, b) => b.varShare - a.varShare);
      table.innerHTML = `<table><thead><tr><th>Row</th><th>±</th><th>× s</th><th>Worst case</th><th>Variance</th></tr></thead><tbody>${order.map((r, i) =>
        `<tr><td>${esc(r.name)}${r.c.group ? ` <small>(${esc(r.c.group)})</small>` : ''}${r.c.dist === 'uniform' ? ' <small>u</small>' : ''}</td><td>${f(r.half, 4)}</td><td>${g4(r.c.sens)}</td><td>${f(100 * r.wcShare, 0)}%</td><td class="${i === 0 && r.varShare > 0.5 ? 'hi' : ''}">${f(100 * r.varShare, 0)}%</td></tr>`).join('')}</tbody></table>`;
      out.push({ dt: 'Largest shares of the variance', dd: shares(order.map((r): [string, number] => [r.name, r.varShare])) });

      if (order[0].varShare > 0.5) notes.push(['warn', `${esc(order[0].name)} is ${f(100 * order[0].varShare, 0)}% of the variance (${f(100 * order[0].wcShare, 0)}% of the worst case). Tightening anything else barely moves the result.`]);
      if (hasLim && inside(st.wcMin, st.wcMax)) notes.push(['ok', 'The worst case meets the limit: every assembly of in-tolerance parts does, whatever the distributions. No statistics needed.']);
      else if (hasLim && inside(st.rssMin, st.rssMax)) notes.push(['warn', 'The worst case fails and the statistics pass. Accepting that is a decision, not a calculation: it needs process data showing the parts are centred, independent and as capable as assumed (and a failure that is tolerable at the predicted rate, or that inspection will catch).']);
      else if (hasLim) notes.push(['bad', 'Even the statistical stack misses the limit: change the design or the tolerances that dominate. The Allocate tab shows the tolerances that would meet it.']);
      if (rows.some((r) => r.on !== false && r.format === 'gdt' && r.gdt === 'pos')) notes.push(['', 'A diametral position zone ⌀t acts by its radius, ±t/2, in one direction. Using ±t doubles its effect. At MMC, add the bonus that the feature can have: up to its size tolerance.']);
      if (uniform) notes.push(['', 'Uniform parts (tool wear, an uncontrolled feature, a lot whose mean can sit anywhere) have a σ 1.7 times the normal one, and widen the statistical result.']);
      if (!st.groups.length) notes.push(['', 'RSS and Monte Carlo assume independent parts. Features made in the same setup, by the same tool or from the same batch change together: give them a group letter.']);

      return () => {
        if (field('l_chart').value === 'share') { bars(order.map((r) => [r.name, r.varShare, r.wcShare]), 'share of the variance and of the worst case'); return; }
        let x0 = Math.min(st.wcMin, mc.min), x1 = Math.max(st.wcMax, mc.max);
        if (lsl !== undefined) x0 = Math.min(x0, lsl); if (usl !== undefined) x1 = Math.max(x1, usl);
        const pad = 0.06 * (x1 - x0 || 1); x0 -= pad; x1 += pad;
        const nb = 44, bw = (x1 - x0) / nb, bins = new Array(nb).fill(0);
        for (const v of mc.sorted) bins[Math.min(nb - 1, Math.max(0, Math.floor((v - x0) / bw)))]++;
        const top = (100 * Math.max(...bins)) / N;
        const c = frame({ x0, x1, y0: 0, y1: top * 1.18, xl: 'stack result', yl: 'assemblies per bin (%)' });
        bins.forEach((b, i) => { if (b) el('rect', { x: c.X(x0 + i * bw) + 0.5, y: c.Y((100 * b) / N), width: Math.max(1, c.X(x0 + bw) - c.X(x0) - 1), height: c.Y(0) - c.Y((100 * b) / N), fill: 'var(--rd-steel)', 'fill-opacity': 0.55 }); });
        const vline = (v: number, color: string, dash = '') => el('line', { x1: c.X(v), x2: c.X(v), y1: c.T, y2: c.H - c.B, stroke: color, 'stroke-width': 2, ...(dash ? { 'stroke-dasharray': dash } : {}) });
        vline(st.wcMin, 'var(--rd-muted)', '5 4'); vline(st.wcMax, 'var(--rd-muted)', '5 4');
        vline(st.rssMin, 'var(--rd-blue)'); vline(st.rssMax, 'var(--rd-blue)');
        if (lsl !== undefined) vline(lsl, 'var(--rd-accent)'); if (usl !== undefined) vline(usl, 'var(--rd-accent)');
        legend([['worst case', 'var(--rd-muted)', '5 4'], ['RSS', 'var(--rd-blue)'], ...(hasLim ? [['limit', 'var(--rd-accent)'] as [string, string]] : [])]);
      };
    }

    // ---- allocation ----
    let lastAlloc: ReturnType<typeof allocate> | null = null;
    function allocInputs() {
      const { cs, st } = stackState();
      if (!st) return null;
      let target = num('a_t'), src = 'your target';
      if (!(target > 0)) {
        const lsl = num('l_lsl'), usl = num('l_usl'), d = [Number.isFinite(lsl) ? st.nominal - lsl : Infinity, Number.isFinite(usl) ? usl - st.nominal : Infinity];
        target = Math.min(...d); src = 'the limits on the linear tab';
      }
      const active = rows.filter((r) => r.on !== false);
      const ar = active.map((r, i) => { const l = rowLimits(r); return { name: r.name, sens: cs[i].sens, half: l.half, mean: l.mean, locked: r.locked, gdt: r.format === 'gdt', unsized: r.format === 'gdt' }; });
      return { st, target, src, ar, active };
    }
    function runAlloc(out: Row[], notes: [string, string][]) {
      const a = allocInputs();
      if (!a) { notes.push(['bad', 'Add rows on the linear tab first.']); table.innerHTML = ''; return null; }
      if (!(a.target > 0) || !Number.isFinite(a.target)) { out.push({ dt: 'Target', dd: criterion('target on the result', 'share it among the rows') }); table.innerHTML = ''; lastAlloc = null; return null; }
      const basis = field('a_b').value as 'wc' | 'rss', method = field('a_m').value as AllocMethod;
      const r = allocate(a.ar, a.target, basis, method);
      lastAlloc = r;
      const now = basis === 'wc' ? a.st.wc : a.st.rss;
      out.push({ dt: 'Target', dd: `± ${f(a.target, 4)} <small>from ${a.src} · ${basis === 'wc' ? 'worst case' : 'RSS'} now ± ${f(now, 4)}</small>`, primary: true, cls: now <= a.target + 1e-12 ? 'ok' : 'bad' });
      if (!r.ok) { notes.push(['bad', `The fixed rows alone use ± ${f(r.used, 4)}, which is the full target or more. Change a fixed part, or the design.`]); table.innerHTML = ''; return null; }
      out.push({ dt: method === 'scale' ? 'Scale factor' : 'Factor', dd: `${f(r.k, method === 'scale' ? 3 : 4)} <small>${method === 'scale' ? (r.k >= 1 ? 'the tolerances can open by this factor' : 'every free tolerance must close by this factor') : 'applied to the weight of each row'} · fixed rows use ± ${f(r.used, 4)}</small>`, cls: method === 'scale' ? (r.k >= 1 ? 'ok' : 'warn') : '' });
      table.innerHTML = `<table><thead><tr><th>Row</th><th>Now ±</th><th>New ±</th><th>Change</th><th>Grade</th></tr></thead><tbody>${r.rows.map((x, i) => {
        const it = x.locked || a.ar[i].gdt ? undefined : itGrade(x.mean, 2 * x.newHalf, itValue);
        return `<tr><td>${esc(x.name)}${x.locked ? ' <small>fixed</small>' : ''}</td><td>${f(x.half, 4)}</td><td>${f(x.newHalf, 4)}</td><td class="${!x.locked && x.newHalf < x.half ? 'hi' : ''}">${x.locked ? '—' : `×${f(x.newHalf / x.half, 2)}`}</td><td>${it ? `IT${it}` : '—'}</td></tr>`;
      }).join('')}</tbody></table>`;
      notes.push(['', 'Grade: the coarsest ISO 286 grade whose width fits inside the new tolerance at the size of the row. It shows how hard each tolerance is to make: IT6 and finer needs grinding or honing, IT7–IT8 fine turning or boring, IT9–IT11 normal machining.']);
      if (method === 'size') notes.push(['', 'By size gives each row the same IT grade, so each process works equally hard. It is usually the most economic first allocation.']);
      if (method === 'equal') notes.push(['', 'Equal effect gives a ½-sensitivity diameter twice the tolerance of a length. It suits rows made by similar processes.']);
      notes.push(['', '“Apply to the rows” writes the new tolerances back to the linear tab, about the present mean of each row. Check the result there.']);
      return () => bars(r.rows.map((x) => [x.name, Math.min(1, x.newHalf / Math.max(...r.rows.map((y) => Math.max(y.half, y.newHalf)))), Math.min(1, x.half / Math.max(...r.rows.map((y) => Math.max(y.half, y.newHalf))))]), 'new (red) and present (grey) tolerance, relative');
    }
    function applyAllocation() {
      const a = allocInputs();
      if (!a || !lastAlloc || !lastAlloc.ok) return;
      a.active.forEach((r, i) => {
        const x = lastAlloc!.rows[i];
        if (!x || x.locked || !Number.isFinite(x.newHalf)) return;
        const l = rowLimits(r);
        if (r.format === 'gdt') { r.zone = 2 * x.newHalf; r.bonus = 0; }
        else if (r.format === 'eq') { r.nom = l.mean; r.tol = x.newHalf; }
        else { r.format = 'limits'; r.max = l.mean + x.newHalf; r.min = l.mean - x.newHalf; }
      });
      select('lin');
    }

    // ---- radial stack ----
    function runRad(out: Row[], notes: [string, string][]) {
      const lever = num('r_lever'), F = num('r_force'), pIn = num('r_p'), lim = num('r_lim');
      const p = parseOffsets(field('r_rows').value, lever);
      if (p.bad.length) notes.push(['bad', `Not read: ${p.bad.map((b) => `“${esc(b)}”`).join(', ')}. Use “name, offset, zone|shift|fixed”; a tilt “t/l” needs the lever arm.`]);
      if (!p.rows.length) { notes.push(['bad', 'Enter at least one offset as “name, offset, kind”.']); return null; }
      const N = 100000, s = radialStack(p.rows, { n: N, seed: 1 }), q = s.mc.quantile;
      const hasP = pIn > 0 && pIn < 100, hasL = lim > 0, qp = hasP ? q(pIn / 100) : NaN;
      const extra = (d: number) => [F > 0 ? `${f(F * d, 1)} N·m at ${f(F, 1)} kN` : '', lever > 0 ? `${f((Math.atan(d / lever) * 180) / Math.PI, 3)}° over ${f(lever, 0)} mm` : ''].filter(Boolean).join(' · ');
      const vs = (d: number) => (hasL ? (d <= lim ? 'ok' : 'bad') : '');
      out.push({ dt: 'Worst case', dd: `${f(s.wc)} mm <small>every offset in line · ${extra(s.wc)}</small>`, cls: vs(s.wc) });
      out.push({ dt: 'RSS of the radii', dd: `${f(s.rssRadii)} mm <small>exceeded by ${pct(s.mc.above(s.rssRadii))} of assemblies, not a bound for vectors</small>`, cls: 'warn' });
      out.push({ dt: 'Monte Carlo median', dd: `${f(q(0.5))} mm <small>half of ${N.toLocaleString('en-GB')} assemblies are better · largest seen ${f(s.mc.max)} mm</small>` });
      if (hasP) out.push({ dt: `Covering ${f(pIn, pIn % 1 ? 2 : 0)}%`, dd: `${f(qp)} mm <small>${extra(qp)}</small>`, cls: vs(qp), primary: true });
      else out.push({ dt: 'Coverage', dd: criterion('fraction of assemblies to cover', 'read the offset they stay within') });
      if (hasL) out.push({ dt: `Over ${f(lim)} mm`, dd: `${pct(s.mc.above(lim))} of assemblies <small>${Math.round(s.mc.above(lim) * N).toLocaleString('en-GB')} of ${N.toLocaleString('en-GB')}</small>`, cls: s.mc.above(lim) > 0 ? 'warn' : 'ok' });
      else out.push({ dt: 'Requirement', dd: criterion('limit on the offset', 'check the stack against it') });
      const order = [...s.shares].sort((a, b) => b.wcShare - a.wcShare);
      out.push({ dt: 'Largest shares of the worst case', dd: shares(order.map((r): [string, number] => [r.name, r.wcShare])) });
      notes.push(['warn', `Offsets in random directions add as vectors. The RSS of the radii, ${f(s.rssRadii)} mm, treats each like a ±3σ dimension; a clearance taken up fully is nothing like that, and ${pct(s.mc.above(s.rssRadii))} of assemblies exceed it. Use the Monte Carlo.`]);
      if (p.rows.some((o) => o.kind === 'fixed')) notes.push(['', 'Fixed offsets all point the same way (to the right in the chart) and add arithmetically, like a worst case, before the random ones spread around them.']);
      if (hasL && s.wc > lim && hasP && qp <= lim) notes.push(['warn', 'The worst case exceeds the limit but the required coverage meets it. That is acceptable only where the programme accepts a statistical requirement, and is best backed by measuring the alignment of every motor.']);
      if (p.rows.some((o) => o.kind === 'shift')) notes.push(['', 'A clearance shift is frozen when the bolts are tightened. Assembling in a fixture that centres the part removes it; assembling horizontally turns it into a fixed offset downwards.']);
      return () => {
        svg.replaceChildren();
        const W = width(), H = 250, T = 30, B = 26;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const side = H - T - B, cx = W / 2, cy = T + side / 2, rmax = Math.max(s.wc, hasL ? lim : 0) * 1.05 || 1, k = side / 2 / rmax;
        el('path', { d: `M${cx - side / 2},${cy} L${cx + side / 2},${cy} M${cx},${T} L${cx},${T + side}`, stroke: 'var(--rd-line)' });
        const { xs, ys } = s.points;
        for (let i = 0; i < xs.length; i++) el('circle', { cx: cx + k * xs[i], cy: cy + k * ys[i], r: 1.3, fill: 'var(--rd-steel)', 'fill-opacity': 0.6 });
        const ring = (r: number, color: string, dash = '', w = 2) => el('circle', { cx, cy, r: k * r, fill: 'none', stroke: color, 'stroke-width': w, ...(dash ? { 'stroke-dasharray': dash } : {}) });
        ring(s.wc, 'var(--rd-muted)', '5 4'); ring(s.rssRadii, 'var(--rd-blue)', '2 3');
        if (hasP) ring(qp, 'var(--rd-ink)');
        if (hasL) ring(lim, 'var(--rd-accent)');
        el('text', { x: cx + k * s.wc * 0.7071 + 4, y: cy - k * s.wc * 0.7071 - 2, 'font-size': 12, fill: 'var(--rd-muted)', ...halo }, `${f(s.wc, 2)}`);
        legend([['worst', 'var(--rd-muted)', '5 4'], ['RSS radii', 'var(--rd-blue)', '2 3'], ...(hasP ? [['coverage', 'var(--rd-ink)'] as [string, string]] : []), ...(hasL ? [['limit', 'var(--rd-accent)'] as [string, string]] : [])]);
        el('text', { x: W / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, `${xs.length.toLocaleString('en-GB')} of the simulated assemblies, offsets in mm`);
      };
    }

    // ---- fasteners ----
    function runFast(out: Row[], notes: [string, string][]) {
      const kind = field('f_case').value, H = num('f_h'), F = num('f_f'), t1 = num('f_t1'), t2 = num('f_t2'), P = num('f_p'), D = num('f_d');
      root.querySelectorAll<HTMLElement>('[data-fx]').forEach((e) => (e.hidden = kind === 'float'));
      root.querySelectorAll<HTMLElement>('[data-np]').forEach((e) => (e.hidden = kind !== 'noproj'));
      table.innerHTML = '';
      if (!(H > 0 && F > 0)) { notes.push(['bad', 'Enter the hole and the fastener sizes at MMC.']); return null; }
      if (H <= F) { out.push({ dt: 'Clearance', dd: 'none <small>the hole at MMC is not larger than the fastener</small>', cls: 'bad', primary: true }); return null; }
      if (kind === 'float') {
        const T = floatingTolerance(H, F);
        out.push({ dt: 'Position, each part', dd: `⌀${f(T)} at MMC <small>T = H − F, in both parts</small>`, primary: true });
        notes.push(['', 'Floating fasteners: both parts have clearance holes, so each part can use the full difference between the hole and the fastener.']);
      } else if (kind === 'fixed') {
        const T = fixedTotal(H, F), a = Number.isFinite(t1) ? Math.min(T, t1) : T / 2, b = T - a;
        out.push({ dt: 'Total, both parts', dd: `⌀${f(T)} <small>T₁ + T₂ = H − F</small>`, primary: true });
        out.push({ dt: 'Clearance holes T₁', dd: `⌀${f(a)} at MMC <small>${Number.isFinite(t1) ? 'your value' : 'half of the total'}</small>` });
        out.push({ dt: 'Threaded holes T₂', dd: `⌀${f(b)} at MMC, projected <small>the zone projects over the thickness of the clamped part</small>`, cls: b > 0 ? 'ok' : 'bad' });
        notes.push(['', 'Fixed fasteners: one part holds the fastener, so the two parts share the clearance. Give the threaded holes a projected tolerance zone (Ⓟ) equal to the maximum thickness of the clamped part.']);
      } else {
        if (!(P > 0 && D > 0 && t2 >= 0)) { notes.push(['bad', 'Enter T₂, the projection P and the engagement D.']); return null; }
        const a = Number.isFinite(t1) ? t1 : fixedTotal(H, F) - t2, Hneed = holeWithoutProjection(F, a, t2, P, D);
        out.push({ dt: 'Clearance hole needed', dd: `⌀${f(Hneed)} at MMC <small>H = F + T₁ + T₂(1 + 2P/D), with T₁ ${f(a)}</small>`, primary: true, cls: Hneed <= H + 1e-9 ? 'ok' : 'bad' });
        out.push({ dt: 'Your hole', dd: `⌀${f(H)} <small>${Hneed <= H + 1e-9 ? 'large enough' : `${f(Hneed - H)} too small: use a projected zone, or a larger hole`}</small>`, cls: Hneed <= H + 1e-9 ? 'ok' : 'bad' });
        notes.push(['warn', 'Without a projected zone, a perpendicularity error of the threaded hole tilts the fastener, and the tilt grows over the height of the clamped part. Specify Ⓟ on the threaded holes instead.']);
      }
      return null;
    }

    const RUN: Record<string, typeof runLin> = { lin: runLin, alloc: runAlloc, rad: runRad, fast: runFast };
    const CAPS: Record<string, string> = {
      lin: 'The Monte Carlo result as a histogram, with the worst-case and RSS bands and the limits once entered. Or each row’s share of the variance and of the worst case.',
      alloc: 'The new tolerance of each row against its present tolerance, relative to the largest.',
      rad: 'Where the axis lands in simulated assemblies, with the worst case, the RSS of the radii and (once entered) the coverage and the limit.',
      fast: '',
    };

    function run() {
      const out: Row[] = [], notes: [string, string][] = [];
      if (mode !== 'lin' && mode !== 'alloc') table.innerHTML = '';
      draw = RUN[mode](out, notes);
      root.querySelector('[data-out]')!.innerHTML = out.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      fig.hidden = !draw;
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    function select(key: string, focus = false) {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    }
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    wireWorkedExample({
      root, onLoad: () => { rows = SEAL.map((r) => ({ ...r })); render(); run(); }, factorFields: ['l_cpk', 'l_lsl', 'r_p', 'r_lim'],
      note: 'Worked-example values loaded: parts at Cpk 1.33, squeeze at least 0.74 mm, 99.73% of motors within 0.45 mm',
      values: { l_cpk: '1.33', l_lsl: '0.74', r_p: '99.73', r_lim: '0.45' },
    });
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 200); });
    form.addEventListener('change', run);
    render();
    run();
  });
</script>
