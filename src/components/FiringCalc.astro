---
// Static firing: reduce a pressure and thrust trace (pasted, or the synthetic firing of the 300 mm motor), the dynamics
// of the thrust stand, and the uncertainty of the results. Calculations live in src/lib/firing.ts (unit-tested); this
// file is UI only.
---

<div class="calc frcalc" data-frcalc>
  <div class="calc-head">
    <span>Static firing: data reduction, stand and uncertainty</span>
    <span class="head-btns">
      <button type="button" class="chip" data-load-example>Load the synthetic firing</button>
      <button type="button" class="chip" data-share>Copy link to these inputs</button>
    </span>
  </div>
  <div class="hc-tabs" role="tablist" aria-label="Tool">
    <button type="button" role="tab" class="chip" data-tab="reduce" aria-selected="true">Reduce a firing</button>
    <button type="button" role="tab" class="chip" data-tab="stand" aria-selected="false">Thrust stand</button>
    <button type="button" role="tab" class="chip" data-tab="unc" aria-selected="false">Uncertainty</button>
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="reduce">
        <legend>Trace</legend>
        <label>Time (s), pressure (MPa), thrust (kN): one sample on each line
          <textarea name="trace" rows="7" spellcheck="false" autocomplete="off"></textarea>
        </label>
        <p class="hint" data-traceinfo></p>
      </fieldset>
      <fieldset data-panel="reduce">
        <legend>Motor</legend>
        <div class="row2">
          <label>Propellant mass (kg)<input name="mp" type="number" min="0.001" step="any" value="115.2" /></label>
          <label>Web (mm)<input name="web" type="number" min="0" step="any" value="100" /></label>
          <label>Throat ⌀ before (mm)<input name="d0" type="number" min="0.1" step="any" value="45.65" /></label>
          <label>Throat ⌀ after (mm)<input name="d1" type="number" min="0.1" step="any" value="47.88" /></label>
          <label>Exit ⌀ (mm)<input name="de" type="number" min="0" step="any" value="129.1" /></label>
          <label>γ<input name="g" type="number" min="1.05" max="1.67" step="0.01" value="1.2" /></label>
          <label>Ambient (MPa)<input name="pa" type="number" min="0" step="any" value="0.101325" /></label>
          <label>Cone half-angle (°)<input name="th" type="number" min="0" max="30" step="any" value="15" /></label>
        </div>
        <p class="hint">The propellant mass is what burned: weigh the motor before and after, and remove the mass of the insulation and nozzle material that was lost. The exit diameter, γ and the ambient pressure are only for the ideal C<sub>F</sub>.</p>
      </fieldset>
      <fieldset data-panel="stand" hidden>
        <legend>Stand and motor</legend>
        <div class="row2">
          <label>Motor mass at ignition (kg)<input name="m0" type="number" min="0.1" step="any" value="141.8" /></label>
          <label>Motor mass at burnout (kg)<input name="m1" type="number" min="0.1" step="any" value="26.6" /></label>
          <label>Moving mount mass (kg)<input name="mm" type="number" min="0" step="any" value="20" /></label>
          <label>Load cell stiffness (kN/mm)<input name="kc" type="number" min="0.1" step="any" value="500" /></label>
          <label>Structure stiffness (kN/mm)<input name="ks" type="number" min="0.1" step="any" value="300" /></label>
          <label>Ignition rise time (ms)<input name="tr" type="number" min="0" step="any" value="120" /></label>
          <label>Peak thrust (kN)<input name="fp" type="number" min="0.1" step="any" value="22" /></label>
          <label>Sample rate (Hz)<input name="fs" type="number" min="1" step="any" value="5000" /></label>
        </div>
        <label>Orientation
          <select name="or">
            <option value="h">Horizontal</option>
            <option value="up">Vertical, nozzle up (thrust down)</option>
            <option value="down">Vertical, nozzle down (thrust up)</option>
          </select>
        </label>
      </fieldset>
      <fieldset data-panel="unc" hidden>
        <legend>Measurement uncertainty (1σ)</legend>
        <div class="row2">
          <label>Thrust (% of reading)<input name="uF" type="number" min="0" step="any" value="0.5" /></label>
          <label>Pressure (% of reading)<input name="up" type="number" min="0" step="any" value="0.5" /></label>
          <label>Propellant mass (kg)<input name="um" type="number" min="0" step="any" value="0.1" /></label>
          <label>Throat ⌀ measurement (mm)<input name="ud" type="number" min="0" step="any" value="0.02" /></label>
          <label>Web (mm)<input name="uw" type="number" min="0" step="any" value="0.5" /></label>
          <label>Burn time (s)<input name="ut" type="number" min="0" step="any" value="0.05" /></label>
          <label>Erosion history (% of the area change)<input name="ue" type="number" min="0" max="100" step="any" value="10" /></label>
        </div>
        <p class="hint">Standard uncertainties of each measurement, from the calibration records. The erosion history is how far the true throat area during the burn could be from the assumed history, as a share of the change from before to after: 10% is illustrative for gradual erosion. The motor values come from the first tab.</p>
      </fieldset>
    </form>

    <div class="fr-out">
      <div data-out="reduce">
        <dl class="readouts">
          <div class="readout primary"><dt>Delivered specific impulse</dt><dd data-r="isp">—</dd></div>
          <div class="readout"><dt>Delivered c*</dt><dd data-r="cs">—</dd></div>
          <div class="readout"><dt>Delivered C<sub>F</sub></dt><dd data-r="cf">—</dd></div>
          <div class="readout"><dt>Burn rate</dt><dd data-r="rb">—</dd></div>
          <div class="readout"><dt>Action and burn time</dt><dd data-r="times">—</dd></div>
          <div class="readout"><dt>Pressure and thrust</dt><dd data-r="levels">—</dd></div>
        </dl>
        <figure class="fr-fig">
          <svg data-chart role="img" aria-label="Pressure and thrust against time, with the 10% points and the tangent-bisector construction"></svg>
          <figcaption>Pressure (red, left axis) and thrust (blue, right axis). The action time runs between the 10% points of the maximum pressure. The two dashed tangents and their bisector (dotted) find the web burnout at the knee of the pressure trace.</figcaption>
        </figure>
      </div>
      <div data-out="stand" hidden>
        <dl class="readouts">
          <div class="readout primary"><dt>Natural frequency of the thrust path</dt><dd data-r="fn">—</dd></div>
          <div class="readout" data-ring><dt>Ringing after the ignition rise</dt><dd data-r="ring">—</dd></div>
          <div class="readout" data-fsr><dt>Sample rate</dt><dd data-r="fsr">—</dd></div>
          <div class="readout"><dt>Deflection at peak thrust</dt><dd data-r="defl">—</dd></div>
          <div class="readout" data-wt><dt>Weight in the reading</dt><dd data-r="wt">—</dd></div>
        </dl>
      </div>
      <div data-out="unc" hidden>
        <div class="fr-scroll" data-utable></div>
      </div>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Data reduction as in NASA SP-8039 and Sutton: action time between the 10% points of the maximum pressure, web
    burnout by the aft tangent-bisector method (built in scaled axes), impulse over the whole thrust trace, c* and
    C<sub>F</sub> from the mean of the throat areas before and after the firing. The synthetic firing is made by this
    tool from the models of this site: it is not test data. Stand dynamics: one undamped spring and mass. Uncertainties
    are combined as a root-sum-square of independent terms.
  </div>
</div>

<style is:global>
  .fr-out { min-width: 0; }
  .fr-out > div > * { min-width: 0; }
  .fr-fig svg { width: 100%; height: auto; display: block; font-family: var(--sl-font-mono); }
  .frcalc textarea { width: 100%; font-family: var(--sl-font-mono); font-size: 0.74rem; line-height: 1.35; resize: vertical; white-space: pre; overflow-x: auto; }
  .fr-scroll { overflow-x: auto; }
  .frcalc table { width: 100%; display: table; margin: 0 !important; }
  .frcalc th, .frcalc td { padding: 0.25rem 0.45rem; border-bottom: 1px solid var(--rd-line); text-align: right; white-space: nowrap; }
  .frcalc th:first-child, .frcalc td:first-child { text-align: left; white-space: normal; }
</style>

<script>
  import { syntheticFiring, EXAMPLE_FIRING, parseTrace, reduceFiring, series, standFrequency, rampOvershoot, rss, type Trace } from '../lib/firing';

  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const G0 = 9.80665;

  document.querySelectorAll<HTMLElement>('[data-frcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const num = (n: string) => +field(n).value;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    let mode = 'reduce', last: ReturnType<typeof reduceFiring> | null = null, lastTrace: Trace | null = null;

    const loadSynthetic = () => {
      const s = syntheticFiring(EXAMPLE_FIRING);
      field('trace').value = s.trace.t.map((t, k) => `${t.toFixed(2)}, ${s.trace.p[k].toFixed(3)}, ${s.trace.F[k].toFixed(3)}`).join('\n');
      const v: Record<string, string> = { mp: s.mass.toFixed(1), web: '100', d0: '45.65', d1: s.dEnd.toFixed(2), de: (45.65 * Math.sqrt(8)).toFixed(1), g: '1.2', pa: '0.101325', th: '15' };
      for (const [k, x] of Object.entries(v)) field(k).value = x;
    };

    try { for (const [k, v] of new URLSearchParams(location.search)) { if (k === 'trace') continue; const el = field(k); if (el) el.value = v; } } catch {}
    if (!field('trace').value.trim()) loadSynthetic();

    function run() {
      const notes: [string, string][] = [];
      const parsed = parseTrace(field('trace').value);
      $('[data-traceinfo]').textContent = parsed.ok
        ? `${parsed.trace.t.length} samples from ${f(parsed.trace.t[0], 2)} to ${f(parsed.trace.t[parsed.trace.t.length - 1], 2)} s${parsed.skipped ? `; ${parsed.skipped} line${parsed.skipped === 1 ? '' : 's'} skipped (headers or text)` : ''}. Paste your own firing in the same three columns.`
        : 'Paste at least 20 lines of time (s), pressure (MPa) and thrust (kN), with the time increasing.';
      last = null; lastTrace = null;
      if (parsed.ok && num('mp') > 0 && num('d0') > 0 && num('d1') > 0) {
        last = reduceFiring(parsed.trace, { mp: num('mp'), dPre: num('d0'), dPost: num('d1'), web: num('web') || undefined, de: num('de') || undefined, g: num('g'), pa: num('pa'), thetaDeg: num('th') });
        lastTrace = parsed.trace;
      }
      if (mode === 'reduce') runReduce(notes, parsed.ok);
      else if (mode === 'stand') runStand(notes);
      else runUnc(notes);
      $('[data-notes]').innerHTML = notes.map(([k, t]) => `<li class="${k}">${t}</li>`).join('');
    }

    function runReduce(notes: [string, string][], ok: boolean) {
      if (!last || !lastTrace) {
        root.querySelectorAll<HTMLElement>('[data-out="reduce"] [data-r]').forEach((el) => (el.textContent = '—'));
        root.querySelector<SVGSVGElement>('[data-chart]')!.innerHTML = '';
        notes.push(['bad', ok ? 'Enter the propellant mass and the throat diameters.' : 'The trace could not be read.']);
        return;
      }
      const x = last, rd = x.read;
      r('isp').innerHTML = `${f(x.isp, 1)} s <small>total impulse ${f(x.impulse / 1000, 1)} kN·s from ${f(num('mp'), 1)} kg; C<sub>F</sub>·c*/g₀ = ${f((x.cf * x.cStar) / G0, 1)} s</small>`;
      r('cs').innerHTML = `${f(x.cStar, 0)} m/s <small>∫p·A<sub>t</sub> dt / m<sub>p</sub>, with the throat area following ∫p<sup>0.8</sup> dt; ${f(x.cStarMean, 0)} m/s with the mean of the two areas</small>`;
      r('cf').innerHTML = `${f(x.cf, 3)} <small>${Number.isFinite(x.cfIdeal) ? `ideal ${f(x.cfIdeal, 3)} at ${f(x.pAction, 2)} MPa and ε ${f(x.epsAvg, 2)}: efficiency ${f(x.etaCf * 100, 1)}%` : 'enter the exit diameter for the ideal value'}</small>`;
      r('rb').innerHTML = Number.isFinite(x.burnRate) ? `${f(x.burnRate, 2)} mm/s <small>web ÷ burn time, at the burn-time mean pressure of ${f(x.pBurn, 2)} MPa</small>` : '— <small>enter the web</small>';
      r('times').innerHTML = `${f(rd.actionTime, 2)} s · ${f(rd.burnTime, 2)} s <small>action time, then burn time to web burnout at ${f(rd.tWb, 2)} s (start ${f(rd.t0, 2)} s)</small>`;
      r('levels').innerHTML = `${f(x.pMax, 2)} MPa · ${f(x.fMax, 2)} kN <small>maxima; action-time means ${f(x.pAction, 2)} MPa and ${f(x.fAction, 2)} kN</small>`;
      drawTrace(lastTrace, x);
      if (!Number.isFinite(rd.tWb)) notes.push(['warn', 'The tangent-bisector construction did not meet the trace: check that the trace includes the tail-off.']);
      notes.push(['', `Check: C<sub>F</sub>·c*/g₀ = ${f((x.cf * x.cStar) / G0, 2)} s and I<sub>sp</sub> = ${f(x.isp, 2)} s. They must agree, because the three results come from the same two integrals.`]);
      if (num('d1') > num('d0')) notes.push(['', `The throat grew from ${f(num('d0'), 2)} to ${f(num('d1'), 2)} mm (${f(((num('d1') / num('d0')) ** 2 - 1) * 100, 1)}% in area). c* and C<sub>F</sub> take the area between the two in proportion to ∫p<sup>0.8</sup> dt. If the throat lost material in a step (a crack, a piece of insert), this history is wrong and so are c* and C<sub>F</sub>; the specific impulse does not use the throat.`]);
      if (Number.isFinite(x.burnRate) && num('web') > 0) notes.push(['', 'One firing gives one point of the burn-rate law at its mean pressure. Fire at two or more pressures (different throats), and at the hot and cold conditioning temperatures, to get a, n and the temperature sensitivity.']);
    }

    function runStand(notes: [string, string][]) {
      const k = series(num('kc'), num('ks')), mm = num('mm');
      const f0 = standFrequency(k, num('m0') + mm), f1 = standFrequency(k, num('m1') + mm);
      r('fn').innerHTML = `${f(f0, 0)} → ${f(f1, 0)} Hz <small>at ignition and at burnout; the thrust path is ${f(k, 0)} kN/mm (load cell and structure in series)</small>`;
      const ov = rampOvershoot(f0, num('tr') / 1000);
      r('ring').innerHTML = `${f(ov * 100, 1)}% <small>of the thrust step, for a ${f(num('tr'), 0)} ms rise against a period of ${f(1000 / f0, 1)} ms</small>`;
      $('[data-ring]').className = `readout ${ov > 0.1 ? 'warn' : 'ok'}`;
      const need = 10 * f1;
      r('fsr').innerHTML = `${f(num('fs'), 0)} Hz <small>${num('fs') >= need ? 'at least' : 'below'} 10 times the highest natural frequency (${f(need, 0)} Hz)</small>`;
      $('[data-fsr]').className = `readout ${num('fs') >= need ? 'ok' : 'warn'}`;
      r('defl').innerHTML = `${f(num('fp') / k, 3)} mm <small>the motor moves this far onto the load cell</small>`;
      const mp = num('m0') - num('m1'), or = field('or').value;
      if (or === 'h') {
        r('wt').innerHTML = '0 <small>horizontal: the weight acts across the load cell, not along it</small>';
        $('[data-wt]').className = 'readout ok';
      } else {
        const dW = (mp * G0) / 1000;
        r('wt').innerHTML = `${f(dW, 2)} kN change <small>${f((dW / num('fp')) * 100, 1)}% of the peak thrust: the weight ${or === 'up' ? 'adds to' : 'subtracts from'} the reading and falls as the propellant burns</small>`;
        $('[data-wt]').className = 'readout warn';
        notes.push(['warn', `Vertical stand: the load cell reads the thrust ${or === 'up' ? 'plus' : 'minus'} the weight of the motor and its mount. The tare at the start removes only the starting weight. Correct the trace with the mass history: the mass that has burned is in proportion to the impulse so far.`]);
      }
      if (ov > 0.1) notes.push(['warn', 'The ignition rise is short compared with the period of the stand, so the stand rings. The load cell then reads the thrust plus the inertia force of the moving mass. Make the thrust path stiffer or the moving mass smaller, or measure the acceleration and correct.']);
      notes.push(['', 'Calibrate in place: a reference load cell and a hydraulic actuator push on the motor mount through the same path, before and after the firing. This includes the flexures and the cables that share the thrust, which a bench calibration of the load cell does not.']);
      notes.push(['', 'Do not filter the thrust and pressure traces below the frequencies you want to see. Filter the record only for averages, and keep the raw data. The anti-aliasing filter goes below half the sample rate.']);
    }

    function runUnc(notes: [string, string][]) {
      if (!last) { $('[data-utable]').innerHTML = ''; notes.push(['bad', 'Reduce a firing on the first tab first.']); return; }
      const uF = num('uF') / 100, up = num('up') / 100, um = num('um') / num('mp'), uD = num('ud');
      const d0 = num('d0'), d1 = num('d1'), aBar = (d0 * d0 + d1 * d1) / 2;
      const uA = (2 * uD) / Math.sqrt(aBar); // both diameters with the same gauge: taken as fully correlated
      const uE = ((num('ue') / 100) * Math.abs(d1 * d1 - d0 * d0)) / aBar; // the throat area history
      const uTb = num('ut') / last.read.burnTime, uW = num('web') > 0 ? num('uw') / num('web') : 0;
      const rows: [string, number, number, string][] = [
        ['Specific impulse', last.isp, rss(uF, um), 'thrust, mass'],
        ['c*', last.cStar, rss(up, uA, uE, um), 'pressure, throat, erosion, mass'],
        ['C<sub>F</sub>', last.cf, rss(uF, up, uA, uE), 'thrust, pressure, throat, erosion'],
        ['Burn rate', last.burnRate, rss(uW, uTb), 'web, burn time'],
      ];
      $('[data-utable]').innerHTML = `<table><thead><tr><th>Result</th><th>Value</th><th>1σ</th><th>±95% (k = 2)</th><th>From</th></tr></thead><tbody>${rows.map(([n, v, u, from]) =>
        `<tr><td>${n}</td><td>${f(v, n === 'C<sub>F</sub>' ? 3 : n === 'Burn rate' ? 2 : 1)}</td><td>${f(u * 100, 2)}%</td><td>${f(2 * u * 100, 2)}%</td><td>${from}</td></tr>`).join('')}</tbody></table>`;
      notes.push(['', `The throat governs c* and C<sub>F</sub> here: a ${f(uD, 2)} mm measurement is ${f(uA * 100, 2)}% of the area, but the erosion history between ${f(d0, 2)} and ${f(d1, 2)} mm adds ${f(uE * 100, 2)}%. If nothing is known about the history, the area could be anywhere between the two: ${f((Math.abs(d1 * d1 - d0 * d0) / (2 * Math.sqrt(3) * aBar)) * 100, 1)}%. The specific impulse does not need the throat at all, which is why it is the most accurate result of a firing.`]);
      notes.push(['', 'These are the measurement terms only. The scatter between motors of the same lot is usually larger: fire enough motors to see it, and keep the two apart in the report.']);
    }

    // pressure and thrust traces with the 10% points and the tangent-bisector construction
    function drawTrace(tr: Trace, x: ReturnType<typeof reduceFiring>) {
      const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
      const W = Math.round(Math.min(640, Math.max(280, svg.clientWidth || 560))), H = 250, L = 40, R = 40, T = 18, B = 34;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const tMax = tr.t[tr.t.length - 1], pTop = Math.ceil(x.pMax * 1.15), fTop = Math.ceil(x.fMax * 1.15);
      const X = (t: number) => L + (t / tMax) * (W - L - R), Yp = (p: number) => T + (H - T - B) * (1 - p / pTop), Yf = (F: number) => T + (H - T - B) * (1 - F / fTop);
      const out: string[] = [];
      const ticks = (top: number) => { const s = [1, 2, 5, 10, 20, 50].find((v) => top / v <= 6) ?? 100; return Array.from({ length: Math.floor(top / s) + 1 }, (_, k) => k * s); };
      for (const v of ticks(pTop)) out.push(`<line x1="${L}" x2="${W - R}" y1="${Yp(v).toFixed(1)}" y2="${Yp(v).toFixed(1)}" stroke="var(--rd-line)"/><text x="${L - 5}" y="${(Yp(v) + 3).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--rd-accent)">${v}</text>`);
      for (const v of ticks(fTop)) out.push(`<text x="${W - R + 5}" y="${(Yf(v) + 3).toFixed(1)}" font-size="10" fill="var(--rd-blue)">${v}</text>`);
      const ts = [1, 2, 5, 10, 20].find((v) => tMax / v <= 8) ?? 50;
      for (let v = 0; v <= tMax + 1e-9; v += ts) out.push(`<text x="${X(v).toFixed(1)}" y="${H - B + 14}" text-anchor="middle" font-size="10" fill="var(--rd-muted)">${v}</text>`);
      out.push(`<text x="${(L + W - R) / 2}" y="${H - 4}" text-anchor="middle" font-size="10" fill="var(--rd-ink)">time, s</text><text x="4" y="11" font-size="10" fill="var(--rd-accent)">p, MPa</text><text x="${W - 4}" y="11" text-anchor="end" font-size="10" fill="var(--rd-blue)">F, kN</text>`);
      const step = Math.max(1, Math.floor(tr.t.length / 700));
      const path = (y: (k: number) => number) => { const s: string[] = []; for (let k = 0; k < tr.t.length; k += step) s.push(`${s.length ? 'L' : 'M'}${X(tr.t[k]).toFixed(1)},${y(k).toFixed(1)}`); return s.join(''); };
      const rd = x.read;
      // 10% level and the action time
      out.push(`<line x1="${L}" x2="${W - R}" y1="${Yp(0.1 * rd.yMax).toFixed(1)}" y2="${Yp(0.1 * rd.yMax).toFixed(1)}" stroke="var(--rd-muted)" stroke-dasharray="2 3"/>`);
      for (const tt of [rd.t0, rd.t1]) out.push(`<line x1="${X(tt).toFixed(1)}" x2="${X(tt).toFixed(1)}" y1="${T}" y2="${H - B}" stroke="var(--rd-muted)" stroke-dasharray="2 3"/>`);
      out.push(`<path d="${path((k) => Yf(tr.F[k]))}" fill="none" stroke="var(--rd-blue)" stroke-width="1.6"/>`);
      out.push(`<path d="${path((k) => Yp(tr.p[k]))}" fill="none" stroke="var(--rd-accent)" stroke-width="2"/>`);
      // the construction, near the knee
      if (Number.isFinite(rd.tWb)) {
        const span = 0.18 * tMax, c = rd.corner;
        const seg = (m: number, cc: number, ta: number, tb: number) => `<line x1="${X(ta).toFixed(1)}" x2="${X(tb).toFixed(1)}" y1="${Yp(m * ta + cc).toFixed(1)}" y2="${Yp(m * tb + cc).toFixed(1)}" stroke="var(--rd-ink)" stroke-width="1" stroke-dasharray="5 3"/>`;
        out.push(seg(rd.tangent1.m, rd.tangent1.c, c.t - span, c.t + span * 0.15));
        const t2a = c.t - span * 0.05, t2b = Math.min(tMax, c.t + (c.y / Math.abs(rd.tangent2.m || 1)) * 1.05);
        out.push(seg(rd.tangent2.m, rd.tangent2.c, t2a, t2b));
        const pW = (() => { let k = 0; while (k < tr.t.length - 1 && tr.t[k] < rd.tWb) k++; return tr.p[k]; })();
        out.push(`<line x1="${X(c.t).toFixed(1)}" x2="${X(rd.tWb).toFixed(1)}" y1="${Yp(c.y).toFixed(1)}" y2="${Yp(pW).toFixed(1)}" stroke="var(--rd-ink)" stroke-width="1" stroke-dasharray="1.5 2.5"/>`);
        out.push(`<circle cx="${X(rd.tWb).toFixed(1)}" cy="${Yp(pW).toFixed(1)}" r="4.5" fill="var(--rd-panel)" stroke="var(--rd-ink)" stroke-width="2"/>`);
        out.push(`<text x="${(X(rd.tWb) - 8).toFixed(1)}" y="${(Yp(pW) + 18).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--rd-ink)">web burnout ${f(rd.tWb, 2)} s</text>`);
      }
      out.push(`<text x="${(X(rd.t0) + 4).toFixed(1)}" y="${(Yp(0.1 * rd.yMax) - 4).toFixed(1)}" font-size="10" fill="var(--rd-muted)">10%</text>`);
      svg.innerHTML = out.join('');
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    tabs.forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.tab!;
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => (el.hidden = el.dataset.panel !== mode));
      root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => (el.hidden = el.dataset.out !== mode));
      run();
    }));
    let pending = 0;
    form.addEventListener('input', () => { window.clearTimeout(pending); pending = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    root.querySelector('[data-load-example]')!.addEventListener('click', () => { loadSynthetic(); run(); });
    root.querySelector('[data-share]')!.addEventListener('click', async (ev) => {
      const q = new URLSearchParams();
      for (const el of Array.from(form.elements) as HTMLInputElement[]) if (el.name && el.name !== 'trace' && el.value) q.set(el.name, el.value);
      const url = `${location.origin}${location.pathname}?${q}#calculator`;
      try { history.replaceState(null, '', url); } catch {}
      const btn = ev.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(url); btn.textContent = 'Link copied'; } catch { btn.textContent = 'Link in address bar'; }
      setTimeout(() => (btn.textContent = 'Copy link to these inputs'), 2000);
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([en]) => { const nw = Math.round(en.contentRect.width); if (Math.abs(nw - w) > 8) { w = nw; run(); } }).observe(root.querySelector('.fr-out')!);
    }
    run();
  });
</script>
