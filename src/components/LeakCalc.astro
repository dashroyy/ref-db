---
// Leak testing in three tabs: pressure decay with temperature correction and uncertainty; helium accumulation in a
// hood; and the conversion of a tracer-gas leak rate to a service leak rate. Maths in src/lib/leak.ts (unit-tested);
// UI only here.
import { UNITS, GASES } from '../lib/leak';

const TABS = [{ key: 'decay', name: 'Pressure decay' }, { key: 'hood', name: 'Helium hood' }, { key: 'conv', name: 'Test to service' }];
---

<div class="calc leakcalc" data-leakcalc>
  <div class="calc-head"><span>Leak test</span><span class="head-btns"><span>ideal gas · capillary leak path</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Leak test">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Requirement and units</legend>
        <div class="row2">
          <label>Allowable leak rate<input name="allow" type="text" inputmode="decimal" placeholder="your value, e.g. 1e-5" autocomplete="off" /></label>
          <label>Unit<select name="unit">{UNITS.map((u) => <option value={u.key} selected={u.key === 'atmccs'}>{u.name}</option>)}</select></label>
        </div>
        <p class="hint">The allowable comes from your requirement, with its gas and conditions. All rates on this calculator are in the unit selected here.</p>
      </fieldset>

      <fieldset data-panel="decay">
        <legend>Pressure-decay test</legend>
        <div class="row2">
          <label>Test volume, with lines (cm³)<input name="V" type="number" min="0.01" step="any" value="12" /></label>
          <label>Test pressure (kPa gauge)<input name="pg" type="number" min="1" step="any" value="700" /></label>
          <label>Hold time (s)<input name="t" type="number" min="1" step="any" value="600" /></label>
          <label>Pressure drop measured (Pa)<input name="dp" type="number" step="any" value="150" /></label>
          <label>Gas temperature fall (K)<input name="dT" type="number" step="any" value="0.05" /></label>
          <label>Gas temperature (°C)<input name="T" type="number" step="any" value="20" /></label>
          <label>Pressure resolution (Pa)<input name="rp" type="number" min="0" step="any" value="20" /></label>
          <label>Temperature resolution (K)<input name="rt" type="number" min="0" step="any" value="0.02" /></label>
        </div>
        <p class="hint">A negative temperature fall is a rise. The volume includes the gauge, the tubing and the valves: they are often larger than the space between the seals.</p>
      </fieldset>

      <fieldset data-panel="hood" hidden>
        <legend>Helium accumulation in a hood</legend>
        <div class="row2">
          <label>Hood free volume (L)<input name="hv" type="number" min="0.01" step="any" value="5" /></label>
          <label>Accumulation time (s)<input name="ht" type="number" min="1" step="any" value="600" /></label>
          <label>Helium rise measured (ppm)<input name="dc" type="number" min="0" step="any" value="0.05" /></label>
          <label>Detector resolution (ppm)<input name="rc" type="number" min="0.001" step="any" value="0.1" /></label>
          <label>Helium in the part (%)<input name="fr" type="number" min="0.1" max="100" step="any" value="100" /></label>
        </div>
        <p class="hint">Air contains approximately 5 ppm of helium: the rise above that background is what counts. Use the resolution demonstrated with a calibrated reference leak.</p>
      </fieldset>

      <fieldset data-panel="conv" hidden>
        <legend>Same leak path, test and service</legend>
        <div class="row2">
          <label>Leak rate in the test<input name="qt" type="text" inputmode="decimal" value="1e-5" /></label>
          <label>Leak path length (mm)<input name="L" type="number" min="0.01" step="any" value="3" /></label>
          <label>Test gas<select name="gt">{GASES.map((g) => <option value={g.key} selected={g.key === 'he'}>{g.name}</option>)}</select></label>
          <label>Service gas<select name="gs">{GASES.map((g) => <option value={g.key} selected={g.key === 'air'}>{g.name}</option>)}</select></label>
          <label>Test, upstream (kPa abs)<input name="p1t" type="number" min="0" step="any" value="801.3" /></label>
          <label>Test, downstream (kPa abs)<input name="p2t" type="number" min="0" step="any" value="101.3" /></label>
          <label>Service, upstream (kPa abs)<input name="p1s" type="number" min="0" step="any" value="10101.3" /></label>
          <label>Service, downstream (kPa abs)<input name="p2s" type="number" min="0" step="any" value="101.3" /></label>
        </div>
        <p class="hint">The path length is the length of the leak path, for example the width of the seal contact. Use air or nitrogen for cold combustion gas at the seal; hot gas is more viscous.</p>
      </fieldset>
      <p class="hint example-note" data-example-note hidden></p>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 260" data-chart role="img" aria-label="Chart for the selected leak test"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Screening only: ideal gas at constant volume, readings with the stated resolution, a hood with uniform helium
    concentration, and a leak path that is a single round capillary. The governing values come from your test procedure
    and calibrated reference leaks.
  </div>
</div>

<style is:global>
  .leakcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .leakcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
  .leakcalc .pv-notes li.bad { color: var(--rd-accent); }
  .leakcalc .pv-notes li.warn { color: var(--rd-warn); }
  .leakcalc .example-note { margin: 0.5rem 0 0 !important; }
  .leakcalc input[type='text'] { width: 100%; }
</style>

<script>
  import { UNITS, toSI, fromSI, decay, holdFor, accumulation, accumulateFor, convert, gas, viscousQ, molecularQ, timeToLoseCc, P_ATM, type Unit } from '../lib/leak';
  import { awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const sci = (v: number, d = 2) => {
    if (!Number.isFinite(v)) return '—';
    if (v === 0) return '0';
    const e = Math.floor(Math.log10(Math.abs(v))), m = v / 10 ** e;
    return e >= -2 && e <= 3 ? (+v.toPrecision(d + 1)).toLocaleString('en-GB') : `${m.toFixed(d)} × 10${String(e).split('').map((c) => SUP[c]).join('')}`;
  };
  const f = (v: number, d = 0) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const dur = (s: number) => (!Number.isFinite(s) ? '—' : s < 120 ? `${f(s)} s` : s < 7200 ? `${f(s / 60)} min` : s < 172800 ? `${f(s / 3600, 1)} h` : s < 3.2e7 ? `${f(s / 86400)} days` : `${f(s / 3.156e7)} years`);
  const pow = (e: number) => `10${String(e).split('').map((c) => SUP[c]).join('')}`;
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-leakcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => { const s = field(n).value.trim().replace(/\s/g, '').replace(/×10\^?/i, 'e'); return s === '' ? NaN : +s; };
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const txt = (x: number, y: number, s: string, c = 'var(--rd-ink)', anchor = 'start', fs = 10) =>
      el('text', { x, y, 'text-anchor': anchor, 'font-size': fs, fill: c, stroke: 'var(--rd-panel)', 'stroke-width': 3, 'paint-order': 'stroke' }, s);
    const width = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    const frame = (H: number) => { svg.replaceChildren(); const W = width(); svg.setAttribute('viewBox', `0 0 ${W} ${H}`); return W; };
    const unit = () => field('unit').value as Unit;
    const uName = () => UNITS.find((u) => u.key === unit())!.name.split(' ')[0];
    const show = (q: number) => `${sci(fromSI(q, unit()))} <small>${uName()}</small>`;
    const allowSI = () => { const a = num('allow'); return a > 0 ? toSI(a, unit()) : null; };
    // log-log axes; returns mappers
    function logAxes(W: number, H: number, x0: number, x1: number, y0: number, y1: number, xl: string, yl: string, xfmt: (v: number) => string) {
      const L = 50, R = 12, T = 14, B = 32;
      const X = (v: number) => L + ((Math.log10(v) - x0) / (x1 - x0)) * (W - L - R), Y = (v: number) => H - B - ((Math.log10(v) - y0) / (y1 - y0)) * (H - T - B);
      const xs = Math.max(1, Math.ceil((x1 - x0) / 6));
      for (let e = Math.ceil(x0); e <= x1; e += xs) { el('line', { x1: X(10 ** e), x2: X(10 ** e), y1: T, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(10 ** e), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, xfmt(10 ** e)); }
      const ys = Math.max(1, Math.ceil((y1 - y0) / 6));
      for (let e = Math.ceil(y0); e <= y1; e += ys) { el('line', { x1: L, x2: W - R, y1: Y(10 ** e), y2: Y(10 ** e), stroke: 'var(--rd-line)' }); if (Y(10 ** e) < H - B - 6) el('text', { x: L - 4, y: Y(10 ** e) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, pow(e)); }
      el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, xl);
      el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, yl);
      return { X, Y, L, R, T, B };
    }
    let mode = 'decay';
    let draw: (() => void) | null = null;

    // ---- pressure decay ----
    function runDecay(rows: Row[], notes: [string, string][]) {
      const V = num('V') * 1e-6, pAbs = num('pg') * 1000 + P_ATM, t = num('t'), dp = num('dp'), dT = num('dT') || 0, T = (Number.isFinite(num('T')) ? num('T') : 20) + 273.15, resP = num('rp') || 0, resT = num('rt') || 0;
      if (!(V > 0 && pAbs > 0 && t > 0 && Number.isFinite(dp))) { notes.push(['bad', 'Enter the volume, the test pressure, the hold time and the measured pressure drop.']); return null; }
      const d = decay({ V, pAbs, t, dp, dT, T, resP, resT }), a = allowSI();
      let cls = '', verdict = '';
      if (a !== null) {
        if (d.Q + d.dQ <= a) { cls = 'ok'; verdict = 'pass: below the allowable with its uncertainty'; }
        else if (d.Q - d.dQ > a) { cls = 'bad'; verdict = 'fail: above the allowable with its uncertainty'; }
        else { cls = 'warn'; verdict = 'inconclusive: the uncertainty covers the allowable'; }
      }
      rows.push({ dt: 'Leak rate, temperature corrected', dd: `${sci(fromSI(d.Q, unit()))} ± ${sci(fromSI(d.dQ, unit()))} <small>${uName()}${verdict ? ` · ${verdict}` : ''}</small>`, primary: true, cls });
      rows.push({ dt: 'Without the correction', dd: `${show(d.Qraw)}`, cls: a !== null && d.Qraw > a && d.Q <= a ? 'warn' : '' });
      rows.push({ dt: 'Pressure change from temperature', dd: `${f(d.thermal, 1)} Pa <small>of the ${f(dp, 1)} Pa measured · uncertainty of the drop ± ${f(d.dpUnc, 1)} Pa</small>` });
      if (a === null) { rows.push({ dt: 'Hold for the allowable', dd: '<small>needs allowable leak rate</small>' }); notes.push(['warn', awaitingMessage(['allowable leak rate'], 'whether the test passes and the hold time it needs')]); }
      else rows.push({ dt: 'Hold for the allowable', dd: `${dur(holdFor(a, V, d.dpUnc))} <small>uncertainty equal to the allowable; twice as long for half</small>` });
      if (Math.abs(d.thermal) > Math.abs(d.dpLeak)) notes.push(['warn', `The temperature change gives more of the pressure drop (${f(d.thermal, 0)} Pa) than the leak does (${f(d.dpLeak, 0)} Pa). Soak until the temperature is stable, and record it.`]);
      if (d.dpLeak < 0) notes.push(['warn', 'The corrected drop is negative: the temperature correction is larger than the measured drop. The temperature measurement may not represent the gas.']);
      notes.push(['', 'A decay test measures the sum of all leaks from the test volume: both seals, the port plug, the fittings and the gauge. A pass clears all of them; a fail does not say which one.']);
      return () => {
        const H = 250, W = frame(H);
        const ts = Array.from({ length: 60 }, (_, k) => 10 ** (1 + (4 * k) / 59));
        const mins = ts.map((x) => holdFor(1, V, d.dpUnc) / x), gauge = ts.map((x) => (V * Math.SQRT2 * resP) / x);
        const vals = [...mins, ...gauge.filter((g) => g > 0), Math.abs(d.Q), d.dQ, a ?? NaN].filter((v) => v > 0 && Number.isFinite(v)).map((v) => fromSI(v, unit()));
        const y0 = Math.floor(Math.log10(Math.min(...vals))) , y1 = Math.ceil(Math.log10(Math.max(...vals)));
        const A = logAxes(W, H, 1, 5, y0, Math.max(y1, y0 + 1), 'hold time, s', `leak, ${uName()}`, (v) => (v >= 1000 ? `${v / 1000}k` : String(v)));
        el('polyline', { points: ts.map((x, k) => `${A.X(x).toFixed(1)},${A.Y(fromSI(mins[k], unit())).toFixed(1)}`).join(' '), fill: 'none', stroke: 'var(--rd-blue)', 'stroke-width': 2.2 });
        if (resP > 0) el('polyline', { points: ts.map((x, k) => `${A.X(x).toFixed(1)},${A.Y(fromSI(gauge[k], unit())).toFixed(1)}`).join(' '), fill: 'none', stroke: 'var(--rd-blue)', 'stroke-width': 1.3, 'stroke-dasharray': '5 3' });
        if (a !== null) { el('line', { x1: A.L, x2: W - A.R, y1: A.Y(fromSI(a, unit())), y2: A.Y(fromSI(a, unit())), stroke: 'var(--rd-accent)', 'stroke-dasharray': '6 4' }); txt(W - A.R - 4, A.Y(fromSI(a, unit())) - 5, 'allowable', 'var(--rd-accent)', 'end'); }
        if (t >= 10 && t <= 1e5) {
          const q = fromSI(Math.max(d.Q, 1e-30), unit()), hi = fromSI(d.Q + d.dQ, unit()), lo = fromSI(Math.max(d.Q - d.dQ, 1e-30), unit());
          const yb = 10 ** (y0 - 0), clamp = (v: number) => Math.max(v, yb);
          el('line', { x1: A.X(t), x2: A.X(t), y1: A.Y(clamp(lo)), y2: A.Y(hi), stroke: 'var(--rd-ink)', 'stroke-width': 1.6 });
          el('circle', { cx: A.X(t), cy: A.Y(clamp(q)), r: 5, fill: 'var(--rd-panel)', stroke: 'var(--rd-ink)', 'stroke-width': 2 });
        }
        txt(A.L + 6, A.T + 10, 'smallest leak this test can show', 'var(--rd-blue)');
      };
    }

    // ---- helium hood ----
    function runHood(rows: Row[], notes: [string, string][]) {
      const V = num('hv') * 1e-3, t = num('ht'), dC = (num('dc') || 0) * 1e-6, resC = num('rc') * 1e-6, frac = num('fr') / 100;
      if (!(V > 0 && t > 0 && resC > 0 && frac > 0 && frac <= 1)) { notes.push(['bad', 'Enter the hood volume, the time, the detector resolution and the helium fraction.']); return null; }
      const r = accumulation({ V, t, dC, resC, frac }), a = allowSI();
      const seen = dC >= resC;
      rows.push({ dt: seen ? 'Total leak rate' : 'Total leak rate, below resolution', dd: seen ? show(r.total) : `< ${show(r.minTotal)}`, primary: true, cls: a === null ? '' : (seen ? r.total : r.minTotal) <= a ? 'ok' : 'bad' });
      rows.push({ dt: 'Smallest leak this test can show', dd: `${show(r.minTotal)} <small>${a !== null ? `${f(a / r.minTotal, 1)} times below the allowable` : `helium alone ${sci(fromSI(r.minTotal * frac, unit()))}`}</small>`, cls: a !== null && r.minTotal > a ? 'bad' : '' });
      if (a === null) { rows.push({ dt: 'Time to see the allowable', dd: '<small>needs allowable leak rate</small>' }); notes.push(['warn', awaitingMessage(['allowable leak rate'], 'whether the test can show it, and how long it takes')]); }
      else rows.push({ dt: 'Time to see the allowable', dd: `${dur(accumulateFor(a, { V, resC, frac }))} <small>for the rise to equal the detector resolution</small>` });
      if (frac < 1) notes.push(['', `The part holds ${f(frac * 100, 0)}% helium, so the hood sees only that fraction of the leak. The total is the helium rate divided by ${f(frac, 2)}.`]);
      notes.push(['', 'Seal the hood, mix the gas inside it, and measure its free volume. Elastomer seals let helium through slowly by permeation: measure before it gets through them, or measure that background.']);
      return () => {
        const H = 250, W = frame(H), L = 46, R = 12, T = 14, B = 32;
        const tMax = Math.max(t * 1.5, a !== null ? Math.min(accumulateFor(a, { V, resC, frac }) * 1.5, t * 6) : 0);
        const rate = (q: number) => (q * frac) / (V * P_ATM) * 1e6; // ppm per second
        const lines: [number, string, string][] = [];
        if (seen) lines.push([dC * 1e6 / t, 'var(--rd-ink)', 'measured']);
        if (a !== null) lines.push([rate(a), 'var(--rd-accent)', 'allowable']);
        const cMax = Math.max(resC * 1e6 * 2.5, ...lines.map(([s]) => s * tMax)) * 1.05;
        const X = (x: number) => L + (x / tMax) * (W - L - R), Y = (c: number) => H - B - (Math.min(c, cMax) / cMax) * (H - T - B);
        const nice = (m: number) => { const e = 10 ** Math.floor(Math.log10(m)); return [1, 2, 2.5, 5, 10].map((k) => k * e).find((s) => m / s <= 6)!; };
        const sx = nice(tMax), sy = nice(cMax);
        for (let x = 0; x <= tMax; x += sx) { el('line', { x1: X(x), x2: X(x), y1: T, y2: H - B, stroke: 'var(--rd-line)' }); if (x > 0) el('text', { x: X(x), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, String(+x.toFixed(0))); }
        for (let c = 0; c <= cMax; c += sy) { el('line', { x1: L, x2: W - R, y1: Y(c), y2: Y(c), stroke: 'var(--rd-line)' }); el('text', { x: L - 4, y: Y(c) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, String(+c.toPrecision(3))); }
        el('rect', { x: L, y: Y(resC * 1e6), width: W - L - R, height: H - B - Y(resC * 1e6), fill: 'var(--rd-muted)', 'fill-opacity': 0.12 });
        txt(W - R - 4, Y(resC * 1e6) + 12, 'below resolution', 'var(--rd-muted)', 'end');
        for (const [s, c, n] of lines) {
          const xEnd = Math.min(tMax, cMax / s);
          el('line', { x1: X(0), y1: Y(0), x2: X(xEnd), y2: Y(s * xEnd), stroke: c, 'stroke-width': 2.2 });
          txt(X(xEnd) - 4, Y(s * xEnd) + (n === 'measured' ? 14 : -6), n, c, 'end');
        }
        el('line', { x1: X(t), x2: X(t), y1: T, y2: H - B, stroke: 'var(--rd-ink)', 'stroke-dasharray': '3 3' });
        el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'accumulation time, s');
        el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, 'helium rise, ppm');
      };
    }

    // ---- test to service ----
    function runConv(rows: Row[], notes: [string, string][]) {
      const q = toSI(num('qt'), unit()), L = num('L') * 1e-3, gt = gas(field('gt').value), gs = gas(field('gs').value);
      const p1t = num('p1t') * 1e3, p2t = num('p2t') * 1e3, p1s = num('p1s') * 1e3, p2s = num('p2s') * 1e3;
      if (!(q > 0 && L > 0 && p1t > p2t && p2t >= 0 && p1s > p2s && p2s >= 0)) { notes.push(['bad', 'Enter a test leak rate, a path length, and upstream pressures higher than downstream.']); return null; }
      const c = convert({ q, test: gt, p1t, p2t, service: gs, p1s, p2s, L }), a = allowSI();
      const gov = c.regimeService === 'molecular' ? c.molecular : c.viscous;
      rows.push({ dt: `${gs.name} leak in service`, dd: `${show(gov)} <small>${c.regimeService} flow: ${f(gov / q, gov / q < 10 ? 1 : 0)} × the test rate</small>`, primary: true });
      rows.push({ dt: 'The two limits', dd: `<small>viscous ${sci(fromSI(c.viscous, unit()))} · molecular ${sci(fromSI(c.molecular, unit()))} ${uName()}</small>` });
      rows.push({ dt: 'Equivalent leak path', dd: `${f(c.d * 1e6, 2)} µm <small>diameter of a ${f(L * 1e3, 1)} mm capillary · test ${c.regimeTest} (Kn ${f(c.knTest, 3)}), service ${c.regimeService} (Kn ${f(c.knService, 4)})</small>` });
      rows.push({ dt: 'Gas lost in service', dd: `<small>1 cm³ at 1 bar every ${dur(timeToLoseCc(gov))}</small>` });
      if (a !== null) notes.push(['', `The allowable (${sci(fromSI(a, unit()))} ${uName()}) is a rate for its stated gas and conditions. Compare like with like: a test rate with a test allowable, a service rate with a service requirement.`]);
      if (gov / q > 10) notes.push(['warn', `A higher pressure across the same path passes much more gas: ${f(gov / q, 0)} times here. A helium test at a low pressure does not show the leak at MEOP directly.`]);
      notes.push(['', 'A pressure-energised seal (an O-ring) closes its leak path as the pressure increases, so the real service leak is usually less than the viscous estimate. A path through a crack or a porous weld does not close.']);
      return () => {
        const H = 250, W = frame(H);
        const pd = 101325, ps = Array.from({ length: 60 }, (_, k) => 10 ** (5.05 + (2.45 * k) / 59));
        const vt = ps.map((p) => viscousQ(c.d, L, p, pd, gt)), vs = ps.map((p) => viscousQ(c.d, L, p, pd, gs)), mt = ps.map((p) => molecularQ(c.d, L, p, pd, gt));
        const all = [...vt, ...vs, ...mt, q, gov].filter((v) => v > 0).map((v) => fromSI(v, unit()));
        const y0 = Math.floor(Math.log10(Math.min(...all.filter((v) => v > 0)))), y1 = Math.ceil(Math.log10(Math.max(...all)));
        const A = logAxes(W, H, 5, 7.5, Math.max(y0, y1 - 8), y1, 'upstream pressure, kPa abs (to 1 atm)', `leak, ${uName()}`, (v) => (v >= 1e6 ? `${v / 1e6}k` : String(v / 1e3)));
        const line = (arr: number[], c: string, dash = '') => el('polyline', { points: ps.map((p, k) => `${A.X(p).toFixed(1)},${A.Y(Math.max(fromSI(arr[k], unit()), 10 ** (y1 - 8))).toFixed(1)}`).join(' '), fill: 'none', stroke: c, 'stroke-width': 2, 'stroke-dasharray': dash });
        line(vt, 'var(--rd-blue)'); line(vs, 'var(--rd-ok)'); line(mt, 'var(--rd-blue)', '4 3');
        if (p2t > 0.9 * pd && p2t < 1.1 * pd && p1t >= 10 ** 5.05) el('circle', { cx: A.X(p1t), cy: A.Y(fromSI(q, unit())), r: 5, fill: 'var(--rd-panel)', stroke: 'var(--rd-blue)', 'stroke-width': 2.5 });
        if (p2s > 0.9 * pd && p2s < 1.1 * pd && p1s <= 10 ** 7.5) el('circle', { cx: A.X(p1s), cy: A.Y(fromSI(gov, unit())), r: 5, fill: 'var(--rd-panel)', stroke: 'var(--rd-ok)', 'stroke-width': 2.5 });
        txt(A.L + 6, A.T + 10, `blue: ${gt.name.toLowerCase()} · green: ${gs.name.toLowerCase()}`, 'var(--rd-ink)');
        txt(A.L + 6, A.T + 23, 'dashed: molecular limit', 'var(--rd-muted)');
      };
    }

    const RUN: Record<string, typeof runDecay> = { decay: runDecay, hood: runHood, conv: runConv };
    const CAPS: Record<string, string> = {
      decay: 'The smallest leak that the test can show against hold time, with the temperature uncertainty (solid) and from the gauge alone (dashed). The point is your result with its uncertainty.',
      hood: 'Helium concentration in the hood against time, for your measured rise and for a leak equal to the allowable. Grey: below the detector resolution.',
      conv: 'Leak rate through the same path against upstream pressure, to atmosphere. Circles: your test and service conditions.',
    };
    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    wireWorkedExample({
      root, onLoad: run, factorFields: ['allow'],
      note: 'Worked-example requirement loaded: 1 × 10⁻⁵ std cm³/s of helium',
      values: { allow: '1e-5', unit: 'atmccs', V: '12', pg: '700', t: '600', dp: '150', dT: '0.05', T: '20', rp: '20', rt: '0.02',
        hv: '5', ht: '600', dc: '0.05', rc: '0.1', fr: '100', qt: '1e-5', L: '3', gt: 'he', gs: 'air', p1t: '801.3', p2t: '101.3', p1s: '10101.3', p2s: '101.3' },
    });
    run();
  });
</script>
