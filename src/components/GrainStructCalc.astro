---
// Case-bonded cylindrical grain: closed-form structural screening.
// Formulas in src/lib/grain.ts (unit-tested); this file is UI only.
import MaterialSelect from './MaterialSelect.astro';
import { withProps, DEFAULTS as D } from '../lib/materials';
import { PROPELLANT_CLASSES } from '../lib/grain';

// Propellant classes carried over from REF·DB v1 (src/lib/grain.ts). Illustrative, not measured data.
const PROPS = PROPELLANT_CLASSES;
// Case materials: the metals and composites of the material library with E, ν and α (α in µm/m·K, E in GPa here).
const CASES = withProps(['E', 'nu', 'alpha'], ['metal', 'composite']).map((m) => ({ key: m.key, name: m.name, family: m.family, alpha: +(m.alpha! * 1e6).toPrecision(4), E: m.E! / 1000, nu: m.nu! }));
const steel = CASES.find((c) => c.key === D.caseSteel)!;
---

<div class="calc gscalc" data-gscalc>
  <div class="calc-head"><span>Case-bonded grain: structural screen</span><span class="head-btns"><span>long cylinder · incompressible propellant</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Materials</legend>
        <label>Propellant class
          <select name="prop">{PROPS.map((p) => <option value={p.key}>{p.name}</option>)}</select>
        </label>
        <div class="row2">
          <label>CTE α<sub>p</sub> (µm/m·K)<input name="ap" type="number" step="any" value="100" /></label>
          <label>Relaxed modulus (MPa)<input name="E" type="number" step="any" value="3.6" /></label>
          <label>Bulk modulus K (MPa)<input name="K" type="number" step="any" value="3500" /></label>
        </div>
        <label>Case
          <MaterialSelect name="case" list={CASES} selected={D.caseSteel} />
        </label>
        <div class="row2">
          <label>CTE α<sub>c</sub> (µm/m·K)<input name="ac" type="number" step="any" value={steel.alpha} /></label>
          <label>Modulus (GPa)<input name="Ec" type="number" step="any" value={steel.E} /></label>
          <label>Poisson's ratio<input name="nu" type="number" step="any" value={steel.nu} /></label>
          <label>Case wall (mm)<input name="h" type="number" step="any" value="1.377" /></label>
        </div>
      </fieldset>
      <fieldset>
        <legend>Geometry &amp; loads</legend>
        <div class="row2">
          <label>Grain OD, 2b (mm)<input name="od" type="number" min="1" step="any" value="300" /></label>
          <label>Bore Ø, 2a (mm)<input name="bore" type="number" min="1" step="any" value="100" /></label>
          <label>Stress-free temp (°C)<input name="tsf" type="number" step="any" value="60" /></label>
          <label>Coldest service temp (°C)<input name="tlow" type="number" step="any" value="-40" /></label>
          <label>MEOP (MPa)<input name="p" type="number" min="0" step="any" value="10" /></label>
          <label>Bore strain conc. factor<input name="kt" type="number" min="1" step="0.1" value="1" /></label>
        </div>
        <p class="hint">Concentration factor: 1 for a circular bore; star points and slot tips are typically several times higher and need FEA.</p>
      </fieldset>
      <fieldset>
        <legend>Capability</legend>
        <div class="row2">
          <label>Strain cap., slow &amp; cold (%)<input name="capS" type="number" step="any" value="39.6" /></label>
          <label>Strain cap., ignition &amp; cold (%)<input name="capF" type="number" step="any" value="39.6" /></label>
          <label>Bond strength (MPa)<input name="bond" type="number" step="any" value="0.7" /></label>
          <label>Safety factor<input name="sf" type="number" min="1" step="0.1" placeholder="your value" autocomplete="off" /></label>
        </div>
        <p class="hint" data-caphint></p>
        <p class="hint">Enter your programme's safety factor: it comes from the governing requirement, not from this site.</p>
        <p class="hint example-note" data-example-note hidden></p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts">
        <div class="readout"><dt>m = b / a</dt><dd data-r="m">—</dd></div>
        <div class="readout"><dt>Web fraction</dt><dd data-r="wf">—</dd></div>
        <div class="readout"><dt>Case hoop strain at MEOP</dt><dd data-r="ch">—</dd></div>
      </dl>
      <p class="pv-sub">Bore hoop strain and margin</p>
      <dl class="readouts">
        <div class="readout" data-ms="th"><dt>Cool-down</dt><dd data-r="th">—</dd></div>
        <div class="readout" data-ms="pr"><dt>Pressurisation</dt><dd data-r="pr">—</dd></div>
        <div class="readout primary" data-ms="co"><dt>Cold ignition (sum)</dt><dd data-r="co">—</dd></div>
      </dl>
      <p class="pv-sub">Case bond, cool-down</p>
      <dl class="readouts">
        <div class="readout" data-ms="bd"><dt>Radial tension at bond</dt><dd data-r="bd">—</dd></div>
      </dl>
      <figure class="gs-fig">
        <svg viewBox="0 0 480 250" data-chart role="img" aria-label="Bore strain versus web fraction"></svg>
        <figcaption>Bore strain vs web fraction for this propellant, case and temperature. The dot is your design.</figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Closed-form screening (generalised plane strain, elastic, incompressible except for the bulk-modulus term in
    pressurisation). Ignores grain ends, stress-relief flaps, gravity slump, acceleration, thermal gradients, ageing and
    cumulative damage. Default capabilities are an illustrative curve from REF·DB v1, not data for any real propellant.
  </div>
  <script type="application/json" data-presets set:html={JSON.stringify({ PROPS, CASES, STEEL: steel })}></script>
</div>

<style is:global>
  .gscalc .pv-sub {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rd-muted);
    margin: 1rem 0 0.4rem !important;
  }
  .gs-fig { margin: 1rem 0 0 !important; }
  .gs-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .gs-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .gscalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
  .gscalc .pv-notes li.bad { color: var(--rd-accent); }
  .gscalc .pv-notes li.warn { color: var(--rd-warn); }
</style>

<script>
  import { grainStructure, strainCapability, type GrainStructInputs } from '../lib/grain';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 1) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  // Illustrative capability-vs-temperature curve from REF·DB v1 (smooth glass transition), in src/lib/grain.ts.
  const capCurve = (T: number, capWarm: number, capCold: number, tg: number) => strainCapability(T, { capWarm, capCold, tg });

  document.querySelectorAll<HTMLElement>('[data-gscalc]').forEach((root) => {
    const { PROPS, CASES, STEEL } = JSON.parse(root.querySelector('[data-presets]')!.textContent!);
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => +field(n).value;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };

    const applyProp = () => {
      const p = PROPS.find((x: any) => x.key === field('prop').value);
      field('ap').value = p.alpha; field('E').value = p.E;
      applyCap();
    };
    const applyCase = () => {
      const c = CASES.find((x: any) => x.key === field('case').value);
      field('ac').value = c.alpha; field('Ec').value = c.E; field('nu').value = c.nu;
    };
    const applyCap = () => {
      const p = PROPS.find((x: any) => x.key === field('prop').value);
      const cap = capCurve(num('tlow'), p.capWarm, p.capCold, p.tg);
      field('capS').value = cap.toFixed(1);
      field('capF').value = cap.toFixed(1);
      root.querySelector('[data-caphint]')!.textContent =
        `Filled from an illustrative ${p.name.toLowerCase()} curve at ${num('tlow')} °C. Replace with measured values for your propellant, aged, at the right rate and temperature.`;
    };

    function inputs(boreD = num('bore')): GrainStructInputs {
      return {
        boreD, od: num('od'),
        alphaP: num('ap') * 1e-6, alphaC: num('ac') * 1e-6,
        dT: num('tlow') - num('tsf'),
        eRelaxed: num('E'), bulkK: num('K'), pressure: num('p'),
        caseE: num('Ec') * 1000, caseNu: num('nu'), caseT: num('h'), kt: num('kt'),
      };
    }

    function run() {
      const notes: [string, string][] = [];
      if (!(num('bore') > 0 && num('od') > num('bore'))) {
        root.querySelector('[data-notes]')!.innerHTML = '<li class="bad">Bore diameter must be smaller than the grain OD.</li>';
        return;
      }
      const s = grainStructure(inputs());
      // Without a safety factor the strains still show; margins read NaN ("needs SF").
      const sf = readFactor(field('sf').value);
      const capS = num('capS') / 100, capF = num('capF') / 100;
      const ms = (cap: number, e: number) => (e > 0 ? (sf === null ? NaN : cap / (sf * e) - 1) : Infinity);
      const msTh = ms(capS, s.thermal), msPr = ms(capF, s.pressure), msCo = ms(capF, s.combined);
      const msBd = ms(num('bond'), s.bond);
      const MS = (v: number) => (Number.isNaN(v) ? 'needs SF' : Number.isFinite(v) ? `MS ${v >= 0 ? '+' : ''}${f(v, 2)}` : 'no tension');

      r('m').textContent = f(s.m, 2);
      r('wf').textContent = f(s.webFraction, 2);
      r('ch').textContent = `${f(s.caseHoop * 100, 2)} %`;
      r('th').innerHTML = `${f(s.thermal * 100, 1)} % <small>${MS(msTh)}</small>`;
      r('pr').innerHTML = `${f(s.pressure * 100, 1)} % <small>${MS(msPr)}</small>`;
      r('co').innerHTML = `${f(s.combined * 100, 1)} % <small>${MS(msCo)}</small>`;
      r('bd').innerHTML = `${f(s.bond, 3)} <small>MPa · ${MS(msBd)}</small>`;
      for (const [k, v] of [['th', msTh], ['pr', msPr], ['co', msCo], ['bd', msBd]] as const)
        root.querySelector(`[data-ms="${k}"]`)!.className = `readout ${k === 'co' ? 'primary ' : ''}${Number.isNaN(v) ? '' : v < 0 ? 'bad' : v < 0.25 ? 'warn' : 'ok'}`;

      if (sf === null) notes.push(['warn', `Strains are shown. ${awaitingMessage(['safety factor'], 'the margins')}`]);
      if (num('tlow') >= num('tsf')) notes.push(['', 'The service temperature is not below the stress-free temperature, so cool-down puts the bore in compression, not tension.']);
      if (msCo < 0) notes.push(['bad', `Cold ignition fails the screen: ${f(s.combined * 100, 1)}% × SF ${f(sf!, 1)} exceeds ${f(capF * 100, 1)}% capability. Options: a smaller web (larger bore), a propellant with more low-temperature strain capability, a stiffer case, a higher minimum firing temperature, or stress-relief features.`]);
      if (msBd < 0) notes.push(['bad', 'Bond tension exceeds the bond strength with this safety factor. Debonds usually start at the grain ends, where the stress is far higher than this long-cylinder value: that is what stress-relief flaps are for.']);
      if (num('kt') === 1) notes.push(['', 'Circular bore assumed. A star or slotted bore concentrates strain at its points: try a concentration factor of 2–3 to see what that does.']);
      if (s.pressure > 0 && s.caseHoop > 0) notes.push(['', `The case stretches ${f(s.caseHoop * 100, 2)}% at MEOP; the bore stretches ${f(s.pressure / s.caseHoop, 1)}× that. A stiffer or thicker case directly lowers ignition strain.`]);
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, t]) => `<li class="${c}">${t}</li>`).join('');
      chart(s.webFraction, capS, capF, sf);
    }

    function chart(wf0: number, capS: number, capF: number, sf: number | null) {
      const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
      svg.replaceChildren();
      const W = 480, H = 250, L = 46, R = 12, T = 12, B = 36;
      const od = num('od');
      const wfs = Array.from({ length: 61 }, (_, i) => 0.2 + (i / 60) * 0.65);
      const at = (wf: number) => grainStructure(inputs(od * (1 - wf)));
      const th = wfs.map((w) => at(w).thermal), co = wfs.map((w) => at(w).combined);
      const allow = Math.min(capS, capF) / (sf ?? 1);
      const yMax = Math.min(1.5, Math.max(...co, allow) * 1.1);
      const X = (w: number) => L + ((w - 0.2) / 0.65) * (W - L - R);
      const Y = (e: number) => H - B - (Math.min(e, yMax) / yMax) * (H - T - B);
      const step = yMax > 0.6 ? 0.2 : yMax > 0.3 ? 0.1 : 0.05;
      for (let e = 0; e <= yMax + 1e-9; e += step) {
        svg.append(el('line', { x1: L, x2: W - R, y1: Y(e), y2: Y(e), stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: L - 6, y: Y(e) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, `${Math.round(e * 100)}%`));
      }
      for (const w of [0.2, 0.4, 0.6, 0.8]) {
        svg.append(el('line', { x1: X(w), x2: X(w), y1: T, y2: H - B, stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: X(w), y: H - B + 14, 'text-anchor': w === 0.2 ? 'start' : 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, w.toFixed(1)));
      }
      svg.append(el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'web fraction  (b − a) / b'));
      const line = (ys: number[]) => wfs.map((w, i) => `${i ? 'L' : 'M'}${X(w).toFixed(1)},${Y(ys[i]).toFixed(1)}`).join('');
      svg.append(el('line', { x1: L, x2: W - R, y1: Y(allow), y2: Y(allow), stroke: 'var(--rd-accent)', 'stroke-dasharray': '6 4' }));
      svg.append(el('text', { x: L + 6, y: Y(allow) - 5, 'font-size': 10, fill: 'var(--rd-accent)' }, sf === null ? 'capability (no SF applied)' : 'capability ÷ SF'));
      svg.append(el('path', { d: line(th), fill: 'none', stroke: 'var(--rd-blue)', 'stroke-width': 2.5 }));
      svg.append(el('path', { d: line(co), fill: 'none', stroke: 'var(--rd-hot)', 'stroke-width': 2.5 }));
      svg.append(el('text', { x: W - R - 4, y: Y(co[co.length - 1]) + 14, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-hot)' }, 'cold ignition'));
      svg.append(el('text', { x: W - R - 4, y: Y(th[th.length - 1]) + 14, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-blue)' }, 'cool-down'));
      const me = at(wf0);
      if (wf0 >= 0.2 && wf0 <= 0.85)
        svg.append(el('circle', { cx: X(wf0), cy: Y(me.combined), r: 5.5, fill: 'var(--rd-panel)', stroke: 'var(--rd-ink)', 'stroke-width': 2.5 }));
    }

    field('prop').addEventListener('change', () => { applyProp(); run(); });
    field('case').addEventListener('change', () => { applyCase(); run(); });
    field('tlow').addEventListener('input', applyCap);
    form.addEventListener('input', run);
    wireWorkedExample({
      root, onLoad: () => { applyCap(); run(); }, factorFields: ['sf'],
      note: 'Worked-example safety factor loaded: 1.5',
      values: {
        prop: 'comp', case: STEEL.key, ap: '100', E: '3.6', K: '3500', ac: String(STEEL.alpha), Ec: String(STEEL.E), nu: String(STEEL.nu), h: '1.377',
        od: '300', bore: '100', tsf: '60', tlow: '-40', p: '10', kt: '1', bond: '0.7', sf: '1.5',
      },
    });
    applyCap();
    run();
  });
</script>
