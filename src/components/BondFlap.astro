---
// The aft end of a case-bonded grain in half section, cold: the case and its aft dome, the insulation, the liner and the
// propellant, and a stress-relief flap. The flap is bonded to the propellant but not to the insulation of the dome, so
// it opens as the grain shrinks toward its middle, and the bond ends at the root of the flap, in rubber. Schematic; the
// layers and the gap are drawn thicker than they are.
const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', hot = 'var(--rd-accent)', steel = 'var(--rd-steel)';
const AX = 262, BORE = 204; // the motor axis and the bore surface
// the inner surface of the insulation over the dome: a quadratic from the end of the cylinder to the boss
const Q = { p0: [236, 76], p1: [324, 80], p2: [372, 192] } as const;
const qb = (t: number) => [
  (1 - t) ** 2 * Q.p0[0] + 2 * (1 - t) * t * Q.p1[0] + t * t * Q.p2[0],
  (1 - t) ** 2 * Q.p0[1] + 2 * (1 - t) * t * Q.p1[1] + t * t * Q.p2[1],
] as const;
const qn = (t: number) => { // unit normal toward the inside of the motor
  const dx = 2 * (1 - t) * (Q.p1[0] - Q.p0[0]) + 2 * t * (Q.p2[0] - Q.p1[0]);
  const dy = 2 * (1 - t) * (Q.p1[1] - Q.p0[1]) + 2 * t * (Q.p2[1] - Q.p1[1]);
  const l = Math.hypot(dx, dy);
  return [-dy / l, dx / l] as const;
};
const pt = (p: readonly [number, number]) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`;
const off = (t: number, d: number) => [qb(t)[0] + qn(t)[0] * d, qb(t)[1] + qn(t)[1] * d] as const;
// the flap runs from its root to its tip along the dome; the gap opens toward the tip
const t0 = 0.05, t1 = 0.62, TH = 6, GAP = 9, N = 24;
const ts = Array.from({ length: N + 1 }, (_, k) => t0 + ((t1 - t0) * k) / N);
const gapAt = (t: number) => (GAP * (t - t0)) / (t1 - t0);
const flapOut = ts.map((t) => off(t, gapAt(t)));
const flapIn = ts.map((t) => off(t, gapAt(t) + TH));
const flap = `M${flapOut.map(pt).join(' L')} L${[...flapIn].reverse().map(pt).join(' L')} Z`;
const gap = `M${ts.map((t) => pt(qb(t))).join(' L')} L${[...flapOut].reverse().map(pt).join(' L')} Z`;
const tip = flapIn[N];
const endFoot = [tip[0] - 46, BORE] as const; // where the end face meets the bore
// the insulation thickens into the root of the flap; the propellant and the liner follow it
const RAMP = 196;
const ramp = `M${RAMP},76 L${pt(qb(t0))} L${pt(flapOut[0])} L${pt(flapIn[0])} L${RAMP},77 Z`;
const prop = `M0,78 L${RAMP},78 L${flapIn.map(pt).join(' L')} L${pt(endFoot)} L0,${BORE} Z`;
const liner = `M0,77 L${RAMP},77 L${flapIn.map(pt).join(' L')}`;
// case: the cylinder and the dome, and the boss; the insulation inside them
const caseUp = `M0,60 L236,60 Q338,62 392,188 L404,188 L404,234 L386,234 L386,196 Q330,68 236,67 L0,67 Z`;
const insul = `M0,67 L236,67 Q330,68 386,196 L372,196 Q324,80 236,76 L0,76 Z`;
const inhibitor = `M${pt(tip)} L${pt(endFoot)}`;
---

<figure class="viz bdf">
  <p class="viz-title">The end of a case-bonded grain, cold, with a stress-relief flap</p>
  <svg viewBox="0 0 440 280" role="img" aria-labelledby="bdf-desc" style="max-width: 640px; margin: 0 auto;">
    <desc id="bdf-desc">
      Half section through the aft end of a motor, cold. From the outside in: the case, which curves into the aft dome
      and ends at the boss; the insulation; the thin liner; and the propellant, with its bore along the bottom. Along the
      dome, a flap of insulation runs from its root, near the end of the cylinder, to its tip. The propellant is bonded
      to the inside of the flap. The outside of the flap is not bonded to the insulation of the dome, so as the cold grain
      shrinks toward its middle the flap opens and a gap appears between the flap and the dome. The bond between the
      propellant and the case ends at the root of the flap, in rubber. The end face of the grain is inhibited.
    </desc>
    <path d={caseUp} fill={steel} fill-opacity="0.6" stroke={muted}></path>
    <path d={insul} fill="var(--rd-insul)" fill-opacity="0.9"></path>
    <path d={ramp} fill="var(--rd-insul)" fill-opacity="0.9"></path>
    <path d={prop} fill="var(--rd-propellant)" fill-opacity="0.55"></path>
    <path d={gap} fill="var(--rd-panel)" stroke={hot} stroke-width="1" stroke-dasharray="3 2"></path>
    <path d={flap} fill="var(--rd-insul)" stroke={ink} stroke-width="0.8"></path>
    <path d={liner} fill="none" stroke={ink} stroke-width="2"></path>
    <path d={inhibitor} fill="none" stroke={hot} stroke-width="3"></path>
    <line x1="0" x2="440" y1={AX} y2={AX} stroke={muted} stroke-dasharray="10 3 2 3"></line>
    <!-- the grain shrinks toward its middle when cold -->
    <defs><marker id="bdf-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill={ink}></path></marker></defs>
    <line x1="232" x2="168" y1="150" y2="150" stroke={ink} stroke-width="2" marker-end="url(#bdf-a)"></line>
    <text x="164" y="140" text-anchor="end" font-size="11" fill={ink}>cold: the grain</text>
    <text x="164" y="154" text-anchor="end" font-size="11" fill={ink}>shrinks this way</text>
    <text x="60" y="186" font-size="12" fill={muted}>propellant</text>
    <text x="60" y="230" font-size="11" fill={muted}>bore</text>
    <!-- layer labels -->
    <line x1="40" x2="40" y1="34" y2="62" stroke={muted}></line>
    <text x="40" y="28" text-anchor="middle" font-size="11" fill={ink}>case</text>
    <line x1="104" x2="104" y1="34" y2="71" stroke={muted}></line>
    <text x="104" y="28" text-anchor="middle" font-size="11" fill={ink}>insulation</text>
    <line x1="176" x2="176" y1="34" y2="77" stroke={muted}></line>
    <text x="176" y="28" text-anchor="middle" font-size="11" fill={ink}>liner</text>
    <!-- flap labels -->
    <line x1="300" y1="30" x2={flapOut[2][0]} y2={flapOut[2][1] + 3} stroke={muted}></line>
    <text x="304" y="22" font-size="11" fill={ink}>flap root: the bond</text>
    <text x="304" y="36" font-size="11" fill={ink}>ends in rubber</text>
    <line x1="404" y1="72" x2={(qb(0.45)[0] + off(0.45, gapAt(0.45))[0]) / 2} y2={(qb(0.45)[1] + off(0.45, gapAt(0.45))[1]) / 2} stroke={muted}></line>
    <text x="436" y="54" text-anchor="end" font-size="11" fill={hot}>release layer:</text>
    <text x="436" y="68" text-anchor="end" font-size="11" fill={hot}>the gap opens</text>
    <line x1="300" y1="244" x2={(tip[0] + endFoot[0]) / 2} y2={(tip[1] + endFoot[1]) / 2} stroke={muted}></line>
    <text x="304" y="252" font-size="11" fill={ink}>grain end,</text>
    <text x="304" y="266" font-size="11" fill={ink}>inhibited</text>
    <line x1="256" y1="132" x2={flapIn[12][0] - 2} y2={flapIn[12][1] - 2} stroke={muted}></line>
    <text x="252" y="128" text-anchor="end" font-size="11" fill={ink}>flap</text>
  </svg>
  <figcaption>
    Cold, the grain shrinks toward its middle. In the cylinder the bond holds it. At the end, the flap lets the propellant
    pull away from the dome: the gap opens at the release layer, and the bond ends at the root of the flap, where rubber
    can take the stress. Without the flap, the bond would end at the edge of the propellant, its weakest place.
    Schematic; the layers and the gap are drawn thicker than they are.
  </figcaption>
</figure>
