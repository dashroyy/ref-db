---
// Grain flow in a closure with a boss: machined from plate, where the boss cuts across the grain, against a forging,
// where the grain follows the shape. Schematic.
const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', steel = 'var(--rd-steel)', bad = 'var(--rd-accent)', ok = 'var(--rd-ok)';
// outline of a closure half-section: flange at the left, boss rising at the right
const outline = (x: number) => `M${x},150 L${x},120 L${x + 40},120 L${x + 40},100 L${x + 110},100 L${x + 110},60 L${x + 140},60 L${x + 140},150 Z`;
const plateLines = [108, 116, 124, 132, 140, 72, 80, 88, 96];
---

<figure class="viz pgrain">
  <p class="viz-title">Grain flow: plate against forging</p>
  <svg viewBox="0 0 360 234" role="img" aria-labelledby="pgrain-desc" style="max-width: 520px; margin: 0 auto;">
    <desc id="pgrain-desc">
      Two half-sections of the same closure with a raised boss. Left, machined from plate: the grain lines are straight and
      horizontal, so the boss and the flange corner cut across them and the end grain is exposed at the fillets. Right,
      forged: the grain lines follow the outline into the boss and round the corners.
    </desc>
    <defs>
      <clipPath id="pg-a"><path d={outline(20)}></path></clipPath>
      <clipPath id="pg-b"><path d={outline(200)}></path></clipPath>
    </defs>
    <text x="90" y="26" text-anchor="middle" font-size="13" fill={ink}>Machined from plate</text>
    <text x="270" y="26" text-anchor="middle" font-size="13" fill={ink}>Forged</text>
    <path d={outline(20)} fill={steel} fill-opacity="0.35"></path>
    <g clip-path="url(#pg-a)">
      {plateLines.map((y) => <line x1="10" x2="170" y1={y} y2={y} stroke={ink} stroke-opacity="0.55" stroke-width="1.2"></line>)}
    </g>
    <path d={outline(20)} fill="none" stroke={ink} stroke-width="1.5"></path>
    <circle cx="130" cy="100" r="7" fill="none" stroke={bad} stroke-width="2"></circle>
    <circle cx="60" cy="120" r="7" fill="none" stroke={bad} stroke-width="2"></circle>
    <path d={outline(200)} fill={steel} fill-opacity="0.35"></path>
    <g clip-path="url(#pg-b)" fill="none" stroke={ink} stroke-opacity="0.55" stroke-width="1.2">
      {[0, 7, 14, 21, 28].map((d) => (
        <path d={`M196,${146 - d * 0.6} L${240 - d * 0.2},${146 - d * 0.6} Q${246 + d * 0.4},${116 + d * 0.3} ${262},${106 + d * 1.2} L${306 - d * 0.5},${106 + d * 1.2} Q${312 + d * 0.3},${70 + d} ${314 + d * 0.4},${56}`}></path>
      ))}
    </g>
    <path d={outline(200)} fill="none" stroke={ink} stroke-width="1.5"></path>
    <circle cx="310" cy="100" r="7" fill="none" stroke={ok} stroke-width="2"></circle>
    <text x="20" y="178" font-size="13" fill={bad}>end grain at the fillets</text>
    <text x="200" y="178" font-size="13" fill={ok}>grain follows the shape</text>
    <text x="20" y="206" font-size="13" fill={muted}>Short-transverse properties are the lowest:</text>
    <text x="20" y="222" font-size="13" fill={muted}>keep the main stress along the grain.</text>
  </svg>
  <figcaption>
    A forging puts the grain where the load is, and gives better fatigue and stress-corrosion resistance at the fillets.
    A part machined from plate or bar is faster to get, but it cuts the grain and exposes end grain at the corners. The
    allowables must be for the product form that you buy.
  </figcaption>
</figure>
