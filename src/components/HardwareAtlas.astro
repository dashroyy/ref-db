---
// Component atlas: a hardware half-section of a generic case-bonded motor. Select a part to see its job, loads,
// failure modes, materials (then → now) and what goes on its drawing. Schematic: proportions chosen for legibility.

type Link = { href: string; label: string };
const PARTS: { key: string; n: number; name: string; job: string; loads: string; fails: string; then: string; now: string; drawing: string; links: Link[] }[] = [
  { key: 'fwd', n: 1, name: 'Forward closure & igniter boss',
    job: 'Closes the forward end of the pressure vessel and carries the igniter boss, and, on most motors, the forward skirt load path.',
    loads: 'Pressure: membrane tension in the dome, bending where it meets the cylinder and around the boss. Igniter and port loads; handling.',
    fails: 'Discontinuity bending at the boss and the dome–cylinder junction; leaks past the boss seals; buckling of the knuckle of a thin ellipsoidal head, which carries compressive hoop stress.',
    then: 'Integral with a welded or forged steel case.',
    now: 'On composite cases, a metal polar boss (titanium, aluminium or steel) with fibre wound over it on a geodesic dome contour.',
    drawing: 'Boss thread class and seal-surface finish; dome contour; weld NDT where welded; the boss-to-composite interface. The igniter itself is energetics: this site covers only its boss, housing and seals.',
    links: [{ href: '../case-sizing/', label: 'Case sizing: domes' }] },
  { key: 'case', n: 2, name: 'Case (pressure shell)',
    job: 'The pressure vessel and, on most stages and missiles, the main airframe as well.',
    loads: 'Hoop and axial pressure stress; thrust; flight bending; heat soak-back after burnout; handling. Axial compression and external pressure when it is not pressurised.',
    fails: 'Burst; a flaw growing to critical size; buckling while unpressurised; impact damage on a composite case that cannot be seen from outside.',
    then: 'Welded ultra-high-strength steel (D6AC, maraging steels), or titanium on some upper stages.',
    now: 'Filament-wound carbon/epoxy on most high-performance motors (aramid/epoxy before it). Steel where cost, robustness or heritage wins.',
    drawing: 'Material and heat-treat specification, proof test, NDT and fracture-control class. For composites: fibre and resin specification, winding pattern and cure.',
    links: [{ href: '../case-sizing/', label: 'Case sizing' }, { href: '../../verify/proof-testing/', label: 'Proof testing' }] },
  { key: 'skirt', n: 3, name: 'Skirts',
    job: 'Cylindrical extensions that attach the motor to the vehicle and carry interface loads around the domes, so the pressure-carrying domes are not also bending.',
    loads: 'Thrust, bending and shear from the vehicle, plus the mismatch as the case grows under pressure and the skirt does not.',
    fails: 'Buckling; fastener and attach-ring failure; peel at the skirt-to-case bond.',
    then: 'Machined or forged integrally with a metal case.',
    now: 'On composite cases, bonded on through a rubber shear ply that lets the case grow without tearing the skirt off.',
    drawing: 'Interface hole pattern and datums from the vehicle ICD; bond preparation and shear-ply specification; fastener torques.',
    links: [{ href: '../../joints/load-paths/', label: 'Load paths & joints' }] },
  { key: 'joints', n: 4, name: 'Joints & seals',
    job: 'Join closures, nozzle and (in segmented motors) case segments, and keep the hot gas in.',
    loads: 'Pressure end load through pins, bolts or lock rings; joint rotation as the case balloons, which tries to open the seal gap.',
    fails: 'Joint rotation opening the gap faster than the O-ring can follow (Challenger, 1986); pin bearing and shear-out; hot gas finding a path through the insulation to the seals.',
    then: 'Single O-ring seals; tang-and-clevis pinned joints on segmented boosters.',
    now: 'Primary and secondary seals with a leak-check port between them; capture features that limit joint rotation; insulation shaped to keep gas away from the seals.',
    drawing: 'Groove dimensions and surface finish; seal compound and cure date; leak-check pressure and acceptance; fastener preload.',
    links: [{ href: '../../seals/o-ring-design/', label: 'O-ring design' }] },
  { key: 'insul', n: 5, name: 'Insulation, liner & flaps',
    job: 'Insulation keeps combustion gas off the case; the liner bonds the propellant to the insulation; stress-relief flaps let the grain ends move without tearing the bond.',
    loads: 'Heating, erosion and char from the gas side; grain shrinkage and pressurisation loads across the bondline.',
    fails: 'Burn-through; debonds that open a path for flame to reach the case.',
    then: 'Asbestos- and silica-filled nitrile rubber (NBR).',
    now: 'Aramid- or silica-filled EPDM: lower density, better ageing, no asbestos.',
    drawing: 'Thickness by zone; surface preparation, adhesive and liner specification; cure schedule; the NDT that verifies the bond.',
    links: [{ href: '../insulation/', label: 'Insulation & ablatives' }, { href: '../propellant-grain/', label: 'Grain: bondline stress' }] },
  { key: 'aft', n: 6, name: 'Aft closure',
    job: 'Carries the nozzle and its loads into the case through the aft polar boss.',
    loads: 'Pressure; the nozzle blow-off load; thrust-vector actuation and side loads; the hottest chamber gas, accelerating as it turns into the nozzle.',
    fails: 'Boss and joint failure under combined pressure and nozzle loads; insulation erosion where the flow turns into the nozzle.',
    then: 'Bolted steel closure.',
    now: 'Integral polar boss in metal or wound composite, with the nozzle often submerged into the case to shorten the motor.',
    drawing: 'Boss interface to the nozzle, seal grooves, bolt pattern and preload, and the aft-dome insulation: usually the thickest in the motor.',
    links: [{ href: '../insulation/', label: 'Insulation: aft dome' }] },
  { key: 'nozzle', n: 7, name: 'Nozzle structure',
    job: 'Holds the ablative liners in the right shape and carries pressure and thrust loads into the aft closure.',
    loads: 'Pressure on the convergent section; thrust; heat soaking through the liners; steering loads.',
    fails: 'Bondline overheating behind the liners; gas leaking along a liner-to-housing interface; ply lift in carbon-phenolic liners.',
    then: 'Steel housings.',
    now: 'Aluminium, titanium or composite housings; submerged nozzles.',
    drawing: 'Liner-to-housing bond and gap control; housing material and heat treatment; internal joint seals.',
    links: [{ href: '../insulation/', label: 'Nozzle ablatives' }] },
  { key: 'throat', n: 8, name: 'Throat insert',
    job: 'Holds the throat area (and so chamber pressure) steady while the hottest, fastest gas in the motor passes it.',
    loads: 'The highest heat flux in the motor; severe thermal shock at ignition; oxidation by H₂O and CO₂ in the exhaust.',
    fails: 'Erosion (throat area grows, so pressure and thrust fall); thermal-shock cracking; fragments ejected through the nozzle.',
    then: 'Bulk or pyrolytic graphite; refractory metals such as tungsten on small motors.',
    now: 'Carbon–carbon, often 3-D woven, for toughness under thermal shock at low mass.',
    drawing: 'Material grade and density; orientation of the reinforcement; fit to the housing at temperature as well as at assembly.',
    links: [{ href: '../../joints/differential-expansion/', label: 'Differential expansion' }] },
  { key: 'exit', n: 9, name: 'Exit cone',
    job: 'Expands the gas to supersonic speed, turning chamber pressure into exhaust velocity.',
    loads: 'Heat and erosion, falling with distance from the throat; side loads from flow separation when an over-expanded nozzle fires at sea level; vibration.',
    fails: 'Erosion and char; ply lift and delamination; structural failure under separation side loads.',
    then: 'Tape-wrapped carbon- and silica-phenolic over a metal shell.',
    now: 'Thin carbon–carbon cones that cool by radiating; extendible exit cones on upper stages, for a bigger expansion ratio in the same stowed length.',
    drawing: 'Ply angle and wrap specification; char and erosion allowances; attach flange and seal to the housing.',
    links: [{ href: '../insulation/', label: 'Nozzle ablatives' }] },
  { key: 'tvc', n: 10, name: 'Thrust vector control',
    job: 'Steers the vehicle by swivelling the thrust.',
    loads: 'Actuator loads; a flexible bearing carries the full nozzle blow-off load while it flexes; heat.',
    fails: 'Elastomer overheating or ageing in the bearing; actuator stall; torque rising at low temperature as the elastomer stiffens.',
    then: 'Jet vanes or jetavators in the exhaust, or liquid injected into the nozzle (Titan III’s solid boosters injected nitrogen tetroxide).',
    now: 'A movable nozzle on a flexible bearing (laminated elastomer pads and metal or composite shims that flex in shear) driven by actuators, increasingly electromechanical.',
    drawing: 'Elastomer compound and shim material; bearing stiffness and torque at temperature; actuator attach points.',
    links: [{ href: '../../fundamentals/viscoelasticity/', label: 'Viscoelasticity' }] },
];

// Material candidates, drawing notes and an example callout for each part (from REF·DB v1, rewritten).
const EXTRA: Record<string, { materials?: string[]; notes?: string[]; callout?: string }> = {
  fwd: {
    materials: [
      'D6AC, 15CDV6 or maraging 18Ni-250: the same steel as the case, so that the joint can be welded.',
      'Ti-6Al-4V: less mass. Isolate it from a steel case (see Galvanic corrosion).',
      'Al 2219-T87 or 7075-T73: low pressure, low temperature, and ground-test hardware.',
    ],
    notes: [
      'Large fillet radii into the boss, with their surface finish. Fatigue and fracture usually start here.',
      'For a forging, add a grain-flow requirement or a macro-etch acceptance. The bar specification alone is not sufficient.',
      'If it is welded to the case: the weld preparation, the procedure specification and the heat-treatment condition after welding. 15CDV6 and maraging steels tolerate welding better than D6AC.',
    ],
    callout: 'MATERIAL: 15CDV6 FORGING PER AIR 9160C, HEAT TREAT PER [PROCESS SPEC], UTS 980 MPa MIN\nNDT:      100% FPI PER ASTM E1417, SENSITIVITY LEVEL 3; MPI PER ASTM E1444\nMARK:     ETCH PART NO., ISSUE AND HEAT/BATCH NO. AT LOCATION SHOWN. STAMPING NOT PERMITTED.',
  },
  case: {
    materials: [
      'D6AC (AMS 6431, VAR melted): the classic. Weld, anneal, then heat treat.',
      '15CDV6: welds with almost no loss of properties, and needs no heat treatment after welding.',
      'Maraging 18Ni-250 or 300: the highest strength with good weldability, and almost no distortion when aged.',
      '4130: lower performance and ground-test hardware.',
      'Filament-wound carbon/epoxy (the highest efficiency), aramid/epoxy (more damage tolerant) or S-glass/epoxy (low cost).',
    ],
    notes: [
      'With composites, the process is the material: fibre and resin system, prepreg or wet winding, winding pattern and angles, fibre volume fraction, cure cycle and the boss interface. Two cases wound to one drawing with a different fibre tension do not burst at the same pressure.',
      'The wall thickness of a thin shell usually governs. Measure it by ultrasonic thickness mapping, not with a micrometer (see Gauging).',
      'Give the ultrasonic quality class of the billet or plate for a fracture-critical shell.',
      'Straightness, roundness and total runout of the bore control the insulation bond and the fit of the grain.',
      'Proof pressure and leak test are drawing requirements: refer to the test specification.',
    ],
    callout: 'MATERIAL: D6AC PER AMS 6431, VAR, HEAT TREAT TO 1520 MPa MIN UTS, DOUBLE TEMPER\nNDT:      WELDS 100% RT AND UT PER [SPEC], CLASS [X]; BODY MPI PER ASTM E1444\nTEST:     PROOF PRESSURE AND LEAK TEST PER [TEST SPEC]. NO PERMANENT SET.',
  },
  skirt: {
    materials: [
      'Machined integrally with a metal case, in the same alloy.',
      'On a composite case: aluminium, titanium or composite skirts, bonded through a rubber shear ply.',
    ],
    notes: [
      'The interface hole pattern comes from the vehicle ICD. Use datums that agree with the vehicle interface.',
      'Bond preparation, adhesive and shear-ply specification, and the inspection of the bond.',
    ],
  },
  insul: {
    materials: [
      'EPDM filled with aramid or silica: the standard internal insulation.',
      'Silica or carbon phenolic locally, where the heat flux or erosion is higher.',
      'Liner: the thin layer that bonds the propellant. Its formulation is energetics. The hardware drawing gives its geometry, surface preparation and inspection.',
    ],
    notes: [
      'You design a bondline, not a rubber part. Define the surface preparation (grit-blast specification, cleanliness, time limit before bonding), the adhesive or primer, the bondline thickness with its tolerance, the cure, and the NDT method and acceptance.',
      'A thickness that changes along the case: use a profile tolerance against the model, not a chain of ± thicknesses.',
      'Cleanliness: no silicone contamination near a bonding operation. A fingerprint from the wrong glove can cause a bond to fail.',
      'Inspection: tap test, ultrasonic or thermography, with an acceptance size and location for debonds.',
    ],
  },
  aft: {
    materials: [
      'The case steel (D6AC, 15CDV6, maraging) for a welded closure; Ti-6Al-4V, 17-4PH or 15-5PH for a bolted closure.',
      'Inconel 718 or 625 where the local gas temperature is too high for steel.',
    ],
    notes: [
      'Preload control for bolted joints: torque with the lubrication condition, or an angle or preload method. Positive locking is usually required.',
      'Seal grooves, the seal specification and the assembly condition. Redundant seals are usual: check the rules of your programme.',
      'Thread inserts in aluminium or titanium: the insert part number and the STI tapped hole, and the number of assemblies that it must survive.',
      'Edge distance and bolt spacing on the flange are strength-critical. Do not let the CAD default set them.',
    ],
    callout: 'BOLTS: 30 × M10 × 1.5 CLASS 12.9, TORQUE 60 N·m WITH [LUBRICANT], TIGHTEN IN THE SEQUENCE SHOWN\nLOCK:  [POSITIVE LOCKING METHOD] PER [SPEC]\nSEAL:  O-RING 139.29 × 5.33 [COMPOUND] PER ISO 3601-1, CURE DATE RECORDED; LEAK TEST PER [TEST SPEC]',
  },
  nozzle: {
    materials: [
      '4130 or 15CDV6 steel: welded shells and structure, low cost and tolerant.',
      'Ti-6Al-4V, Al 7075-T73 or 2219: brackets and structure away from the heat, where mass is important.',
      'A286 or Inconel 718: fasteners that must keep their preload when hot.',
    ],
    notes: [
      'Hot joints relax. Select the fastener alloy for its temperature, and specify positive locking.',
      'Do not change a fastener class or finish without engineering approval. Plating changes strength and friction, and hydrogen-embrittlement rules apply to high-strength steel.',
      'Where a bracket bolts to composite: specify the bearing area, the isolation and the torque separately.',
      'Position tolerances with datums that agree with the assembly fixture, not coordinates from convenient edges.',
    ],
  },
  throat: {
    materials: [
      'Bulk graphite: low cost, easy to machine, stronger when hot. It is brittle and weak in tension, so hold it in compression.',
      'Carbon–carbon: much tougher at a similar temperature capability, and light. It needs an oxidation coating for air exposure.',
      'Tungsten, W-Re or W-Cu: the best erosion resistance and melting point, but high mass.',
      'TZM molybdenum or Ta-10W: good hot strength and conductivity. Both need oxidation protection.',
      'Rhenium with an iridium coating: the highest capability, at the highest cost.',
    ],
    notes: [
      'Design it as an insert: a small refractory part in a lighter, lower-cost shell. The design problem is then the retention and the differential expansion across the joint.',
      'Graphite and carbon–carbon are anisotropic. Give the grain or ply direction relative to the axis on the drawing.',
      'Give the fit at a stated temperature. "⌀50 H7/p6" alone is not sufficient when the parts are hundreds of degrees apart in service (see Differential expansion).',
      'Specify the surface finish in the flow path, and handling and edge-chip acceptance for brittle materials.',
    ],
  },
  exit: {
    materials: [
      'Tape-wrapped carbon phenolic: the standard ablative liner. The wrap angle is a controlled parameter.',
      'Silica phenolic: lower cost, more erosion; for a lower heat flux.',
      'Carbon–carbon: light, expensive, and can be reused.',
      'C-103 niobium with a silicide coating: radiation-cooled extensions for upper stages. Without the coating it oxidises rapidly in air above approximately 400 °C.',
      'Inconel 625, Haynes 230 or Hastelloy X sheet, where the temperature permits.',
    ],
    notes: [
      'The contour is the function. Use a profile tolerance against the model, with datums that agree with how it mounts.',
      'Coated refractories: the coating specification, thickness, coverage and repair rules, and if the dimensions apply before or after coating.',
      'Thin shells distort. Give the free-state condition (ISO 10579) or the restrained inspection condition.',
    ],
  },
};

// Badge position and the point on the part its leader line touches.
const BADGES: Record<string, [number, number, number, number]> = {
  fwd: [92, 186, 158, 202], case: [430, 104, 430, 131], skirt: [176, 94, 192, 121], joints: [92, 276, 146, 259],
  insul: [330, 168, 330, 143], aft: [662, 206, 710, 214], nozzle: [800, 184, 790, 207], throat: [790, 293, 790, 276],
  exit: [905, 172, 890, 211], tvc: [752, 178, 746, 206],
};
---

<figure class="viz ha" data-atlas>
  <p class="viz-title">Motor hardware: half-section, schematic, not to scale</p>
  <svg viewBox="0 82 960 230" role="img" aria-labelledby="ha-desc" data-svg>
    <desc id="ha-desc">
      Upper half of a solid rocket motor, centreline at the bottom. From left: the igniter in the forward polar boss, the
      forward dome, the cylindrical case with skirts at each end, insulation and the propellant grain inside, the aft
      dome and polar boss, a flexible bearing, and the nozzle with its housing, throat insert and exit cone. Numbered
      markers select each component.
    </desc>
    <defs>
      <pattern id="ha-flex" width="5" height="6" patternUnits="userSpaceOnUse">
        <rect width="5" height="6" fill="#b08a2e"></rect>
        <rect width="2" height="6" fill="var(--rd-steel)"></rect>
      </pattern>
      <linearGradient id="ha-gas" x1="0" x2="1">
        <stop offset="0" stop-color="var(--rd-hot)" stop-opacity="0.05"></stop>
        <stop offset="0.75" stop-color="var(--rd-hot)" stop-opacity="0.22"></stop>
        <stop offset="1" stop-color="var(--rd-hot)" stop-opacity="0.05"></stop>
      </linearGradient>
    </defs>

    <!-- gas path and grain (context only) -->
    <path d="M190,240 L690,240 L722,230 L785,274 L795,274 L940,200 L940,300 L190,300 Z" fill="url(#ha-gas)"></path>
    <path d="M190,240 L190,177.5 A66,154 0 0 1 230,146 L640,146 A66,154 0 0 1 680,177.5 L680,240 Z"
      fill="var(--rd-propellant)" fill-opacity="0.35" stroke="var(--rd-propellant)" stroke-opacity="0.6"></path>
    <text x="435" y="200" text-anchor="middle" font-size="12" fill="var(--rd-muted)">propellant grain</text>
    <text x="435" y="272" text-anchor="middle" font-size="12" fill="var(--rd-muted)">bore: hot gas</text>
    <line x1="20" y1="300" x2="950" y2="300" stroke="var(--rd-muted)" stroke-dasharray="14 4 3 4"></line>
    <text x="24" y="294" font-size="10" fill="var(--rd-muted)">℄</text>

    <g class="ha-part" data-part="insul">
      <path d="M154.4,260 A78,163 0 0 1 230,137 L640,137 A78,163 0 0 1 710.4,230 L698.8,230 A66,154 0 0 0 640,146 L230,146 A66,154 0 0 0 166.3,260 Z" fill="var(--rd-insul)"></path>
      <path d="M606,149 L640,149 A63,151 0 0 1 668,181" fill="none" stroke="var(--rd-panel)" stroke-width="2.5"></path>
    </g>
    <g class="ha-part" data-part="case">
      <rect x="230" y="130" width="410" height="7" fill="var(--rd-steel)"></rect>
    </g>
    <g class="ha-part" data-part="fwd">
      <path d="M147.4,260 A85,170 0 0 1 230,130 L230,137 A78,163 0 0 0 154.4,260 Z" fill="var(--rd-steel)"></path>
      <rect x="134" y="244" width="30" height="16" fill="var(--rd-steel)"></rect>
      <rect x="118" y="274" width="92" height="26" rx="3" fill="#7d858c"></rect>
      <rect x="130" y="260" width="22" height="14" fill="#7d858c"></rect>
    </g>
    <g class="ha-part" data-part="aft">
      <path d="M640,130 A85,170 0 0 1 717.5,230 L710.4,230 A78,163 0 0 0 640,137 Z" fill="var(--rd-steel)"></path>
      <rect x="704" y="212" width="34" height="18" fill="var(--rd-steel)"></rect>
    </g>
    <g class="ha-part" data-part="skirt">
      <rect x="150" y="121" width="112" height="8" fill="var(--rd-steel)" fill-opacity="0.75"></rect>
      <rect x="610" y="121" width="120" height="8" fill="var(--rd-steel)" fill-opacity="0.75"></rect>
      <rect x="230" y="129" width="32" height="1.6" fill="#b08a2e"></rect>
      <rect x="610" y="129" width="30" height="1.6" fill="#b08a2e"></rect>
    </g>
    <g class="ha-part" data-part="tvc">
      <rect x="738" y="206" width="14" height="26" fill="url(#ha-flex)"></rect>
    </g>
    <g class="ha-part" data-part="nozzle">
      <polygon points="752,206 806,206 812,248 770,248 770,251.5 752,238.9" fill="var(--rd-steel)"></polygon>
      <polygon points="722,230 770,263.5 770,251.5 722,218" fill="#4a3b33"></polygon>
    </g>
    <g class="ha-part" data-part="throat">
      <polygon points="770,263.5 785,274 795,274 805,268.9 805,248 770,248" fill="#2b2f33" stroke="#5a6168" stroke-width="0.8"></polygon>
    </g>
    <g class="ha-part" data-part="exit">
      <polygon points="805,268.9 940,200 940,190 805,258" fill="#4a3b33"></polygon>
      <polygon points="805,258 940,190 940,186 805,254" fill="var(--rd-steel)"></polygon>
    </g>
    <g class="ha-part" data-part="joints">
      <circle cx="146" cy="259" r="3.6" fill="var(--rd-accent)"></circle>
      <circle cx="712" cy="233" r="3.6" fill="var(--rd-accent)"></circle>
      <circle cx="808" cy="252" r="3.6" fill="var(--rd-accent)"></circle>
    </g>

    {PARTS.map((p) => {
      const [bx, by, tx, ty] = BADGES[p.key];
      return (
        <g class="ha-badge" data-badge={p.key}>
          <line x1={bx} y1={by} x2={tx} y2={ty} stroke="var(--rd-muted)" stroke-width="1"></line>
          <circle cx={bx} cy={by} r="11"></circle>
          <text x={bx} y={by + 4} text-anchor="middle" font-size="11" font-weight="700">{p.n}</text>
        </g>
      );
    })}
    <g font-size="10" fill="var(--rd-muted)">
      <circle cx="830" cy="98" r="3.6" fill="var(--rd-accent)"></circle><text x="840" y="102">seal</text>
      <rect x="870" y="93" width="12" height="10" fill="url(#ha-flex)"></rect><text x="888" y="102">flex bearing</text>
    </g>
  </svg>

  <div class="ha-chips" role="tablist" aria-label="Motor components">
    {PARTS.map((p, i) => (
      <button type="button" role="tab" class="chip" data-pick={p.key} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`ha-card-${p.key}`}>
        <b>{p.n}</b> {p.name}
      </button>
    ))}
  </div>

  {PARTS.map((p, i) => (
    <section class="ha-card" id={`ha-card-${p.key}`} data-card={p.key} role="tabpanel" hidden={i !== 0}>
      <h4><span>{p.n}</span>{p.name}</h4>
      <p class="ha-job">{p.job}</p>
      <dl>
        <div><dt>Carries</dt><dd>{p.loads}</dd></div>
        <div><dt>Fails by</dt><dd>{p.fails}</dd></div>
        <div><dt>Then</dt><dd>{p.then}</dd></div>
        <div><dt>Now</dt><dd>{p.now}</dd></div>
        <div class="wide"><dt>On the drawing</dt><dd>{p.drawing}</dd></div>
      </dl>
      {EXTRA[p.key]?.materials && (
        <div class="ha-more"><p class="ha-h">Material candidates</p><ul>{EXTRA[p.key].materials!.map((m) => <li>{m}</li>)}</ul></div>
      )}
      {EXTRA[p.key]?.notes && (
        <div class="ha-more"><p class="ha-h">Drawing notes</p><ul>{EXTRA[p.key].notes!.map((m) => <li>{m}</li>)}</ul></div>
      )}
      {EXTRA[p.key]?.callout && (
        <div class="ha-more"><p class="ha-h">Example callout (illustrative)</p><pre class="ha-callout">{EXTRA[p.key].callout}</pre></div>
      )}
      <p class="ha-links">Go deeper: {p.links.map((l, j) => <>{j > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}</p>
    </section>
  ))}
  <figcaption>Select a number on the drawing or a name above. Proportions are for legibility only: no design dimensions implied.</figcaption>
</figure>

<style is:global>
  .ha svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .ha .ha-part { cursor: pointer; transition: opacity 0.2s; }
  .ha svg.has-sel .ha-part:not(.on) { opacity: 0.55; }
  .ha .ha-part.on > * { stroke: var(--sl-color-white); stroke-width: 1.6; }
  .ha .ha-badge { cursor: pointer; }
  .ha .ha-badge circle { fill: var(--rd-panel); stroke: var(--pc, var(--sl-color-accent)); stroke-width: 2; }
  .ha .ha-badge text { fill: var(--rd-ink); pointer-events: none; }
  .ha .ha-badge.on circle { fill: var(--pc, var(--sl-color-accent)); }
  .ha .ha-badge.on text { fill: var(--sl-color-black); }
  .ha-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.75rem 0 0 !important; }
  .ha-chips .chip {
    font-family: var(--sl-font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--rd-ink);
    background: transparent; border: 1px solid var(--rd-line); border-radius: 4px; padding: 0.25rem 0.55rem; cursor: pointer;
  }
  .ha-chips .chip:hover { border-color: var(--pc, var(--sl-color-accent)); }
  .ha-chips > * { margin: 0 !important; }
  .ha-chips .chip b { color: var(--pc, var(--sl-color-accent)); margin-right: 0.15rem; }
  .ha-chips .chip[aria-selected='true'] { border-color: var(--pc, var(--sl-color-accent)); color: var(--sl-color-white); background: color-mix(in srgb, var(--pc, var(--sl-color-accent)) 18%, transparent); }
  .ha-card { margin: 0.75rem 0 0 !important; padding: 0.9rem 1rem; border: 1px solid var(--rd-line); border-left: 3px solid var(--pc, var(--sl-color-accent)); border-radius: 6px; background: var(--rd-panel); }
  .ha-card h4 { margin: 0 !important; font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem; }
  .ha-card h4 span { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--pc, var(--sl-color-accent)); color: var(--sl-color-black); font-family: var(--sl-font-mono); font-size: 0.8rem; }
  .ha-card .ha-job { margin: 0.5rem 0 0 !important; font-size: var(--sl-text-sm); }
  .ha-card dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.6rem 1rem; margin: 0.75rem 0 0 !important; }
  .ha-card dl > div { margin: 0 !important; }
  .ha-card dl .wide { grid-column: 1 / -1; }
  .ha-card dt { font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--rd-muted); }
  .ha-card dd { margin: 0.15rem 0 0 !important; font-size: var(--sl-text-sm); }
  .ha-card .ha-more { margin: 0.75rem 0 0 !important; }
  .ha-card .ha-h { font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--rd-muted); margin: 0 !important; }
  .ha-card .ha-more ul { margin: 0.25rem 0 0 !important; padding-left: 1.1rem; font-size: var(--sl-text-sm); }
  .ha-card .ha-more li { margin: 0.15rem 0 0 !important; }
  .ha-card .ha-callout { margin: 0.3rem 0 0 !important; font-size: 0.72rem; line-height: 1.5; white-space: pre; overflow-x: auto; background: var(--rd-panel2, var(--rd-panel)); border: 1px solid var(--rd-line); border-radius: 4px; padding: 0.5rem 0.6rem; }
  .ha-card .ha-links { margin: 0.75rem 0 0 !important; font-size: var(--sl-text-sm); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-atlas]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const select = (key: string, focus = false) => {
      svg.classList.add('has-sel');
      root.querySelectorAll<SVGGElement>('[data-part]').forEach((g) => g.classList.toggle('on', g.dataset.part === key));
      root.querySelectorAll<SVGGElement>('[data-badge]').forEach((g) => g.classList.toggle('on', g.dataset.badge === key));
      root.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
        const on = b.dataset.pick === key;
        b.setAttribute('aria-selected', String(on));
        if (on && focus) b.focus();
      });
      root.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => (c.hidden = c.dataset.card !== key));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => select(b.dataset.pick!)));
    root.querySelectorAll<SVGGElement>('[data-part]').forEach((g) => g.addEventListener('click', () => select(g.dataset.part!)));
    root.querySelectorAll<SVGGElement>('[data-badge]').forEach((g) => g.addEventListener('click', () => select(g.dataset.badge!)));
    // Arrow keys move between tabs, as for any tab list.
    const keys = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')].map((b) => b.dataset.pick!);
    root.querySelector('.ha-chips')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      const cur = keys.indexOf((document.activeElement as HTMLElement)?.dataset.pick ?? keys[0]);
      select(keys[(cur + (ev.key === 'ArrowRight' ? 1 : keys.length - 1)) % keys.length], true);
      ev.preventDefault();
    });
    select(keys[0]);
  });
</script>
