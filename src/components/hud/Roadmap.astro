---
// Roadmap, derived from the zone plan: status comes from REBUILT/PRIMERS, numbers
// from ZONE_PLAN order. Only the wave order and notes are written here — by zone key.
import { PHASES, route, hrefOf } from '../../data/zones.mjs';

const base = import.meta.env.BASE_URL;
const items = route();
const byKey = Object.fromEntries(items.map((i) => [i.key, i]));

const WAVES = [
  { n: 'Wave 1: Solid rocket motor core', why: 'The reason this site exists, so it goes first.',
    keys: ['primer-srm', 'pv', 'primer-composite', 'grain', 'ablative', 'primer-nozzle', 'proof', 'rocket', 'propellant', 'thermal', 'lbb', 'buckling', 'visco', 'ageing'] },
  { n: 'Wave 2: Materials', why: 'Selection, data and how to call it up.',
    keys: ['materials', 'xref', 'matspec', 'trade', 'sheet', 'allow', 'metal', 'fatigue', 'cryo', 'density', 'plastics', 'elast', 'coat', 'galvanic'] },
  { n: 'Wave 3: Joints, seals and features', why: 'Where pressure hardware actually leaks or loosens.',
    keys: ['oring', 'sealstrat', 'bolts', 'threads', 'locking', 'loadpath', 'diffexp', 'residual', 'handcalc'] },
  { n: 'Wave 4: Verification', why: 'Proving it survives.',
    keys: ['margins', 'vibration', 'feamat', 'fea', 'correl'] },
  { n: 'Wave 5: Drawing, manufacture and inspection', why: 'Turning the design into parts that pass inspection.',
    keys: ['gdt', 'gdtprac', 'fits', 'stack', 'surf', 'gauge', 'process', 'cost', 'weld', 'ndt', 'leak', 'certs'] },
  { n: 'Wave 6: Process, standards and tools', why: 'Everything around the design itself.',
    keys: ['home', 'reqs', 'duty', 'risk', 'sandbox', 'worked', 'read', 'access', 'standards', 'guides', 'drawing', 'release', 'export'] },
];

const NOTES: Record<string, string> = {
  home: 'Replaced by the mission-control home page',
};

// Every zone must appear in exactly one wave (guards against a zone being forgotten).
const listed = new Set(WAVES.flatMap((w) => w.keys));
const missing = items.filter((i) => !listed.has(i.key)).map((i) => i.key);
if (missing.length) throw new Error(`Roadmap is missing zones: ${missing.join(', ')}`);
const done = items.filter((i) => !i.primer && i.slug !== null).length;
const total = items.filter((i) => !i.primer).length;
---

<div class="rm-sum">
  <span class="rm-bar" aria-hidden="true"><i style={`width:${(done / total) * 100}%`}></i></span>
  <span>{done} of {total} zones rebuilt · {items.filter((i) => i.primer).length} primer page{items.filter((i) => i.primer).length === 1 ? '' : 's'}</span>
</div>

{WAVES.map((w) => (
  <section class="rm-wave">
    <h2>{w.n}</h2>
    <p>{w.why}</p>
    <ul class="rm-list">
      {w.keys.map((k) => byKey[k]).map((z) => {
        const ph = PHASES.find((p) => p.k === z.phase)!;
        const status = z.slug !== null ? 'done' : NOTES[z.key] ? 'part' : 'todo';
        return (
          <li class:list={['rm-row', status]} style={`--pc: var(--ph-${ph.k})`}>
            <span class="rm-tag">{z.tag}</span>
            <a href={hrefOf(z, base)}>{z.label}</a>
            <span class="rm-ph">{ph.n}</span>
            <span class="rm-st">{status === 'done' ? '✓ v2' : status === 'part' ? '◐ partly' : '○ v1'}</span>
            {NOTES[z.key] && <span class="rm-note">{NOTES[z.key]}</span>}
          </li>
        );
      })}
    </ul>
  </section>
))}

<style>
  .rm-sum { display: grid; gap: 0.4rem; font-family: var(--sl-font-mono); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--sl-color-gray-2); }
  .rm-bar { height: 4px; background: var(--hud-edge); border-radius: 2px; overflow: hidden; }
  .rm-bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--sl-color-accent), var(--rd-blue)); }
  .rm-list { list-style: none; padding: 0; display: grid; gap: 2px; }
  .rm-row {
    display: grid; grid-template-columns: 3rem 1fr auto 5.5rem; gap: 0.2rem 0.75rem; align-items: center; margin: 0 !important;
    padding: 0.35rem 0.6rem; border-left: 3px solid var(--pc); background: color-mix(in srgb, var(--pc) 6%, transparent);
    font-family: var(--sl-font-mono); font-size: 0.75rem; letter-spacing: 0.04em;
  }
  .rm-row.todo { border-left-style: dashed; background: transparent; }
  .rm-tag { color: var(--pc); }
  .rm-row a { color: var(--sl-color-white); text-decoration: none; }
  .rm-row.todo a { color: var(--sl-color-gray-2); }
  .rm-row a:hover { color: var(--pc); }
  .rm-ph { font-size: 0.62rem; color: var(--sl-color-gray-3); letter-spacing: 0.12em; }
  .rm-st { text-align: right; }
  .rm-row.done .rm-st { color: var(--rd-ok); }
  .rm-row.part .rm-st { color: var(--rd-warn); }
  .rm-row.todo .rm-st { color: var(--sl-color-gray-4); }
  .rm-note { grid-column: 2 / -1; font-family: var(--sl-font); font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); letter-spacing: 0; }
  @media (max-width: 40rem) { .rm-row { grid-template-columns: 2.6rem 1fr auto; } .rm-ph { display: none; } }
</style>
