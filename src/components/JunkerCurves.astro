---
// Preload under transverse vibration, by locking method — schematic shapes of the behaviour summarised in
// NASA-STD-5020B Appendix B (safety wire: some loss until taut; prevailing torque: captive, not preloaded;
// cured adhesive: holds well; nothing or a split washer: lost). Not test data.
const curves = [
  { key: 'noslip', label: 'enough preload that nothing slips', color: 'var(--rd-ok)', f: (_x: number) => 1, dash: '' },
  { key: 'adhesive', label: 'adhesive, cured', color: 'var(--rd-blue)', f: (x: number) => 1 - 0.09 * (1 - Math.exp(-x / 0.1)), dash: '' },
  { key: 'wire', label: 'safety wire / cotter pin', color: 'var(--rd-warn)', f: (x: number) => 1 - 0.3 * (1 - Math.exp(-x / 0.05)), dash: '' },
  { key: 'pt', label: 'prevailing torque', color: '#c79bff', f: (x: number) => 0.14 + 0.86 * Math.exp(-x / 0.1), dash: '' },
  { key: 'none', label: 'none, or split washer', color: 'var(--rd-accent)', f: (x: number) => Math.exp(-x / 0.06), dash: '6 4' },
];
const W = 340, H = 256, L = 44, R = 10, T = 24, B = 36;
const X = (x: number) => L + x * (W - L - R), Y = (y: number) => T + (1 - y) * (H - T - B);
const path = (f: (x: number) => number) => Array.from({ length: 121 }, (_, i) => i / 120).map((x, i) => `${i ? 'L' : 'M'}${X(x).toFixed(1)},${Y(f(x)).toFixed(1)}`).join('');
// label positions: at the right end, except the top line, which is labelled at the left
const lab: Record<string, { x: number; y: number; anchor: string }> = {
  noslip: { x: X(0.02), y: Y(1) - 6, anchor: 'start' },
  adhesive: { x: X(0.98), y: Y(0.91) - 7, anchor: 'end' },
  wire: { x: X(0.98), y: Y(0.7) - 7, anchor: 'end' },
  pt: { x: X(0.98), y: Y(0.14) - 7, anchor: 'end' },
  none: { x: X(0.3), y: Y(0.02) - 7, anchor: 'start' },
};
---

<figure class="viz">
  <p class="viz-title">Preload under transverse vibration: schematic</p>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="jk-desc" style="max-width: 440px; margin: 0 auto;">
    <desc id="jk-desc">
      Schematic curves of remaining preload against vibration cycles. A joint with enough preload that nothing slips keeps
      all of it. A cured adhesive keeps most of it. Safety wire or a cotter pin loses about a third until taut, then holds.
      A prevailing-torque feature loses most of it but keeps the fastener captive. With no locking feature, or a split
      washer, the preload is lost entirely.
    </desc>
    {[0, 0.25, 0.5, 0.75, 1].map((v) => (
      <g>
        <line x1={L} x2={W - R} y1={Y(v)} y2={Y(v)} stroke="var(--rd-line)"></line>
        <text x={L - 6} y={Y(v) + 4} text-anchor="end" font-size="12" fill="var(--rd-muted)">{Math.round(v * 100)}%</text>
      </g>
    ))}
    <text x={(L + W - R) / 2} y={H - 10} text-anchor="middle" font-size="12" fill="var(--rd-ink)">vibration cycles →</text>
    {curves.map((c) => <path d={path(c.f)} fill="none" stroke={c.color} stroke-width="2.4" stroke-dasharray={c.dash || undefined}></path>)}
    {curves.map((c) => (
      <text x={lab[c.key].x} y={lab[c.key].y} text-anchor={lab[c.key].anchor} font-size="13" fill={c.color}
        stroke="var(--rd-panel)" stroke-width="4" paint-order="stroke">{c.label}</text>
    ))}
  </svg>
  <figcaption>
    Schematic, not test data: the shapes reported for transverse-vibration (Junker) tests and summarised in
    NASA-STD-5020B. Safety wire allows rotation until it is taut: the standard cites about 30% preload loss in severe
    vibration. A prevailing-torque feature keeps the part captive rather than preloaded. The best lock is a joint that
    never slips.
  </figcaption>
</figure>
