---
// Coatings in three tabs: limits before coating for a diameter or thread; the preload change when a finish changes the
// friction; and the life of a sacrificial zinc coating by ISO 9223 category. Maths in src/lib/coatings.ts
// (unit-tested); UI only here.
import { FINISHES, FEATURES, CATEGORIES } from '../lib/coatings';
import { THREADS } from '../lib/bolts';

const TABS = [{ key: 'dim', name: 'Dimensions' }, { key: 'tq', name: 'Friction and torque' }, { key: 'life', name: 'Zinc life' }];
---

<div class="calc coatcalc" data-coatcalc>
  <div class="calc-head"><span>Coating</span><span class="head-btns"><span>build-up · torque · ISO 9223</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Coating">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="dim">
        <legend>Feature and finish</legend>
        <div class="row2">
          <label class="wide">Feature<select name="ft">{FEATURES.map((f) => <option value={f.key} selected={f.key === 'te'}>{f.name}</option>)}</select></label>
          <label class="wide">Finish<select name="fin">{FINISHES.map((f) => <option value={f.key} selected={f.key === 'flake'}>{f.name}</option>)}</select></label>
          <label>Build-up fraction (outward)<input name="out" type="number" min="0" max="1" step="any" value="1" /></label>
          <label>Thickness, minimum (µm)<input name="tmin" type="number" min="0" step="any" value="8" /></label>
          <label>Thickness, maximum (µm)<input name="tmax" type="number" min="0" step="any" value="12" /></label>
          <label>After coating, minimum (mm)<input name="lmin" type="number" step="any" value="8.862" /></label>
          <label>After coating, maximum (mm)<input name="lmax" type="number" step="any" value="9.026" /></label>
        </div>
        <p class="hint">A diameter changes by twice the build-up; the pitch diameter of a 60° thread by four times it. The limits after coating come from the drawing.</p>
      </fieldset>

      <fieldset data-panel="tq" hidden>
        <legend>Bolt, torque and friction</legend>
        <div class="row2">
          <label>Thread<select name="th">{THREADS.map((t) => <option value={t.name} selected={t.name === 'M10'}>{t.name} × {t.P}</option>)}</select></label>
          <label>Torque (N·m)<input name="T" type="number" min="0.1" step="any" value="60" /></label>
          <label>Head bearing diameter (mm)<input name="dw" type="number" min="1" step="any" value="15" /></label>
          <label>Clearance hole (mm)<input name="dh" type="number" min="1" step="any" value="11" /></label>
          <label>Friction the joint was sized with<input name="mu0" type="number" min="0.02" max="0.6" step="any" value="0.12" /></label>
          <label>Coated, minimum friction<input name="mu1" type="number" min="0.02" max="0.6" step="any" value="0.09" /></label>
          <label>Coated, maximum friction<input name="mu2" type="number" min="0.02" max="0.6" step="any" value="0.14" /></label>
        </div>
        <p class="hint">One friction coefficient on the thread and under the head. Get the range of the coated parts from the coating maker or a torque–tension test (ISO 16047).</p>
      </fieldset>

      <fieldset data-panel="life" hidden>
        <legend>Sacrificial coating and environment</legend>
        <div class="row2">
          <label>Zinc thickness (µm)<input name="zt" type="number" min="0" step="any" value="10" /></label>
          <label>Rate relative to zinc<input name="rel" type="number" min="0.01" step="any" value="1" /></label>
          <label class="wide">Corrosivity category (ISO 9223)<select name="cat">{CATEGORIES.map((c) => <option value={c.key} selected={c.key === 'C3'}>{c.name}</option>)}</select></label>
          <label>Required life (years)<input name="req" type="number" min="0" step="any" placeholder="your value" /></label>
        </div>
        <p class="hint">The rates are for zinc in the first year. Zinc alloys and zinc flake with a topcoat corrode more slowly: enter their rate relative to zinc from the coating maker’s data.</p>
      </fieldset>
      <p class="hint example-note" data-example-note hidden></p>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 240" data-chart role="img" aria-label="Chart for the selected coating check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Screening only: uniform coating thickness, a fixed build-up fraction, one friction coefficient for the thread and
    the head, and constant zinc corrosion rates. The governing values come from the coating specification, a
    torque–tension test and the coating maker’s data.
  </div>
</div>

<style is:global>
  .coatcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .coatcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
  .coatcalc .pv-notes li.bad { color: var(--rd-accent); }
  .coatcalc .pv-notes li.warn { color: var(--rd-warn); }
  .coatcalc .example-note { margin: 0.5rem 0 0 !important; }
  .coatcalc label.wide { grid-column: 1 / -1; }
  .coatcalc select { width: 100%; }
</style>

<script>
  import { finish, preCoat, frictionChange, preloadAt, zincLife, CATEGORIES } from '../lib/coatings';
  import { THREADS } from '../lib/bolts';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 0) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const pct = (v: number) => `${v >= 0 ? '+' : '−'}${f(Math.abs(v) * 100)}%`;
  const yrs = (y: number) => (!Number.isFinite(y) ? 'no limit' : y >= 100 ? 'more than 100' : f(y, y < 10 ? 1 : 0));
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-coatcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => { const s = field(n).value.trim(); return s === '' ? NaN : +s; };
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const txt = (x: number, y: number, s: string, c = 'var(--rd-ink)', anchor = 'start', fs = 10) =>
      el('text', { x, y, 'text-anchor': anchor, 'font-size': fs, fill: c, stroke: 'var(--rd-panel)', 'stroke-width': 3, 'paint-order': 'stroke' }, s);
    const width = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    const frame = (H: number) => { svg.replaceChildren(); const W = width(); svg.setAttribute('viewBox', `0 0 ${W} ${H}`); return W; };
    const nice = (m: number) => { const e = 10 ** Math.floor(Math.log10(m)); return [1, 2, 2.5, 5, 10].map((k) => k * e).find((s) => m / s <= 6)!; };
    const line = (pts: [number, number][], c: string, w = 2, dash = '') => el('polyline', { points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), fill: 'none', stroke: c, 'stroke-width': w, 'stroke-dasharray': dash });
    let mode = 'dim';
    let draw: (() => void) | null = null;

    // ---- dimensions ----
    function runDim(rows: Row[], notes: [string, string][]) {
      const out = num('out'), tMin = num('tmin'), tMax = num('tmax'), min = num('lmin'), max = num('lmax');
      if (!(out >= 0 && out <= 1 && tMin >= 0 && tMax >= tMin && max > min)) { notes.push(['bad', 'Enter a build-up fraction from 0 to 1, a thickness range, and limits after coating with the maximum above the minimum.']); return null; }
      const r = preCoat({ feature: field('ft').value, out, tMin, tMax, min, max });
      const d = (v: number) => f(v, 3);
      rows.push({ dt: 'Limits before coating', dd: r.ok ? `${d(r.min)} to ${d(r.max)} mm <small>tolerance ${f(r.tol * 1000)} µm of the ${f((max - min) * 1000)} µm after coating</small>` : 'none possible <small>the thickness range is larger than the tolerance</small>', primary: true, cls: r.ok ? (r.used > 0.5 ? 'warn' : 'ok') : 'bad' });
      rows.push({ dt: 'Change of the dimension', dd: `${r.f.sign > 0 ? '+' : '−'}${f(r.gMin * 1000)} to ${f(r.gMax * 1000)} µm <small>${r.f.k} × ${f(out, 2)} × the thickness</small>` });
      rows.push({ dt: 'Tolerance used by the coating', dd: `${f(Math.min(r.used, 9.99) * 100)}% <small>from the thickness range of ${f(tMax - tMin)} µm</small>`, cls: r.used > 0.5 ? 'warn' : '' });
      if (!r.ok) notes.push(['bad', 'No machined size can give the final limits. Specify a smaller thickness range, a larger tolerance, or machine after coating (hard chrome and thick anodise are often ground).']);
      else if (r.used > 0.5) notes.push(['warn', 'The coating uses more than half of the tolerance. Specify a smaller thickness range, or machine after coating.']);
      if (r.f.k === 4) notes.push(['', 'ISO 965-1 gives the positions e, f and g to leave room for a coating. After coating, the thread must still accept the GO gauge of position h (H for a nut).']);
      return () => {
        const H = 200, W = frame(H), L = 14, R = 14;
        const lo = Math.min(min, r.min) - 0.15 * (max - min), hi = Math.max(max, r.max) + 0.15 * (max - min);
        const X = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
        const band = (y: number, a: number, b: number, c: string, label: string, sub: string) => {
          el('rect', { x: X(a), y, width: Math.max(1, X(b) - X(a)), height: 22, rx: 3, fill: c, 'fill-opacity': 0.55 });
          txt(L, y - 6, label, 'var(--rd-ink)');
          txt(W - R, y - 6, sub, 'var(--rd-muted)', 'end');
        };
        band(40, min, max, 'var(--rd-ok)', 'after coating (drawing)', `${f(min, 3)} to ${f(max, 3)}`);
        if (r.ok) band(100, r.min, r.max, 'var(--rd-blue)', 'before coating', `${f(r.min, 3)} to ${f(r.max, 3)}`);
        else txt(L, 112, 'no size before coating works', 'var(--rd-accent)');
        el('line', { x1: L, x2: W - R, y1: 160, y2: 160, stroke: 'var(--rd-muted)' });
        const sx = nice(hi - lo);
        for (let v = Math.ceil(lo / sx) * sx; v <= hi + 1e-12; v += sx) { el('line', { x1: X(v), x2: X(v), y1: 156, y2: 164, stroke: 'var(--rd-muted)' }); el('text', { x: X(v), y: 178, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, String(+v.toFixed(4))); }
        el('text', { x: (L + W - R) / 2, y: 196, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'dimension, mm');
      };
    }

    // ---- friction and torque ----
    function runTq(rows: Row[], notes: [string, string][]) {
      const t = THREADS.find((x) => x.name === field('th').value)!, T = num('T'), dw = num('dw'), dh = num('dh'), mu0 = num('mu0'), mu1 = num('mu1'), mu2 = num('mu2');
      if (!(T > 0 && dw > dh && dh > 0 && mu0 > 0 && mu1 > 0 && mu2 >= mu1)) { notes.push(['bad', 'Enter the torque, a head diameter larger than the hole, and friction values with the maximum not below the minimum.']); return null; }
      const c = frictionChange({ T, t, dw, dh, mu0, muMin: mu1, muMax: mu2 });
      rows.push({ dt: 'Preload, coated', dd: `${f(c.Flo, 1)} to ${f(c.Fhi, 1)} kN <small>${pct(c.dLo)} to ${pct(c.dHi)} against the design</small>`, primary: true, cls: c.dHi > 0.1 || c.dLo < -0.1 ? 'warn' : 'ok' });
      rows.push({ dt: 'Preload as designed', dd: `${f(c.F0, 1)} kN <small>${t.name} at ${f(T)} N·m with μ = ${f(mu0, 2)}</small>` });
      rows.push({ dt: 'Torque for the design preload', dd: `${f(c.Tnew, 1)} N·m <small>at the mean coated friction of ${f((mu1 + mu2) / 2, 3)}</small>` });
      rows.push({ dt: 'Scatter from friction alone', dd: `± ${f(c.scatter * 100)}% <small>add the scatter of the tightening tool</small>` });
      if (c.dHi > 0.1) notes.push(['warn', `At the low end of the friction, the bolt gets ${pct(c.dHi)} more preload than designed. Check the tightening stress and the yield margin at that preload (Bolted joints).`]);
      if (c.dLo < -0.1) notes.push(['warn', `At the high end of the friction, the preload is ${pct(c.dLo)}. Check the separation and slip margins at that preload.`]);
      notes.push(['', 'A coating changes the friction under the head too. Set the torque from a torque–tension test of the coated parts, and write it on the drawing with the finish.']);
      return () => {
        const H = 230, W = frame(H), L = 46, R = 12, T0 = 14, B = 32, x0 = 0.04, x1 = 0.3;
        const ms = Array.from({ length: 50 }, (_, k) => x0 + ((x1 - x0) * k) / 49), Fs = ms.map((m) => preloadAt(T, t, m, dw, dh));
        const yMax = Math.max(...Fs) * 1.05;
        const X = (m: number) => L + ((m - x0) / (x1 - x0)) * (W - L - R), Y = (F: number) => H - B - (F / yMax) * (H - T0 - B);
        for (let m = 0.05; m <= x1 + 1e-9; m += 0.05) { el('line', { x1: X(m), x2: X(m), y1: T0, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(m), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, m.toFixed(2)); }
        const sy = nice(yMax);
        for (let F = 0; F <= yMax; F += sy) { el('line', { x1: L, x2: W - R, y1: Y(F), y2: Y(F), stroke: 'var(--rd-line)' }); if (Y(F) < H - B - 6) el('text', { x: L - 4, y: Y(F) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, String(+F.toFixed(1))); }
        el('rect', { x: X(Math.max(mu1, x0)), y: T0, width: Math.max(0, X(Math.min(mu2, x1)) - X(Math.max(mu1, x0))), height: H - B - T0, fill: 'var(--rd-blue)', 'fill-opacity': 0.12 });
        line(ms.map((m, k) => [X(m), Y(Fs[k])]), 'var(--rd-accent)', 2.4);
        line([[L, Y(c.F0)], [W - R, Y(c.F0)]], 'var(--rd-ok)', 1.4, '5 3');
        txt(W - R - 4, Y(c.F0) - 5, 'design preload', 'var(--rd-ok)', 'end');
        if (mu0 >= x0 && mu0 <= x1) el('circle', { cx: X(mu0), cy: Y(c.F0), r: 5, fill: 'var(--rd-panel)', stroke: 'var(--rd-ink)', 'stroke-width': 2 });
        txt(X(Math.max(mu1, x0)) + 4, T0 + 10, 'coated', 'var(--rd-blue)');
        el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'friction coefficient');
        el('text', { x: 12, y: (T0 + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T0 + H - B) / 2})` }, `preload, kN at ${f(T)} N·m`);
      };
    }

    // ---- zinc life ----
    function runLife(rows: Row[], notes: [string, string][]) {
      const t = num('zt'), rel = num('rel') || 1, cat = field('cat').value;
      if (!(t > 0 && rel > 0)) { notes.push(['bad', 'Enter the zinc thickness and a relative rate above zero.']); return null; }
      const r = zincLife({ t, cat, rel }), req = readFactor(field('req').value, 0);
      const cls = req === null || req === 0 ? '' : r.short >= req ? 'ok' : r.long >= req ? 'warn' : 'bad';
      rows.push({ dt: `Life in ${r.c.key}`, dd: `${Number.isFinite(r.long) ? `${yrs(r.short)} to ${yrs(r.long)}` : r.short >= 100 ? yrs(r.short) : `more than ${yrs(r.short)}`} years <small>${f(t)} µm at ${f(r.c.lo * rel, 2)} to ${f(r.c.hi * rel, 2)} µm/year${cls === 'ok' ? ' · meets the requirement' : cls === 'warn' ? ' · only at the low end of the rate' : cls === 'bad' ? ' · short of the requirement' : ''}</small>`, primary: true, cls });
      if (req === null || req === 0) { rows.push({ dt: 'Thickness for the requirement', dd: '<small>needs required life</small>' }); notes.push(['warn', awaitingMessage(['required life'], 'whether the coating lasts, and the thickness it needs', true)]); }
      else rows.push({ dt: 'Thickness for the requirement', dd: `${f(req * r.c.hi * rel, 1)} µm <small>at the high end of the ${r.c.key} rate</small>`, cls });
      notes.push(['', 'A sacrificial coating protects the steel at scratches and cut edges while it lasts. When it is gone, the steel rusts, and the coating also stops protecting the metals around it (Galvanic).']);
      return () => {
        const H = 234, W = frame(H), L = 30, R = 12, T = 22, B = 36;
        const rowH = (H - T - B) / CATEGORIES.length;
        const cap = 60, X = (y: number) => L + (Math.min(y, cap) / cap) * (W - L - R);
        for (let y = 0; y <= cap; y += 10) { el('line', { x1: X(y), x2: X(y), y1: T, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(y), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, y === cap ? `${cap}+` : String(y)); }
        CATEGORIES.forEach((c, k) => {
          const z = zincLife({ t, cat: c.key, rel }), y = T + k * rowH + 4;
          const on = c.key === cat;
          el('rect', { x: X(z.short), y, width: Math.max(2, X(z.long) - X(z.short)), height: rowH - 8, rx: 3, fill: on ? 'var(--rd-accent)' : 'var(--rd-blue)', 'fill-opacity': on ? 0.75 : 0.4 });
          el('text', { x: L - 4, y: y + rowH / 2, 'text-anchor': 'end', 'font-size': 10, fill: on ? 'var(--rd-accent)' : 'var(--rd-muted)' }, c.key);
        });
        if (req) { line([[X(req), T - 6], [X(req), H - B]], 'var(--rd-ok)', 1.6, '6 3'); txt(X(req) + 4, T - 8, 'required', 'var(--rd-ok)'); }
        el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, `years, ${f(t)} µm`);
      };
    }

    const RUN: Record<string, typeof runDim> = { dim: runDim, tq: runTq, life: runLife };
    const CAPS: Record<string, string> = {
      dim: 'The drawing limits after coating (green) and the limits to machine before coating (blue).',
      tq: 'Preload at your torque against the friction coefficient. Blue: the friction range of the coated parts. The point is the design.',
      life: 'Life of the zinc in each ISO 9223 category, from the high to the low end of its corrosion rate. Your category is red.',
    };
    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    // a finish fills its build-up fraction
    field('fin').addEventListener('change', () => { const fi = finish(field('fin').value); if (fi && fi.key !== 'custom') field('out').value = String(+fi.out.toFixed(3)); });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    wireWorkedExample({
      root, onLoad: run, factorFields: ['req'],
      note: 'Worked-example requirement loaded: 10 years of storage',
      values: { ft: 'te', fin: 'flake', out: '1', tmin: '8', tmax: '12', lmin: '8.862', lmax: '9.026',
        th: 'M10', T: '60', dw: '15', dh: '11', mu0: '0.12', mu1: '0.09', mu2: '0.14', zt: '10', rel: '1', cat: 'C3', req: '10' },
    });
    run();
  });
</script>
