---
// Mission rail: the whole route, every zone title always visible (REF·DB rule),
// grouped by phase with phase colours, an orbit map on top, and the current
// zone centred on load. Rebuilt zones open their v2 page; the rest open the
// v1 archive at that zone. Everything derives from src/data/zones.mjs.
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import StarMapButton from '../hud/StarMapButton.astro';
import { PHASES, BRIEFING, route, hrefOf, toSlug } from '../../data/zones.mjs';

const base = import.meta.env.BASE_URL;
const slug = toSlug(Astro.url.pathname, base);
const items = route();
const here = items.find((r) => r.slug !== null && r.slug === slug);

// Orbit map geometry (v1 proportions)
const W = 266, H = 160, cx = W / 2, cy = 76, rx = 104, ry = 44;
const planets = PHASES.map((p, i) => {
  const a = -Math.PI / 2 + (i / PHASES.length) * Math.PI * 2;
  const zones = items.filter((z) => z.phase === p.k && !z.primer);
  return {
    ...p, x: cx + rx * Math.cos(a), y: cy + ry * Math.sin(a), here: here?.phase === p.k,
    total: zones.length, v2: zones.filter((z) => z.slug !== null).length,
  };
});
const herePhaseIdx = here ? PHASES.findIndex((p) => p.k === here.phase) : -1;
const v2Count = items.filter((z) => !z.primer && z.slug !== null).length;
---

<!-- on a phone the map button also heads the menu, where it is found without scrolling the whole rail -->
<div class="md:sl-hidden rail-map"><StarMapButton /></div>

<div class="rail">
  <div class="rail-brief">
    {BRIEFING.map((b) => (
      <a href={`${base}${b.slug}/`} aria-current={slug === b.slug ? 'page' : undefined}>{b.label}</a>
    ))}
    <a href={`${base}legacy/`} title="The complete v1 reference, all 64 zones">v1 archive</a>
  </div>

  <figure class="rail-orbit" aria-label="Workflow phases">
    <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Eight workflow phases. Select one to go to it in the list">
      <defs>
        <radialGradient id="railSun"><stop offset="0" stop-color="#fff6d8"></stop><stop offset=".45" stop-color="#ffb347"></stop><stop offset="1" stop-color="#ff6a00" stop-opacity="0"></stop></radialGradient>
        {PHASES.map((p) => (
          <radialGradient id={`railP_${p.k}`} cx=".35" cy=".35" r=".75">
            <stop offset="0" stop-color="#fff" stop-opacity=".9"></stop><stop offset=".38" stop-color={`var(--ph-${p.k})`}></stop><stop offset="1" stop-color="#000"></stop>
          </radialGradient>
        ))}
      </defs>
      <ellipse class="orb-path" cx={cx} cy={cy} rx={rx} ry={ry}></ellipse>
      <circle cx={cx} cy={cy} r="19" fill="url(#railSun)"></circle>
      <text class="orb-sun-label" x={cx} y={cy + 4}>{here ? here.tag : '—'}</text>
      {planets.map((p) => {
        const r = p.here ? 10 : 7.5;
        return (
          <a href={`#rail-${p.k}`} class:list={['orb-p', { here: p.here }]} data-phase={p.k}
            aria-label={`${p.n}: ${p.sub}, ${p.v2} of ${p.total} zones rebuilt${p.here ? ', current phase' : ''}`}>
            <title>{`${p.n} · ${p.sub} · ${p.v2}/${p.total} rebuilt`}</title>
            {p.here && <circle class="orb-ring" cx={p.x} cy={p.y} r={r + 5} stroke={`var(--ph-${p.k})`}></circle>}
            <circle cx={p.x} cy={p.y} r={r} fill={`url(#railP_${p.k})`}></circle>
            <text x={p.x} y={p.y + (p.y > cy ? r + 12 : -r - 5)}>{p.n}</text>
          </a>
        );
      })}
      <text class="orb-where" x={cx} y={H - 3}>
        {here && herePhaseIdx >= 0 ? `PHASE ${herePhaseIdx + 1}/8 · ${v2Count} OF 64 ZONES IN v2` : `${v2Count} OF 64 ZONES IN v2`}
      </text>
    </svg>
  </figure>

  {PHASES.map((p) => {
    const zs = items.filter((z) => z.phase === p.k);
    const v2 = zs.filter((z) => !z.primer && z.slug !== null).length;
    const n = zs.filter((z) => !z.primer).length;
    return (
      <section class="rail-phase" id={`rail-${p.k}`} style={`--pc: var(--ph-${p.k})`}>
        <h2 class="rail-ph-head">
          <span class="orb" aria-hidden="true"></span>
          <span class="ph-ico" aria-hidden="true">{p.ico}</span>
          <span class="ph-name">{p.n}</span>
          <span class="ph-sub">{p.sub}</span>
          <span class="ph-cnt" title={`${v2} of ${n} zones rebuilt in v2`}>{v2}/{n}</span>
        </h2>
        <ul>
          {zs.map((z) => {
            const isHere = here?.key === z.key;
            return (
              <li>
                <a href={hrefOf(z, base)} class:list={['rail-z', z.slug !== null ? 'v2' : 'v1', { primer: z.primer, here: isHere }]}
                  aria-current={isHere ? 'page' : undefined}
                  title={z.slug === null ? `${z.tag} ${z.label}: opens in the v1 archive` : undefined}>
                  <span class="zn">{z.tag}</span>
                  <span class="zi" aria-hidden="true">{z.ico}</span>
                  <span class="zl">{z.label}</span>
                  {z.slug === null && <span class="tag">v1</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</div>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  /* stays in view: the rail scrolls itself to the current zone */
  .rail-map { position: sticky; top: 0; z-index: 2; margin: 0 0 0.8rem; padding: 0.4rem 0; background: var(--sl-color-bg-sidebar, var(--sl-color-black)); }
  .rail-map :global(.map-switch) { width: 100%; justify-content: center; }
</style>

<script>
  // Centre the current zone in the rail, and let orbit planets scroll the rail to their phase.
  const pane = document.querySelector<HTMLElement>('.sidebar-pane');
  const centre = (el: Element | null, smooth = false) => {
    if (!pane || !el) return;
    const top = el.getBoundingClientRect().top - pane.getBoundingClientRect().top + pane.scrollTop - pane.clientHeight / 3;
    pane.scrollTo({ top: Math.max(0, top), behavior: smooth ? 'smooth' : 'auto' });
  };
  centre(document.querySelector('.rail-z.here'));
  // Phones: the rail is a popover, so centre again each time it opens.
  pane?.addEventListener('toggle', (e) => {
    if ((e as ToggleEvent).newState === 'open') requestAnimationFrame(() => centre(document.querySelector('.rail-z.here')));
  });
  document.querySelectorAll<HTMLAnchorElement>('.rail-orbit .orb-p').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('motion-off');
      centre(document.getElementById(`rail-${a.dataset.phase}`), !reduce);
    }),
  );
</script>
