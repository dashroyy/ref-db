---
// The relaxation curve that each structure gives: glassy, transition, rubbery plateau, flow. Illustrative shapes, built
// here from two smooth steps each (log modulus against log time), so the figure shows what each part of the structure
// adds to or removes from the curve. Not data.
const W = 440, H = 250, L = 48, R = 10, T = 12, B = 30;
const x0 = -8, x1 = 10, y0 = -2.4, y1 = 3.9;
const X = (x: number) => L + ((x - x0) / (x1 - x0)) * (W - L - R);
const Y = (y: number) => H - B - ((Math.max(y0, Math.min(y1, y)) - y0) / (y1 - y0)) * (H - T - B);
const step = (u: number) => 1 / (1 + Math.exp(-u));
const curves = [
  { key: 'short', col: 'var(--rd-warn)', yg: 3.5, xt: -4, yp: 0.3, xf: -1.8, yend: -4, label: 'short chains: flow', lx: -1.3, ly: -1.75, anchor: 'start' },
  { key: 'long', col: 'var(--rd-blue)', yg: 3.5, xt: -4, yp: 0, xf: 4, yend: -4, label: 'long, entangled: plateau, then flow', lx: -1.6, ly: -0.35, anchor: 'start' },
  { key: 'xl', col: 'var(--rd-ok)', yg: 3.5, xt: -4, yp: 0.3, xf: Infinity, yend: 0.3, label: 'crosslinked: the plateau stays', lx: 9.6, ly: 0.62, anchor: 'end' },
  { key: 'ts', col: 'var(--rd-accent)', yg: 3.5, xt: 7.2, yp: 1.8, xf: Infinity, yend: 1.8, label: 'thermoset: glassy until hot', lx: -1.6, ly: 3.68, anchor: 'start' },
];
const path = (c: (typeof curves)[number]) => {
  let d = '';
  for (let k = 0; k <= 180; k++) {
    const x = x0 + ((x1 - x0) * k) / 180;
    const y = c.yg - (c.yg - c.yp) * step((x - c.xt) / 0.55) - (Number.isFinite(c.xf) ? (c.yp - c.yend) * step((x - c.xf) / 0.45) : 0);
    d += `${k ? 'L' : 'M'}${X(x).toFixed(1)},${Y(y).toFixed(1)}`;
  }
  return d;
};
const yt: [number, string][] = [[3, '1 GPa'], [1, '10 MPa'], [-1, '0.1 MPa']];
const regions: [number, number, string][] = [[-8, -4.9, 'glassy'], [-4.9, -3.1, 'transition'], [-3.1, 3.4, 'rubbery plateau'], [3.4, 10, 'flow']];
---

<figure class="viz pcurves">
  <p class="viz-title">What each structure does to the curve</p>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="pc-desc" style="max-width: 680px; margin: 0 auto;">
    <desc id="pc-desc">
      Log modulus against log time at one temperature for four structures. All start glassy near 3 GPa and fall through
      the transition. Short chains then flow at once. Long entangled chains hold a rubbery plateau near 1 MPa for some
      decades of time, then flow. A crosslinked elastomer keeps its plateau for ever. A thermoset stays glassy over most
      of the range and has a high plateau.
    </desc>
    {regions.map(([a, b, t], k) => (
      <g>
        {k > 0 && <line x1={X(a)} x2={X(a)} y1={T} y2={H - B} stroke="var(--rd-line)" stroke-dasharray="3 4" />}
        <text x={(X(a) + X(b)) / 2} y={H - B - 6} text-anchor="middle" font-size="9.5" fill="var(--rd-muted)">{t}</text>
      </g>
    ))}
    {yt.map(([y, t]) => (
      <g>
        <line x1={L} x2={W - R} y1={Y(y)} y2={Y(y)} stroke="var(--rd-line)" />
        <text x={L - 4} y={Y(y) + 3} text-anchor="end" font-size="9" fill="var(--rd-muted)">{t}</text>
      </g>
    ))}
    <line x1={L} x2={L} y1={T} y2={H - B} stroke="var(--rd-ink)" opacity="0.5" />
    <line x1={L} x2={W - R} y1={H - B} y2={H - B} stroke="var(--rd-ink)" opacity="0.5" />
    {curves.map((c) => <path d={path(c)} fill="none" stroke={c.col} stroke-width="2.4" />)}
    {curves.map((c) => <text x={X(c.lx)} y={Y(c.ly)} text-anchor={c.anchor} font-size="10.5" font-weight="600" fill={c.col}>{c.label}</text>)}
    <text x={(L + W - R) / 2} y={H - 8} text-anchor="middle" font-size="10" fill="var(--rd-ink)">log time (a higher temperature moves the curves left)</text>
    <text x={L + 4} y={T + 2} font-size="9.5" fill="var(--rd-ink)">modulus (log)</text>
  </svg>
  <figcaption>
    Illustrative shapes, not data. All four start glassy. Short chains flow as soon as the transition is over. Long
    chains hold a rubbery plateau while they are entangled, then flow. Crosslinks make the plateau permanent. A thermoset
    is still glassy where the others are rubbery. Select each structure in the live model below to see the chains that
    make each curve.
  </figcaption>
</figure>
