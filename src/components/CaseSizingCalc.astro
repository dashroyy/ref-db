---
// Metallic motor case / pressure vessel screening calculator.
// Calculations live in src/lib/pv.ts (unit-tested); this file is UI only.
import MaterialSelect from './MaterialSelect.astro';
import { MATERIALS, DEFAULTS as D, type Material } from '../lib/materials';

// Case alloys: the steel, stainless, titanium, aluminium and nickel entries of the material library with yield and
// ultimate, best specific strength first in each family.
const FAMILIES = ['steel', 'ss', 'ti', 'al', 'ni'];
const raw = (m: Material) => ({ key: m.key, name: m.name, family: m.family, spec: m.spec, uts: m.Ftu!, yield: m.Fty!, density: m.rho! / 1000,
  kic: m.kic, kicIsFamilyDefault: m.kicDefault, maxServiceTemp: m.maxT, weldable: m.weldable });
const metals = MATERIALS.filter((m) => FAMILIES.includes(m.family) && m.Ftu! > 0 && m.Fty! > 0 && m.rho)
  .sort((a, b) => b.Ftu! / b.rho! - a.Ftu! / a.rho!).map(raw);
---

<div class="calc pvcalc" data-pvcalc>
  <div class="calc-head">
    <span>Motor case sizing: metallic, membrane only</span>
    <span class="head-btns">
      <button type="button" class="chip" data-load-example>Load worked example</button>
      <button type="button" class="chip" data-share>Copy link to these inputs</button>
    </span>
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Material</legend>
        <label>Alloy
          <MaterialSelect name="m" list={metals} selected={D.caseSteel} />
        </label>
        <p class="hint" data-matinfo></p>
      </fieldset>

      <fieldset>
        <legend>Geometry</legend>
        <div class="row2">
          <label>Internal diameter (mm)<input name="id" type="number" min="1" step="any" value="300" /></label>
          <label>Cylinder length (mm)<input name="L" type="number" min="0" step="any" value="1000" /></label>
        </div>
        <label>End domes
          <select name="dome">
            <option value="hemi">Hemispherical (wall = ½ cylinder)</option>
            <option value="ellip2">2:1 semi-ellipsoidal (wall ≈ cylinder)</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>Design basis</legend>
        <div class="row2">
          <label>MEOP<input name="p" type="number" min="0" step="any" value="10" /></label>
          <label>Unit
            <select name="u"><option>MPa</option><option>bar</option><option>psi</option></select>
          </label>
        </div>
        <div class="row2">
          <label>Proof factor<input name="pf" type="number" min="1" step="0.01" placeholder="your value" autocomplete="off" /></label>
          <label>Burst factor<input name="bf" type="number" min="1" step="0.01" placeholder="your value" autocomplete="off" /></label>
        </div>
        <p class="hint">Enter your programme's factors: they come from the governing requirement, not from this site.</p>
        <p class="hint example-note" data-example-note hidden></p>
        <label>Weld / joint efficiency
          <select name="e">
            <option value="1">1.00: seamless, no weld in the pressure boundary</option>
            <option value="0.9" selected>0.90: full-penetration weld, fully radiographed</option>
            <option value="0.85">0.85: full-penetration weld, spot radiographed</option>
            <option value="0.7">0.70: single-sided weld, no radiography</option>
          </select>
        </label>
        <label>Check an as-designed wall (mm, optional)
          <input name="t" type="number" min="0" step="any" placeholder="blank = minimum required" />
        </label>
      </fieldset>
    </form>

    <div class="pv-out">
      <dl class="readouts">
        <div class="readout primary"><dt data-r="tLabel">Minimum wall</dt><dd data-r="t">—</dd></div>
        <div class="readout"><dt>Governed by</dt><dd data-r="gov">—</dd></div>
        <div class="readout"><dt>Thin-wall estimate</dt><dd data-r="tthin">—</dd></div>
        <div class="readout"><dt>t / r</dt><dd data-r="tr">—</dd></div>
      </dl>
      <p class="pv-sub">Stress at MEOP</p>
      <dl class="readouts">
        <div class="readout"><dt>Hoop σ<sub>h</sub></dt><dd data-r="hoop">—</dd></div>
        <div class="readout"><dt>Axial σ<sub>a</sub></dt><dd data-r="axial">—</dd></div>
        <div class="readout"><dt>Dome wall</dt><dd data-r="domet">—</dd></div>
      </dl>
      <p class="pv-sub">Pressures and margins</p>
      <dl class="readouts">
        <div class="readout"><dt>Proof pressure</dt><dd data-r="pp">—</dd></div>
        <div class="readout"><dt>Design burst</dt><dd data-r="pb">—</dd></div>
        <div class="readout"><dt>Predicted burst</dt><dd data-r="pred">—</dd></div>
        <div class="readout" data-ms="msb"><dt>MS burst</dt><dd data-r="msb">—</dd></div>
        <div class="readout" data-ms="msp"><dt>MS yield at proof</dt><dd data-r="msp">—</dd></div>
      </dl>
      <svg class="pv-bar" viewBox="0 0 600 100" role="img" aria-label="Pressure scale showing MEOP, proof, design burst and predicted burst" data-bar></svg>

      <p class="pv-sub">Fracture: Irwin leak-before-break screen</p>
      <dl class="readouts">
        <div class="readout"><dt>Critical crack ½-length at MEOP</dt><dd data-r="cm">—</dd></div>
        <div class="readout"><dt>…at proof</dt><dd data-r="cp">—</dd></div>
        <div class="readout" data-lbb><dt>Leak before break?</dt><dd data-r="lbb">—</dd></div>
      </dl>
      <p class="pv-sub">Mass and efficiency</p>
      <dl class="readouts">
        <div class="readout"><dt>Case mass</dt><dd data-r="mass">—</dd></div>
        <div class="readout"><dt>Internal volume</dt><dd data-r="vol">—</dd></div>
        <div class="readout"><dt>p<sub>b</sub>V/W</dt><dd data-r="pvw">—</dd></div>
      </dl>

      <div class="pv-ring">
        <svg viewBox="0 0 240 240" role="img" aria-label="Case cross-section drawn to scale" data-ring></svg>
        <p data-r="ringNote"></p>
      </div>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="pv-cmp">
    <p class="pv-sub">Every material at this duty</p>
    <div data-cmp></div>
  </div>
  <div class="calc-foot">
    Screening tool for early sizing. Membrane stress only: it does not size dome–cylinder junctions, closures, bosses,
    skirts or joints, where real cases usually fail. K<sub>IC</sub> values are indicative. Verify against your governing
    standard and get stress sign-off before anything is built.
  </div>
  <script type="application/json" data-mats set:html={JSON.stringify(Object.fromEntries(metals.map((m) => [m.key, m])))}></script>
</div>

<style is:global>
  .pv-cmp { padding: 0 1rem 1rem; }
  .pv-cmp .wrap { overflow-x: auto; }
  .pv-cmp table { width: 100%; font-size: var(--sl-text-xs); border-collapse: collapse; display: table; margin: 0 !important; }
  .pv-cmp th, .pv-cmp td { padding: 0.25rem 0.45rem; border-bottom: 1px solid var(--rd-line); text-align: right; white-space: nowrap; }
  .pv-cmp th:first-child, .pv-cmp td:first-child { text-align: left; white-space: normal; }
  .pv-cmp tr.sel td { background: color-mix(in srgb, var(--rd-accent) 14%, transparent); font-weight: 600; }
  .pv-cmp .bar { display: inline-block; height: 0.55rem; background: var(--rd-blue); opacity: 0.7; border-radius: 2px; vertical-align: middle; margin-right: 0.35rem; }
  .pv-cmp .w { color: var(--rd-warn); }
  .pv-cmp p.hint { margin: 0 !important; }
  .pv-sub {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rd-muted);
    margin: 1rem 0 0.4rem !important;
  }
  .pv-bar { width: 100%; height: auto; margin-top: 0.75rem; font-family: var(--sl-font-mono); }
  .pv-ring { display: flex; gap: 1rem; align-items: center; margin-top: 1rem !important; }
  .pv-ring svg { width: 9rem; flex: none; }
  .pv-ring p { font-size: var(--sl-text-sm); color: var(--rd-muted); margin: 0; }
  .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
  .pv-notes li.bad { color: var(--rd-accent); }
  .pv-notes li.warn { color: var(--rd-warn); }
</style>

<script>
  import { sizeCase, units, type PressureUnit, type DomeType } from '../lib/pv';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';
  import { DEFAULTS } from '../lib/materials';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');

  document.querySelectorAll<HTMLElement>('[data-pvcalc]').forEach((root) => {
    const mats = JSON.parse(root.querySelector('[data-mats]')!.textContent!);
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const svgEl = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };

    // Restore inputs from the URL so a link reproduces the calculation.
    const params = new URLSearchParams(location.search);
    for (const [k, v] of params) {
      const el = field(k);
      if (el) el.value = v;
    }

    function run() {
      const m = mats[field('m').value];
      const u = field('u').value as PressureUnit;
      const toMPa = units[u];
      const P = (mpa: number) => `${f(mpa / toMPa, u === 'psi' ? 0 : u === 'bar' ? 1 : 2)} <small>${u}</small>`;
      const pf = readFactor(field('pf').value), bf = readFactor(field('bf').value);
      const haveFactors = pf !== null && bf !== null;
      const checking = !!(+field('t').value);

      root.querySelector('[data-matinfo]')!.textContent =
        `UTS ${m.uts} MPa · yield ${m.yield} MPa · ρ ${m.density} g/cm³ · K_IC ≈ ${m.kic ?? '—'} MPa√m` +
        (m.kicIsFamilyDefault ? ' (family default)' : '') + ` · max service ~${m.maxServiceTemp} °C. ${m.spec}`;

      // Without the programme's factors there is no required wall and no margins. With an
      // as-designed wall we can still show everything that doesn't depend on a factor.
      compare(pf, bf, toMPa);
      if (!haveFactors && !checking) {
        root.querySelectorAll<HTMLElement>('[data-r]').forEach((el) => { if (el.dataset.r !== 'tLabel') el.textContent = '—'; });
        r('tLabel').textContent = 'Minimum wall';
        root.querySelectorAll('[data-ms], [data-lbb]').forEach((el) => (el.className = 'readout'));
        root.querySelector<SVGSVGElement>('[data-bar]')!.replaceChildren();
        root.querySelector<SVGSVGElement>('[data-ring]')!.replaceChildren();
        root.querySelector('[data-notes]')!.innerHTML =
          `<li class="warn">${awaitingMessage(['proof factor', 'burst factor'], 'the required wall, test pressures and margins')}</li>` +
          '<li>Or enter an as-designed wall to see its stresses, burst pressure, leak-before-break and mass without them.</li>';
        return;
      }
      const res = sizeCase({
        idMm: +field('id').value,
        lengthMm: +field('L').value,
        meop: +field('p').value * toMPa,
        proofFactor: pf ?? 1,
        burstFactor: bf ?? 1,
        weldEff: +field('e').value,
        dome: field('dome').value as DomeType,
        tMm: +field('t').value || undefined,
        material: m,
      });

      if (!haveFactors) return showUnfactored(res, P);
      r('tLabel').textContent = checking ? 'Wall checked' : 'Minimum wall';
      r('t').innerHTML = Number.isFinite(res.t) ? `${f(res.t, 3)} <small>mm</small>` : 'none';
      r('gov').textContent = checking ? `min ${f(res.tReq, 3)} mm (${res.governs})` : res.governs === 'burst' ? 'Burst (UTS)' : 'Proof (yield)';
      r('tthin').innerHTML = `${f(res.tThinReq, 3)} <small>mm</small>`;
      r('tr').innerHTML = `${f(res.tOverR, 4)} <small>${res.thinWallOk ? 'thin' : 'thick'}</small>`;
      r('hoop').innerHTML = `${f(res.hoopMeop, 0)} <small>MPa</small>`;
      r('axial').innerHTML = `${f(res.axialMeop, 0)} <small>MPa</small>`;
      r('domet').innerHTML = `${f(res.domeT, 3)} <small>mm</small>`;
      r('pp').innerHTML = P(res.pProof);
      r('pb').innerHTML = P(res.pBurst);
      r('pred').innerHTML = P(res.predictedBurst);
      const ms = (v: number) => (Math.abs(v) < 5e-4 ? '0.000' : `${v > 0 ? '+' : ''}${f(v, 3)}`);
      r('msb').textContent = ms(res.msBurst);
      r('msp').textContent = ms(res.msProof);
      for (const k of ['msb', 'msp']) {
        const v = k === 'msb' ? res.msBurst : res.msProof;
        root.querySelector(`[data-ms="${k}"]`)!.className = `readout ${v < -1e-9 ? 'bad' : 'ok'}`;
      }

      r('cm').innerHTML = `${f(res.cMeop, 2)} <small>mm</small>`;
      r('cp').innerHTML = `${f(res.cProof, 2)} <small>mm</small>`;
      r('lbb').textContent = res.leakBeforeBreak === null ? '—' : res.leakBeforeBreak ? 'Likely' : 'No';
      root.querySelector('[data-lbb]')!.className = `readout ${res.leakBeforeBreak ? 'ok' : 'bad'}`;

      r('mass').innerHTML = `${f(res.mass, 2)} <small>kg</small>`;
      r('vol').innerHTML = `${f(res.volume / 1e6, 1)} <small>L</small>`;
      r('pvw').innerHTML = `${f(res.pvw / 1000, 1)} <small>km · ${f(res.pvw / 0.0254 / 1e6, 2)}×10⁶ in</small>`;

      drawBar(res, toMPa, u);
      drawRing(res);

      const notes: [string, string][] = [];
      if (!Number.isFinite(res.t)) notes.push(['bad', 'Design pressure exceeds the allowable stress: no wall thickness works. Pick a stronger material or lower MEOP.']);
      if (!res.thinWallOk) notes.push(['warn', `t/r = ${f(res.tOverR, 3)} ≥ 0.1: thin-wall theory is unconservative here. The sizing above already uses Lamé, which is exact for the cylinder away from its ends.`]);
      if (res.leakBeforeBreak === false) notes.push(['bad', `A crack that has just broken through the wall would run unstably at MEOP (critical ½-length ${f(res.cMeop, 2)} mm < wall ${f(res.t, 2)} mm). Expect burst without a warning leak. Safety then rests on NDT finding cracks reliably, and on the proof test, which fails any through-crack longer than about ${f(2 * res.cProof, 1)} mm on the test stand instead of in service.`]);
      if (m.kicIsFamilyDefault) notes.push(['warn', 'Fracture toughness for this alloy is a family default: treat the fracture result as a rough indication only.']);
      if (m.maxServiceTemp < 150) notes.push(['warn', `Maximum service temperature ~${m.maxServiceTemp} °C. Confirm the insulation keeps the case below this for the whole burn and soak-back.`]);
      if (!m.weldable && +field('e').value < 1) notes.push(['warn', `${m.name} is not normally fusion-welded. A weld efficiency below 1.0 implies a weld that this alloy may not tolerate.`]);
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, t]) => `<li class="${c}">${t}</li>`).join('');
    }

    // The same case sized in every material of the list, ranked by mass (the minimum wall, not an as-designed one).
    function compare(pf: number | null, bf: number | null, toMPa: number) {
      const box = root.querySelector<HTMLElement>('[data-cmp]')!;
      if (pf === null || bf === null) {
        box.innerHTML = `<p class="hint">${awaitingMessage(['proof factor', 'burst factor'], 'every material sized for this duty')}</p>`;
        return;
      }
      const sel = field('m').value, e = +field('e').value;
      const all = Object.entries(mats).map(([key, mat]: [string, any]) => ({
        key, m: mat,
        r: sizeCase({ idMm: +field('id').value, lengthMm: +field('L').value, meop: +field('p').value * toMPa, proofFactor: pf, burstFactor: bf, weldEff: e, dome: field('dome').value as DomeType, material: mat }),
      })).filter((x) => Number.isFinite(x.r.mass) && x.r.mass > 0).sort((a, b) => a.r.mass - b.r.mass);
      if (!all.length) { box.innerHTML = '<p class="hint">No material in the list can carry this pressure.</p>'; return; }
      const top = all.slice(0, 12), i = all.findIndex((x) => x.key === sel);
      if (i >= 12) top.push(all[i]);
      const max = Math.max(...top.map((x) => x.r.mass));
      box.innerHTML = `<div class="wrap"><table><thead><tr><th>Material</th><th>Wall (mm)</th><th>Case mass (kg)</th><th>Governed by</th><th>Leak before break</th><th>Max service (°C)</th></tr></thead><tbody>${top.map((x) => {
        const rank = all.indexOf(x) + 1, weld = e < 1 && !x.m.weldable;
        return `<tr class="${x.key === sel ? 'sel' : ''}"><td>${rank}. ${x.m.name}${weld ? ' <span class="w">†</span>' : ''}</td><td>${f(x.r.t, 3)}</td><td><span class="bar" style="width:${(3 * x.r.mass / max).toFixed(2)}rem"></span>${f(x.r.mass, 2)}</td><td>${x.r.governs === 'burst' ? 'burst' : 'proof'}</td><td>${x.r.leakBeforeBreak === null ? '—' : x.r.leakBeforeBreak ? `yes${x.m.kicIsFamilyDefault ? '*' : ''}` : 'no'}</td><td>${x.m.maxServiceTemp ?? '—'}</td></tr>`;
      }).join('')}</tbody></table></div><p class="hint">${all.length} materials can carry this duty. The lightest twelve${i >= 12 ? ' and your selection' : ''}, with the minimum wall for each. * fracture toughness is a family default. † not usually fusion-welded, and this case has a weld efficiency below 1. Mass is only one criterion: check the temperature, the weldability, the fracture result and the cost of each candidate.</p>`;
    }

    // As-designed wall, no factors entered: factor-independent results only.
    function showUnfactored(res: ReturnType<typeof sizeCase>, P: (mpa: number) => string) {
      const need = '<small>needs factors</small>';
      r('tLabel').textContent = 'Wall checked';
      r('t').innerHTML = `${f(res.t, 3)} <small>mm</small>`;
      r('gov').innerHTML = need; r('tthin').innerHTML = need;
      r('tr').innerHTML = `${f(res.tOverR, 4)} <small>${res.thinWallOk ? 'thin' : 'thick'}</small>`;
      r('hoop').innerHTML = `${f(res.hoopMeop, 0)} <small>MPa</small>`;
      r('axial').innerHTML = `${f(res.axialMeop, 0)} <small>MPa</small>`;
      r('domet').innerHTML = `${f(res.domeT, 3)} <small>mm</small>`;
      r('pp').innerHTML = need; r('pb').innerHTML = need; r('msb').innerHTML = need; r('msp').innerHTML = need; r('cp').innerHTML = need;
      r('pred').innerHTML = P(res.predictedBurst);
      root.querySelectorAll('[data-ms]').forEach((el) => (el.className = 'readout'));
      r('cm').innerHTML = `${f(res.cMeop, 2)} <small>mm</small>`;
      r('lbb').textContent = res.leakBeforeBreak === null ? '—' : res.leakBeforeBreak ? 'Likely' : 'No';
      root.querySelector('[data-lbb]')!.className = `readout ${res.leakBeforeBreak ? 'ok' : 'bad'}`;
      r('mass').innerHTML = `${f(res.mass, 2)} <small>kg</small>`;
      r('vol').innerHTML = `${f(res.volume / 1e6, 1)} <small>L</small>`;
      r('pvw').innerHTML = `${f(res.pvw / 1000, 1)} <small>km · ${f(res.pvw / 0.0254 / 1e6, 2)}×10⁶ in</small>`;
      root.querySelector<SVGSVGElement>('[data-bar]')!.replaceChildren();
      drawRing(res);
      root.querySelector('[data-notes]')!.innerHTML =
        `<li class="warn">Showing the as-designed wall without factors. ${awaitingMessage(['proof factor', 'burst factor'], 'its test pressures and margins')}</li>`;
    }

    function drawBar(res: ReturnType<typeof sizeCase>, toMPa: number, u: string) {
      const svg = root.querySelector<SVGSVGElement>('[data-bar]')!;
      svg.replaceChildren();
      const meop = res.pProof / (readFactor(field('pf').value) ?? 1);
      const marks = [
        { p: meop, label: 'MEOP', c: 'var(--rd-ink)' },
        { p: res.pProof, label: 'proof', c: 'var(--rd-blue)' },
        { p: res.pBurst, label: 'design burst', c: 'var(--rd-accent)' },
        { p: res.predictedBurst, label: 'predicted burst', c: 'var(--rd-ok)' },
      ].filter((m) => Number.isFinite(m.p));
      const max = Math.max(...marks.map((m) => m.p)) * 1.08 || 1;
      const X = (p: number) => 10 + (p / max) * 580;
      svg.append(svgEl('rect', { x: 10, y: 45, width: 580, height: 10, rx: 5, fill: 'var(--rd-panel2)', stroke: 'var(--rd-line)' }));
      svg.append(svgEl('rect', { x: 10, y: 45, width: X(meop) - 10, height: 10, rx: 5, fill: 'var(--rd-hot)', 'fill-opacity': 0.5 }));
      // Labels go in the first of four rows (two above the bar, two below) where they don't overlap one already placed.
      const rows = [{ y: 14, up: true }, { y: 94, up: false }, { y: 30, up: true }, { y: 78, up: false }];
      const taken: [number, number][][] = rows.map(() => []);
      for (const m of marks) {
        const text = `${m.label} ${f(m.p / toMPa, u === 'psi' ? 0 : 1)}`, w = text.length * 6.6, x = X(m.p);
        const anchor = x > 500 ? 'end' : x < 90 ? 'start' : 'middle';
        const x0 = anchor === 'end' ? x - w : anchor === 'start' ? x : x - w / 2, x1 = x0 + w;
        let k = rows.findIndex((_, j) => taken[j].every(([a, b]) => x1 + 6 < a || x0 - 6 > b));
        if (k < 0) k = 0;
        taken[k].push([x0, x1]);
        const row = rows[k];
        svg.append(svgEl('line', { x1: x, x2: x, y1: row.up ? row.y + 4 : 45, y2: row.up ? 55 : row.y - 11, stroke: m.c, 'stroke-width': 2 }));
        svg.append(svgEl('text', { x, y: row.y, 'text-anchor': anchor, 'font-size': 11, fill: m.c }, text));
      }
    }

    function drawRing(res: ReturnType<typeof sizeCase>) {
      const svg = root.querySelector<SVGSVGElement>('[data-ring]')!;
      svg.replaceChildren();
      if (!Number.isFinite(res.t)) return;
      const Ro = 110, Ri = Math.max(0, (Ro * res.ri) / res.ro);
      svg.append(svgEl('path', {
        d: `M120,${120 - Ro} a${Ro},${Ro} 0 1,0 0.01,0 Z M120,${120 - Ri} a${Ri},${Ri} 0 1,0 0.01,0 Z`,
        'fill-rule': 'evenodd', fill: 'var(--rd-steel)',
      }));
      svg.append(svgEl('circle', { cx: 120, cy: 120, r: Ri, fill: 'var(--rd-hot)', 'fill-opacity': 0.15 }));
      const td = res.t / (2 * res.ri);
      const cmp = td < 0.0015 ? 'thinner, relative to its size, than an aluminium drinks can (≈0.0015)'
        : td < 0.008 ? 'between a drinks can (≈0.0015) and an eggshell (≈0.008), relative to size'
        : td < 0.05 ? 'thicker than an eggshell (≈0.008), relative to size'
        : 'a genuinely thick-walled vessel';
      r('ringNote').innerHTML = `Drawn to scale. Wall-to-diameter ratio t/D = ${f(td, 4)}: ${cmp}. Almost all of the strength is in a skin you can barely see.`;
    }

    form.addEventListener('input', run);
    form.addEventListener('change', run);
    root.querySelector('[data-share]')!.addEventListener('click', async (e) => {
      const q = new URLSearchParams();
      for (const el of Array.from(form.elements) as HTMLInputElement[]) if (el.name && el.value) q.set(el.name, el.value);
      const url = `${location.origin}${location.pathname}?${q}#calculator`;
      try { history.replaceState(null, '', url); } catch {} // throws in opaque origins
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = 'Link copied';
      } catch {
        btn.textContent = 'Link in address bar';
      }
      setTimeout(() => (btn.textContent = 'Copy link to these inputs'), 2000);
    });
    wireWorkedExample({
      root, onLoad: run, factorFields: ['pf', 'bf'],
      note: 'Worked-example factors loaded: proof 1.10, burst 1.25',
      values: { m: DEFAULTS.caseSteel, id: '300', L: '1000', dome: 'hemi', p: '10', u: 'MPa', pf: '1.10', bf: '1.25', e: '0.9', t: '' },
    });
    run();
  });
</script>
