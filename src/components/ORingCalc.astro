---
// O-ring gland design and worst-case check. The inputs are in short steps; the result is a live cross-section of the
// gland, to scale, at the nominal or a worst-case corner, at any temperature and with the pressure on or off, plus a row
// of check chips and five views (squeeze range, temperature, statistics, drawing, compounds). Calculations in
// src/lib/oring.ts and src/lib/stack.ts (unit-tested). Housing materials come from the material library.
import data from '../data/orings.json';
import MaterialSelect from './MaterialSelect.astro';
import { withProps, DEFAULTS as D } from '../lib/materials';
const HOUSINGS = withProps(['alpha'], ['metal', 'composite']);
const ALPHA = Object.fromEntries(HOUSINGS.map((m) => [m.key, m.alpha]));
const VIEWS = [{ key: 'range', name: 'Squeeze range' }, { key: 'temp', name: 'Temperature' }, { key: 'stats', name: 'Statistics' }, { key: 'dwg', name: 'Drawing' }, { key: 'mats', name: 'Compounds' }];
---

<div class="calc orcalc" data-orcalc>
  <div class="calc-head">
    <span>O-ring gland: design and worst-case check</span>
    <span>ISO 3601 class A · screening values</span>
  </div>
  <div class="calc-body or-body">
    <div class="or-top">
      <div class="or-head" data-head></div>

      <div class="or-live">
        <div class="or-ctl">
          <div class="or-chips" role="radiogroup" aria-label="Which assembly">
            <button type="button" class="chip" data-corner="nom" aria-pressed="true">Nominal</button>
            <button type="button" class="chip" data-corner="min" aria-pressed="false">Least squeeze</button>
            <button type="button" class="chip" data-corner="max" aria-pressed="false">Most squeeze</button>
          </div>
          <label class="or-t">Temperature <b data-tval>20 °C</b><input type="range" name="liveT" min="-40" max="60" step="1" value="20" aria-label="Temperature for the section view" /></label>
          <div class="or-chips">
            <label class="inline"><input type="checkbox" name="liveP" /> Pressure on</label>
            <button type="button" class="chip" data-sweep>▶ Sweep temperature</button>
          </div>
        </div>
        <svg class="or-gland" viewBox="0 0 480 270" data-gland role="img" aria-label="Gland cross-section to scale"></svg>
        <p class="or-cap" data-gcap></p>
      </div>

      <div class="or-checkrow" data-chips></div>
      <p class="or-checktext" data-chiptext></p>

    </div>
    <form data-form onsubmit="return false">
      <details class="or-step or-design">
        <summary><span class="or-n">★</span> Design a ring and groove for this hardware</summary>
        <div class="or-in">
          <div class="row2">
            <label>Target squeeze (%)<input name="dSq" type="number" min="5" max="40" step="any" value="20" /></label>
            <label>Target fill (%)<input name="dFill" type="number" min="40" max="90" step="any" value="75" /></label>
            <label>Section<select name="dCs"><option value="auto">Auto, from Ø</option>{data.classA.map((c) => <option value={c}>{c.toFixed(2)} mm</option>)}</select></label>
            <label>Back-up rings<select name="dBu"><option value="auto">Auto, from gap</option><option value="0">None</option><option value="1">One</option><option value="2">Two</option></select></label>
            <label data-face hidden>Pressure is<select name="dSide"><option value="in">Inside the ring</option><option value="out">Outside the ring</option></select></label>
            <label data-face hidden>Groove OD or ID (mm)<input name="dFaceD" type="number" min="1" step="any" value="80" /></label>
          </div>
          <button type="button" class="chip" data-design>Design the ring and groove</button>
          <p class="hint" data-design-hint></p>
        </div>
      </details>

      <details class="or-step" open>
        <summary><span class="or-n">1</span> Seal type <small data-sum="type"></small></summary>
        <div class="or-in">
          <div class="or-seg" role="radiogroup" aria-label="Gland">
            <label><input type="radio" name="arr" value="piston" checked /><span>Groove in the plug</span></label>
            <label><input type="radio" name="arr" value="rod" /><span>Groove in the bore</span></label>
            <label><input type="radio" name="arr" value="face" /><span>Face seal</span></label>
          </div>
          <div class="row2">
            <label>Duty<select name="duty"><option value="static">Static</option><option value="dynamic">Dynamic (reciprocating)</option></select></label>
            <label class="inline or-ecc"><input type="checkbox" name="ecc" checked /> Parts can sit fully off-centre</label>
          </div>
        </div>
      </details>

      <details class="or-step" open>
        <summary><span class="or-n">2</span> O-ring <small data-sum="ring"></small></summary>
        <div class="or-in">
          <div class="row2">
            <label>Section (mm)<select name="cs">{data.classA.map((c) => <option value={c} selected={c === 5.33}>{c.toFixed(2)}</option>)}<option value="other">Other: type it</option></select></label>
            <label>Inside diameter (mm)<select name="id"></select></label>
            <label data-custom hidden>Section (mm)<input name="csX" type="number" min="0.5" step="any" value="5.33" /></label>
            <label data-custom hidden>Inside diameter (mm)<input name="idX" type="number" min="1" step="any" value="139.29" /></label>
            <label>Section tolerance ±<input name="csTol" type="number" step="any" min="0" /></label>
            <label>ID tolerance ±<input name="idTol" type="number" step="any" min="0" value="0.84" /></label>
          </div>
          <p class="hint" data-idhint></p>
        </div>
      </details>

      <details class="or-step" open>
        <summary><span class="or-n">3</span> Hardware <small data-sum="hw"></small></summary>
        <div class="or-in">
          <div class="or-grid" data-dims>
            <span></span><span>min</span><span>max</span>
            <span data-lbl="bore">Bore Ø</span><input name="boreMin" type="number" step="any" value="150.000" aria-label="Bore minimum" /><input name="boreMax" type="number" step="any" value="150.063" aria-label="Bore maximum" />
            <span data-lbl="shaft">Plug Ø</span><input name="shaftMin" type="number" step="any" value="149.860" aria-label="Plug minimum" /><input name="shaftMax" type="number" step="any" value="149.900" aria-label="Plug maximum" />
            <span data-lbl="groove">Groove root Ø</span><input name="grooveMin" type="number" step="any" value="141.45" aria-label="Groove minimum" /><input name="grooveMax" type="number" step="any" value="141.55" aria-label="Groove maximum" />
            <span>Groove width</span><input name="wMin" type="number" step="any" value="7.0" aria-label="Width minimum" /><input name="wMax" type="number" step="any" value="7.2" aria-label="Width maximum" />
            <span data-lbl="gap">Flange gap</span><input name="gapMin" type="number" step="any" value="0" aria-label="Gap minimum" /><input name="gapMax" type="number" step="any" value="0" aria-label="Gap maximum" />
          </div>
        </div>
      </details>

      <details class="or-step" open>
        <summary><span class="or-n">4</span> Service <small data-sum="svc"></small></summary>
        <div class="or-in">
          <div class="row2">
            <label>Pressure (MPa)<input name="p" type="number" min="0" step="any" value="10" /></label>
            <label>Back-up rings fitted<select name="buN"><option value="0">None</option><option value="1">One</option><option value="2">Two</option></select></label>
            <label>Coldest (°C)<input name="tMin" type="number" step="any" value="-40" /></label>
            <label>Hottest (°C)<input name="tMax" type="number" step="any" value="60" /></label>
            <label>Compound<select name="cmp">{data.compounds.map((c) => <option value={c.code} selected={c.code === 'FKM'}>{c.code}: {c.name}</option>)}</select></label>
            <label>Medium<select name="med">{data.media.map((m) => <option value={m.key}>{m.name}</option>)}</select></label>
            <label>Hardness (Shore A)<input name="hard" type="number" min="50" max="95" step="5" value="70" /></label>
            <label>Joint opening under pressure (mm)<input name="open" type="number" min="0" step="any" value="0" /></label>
          </div>
        </div>
      </details>

      <details class="or-step">
        <summary><span class="or-n">5</span> Materials and ageing <small data-sum="mat"></small></summary>
        <div class="or-in">
          <div class="row2">
            <label>Housing material<MaterialSelect name="am" list={HOUSINGS} selected={D.caseSteel} /></label>
            <label>Elastomer CTE (×10⁻⁶/K)<input name="ae" type="number" min="0" step="any" value="160" /></label>
            <label>Volume swell (%)<input name="sw" type="number" step="any" value="5" /></label>
            <label>Compression set at end of life (%)<input name="cset" type="number" min="0" max="100" step="any" value="20" /></label>
          </div>
        </div>
      </details>
    </form>

    <div class="or-bottom">
      <div class="or-views" role="tablist" aria-label="More views">
        {VIEWS.map((v, i) => <button type="button" role="tab" class="chip" data-view={v.key} aria-selected={i === 0 ? 'true' : 'false'}>{v.name}</button>)}
      </div>
      <div class="or-pane">
        <svg class="or-vsvg" viewBox="0 0 480 220" data-vsvg role="img" aria-label="Selected view"></svg>
        <div data-vhtml></div>
        <p class="or-cap" data-vcap></p>
      </div>
    </div>
  </div>
  <div class="calc-foot">
    Screening values: squeeze bands, the fill limit and the extrusion table are typical guidance, not ISO 3601-2
    dimensions. Stretch thinning assumes constant volume. The section view is to scale, with the ring shape drawn at
    constant area. Confirm against ISO 3601-2/-4, the seal supplier's tables, and a compatibility test with your actual
    fluid at temperature.
  </div>
  <script type="application/json" data-data set:html={JSON.stringify(data)}></script>
  <script type="application/json" data-alpha set:html={JSON.stringify(ALPHA)}></script>
</div>

<style is:global>
  .or-body { grid-template-columns: minmax(0, 1fr) !important; }
  .or-body > * { min-width: 0; margin: 0 !important; }
  .or-top { display: grid; gap: 0.6rem; }
  .or-top > * { margin: 0 !important; }
  .orcalc .inline { display: flex !important; align-items: center; gap: 0.4rem; }
  .orcalc .inline input { width: auto; }
  .orcalc form { display: grid; gap: 0.5rem; align-content: start; }
  .orcalc form .row2 { grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
  .or-step { min-width: 0; border: 1px solid var(--rd-line); border-radius: 6px; margin: 0 !important; background: color-mix(in srgb, var(--rd-panel) 85%, transparent); }
  .or-step > summary { cursor: pointer; padding: 0.5rem 0.6rem; display: flex; align-items: baseline; gap: 0.5rem; font-size: var(--sl-text-sm); color: var(--rd-ink); list-style: none; }
  .or-step > summary::-webkit-details-marker { display: none; }
  .or-step > summary::after { content: '▾'; margin-left: auto; color: var(--rd-muted); }
  .or-step:not([open]) > summary::after { content: '▸'; }
  .or-step > summary small { color: var(--rd-muted); font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .or-n { display: inline-grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--rd-accent); color: var(--sl-color-black); font: 600 0.72rem var(--sl-font-mono); flex: 0 0 auto; }
  .or-design .or-n { background: var(--rd-blue); }
  .or-in { padding: 0 0.6rem 0.6rem; display: grid; gap: 0.5rem; }
  .or-in > * { margin: 0 !important; }
  .or-in .chip { justify-self: start; }
  .or-seg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--rd-line); border-radius: 6px; overflow: hidden; }
  .or-seg label { margin: 0 !important; position: relative; }
  .or-seg input { position: absolute; opacity: 0; pointer-events: none; }
  .or-seg span { display: block; text-align: center; padding: 0.4rem 0.3rem; font-size: var(--sl-text-xs); color: var(--rd-muted); cursor: pointer; border-right: 1px solid var(--rd-line); }
  .or-seg label:last-child span { border-right: 0; }
  .or-seg input:checked + span { background: color-mix(in srgb, var(--rd-accent) 16%, transparent); color: var(--rd-ink); font-weight: 600; }
  .or-seg input:focus-visible + span { outline: 2px solid var(--rd-accent); outline-offset: -2px; }
  .or-ecc { align-self: end; }
  .or-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr); gap: 0.35rem 0.5rem; align-items: center; font-size: var(--sl-text-sm); color: var(--rd-muted); }
  .or-grid > * { margin: 0 !important; }
  .or-head { margin: 0 0 0.6rem !important; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid var(--rd-line); border-left: 4px solid var(--rd-line); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.3rem 0.6rem; }
  .or-head > * { margin: 0 !important; }
  .or-head.ok { border-left-color: var(--rd-ok); } .or-head.warn { border-left-color: var(--rd-warn); } .or-head.bad { border-left-color: var(--rd-accent); }
  .or-head .v { grid-column: 1 / -1; font-weight: 600; }
  .or-head div b { display: block; font: 600 1.15rem var(--sl-font-mono); }
  .or-head div span { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .or-live { border: 1px solid var(--rd-line); border-radius: 6px; padding: 0.6rem; margin: 0 !important; }
  .or-ctl { display: grid; gap: 0.45rem; }
  .or-ctl > * { margin: 0 !important; }
  .or-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; }
  .or-chips > * { margin: 0 !important; }
  .orcalc .chip[aria-pressed='true'], .orcalc .or-views .chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .or-t { display: grid !important; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 0.5rem; }
  .or-t b { font-family: var(--sl-font-mono); color: var(--rd-ink); min-width: 4.2rem; }
  .or-t input { padding: 0 !important; }
  .or-gland, .or-vsvg { width: 100%; height: auto; margin-top: 0.5rem !important; font-family: var(--sl-font-mono); display: block; }
  .or-cap { font-size: var(--sl-text-xs); color: var(--rd-muted); margin: 0.3rem 0 0 !important; }
  .or-checkrow { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.8rem 0 0 !important; }
  .or-checkrow > * { margin: 0 !important; }
  .or-ck { font: var(--sl-text-xs) var(--sl-font-mono); border: 1px solid var(--rd-line); border-radius: 999px; padding: 0.2rem 0.55rem; background: transparent; color: var(--rd-ink); cursor: pointer; }
  .or-ck.ok { border-color: color-mix(in srgb, var(--rd-ok) 60%, transparent); } .or-ck.ok::before { content: '✓ '; color: var(--rd-ok); }
  .or-ck.warn { border-color: var(--rd-warn); } .or-ck.warn::before { content: '! '; color: var(--rd-warn); }
  .or-ck.bad { border-color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); } .or-ck.bad::before { content: '✗ '; color: var(--rd-accent); }
  .or-ck[aria-pressed='true'] { outline: 2px solid var(--rd-ink); outline-offset: 1px; }
  .or-checktext { font-size: var(--sl-text-sm); margin: 0.5rem 0 0 !important; padding: 0.5rem 0.6rem; border-left: 3px solid var(--rd-line); background: color-mix(in srgb, var(--rd-panel) 85%, transparent); }
  .or-checktext.bad { border-left-color: var(--rd-accent); } .or-checktext.warn { border-left-color: var(--rd-warn); } .or-checktext.ok { border-left-color: var(--rd-ok); }
  .or-views { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 1rem 0 0 !important; }
  .or-views > * { margin: 0 !important; }
  .or-pane { margin: 0.3rem 0 0 !important; }
  .or-pane table { width: 100%; font-size: var(--sl-text-sm); border-collapse: collapse; display: table; margin-top: 0.5rem !important; }
  .or-pane td, .or-pane th { padding: 0.35rem 0.4rem; border-bottom: 1px solid var(--rd-line); vertical-align: top; text-align: left; }
  .or-pane td:first-child { font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); white-space: nowrap; }
  .or-pane .tw { overflow-x: auto; }
  .or-pane tr.sel { outline: 2px solid var(--rd-accent); }
  .st-ok { color: var(--rd-ok); } .st-warn { color: var(--rd-warn); } .st-bad { color: var(--rd-accent); }
</style>

<script>
  import { analyseGland, nearestId, designGland, pointSqueeze, glandAt, CS_TOL, type ORingInputs, type Arrangement, type Duty, type Corner } from '../lib/oring';
  import { monteCarlo } from '../lib/stack';

  const NS = 'http://www.w3.org/2000/svg';
  const pct = (v: number, d = 1) => `${(v * 100).toFixed(d)}%`;
  const calm = () => document.documentElement.classList.contains('motion-off') || matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Status = 'ok' | 'warn' | 'bad';

  document.querySelectorAll<HTMLElement>('[data-orcalc]').forEach((root) => {
    const data = JSON.parse(root.querySelector('[data-data]')!.textContent!);
    const ALPHA: Record<string, number> = JSON.parse(root.querySelector('[data-alpha]')!.textContent!);
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const val = (n: string) => { const f = form.elements.namedItem(n) as any; return f instanceof RadioNodeList ? f.value : f.value; };
    const num = (n: string) => +val(n);
    const ctl = (n: string) => root.querySelector<HTMLInputElement>(`[name="${n}"]`)!;
    const custom = () => val('cs') === 'other';
    const arr = () => val('arr') as Arrangement;
    const el = (svg: Element, tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    let corner: Corner = 'nom', view = 'range', chipSel = -1, sweeping = 0;
    let last: { i: ORingInputs; g: ReturnType<typeof analyseGland>; checks: [string, Status, string][]; cmp: any; med: string } | null = null;

    const fillIds = (keep?: number) => {
      if (custom()) return;
      const ids: number[] = data.idsA[val('cs')] ?? [];
      const sel = field('id') as HTMLSelectElement;
      sel.innerHTML = ids.map((v) => `<option value="${v}">${v.toFixed(2)}</option>`).join('');
      if (keep) sel.value = String(nearestId(ids, keep));
      field('csTol').value = String(CS_TOL[val('cs')] ?? 0.1);
    };
    const labels = () => {
      const a = arr();
      const set = (k: string, t: string, show = true) => {
        const lbl = root.querySelector<HTMLElement>(`[data-lbl="${k}"]`)!;
        lbl.textContent = t; lbl.hidden = !show;
        (field(`${k}Min`) as HTMLElement).hidden = !show; (field(`${k}Max`) as HTMLElement).hidden = !show;
      };
      set('bore', a === 'piston' ? 'Bore Ø' : 'Housing bore Ø', a !== 'face');
      set('shaft', a === 'piston' ? 'Plug Ø' : 'Rod Ø', a !== 'face');
      set('groove', a === 'piston' ? 'Groove root Ø' : a === 'rod' ? 'Groove Ø (in housing)' : 'Groove depth');
      set('gap', 'Flange gap', a === 'face');
      (field('ecc') as HTMLInputElement).disabled = a === 'face';
      root.querySelectorAll<HTMLElement>('[data-face]').forEach((e) => (e.hidden = a !== 'face'));
      root.querySelectorAll<HTMLElement>('[data-custom]').forEach((e) => (e.hidden = !custom()));
      (field('id').closest('label') as HTMLElement).hidden = custom();
      root.querySelector('[data-design-hint]')!.textContent = a === 'face'
        ? 'Uses the groove OD (pressure inside) or ID (pressure outside) and the flange gap. It selects a stock ring against the pressure side, sizes the groove and writes the result into the steps below.'
        : 'Uses the bore and the plug or rod in step 3. It selects a stock ring, sizes the groove for the targets and writes the result into the steps below.';
    };

    function inputs(): ORingInputs {
      const R = (k: string) => ({ min: num(`${k}Min`), max: num(`${k}Max`) });
      const csNow = custom() ? num('csX') : num('cs'), bu = num('buN') * Math.round(csNow * 0.26 * 10) / 10; // back-up rings share the width
      return {
        arrangement: arr(), duty: val('duty') as Duty,
        cs: csNow, csTol: num('csTol'), id: custom() ? num('idX') : num('id'), idTol: num('idTol'),
        bore: R('bore'), shaft: R('shaft'), groove: R('groove'), width: { min: num('wMin') - bu, max: num('wMax') - bu }, faceGap: R('gap'),
        eccentric: (field('ecc') as HTMLInputElement).checked && arr() !== 'face',
        tMin: num('tMin'), tMax: num('tMax'), tAssembly: 20,
        alphaE: num('ae') * 1e-6, alphaM: ALPHA[val('am')] ?? 12e-6, swell: num('sw') / 100, compressionSet: num('cset') / 100,
        pressure: num('p'), hardness: num('hard'), opening: num('open'),
      };
    }

    function run() {
      labels();
      const i = inputs(), g = analyseGland(i);
      const cmp = data.compounds.find((c: any) => c.code === val('cmp')), med = val('med');
      const checks: [string, Status, string][] = [];
      const [nLo, nHi] = g.bands.nom, [wLo, wHi] = g.bands.wc, sqWorstMin = Math.min(g.sqMinEol, g.sqMinPressurised);
      checks.push(['Nominal squeeze', g.sqNom * 100 >= nLo && g.sqNom * 100 <= nHi ? 'ok' : 'warn', `${pct(g.sqNom)} against a ${nLo}–${nHi}% target for this duty.`]);
      checks.push(['Maximum squeeze', g.sqMax * 100 <= wHi ? 'ok' : 'bad', `${pct(g.sqMax)} with the largest ring in the tightest gland, hot and swollen. Above approximately ${wHi}% the ring is overstressed and the assembly force increases.`]);
      checks.push(['Minimum squeeze', sqWorstMin * 100 >= wLo ? 'ok' : sqWorstMin > 0.05 ? 'warn' : 'bad', `${pct(g.sqMinCold)} with the smallest ring in the deepest gland at ${i.tMin} °C; ${pct(g.sqMinEol)} after ${num('cset')}% compression set${i.opening > 0 ? `; ${pct(g.sqMinPressurised)} when the joint opens ${i.opening} mm` : ''}. The minimum is ${wLo}%.`]);
      checks.push(['Fill', g.fillMax <= 0.9 && g.fillNom >= 0.6 ? 'ok' : g.fillMax > 0.9 ? 'bad' : 'warn', `${pct(g.fillNom, 0)} nominal, ${pct(g.fillMax, 0)} worst case (hot, swollen, smallest groove). Over approximately 90% risks hydraulic lock; under approximately 60% the ring can roll.`]);
      if (i.arrangement === 'piston') checks.push(['Stretch', g.stretchMax <= 0.05 && g.rawStretchMin >= 0 ? 'ok' : g.rawStretchMin < 0 ? 'warn' : 'bad', `${pct(g.stretchMin)} to ${pct(g.stretchMax)} onto the groove root. Keep it between 0 and approximately 5% at every tolerance corner; stretch thins the section.`]);
      if (i.arrangement === 'rod') checks.push(['Ring OD', g.circCompression <= 0.03 ? 'ok' : 'warn', `Circumferential compression up to ${pct(Math.max(0, g.circCompression))}. Above approximately 3% the ring can buckle in the groove.`]);
      const buN = num('buN');
      if (buN > 0) checks.push(['Extrusion', 'ok', `${buN === 1 ? 'One back-up ring' : 'Two back-up rings'} fitted (the fill uses the width left for the O-ring). Diametral clearance up to ${g.clearancePressurised.toFixed(3)} mm: confirm it against the back-up ring maker's limit (ISO 3601-4).${buN === 1 ? ' Put it on the low-pressure side; use two if the pressure can reverse.' : ''}`]);
      else checks.push(['Extrusion', !g.backupNeeded ? 'ok' : 'bad', g.extrusionLimit === 0 ? `At ${i.pressure} MPa a ${i.hardness} Shore ring needs a back-up ring at any gap.` : `Diametral clearance up to ${g.clearancePressurised.toFixed(3)} mm against approximately ${g.extrusionLimit.toFixed(2)} mm for ${i.hardness} Shore at ${i.pressure} MPa. Make the fit tighter, use a harder ring, or fit a back-up ring on the low-pressure side.`]);
      const tOk = i.tMin >= cmp.tMin && i.tMax <= cmp.tMax;
      checks.push(['Temperature', tOk ? 'ok' : 'bad', `${cmp.code} is usually good for ${cmp.tMin} to ${cmp.tMax} °C; the service is ${i.tMin} to ${i.tMax} °C.`]);
      const m = cmp.media[med];
      checks.push(['Medium', m === 'ok' ? 'ok' : m === 'lim' ? 'warn' : 'bad', `${cmp.code} in ${data.media.find((x: any) => x.key === med).name.toLowerCase()}: ${m === 'ok' ? 'usually compatible' : m === 'lim' ? 'limited: check the grade' : 'not compatible'}.`]);
      if (i.opening > 0 && i.tMin < cmp.tMin + 15) checks.push(['Cold recovery', 'bad', 'The joint opens under pressure while the ring is within 15 °C of its low-temperature limit. A cold ring recovers slowly and may not follow the gap: the Challenger failure mechanism. Check recovery at temperature (TR-10), keep the ring warm, or design the joint not to open.']);
      last = { i, g, checks, cmp, med };

      // headline
      const worst: Status = checks.some((c) => c[1] === 'bad') ? 'bad' : checks.some((c) => c[1] === 'warn') ? 'warn' : 'ok';
      const head = root.querySelector<HTMLElement>('[data-head]')!;
      head.className = `or-head ${worst}`;
      head.innerHTML = `<p class="v">${worst === 'ok' ? 'The gland passes all the checks' : worst === 'warn' ? 'The gland passes; check the amber items' : `${checks.filter((c) => c[1] === 'bad').length} check${checks.filter((c) => c[1] === 'bad').length > 1 ? 's fail' : ' fails'}`}</p>
        <div><b>${pct(g.sqNom)}</b><span>nominal squeeze</span></div>
        <div><b>${pct(sqWorstMin, 0)}–${pct(g.sqMax, 0)}</b><span>worst-case range</span></div>
        <div><b>${pct(g.fillMax, 0)}</b><span>worst fill</span></div>`;
      // check chips
      root.querySelector('[data-chips]')!.innerHTML = checks.map(([k, s], j) => `<button type="button" class="or-ck ${s}" data-ck="${j}" aria-pressed="${j === chipSel}">${k}</button>`).join('');
      showChip();
      // step summaries
      const sum = (k: string, t: string) => { root.querySelector(`[data-sum="${k}"]`)!.textContent = t; };
      sum('type', `${arr() === 'piston' ? 'plug groove' : arr() === 'rod' ? 'bore groove' : 'face'}, ${val('duty')}`);
      sum('ring', `${i.id.toFixed(2)} × ${i.cs.toFixed(2)}`);
      sum('hw', arr() === 'face' ? `depth ${i.groove.min}–${i.groove.max}` : `bore ${i.bore.min}–${i.bore.max}`);
      sum('svc', `${i.pressure} MPa, ${i.tMin} to ${i.tMax} °C, ${cmp.code}`);
      sum('mat', `α ${(i.alphaM * 1e6).toFixed(1)}, set ${num('cset')}%`);
      root.querySelector('[data-idhint]')!.textContent = i.arrangement === 'piston' ? `Pick the stock ID just below the groove root (${((i.groove.min + i.groove.max) / 2).toFixed(2)} mm) for 1–5% stretch.`
        : i.arrangement === 'rod' ? 'Pick the stock ID at or just below the rod diameter, so that the ring OD sits against the groove.'
        : 'Internal pressure: ring OD close to the groove OD. External pressure: ring ID close to the groove ID.';
      // the temperature slider follows the service range
      const s = ctl('liveT');
      s.min = String(Math.min(i.tMin, i.tMax)); s.max = String(Math.max(i.tMin, i.tMax));
      if (+s.value < +s.min || +s.value > +s.max) s.value = String(Math.min(Math.max(20, +s.min), +s.max));
      drawGland();
      drawView();
    }

    function showChip() {
      const p = root.querySelector<HTMLElement>('[data-chiptext]')!;
      if (!last) return;
      const k = chipSel >= 0 && chipSel < last.checks.length ? chipSel : last.checks.findIndex((c) => c[1] === 'bad') >= 0 ? last.checks.findIndex((c) => c[1] === 'bad') : last.checks.findIndex((c) => c[1] === 'warn');
      if (k < 0) { p.className = 'or-checktext ok'; p.textContent = 'Every check passes. Select a check to see its details.'; return; }
      const [name, s, t] = last.checks[k];
      p.className = `or-checktext ${s}`; p.innerHTML = `<b>${name}.</b> ${t}`;
    }

    // ---- the live gland section, to scale ----
    function drawGland() {
      if (!last) return;
      const { i, g } = last, T = +ctl('liveT').value, P = ctl('liveP').checked, buN = num('buN');
      const s = glandAt(i, corner, T, P), svg = root.querySelector<SVGSVGElement>('[data-gland]')!;
      root.querySelector('[data-tval]')!.textContent = `${T} °C`;
      svg.replaceChildren();
      const W = Math.round(Math.min(620, Math.max(320, svg.clientWidth || 480))), H = 286, top = 80;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const wTot = s.w + buN * Math.round(i.cs * 0.26 * 10) / 10, land = Math.max(wTot * 0.5, i.cs * 0.8);
      const k = Math.min((W - 60) / (wTot + 2 * land), 150 / Math.max(s.g, s.c)), x0 = (W - (wTot + 2 * land) * k) / 2;
      const gx0 = x0 + land * k, gx1 = gx0 + wTot * k, yRoot = top + s.g * k, gapPx = Math.max(s.gap * k, s.gap > 0 ? 2 : 0), yLand = top + gapPx;
      const face = i.arrangement === 'face', mateName = face ? 'flange' : i.arrangement === 'piston' ? 'bore' : 'rod', grooveName = face ? 'grooved flange' : i.arrangement === 'piston' ? 'plug' : 'housing';
      // mating part and grooved part
      el(svg, 'rect', { x: x0 - 10, y: top - 34, width: (wTot + 2 * land) * k + 20, height: 34, fill: 'var(--rd-steel)', 'fill-opacity': 0.75 });
      el(svg, 'path', { d: `M${x0 - 10},${yLand} H${gx0} V${yRoot} H${gx1} V${yLand} H${x0 + (wTot + 2 * land) * k + 10} V${yRoot + 34} H${x0 - 10} Z`, fill: 'var(--rd-steel)', 'fill-opacity': 0.5 });
      el(svg, 'text', { x: x0 - 4, y: top - 12, 'font-size': 12, fill: 'var(--rd-ink)' }, mateName);
      el(svg, 'text', { x: x0 - 4, y: yRoot + 24, 'font-size': 12, fill: 'var(--rd-ink)' }, grooveName);
      // extrusion gap, on the low-pressure side (right)
      const ext = buN === 0 && g.backupNeeded && P;
      if (s.gap > 0) el(svg, 'rect', { x: gx1, y: top, width: land * k, height: gapPx, fill: ext ? 'var(--rd-accent)' : 'var(--rd-warn)', 'fill-opacity': ext ? 0.55 : 0.3 });
      // back-up rings
      const bt = Math.round(i.cs * 0.26 * 10) / 10 * k;
      let ringX0 = gx0, ringX1 = gx1;
      if (buN >= 1) { el(svg, 'rect', { x: gx1 - bt, y: top, width: bt, height: yRoot - top, fill: 'var(--rd-blue)', 'fill-opacity': 0.6 }); ringX1 -= bt; }
      if (buN >= 2) { el(svg, 'rect', { x: gx0, y: top, width: bt, height: yRoot - top, fill: 'var(--rd-blue)', 'fill-opacity': 0.6 }); ringX0 += bt; }
      // the ring at constant area: a circle if free, a stadium when squeezed between the two surfaces
      const A = (Math.PI / 4) * s.c * s.c, room = (ringX1 - ringX0) / k;
      let hgt = Math.min(s.c, s.g), wid = s.c <= s.g ? s.c : (A - (Math.PI / 4) * s.g * s.g) / s.g + s.g;
      const over = wid > room + 1e-9;
      if (over) wid = room;
      const cx = P ? ringX1 / k * k - (wid / 2) * k : (ringX0 + ringX1) / 2, cy = s.c <= s.g ? yRoot - (s.c / 2) * k : top + (s.g / 2) * k;
      const rx = (wid / 2) * k, ry = (hgt / 2) * k, rr = Math.min(rx, ry);
      el(svg, 'rect', { x: cx - rx, y: cy - ry, width: 2 * rx, height: 2 * ry, rx: rr, ry: rr, fill: s.squeeze < 0 ? 'var(--rd-warn)' : 'var(--rd-ink)', 'fill-opacity': 0.88, stroke: over ? 'var(--rd-accent)' : 'none', 'stroke-width': over ? 3 : 0 });
      if (s.squeeze < 0) el(svg, 'text', { x: cx, y: cy - ry - 6, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-warn)' }, 'no contact');
      // pressure arrows
