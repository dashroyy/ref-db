        const y = top + (yRoot - top) * dy, xa = gx0 + 4;
        el(svg, 'path', { d: `M${xa},${y} h${Math.max(10, cx - rx - xa - 4)}`, stroke: 'var(--rd-accent)', 'stroke-width': 2, fill: 'none' });
