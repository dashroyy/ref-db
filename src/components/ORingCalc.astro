      }
      // dimension: gland depth
      el(svg, 'path', { d: `M${gx0 - 8},${top} V${yRoot} M${gx0 - 12},${top} h8 M${gx0 - 12},${yRoot} h8`, stroke: 'var(--rd-muted)', fill: 'none' });
      el(svg, 'text', { x: gx0 - 14, y: (top + yRoot) / 2 + 4, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--rd-muted)' }, `${s.g.toFixed(2)}`);
      // readouts on the drawing
      const sq = corner === 'min' ? s.squeezeEol : s.squeeze;
      const bands = g.bands, sqCls = sq * 100 < bands.wc[0] || sq * 100 > bands.wc[1] ? 'var(--rd-accent)' : 'var(--rd-ok)';
      el(svg, 'text', { x: 10, y: 16, 'font-size': 13, fill: sqCls, 'font-weight': 600 }, `squeeze ${pct(sq)}${corner === 'min' ? (W < 440 ? '*' : ' (after set)') : ''}`);
      el(svg, 'text', { x: 10, y: 34, 'font-size': 12, fill: over ? 'var(--rd-accent)' : 'var(--rd-ink)' }, `fill ${pct(s.fill, 0)}${over ? ': over-filled' : ''}`);
      el(svg, 'text', { x: W - 10, y: 34, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, `${s.c.toFixed(2)} in ${s.g.toFixed(2)} × ${s.w.toFixed(2)}`);
      el(svg, 'text', { x: W - 10, y: 16, 'text-anchor': 'end', 'font-size': 12, fill: ext ? 'var(--rd-accent)' : 'var(--rd-ink)' }, s.gap > 0 ? `gap ${s.gap.toFixed(3)}${ext ? ' extrudes' : ' mm'}` : 'no gap here');
      el(svg, 'text', { x: W / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, W < 440 ? `to scale · ${corner === 'nom' ? 'nominal' : corner === 'min' ? 'least squeeze' : 'most squeeze'} · ${T} °C${P ? ' · pressure' : ''}` : `to scale · ${corner === 'nom' ? 'nominal parts' : corner === 'min' ? 'smallest ring, deepest gland' : 'largest ring, tightest gland, swollen'} · ${T} °C${P ? ' · pressure on' : ''}`);
      root.querySelector('[data-gcap]')!.textContent = 'Select an assembly and move the temperature, or sweep it, to see the ring shrink and swell in its groove. With the pressure on, the ring moves to the low-pressure side and the gap there is the extrusion gap.';
    }

    // ---- the other views ----
    function drawView() {
      if (!last) return;
      const { i, g } = last, svg = root.querySelector<SVGSVGElement>('[data-vsvg]')!, html = root.querySelector<HTMLElement>('[data-vhtml]')!, cap = root.querySelector<HTMLElement>('[data-vcap]')!;
      svg.replaceChildren(); html.innerHTML = ''; svg.style.display = '';
      const W = Math.round(Math.min(620, Math.max(320, svg.clientWidth || root.querySelector<HTMLElement>('.or-pane')!.clientWidth || 480)));
      if (view === 'range') {
        svg.setAttribute('viewBox', `0 0 ${W} 110`);
        const X = (v: number) => 20 + (Math.max(0, Math.min(0.4, v)) / 0.4) * (W - 40);
        for (let v = 0; v <= 0.4001; v += 0.05) { el(svg, 'line', { x1: X(v), x2: X(v), y1: 26, y2: 70, stroke: 'var(--rd-line)' }); el(svg, 'text', { x: X(v), y: 86, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, `${Math.round(v * 100)}%`); }
        el(svg, 'rect', { x: X(g.bands.wc[0] / 100), y: 34, width: X(g.bands.wc[1] / 100) - X(g.bands.wc[0] / 100), height: 28, fill: 'var(--rd-ok)', 'fill-opacity': 0.12 });
        el(svg, 'rect', { x: X(g.bands.nom[0] / 100), y: 34, width: X(g.bands.nom[1] / 100) - X(g.bands.nom[0] / 100), height: 28, fill: 'var(--rd-ok)', 'fill-opacity': 0.25 });
        const lo = Math.min(g.sqMinEol, g.sqMinPressurised);
        el(svg, 'line', { x1: X(lo), x2: X(g.sqMax), y1: 48, y2: 48, stroke: 'var(--rd-ink)', 'stroke-width': 3 });
        for (const [v, c] of [[g.sqMinCold, 'var(--rd-blue)'], [g.sqMinEol, 'var(--rd-warn)'], [g.sqMax, 'var(--rd-accent)']] as const) el(svg, 'circle', { cx: X(v), cy: 48, r: 5, fill: c });
        if (g.sqMinPressurised < g.sqMinEol - 1e-6) el(svg, 'circle', { cx: X(g.sqMinPressurised), cy: 48, r: 5, fill: 'var(--rd-accent)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
        el(svg, 'rect', { x: X(g.sqNom) - 2, y: 36, width: 4, height: 24, fill: 'var(--rd-ink)' });
        el(svg, 'text', { x: 20, y: 16, 'font-size': 11, fill: 'var(--rd-muted)' }, 'worst-case squeeze · bar = nominal · light green = limits, dark = target');
        el(svg, 'text', { x: 20, y: 104, 'font-size': 11, fill: 'var(--rd-blue)' }, '● cold'); el(svg, 'text', { x: 80, y: 104, 'font-size': 11, fill: 'var(--rd-warn)' }, '● after set'); el(svg, 'text', { x: 170, y: 104, 'font-size': 11, fill: 'var(--rd-accent)' }, '● most / opened');
        cap.textContent = 'From the least squeeze (smallest ring, deepest gland, cold, after compression set) to the most (largest ring, tightest gland, hot, swollen).';
      } else if (view === 'temp') {
        const t0 = Math.min(i.tMin, i.tMax), t1 = Math.max(i.tMin, i.tMax), n = 30;
        if (!(t1 > t0)) { cap.textContent = 'Enter a temperature range.'; return; }
        const pts = Array.from({ length: n + 1 }, (_, k) => { const T = t0 + ((t1 - t0) * k) / n, a = analyseGland({ ...i, tMin: T, tMax: T }); return { T, lo: Math.min(a.sqMinEol, a.sqMinPressurised), hi: a.sqMax }; });
        const L = 44, Rr = 12, T = 22, B = 34, H = 220;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const ymax = Math.max(0.4, ...pts.map((p) => p.hi)) * 1.05, ymin = Math.min(0, ...pts.map((p) => p.lo));
        const X = (v: number) => L + ((v - t0) / (t1 - t0)) * (W - L - Rr), Y = (v: number) => T + ((ymax - v) / (ymax - ymin)) * (H - T - B);
        el(svg, 'rect', { x: L, y: Y(g.bands.wc[1] / 100), width: W - L - Rr, height: Y(g.bands.wc[0] / 100) - Y(g.bands.wc[1] / 100), fill: 'var(--rd-ok)', 'fill-opacity': 0.12 });
        for (let v = 0; v <= ymax + 1e-9; v += 0.1) { el(svg, 'line', { x1: L, x2: W - Rr, y1: Y(v), y2: Y(v), stroke: 'var(--rd-line)' }); el(svg, 'text', { x: L - 6, y: Y(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--rd-muted)' }, `${Math.round(v * 100)}%`); }
        const step = t1 - t0 > 120 ? 40 : 20;
        for (let v = Math.ceil(t0 / step) * step; v <= t1; v += step) el(svg, 'text', { x: X(v), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, `${v}`);
        const line = (key: 'lo' | 'hi', c: string) => el(svg, 'polyline', { points: pts.map((p) => `${X(p.T).toFixed(1)},${Y(p[key]).toFixed(1)}`).join(' '), fill: 'none', stroke: c, 'stroke-width': 2.2 });
        line('hi', 'var(--rd-accent)'); line('lo', 'var(--rd-blue)');
        const Tl = +ctl('liveT').value;
        el(svg, 'line', { x1: X(Tl), x2: X(Tl), y1: T, y2: H - B, stroke: 'var(--rd-ink)', 'stroke-dasharray': '3 3' });
        el(svg, 'text', { x: L, y: 14, 'font-size': 11, fill: 'var(--rd-blue)' }, 'least (after set)'); el(svg, 'text', { x: L + 140, y: 14, 'font-size': 11, fill: 'var(--rd-accent)' }, 'most'); el(svg, 'text', { x: L + 190, y: 14, 'font-size': 11, fill: 'var(--rd-ok)' }, 'green: limits');
        el(svg, 'text', { x: (L + W - Rr) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'service temperature (°C)');
        cap.textContent = 'Least and most squeeze across the service temperature range. The dashed line is the temperature of the section view.';
      } else if (view === 'stats') {
        const R = (name: string, r: { min: number; max: number }) => ({ name, sens: 1, lo: r.min, hi: r.max });
        const cs = [{ name: 'cs', sens: 1, lo: i.cs - i.csTol, hi: i.cs + i.csTol }, { name: 'id', sens: 1, lo: i.id - i.idTol, hi: i.id + i.idTol }, R('bore', i.bore), R('shaft', i.shaft), R('groove', i.groove), R('width', i.width), R('gap', i.faceGap)];
        const N = 40000, mc = monteCarlo(cs, { n: N, seed: 1, f: (x) => pointSqueeze(i, x, i.tMin) * (1 - i.compressionSet) });
        const floor = g.bands.wc[0] / 100, below = mc.below(floor), x0 = Math.min(floor, g.sqMinEol, mc.min) - 0.01, x1 = Math.max(mc.max, floor) + 0.01;
        const L = 44, Rr = 12, T = 22, B = 34, H = 220, nb = 40, bins = new Array(nb).fill(0);
        for (const v of mc.sorted) bins[Math.min(nb - 1, Math.max(0, Math.floor(((v - x0) / (x1 - x0)) * nb)))]++;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const X = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - Rr), top = Math.max(...bins), bw = (W - L - Rr) / nb;
        bins.forEach((b, j) => { const h = (b / top) * (H - T - B); if (b) el(svg, 'rect', { x: L + j * bw + 0.5, y: H - B - h, width: Math.max(1, bw - 1), height: h, fill: 'var(--rd-steel)', 'fill-opacity': 0.6 }); });
        el(svg, 'line', { x1: X(floor), x2: X(floor), y1: T, y2: H - B, stroke: 'var(--rd-accent)', 'stroke-width': 2 });
        el(svg, 'line', { x1: X(g.sqMinEol), x2: X(g.sqMinEol), y1: T, y2: H - B, stroke: 'var(--rd-ink)', 'stroke-dasharray': '4 3' });
        const sp = (x1 - x0) > 0.2 ? 0.05 : 0.02;
        for (let v = Math.ceil(x0 / sp) * sp; v <= x1; v += sp) el(svg, 'text', { x: X(v), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, `${Math.round(v * 100)}%`);
        el(svg, 'text', { x: L, y: 14, 'font-size': 11, fill: 'var(--rd-accent)' }, `limit ${g.bands.wc[0]}%`); el(svg, 'text', { x: L + 90, y: 14, 'font-size': 11, fill: 'var(--rd-ink)' }, `dashed: worst case ${pct(g.sqMinEol)}`);
        el(svg, 'text', { x: (L + W - Rr) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, `squeeze at ${i.tMin} °C after compression set`);
        cap.innerHTML = `${N.toLocaleString('en-GB')} simulated assemblies, each dimension normal across its limits: <b>${below > 0 ? `${pct(below, 2)} below ${g.bands.wc[0]}%` : `none below ${g.bands.wc[0]}%`}</b>, 3σ value ${pct(mc.quantile(0.00135))}. The worst case needs every dimension at its limit at once.`;
      } else if (view === 'dwg') {
        svg.style.display = 'none';
        const f2 = (v: number) => v.toFixed(2), f3 = (v: number) => v.toFixed(3), cs = i.cs, chamfer = Math.max(1.1, Math.round(cs * 0.52 * 10) / 10), br = Math.round(cs * 0.26 * 10) / 10, buN = num('buN');
        const rows: [string, string][] = [];
        rows.push(['O-ring', `${f2(i.id)} × ${f2(cs)} (ID ± ${f2(i.idTol)}, section ± ${f2(i.csTol)}), compound and cure date, assembly lubricant compatible with the compound`]);
        if (i.arrangement === 'piston') rows.push(['Groove root Ø', `${f3(i.groove.min)} – ${f3(i.groove.max)}, runout to the pilot (see Tolerance stack)`]);
        if (i.arrangement === 'rod') rows.push(['Groove Ø', `${f3(i.groove.min)} – ${f3(i.groove.max)}, runout to the bore`]);
        if (i.arrangement === 'face') rows.push(['Groove depth', `${f3(i.groove.min)} – ${f3(i.groove.max)}`]);
        rows.push(['Groove width', `${f2(num('wMin'))} – ${f2(num('wMax'))}${buN > 0 ? ` · includes ${buN === 1 ? 'a back-up ring' : 'two back-up rings'} of approximately ${br} mm` : g.backupNeeded ? ' · add the width of a back-up ring' : ''}`]);
        rows.push(['Corners', `root radius ${cs <= 2.62 ? '0.1–0.2' : cs <= 5.33 ? '0.2–0.4' : '0.4–0.6'} mm; groove edges broken 0.1–0.2 mm, no burrs`]);
        rows.push(['Lead-in', `15–20° chamfer, at least ${chamfer} mm long, blended, on each edge that the ring passes`]);
        rows.push(['Surface finish', `${i.duty === 'dynamic' ? 'counterface Ra 0.2–0.4 µm' : 'sealing faces Ra 0.4 µm (gas) to 0.8 µm (liquid)'}; groove walls Ra 1.6–3.2 µm; lay not across the seal path; no radial scratches`]);
        rows.push(['Extrusion gap', `diametral clearance at most ${f3(g.clearanceMax)} mm${buN > 0 ? ', with back-up ring' : ''}`]);
        html.innerHTML = `<table><tbody>${rows.map(([k, t]) => `<tr><td>${k}</td><td>${t}</td></tr>`).join('')}</tbody></table>`;
        cap.textContent = 'What goes on the groove drawing for this gland. Typical values: confirm them against ISO 3601-2 and the seal maker.';
      } else {
        svg.style.display = 'none';
        const { cmp, med } = last;
        html.innerHTML = `<div class="tw"><table><thead><tr><th>Compound</th><th>Range °C</th><th>Fit</th><th>Notes</th></tr></thead><tbody>${data.compounds.map((c: any) => {
          const tOk = i.tMin >= c.tMin && i.tMax <= c.tMax, m = c.media[med], fit = !tOk || m === 'no' ? 'bad' : m === 'lim' ? 'warn' : 'ok';
          return `<tr class="${c.code === cmp.code ? 'sel' : ''}"><td><b>${c.code}</b> ${c.name}</td><td>${c.tMin} to ${c.tMax}</td><td class="st-${fit}">${fit === 'ok' ? '✓ suitable' : fit === 'warn' ? '! check grade' : '✗ ' + (!tOk ? 'temperature' : 'medium')}</td><td>${c.note} <em>${c.watch}</em></td></tr>`;
        }).join('')}</tbody></table></div>`;
        cap.textContent = 'Each compound against this temperature range and medium. Select a compound in step 4.';
      }
    }

    // ---- interaction ----
    root.querySelectorAll<HTMLButtonElement>('[data-corner]').forEach((b) => b.addEventListener('click', () => {
      corner = b.dataset.corner as Corner;
      root.querySelectorAll('[data-corner]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const i = last?.i;
      if (i) ctl('liveT').value = String(corner === 'min' ? i.tMin : corner === 'max' ? i.tMax : Math.min(Math.max(20, Math.min(i.tMin, i.tMax)), Math.max(i.tMin, i.tMax)));
      if (corner === 'min' && i && i.opening > 0) ctl('liveP').checked = true;
      drawGland(); if (view === 'temp') drawView();
    }));
    ctl('liveT').addEventListener('input', () => { drawGland(); if (view === 'temp') drawView(); });
    ctl('liveP').addEventListener('change', drawGland);
    root.querySelector('[data-chips]')!.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-ck]'); if (!b) return;
      chipSel = chipSel === +b.dataset.ck! ? -1 : +b.dataset.ck!;
      root.querySelectorAll('[data-ck]').forEach((x) => x.setAttribute('aria-pressed', String(+(x as HTMLElement).dataset.ck! === chipSel)));
      showChip();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view!;
      root.querySelectorAll('[data-view]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      drawView();
    }));
    const sweepBtn = root.querySelector<HTMLButtonElement>('[data-sweep]')!;
    sweepBtn.addEventListener('click', () => {
      if (sweeping) { cancelAnimationFrame(sweeping); sweeping = 0; sweepBtn.textContent = '▶ Sweep temperature'; return; }
      const s = ctl('liveT'), lo = +s.min, hi = +s.max;
      if (calm()) { s.value = String(+s.value <= (lo + hi) / 2 ? hi : lo); drawGland(); if (view === 'temp') drawView(); return; }
      const t0 = performance.now(), dur = 5000;
      sweepBtn.textContent = '⏸ Stop';
      const tick = (t: number) => {
        const u = ((t - t0) % dur) / dur, x = u < 0.5 ? u * 2 : 2 - u * 2; // cold → hot → cold
        s.value = String(Math.round(lo + (hi - lo) * x));
        drawGland(); if (view === 'temp') drawView();
        if (t - t0 < 2 * dur) sweeping = requestAnimationFrame(tick); else { sweeping = 0; sweepBtn.textContent = '▶ Sweep temperature'; }
      };
      sweeping = requestAnimationFrame(tick);
    });

    root.querySelector('[data-design]')!.addEventListener('click', () => {
      const i = inputs(), a = i.arrangement;
      const mating = a === 'piston' ? (i.bore.min + i.bore.max) / 2 : a === 'rod' ? (i.shaft.min + i.shaft.max) / 2 : num('dFaceD');
      const csSel = val('dCs'), csUse = csSel === 'auto' ? (mating < 20 ? 1.78 : mating < 50 ? 2.62 : mating < 120 ? 3.53 : mating < 300 ? 5.33 : 6.99) : +csSel;
      const bu = val('dBu');
      const d = designGland({
        arrangement: a, duty: i.duty, mating, pressureInside: val('dSide') !== 'out', pressure: i.pressure, hardness: i.hardness,
        clearance: a === 'face' ? 2 * i.faceGap.max : i.bore.max - i.shaft.min, squeeze: num('dSq') / 100, fill: num('dFill') / 100,
        cs: csUse, ids: data.idsA[csUse.toFixed(2)] ?? data.idsA[String(csUse)] ?? [], backups: bu === 'auto' ? undefined : +bu,
      });
      field('cs').value = String(d.cs);
      fillIds(d.id);
      field('id').value = String(d.id);
      field('csTol').value = String(CS_TOL[d.cs.toFixed(2)] ?? d.csTol);
      field('idTol').value = d.idTol.toFixed(2);
      field('grooveMin').value = (d.groove - 0.05).toFixed(a === 'face' ? 2 : 3); field('grooveMax').value = (d.groove + 0.05).toFixed(a === 'face' ? 2 : 3);
      field('wMin').value = d.width.toFixed(2); field('wMax').value = (d.width + 0.2).toFixed(2);
      field('buN').value = String(d.backups);
      run();
    });
    field('cs').addEventListener('change', () => fillIds(num('id') || 100));
    let deb = 0;
    form.addEventListener('input', () => { window.clearTimeout(deb); deb = window.setTimeout(run, 120); });
    form.addEventListener('change', run);
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (Math.abs(nw - w) > 8) { w = nw; drawGland(); drawView(); } }).observe(root.querySelector('[data-gland]')!);
    }
    fillIds(139.29);
    run();
  });
</script>
