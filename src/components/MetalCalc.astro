---
// Metallurgy in three tabs: a steel on the iron–carbon diagram (lever rule, Andrews Ac1/Ac3/Ms, martensite hardness);
// tempering and later heat by the Hollomon–Jaffe parameter; and diffusion depth. Maths in src/lib/metallurgy.ts
// (unit-tested); UI only here.
import { DIFFUSANTS } from '../lib/metallurgy';

const TABS = [{ key: 'fec', name: 'Iron and carbon' }, { key: 'temp', name: 'Tempering' }, { key: 'diff', name: 'Diffusion' }];
---

<div class="calc metalcalc" data-metalcalc>
  <div class="calc-head"><span>Steel heat treatment</span><span class="head-btns"><span>Fe–C · Hollomon–Jaffe · Fick</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Steel heat treatment">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="fec">
        <legend>Composition (mass %)</legend>
        <div class="row2">
          <label>C<input name="C" type="number" min="0" max="2" step="any" value="0.46" /></label>
          <label>Mn<input name="Mn" type="number" min="0" step="any" value="0.75" /></label>
          <label>Si<input name="Si" type="number" min="0" step="any" value="0.22" /></label>
          <label>Ni<input name="Ni" type="number" min="0" step="any" value="0.55" /></label>
          <label>Cr<input name="Cr" type="number" min="0" step="any" value="1.05" /></label>
          <label>Mo<input name="Mo" type="number" min="0" step="any" value="1.0" /></label>
          <label>V<input name="V" type="number" min="0" step="any" value="0.08" /></label>
        </div>
        <p class="hint">Use the certificate of the heat. The formulas are for low-alloy steels with 0.1 to 0.6% carbon.</p>
      </fieldset>

      <fieldset data-panel="temp" hidden>
        <legend>Temper and later heat</legend>
        <div class="row2">
          <label>Temper temperature (°C)<input name="tT" type="number" min="100" max="750" step="any" value="565" /></label>
          <label>Temper time, total (h)<input name="tt" type="number" min="0.01" step="any" value="4" /></label>
          <label>Exposure 1 (°C)<input name="e1T" type="number" min="20" max="750" step="any" value="160" /></label>
          <label>Exposure 1 time (h)<input name="e1t" type="number" min="0" step="any" value="6" /></label>
          <label>Exposure 2 (°C)<input name="e2T" type="number" min="20" max="750" step="any" value="540" /></label>
          <label>Exposure 2 time (h)<input name="e2t" type="number" min="0" step="any" value="2" /></label>
          <label>Constant C<input name="cc" type="number" min="10" max="25" step="any" value="20" /></label>
          <label>Margin below the temper (°C)<input name="mT" type="number" min="0" step="any" placeholder="your value" /></label>
        </div>
        <p class="hint">Exposures are later heat: stress relief, a coating or insulation cure, a hydrogen bake. Leave a time blank or zero to ignore it. C is approximately 20 for low-alloy steels.</p>
      </fieldset>

      <fieldset data-panel="diff" hidden>
        <legend>Diffusion from the surface</legend>
        <div class="row2">
          <label class="wide">What diffuses<select name="sp">{DIFFUSANTS.map((d) => <option value={d.key}>{d.name}</option>)}<option value="custom">Your own D₀ and Q</option></select></label>
          <label>D₀ (m²/s)<input name="D0" type="text" inputmode="decimal" value="2.3e-5" autocomplete="off" /></label>
          <label>Q (kJ/mol)<input name="Q" type="number" min="0" step="any" value="148" /></label>
          <label>Temperature (°C)<input name="dT" type="number" step="any" value="900" /></label>
          <label>Time (h)<input name="dt" type="number" min="0" step="any" value="1" /></label>
          <label>Depth criterion (% of change left)<input name="rem" type="number" min="0.1" max="99" step="any" value="10" /></label>
          <label>Allowed depth (mm)<input name="xa" type="number" min="0" step="any" placeholder="your value" /></label>
        </div>
        <p class="hint">The depth is where only this percentage of the surface change in concentration remains. For decarburisation, 10% means the carbon is back to 90% of the core value.</p>
      </fieldset>
      <p class="hint example-note" data-example-note hidden></p>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 260" data-chart role="img" aria-label="Chart for the selected heat-treatment check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Screening only: the binary iron–carbon diagram, Andrews' empirical formulas for low-alloy steels, a Hollomon–Jaffe
    parameter with one constant, and diffusion into a semi-infinite solid with a constant surface concentration. The
    governing values come from the material specification and the heat-treatment procedure.
  </div>
</div>

<style is:global>
  .metalcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .metalcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
  .metalcalc .pv-notes li.bad { color: var(--rd-accent); }
  .metalcalc .pv-notes li.warn { color: var(--rd-warn); }
  .metalcalc .example-note { margin: 0.5rem 0 0 !important; }
  .metalcalc label.wide { grid-column: 1 / -1; }
  .metalcalc select, .metalcalc input[type='text'] { width: 100%; }
</style>

<script>
  import { FE_C, a3Binary, acmBinary, steelSummary, hjTemp, tempering, diffusant, diffusivity, diffusionDepth, diffusionTime, erfc } from '../lib/metallurgy';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const f = (v: number, d = 0) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const sci = (v: number, d = 2) => {
    if (!Number.isFinite(v)) return '—';
    if (v === 0) return '0';
    const e = Math.floor(Math.log10(Math.abs(v))), m = v / 10 ** e;
    return e >= -2 && e <= 3 ? (+v.toPrecision(d + 1)).toLocaleString('en-GB') : `${m.toFixed(d)} × 10${String(e).split('').map((c) => SUP[c]).join('')}`;
  };
  const hrs = (h: number) => (!Number.isFinite(h) ? '—' : h < 1 / 3600 ? 'less than 1 s' : h < 1 / 60 ? `${f(h * 3600, 0)} s` : h < 1 ? `${f(h * 60, 0)} min` : h < 100 ? `${f(h, 1)} h` : `${f(h, 0)} h`);
  const pow = (e: number) => `10${String(e).split('').map((c) => SUP[c]).join('')}`;
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-metalcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => { const s = field(n).value.trim().replace(/\s/g, '').replace(/×10\^?/i, 'e'); return s === '' ? NaN : +s; };
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const txt = (x: number, y: number, s: string, c = 'var(--rd-ink)', anchor = 'start', fs = 10) =>
      el('text', { x, y, 'text-anchor': anchor, 'font-size': fs, fill: c, stroke: 'var(--rd-panel)', 'stroke-width': 3, 'paint-order': 'stroke' }, s);
    const width = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    const frame = (H: number) => { svg.replaceChildren(); const W = width(); svg.setAttribute('viewBox', `0 0 ${W} ${H}`); return W; };
    const nice = (m: number) => { const e = 10 ** Math.floor(Math.log10(m)); return [1, 2, 2.5, 5, 10].map((k) => k * e).find((s) => m / s <= 6)!; };
    const line = (pts: [number, number][], c: string, w = 2, dash = '') => el('polyline', { points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), fill: 'none', stroke: c, 'stroke-width': w, 'stroke-dasharray': dash });
    const axisTitles = (W: number, H: number, L: number, R: number, T: number, B: number, xl: string, yl: string) => {
      el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, xl);
      el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, yl);
    };
    let mode = 'fec';
    let draw: (() => void) | null = null;

    // ---- iron and carbon ----
    function runFec(rows: Row[], notes: [string, string][]) {
      const s = { C: num('C'), Mn: num('Mn') || 0, Si: num('Si') || 0, Ni: num('Ni') || 0, Cr: num('Cr') || 0, Mo: num('Mo') || 0, V: num('V') || 0 };
      if (!(s.C > 0 && s.C <= 2)) { notes.push(['bad', 'Enter a carbon content between 0 and 2%.']); return null; }
      const r = steelSummary(s), p = r.phases;
      rows.push({ dt: 'As-quenched hardness', dd: `${f(r.hrc)} HRC <small>fully martensitic; carbon alone sets it${s.C > 0.6 ? ' (limited at 0.6% C)' : ''}</small>`, primary: true, cls: r.valid ? '' : 'warn' });
      rows.push({ dt: 'Ac1 and Ac3', dd: `${f(r.ac1)} and ${f(r.ac3)} °C <small>austenitise at approximately ${f(Math.round(r.austenitise[0] / 5) * 5)} to ${f(Math.round(r.austenitise[1] / 5) * 5)} °C</small>` });
      rows.push({ dt: 'Martensite start, Ms', dd: `${f(r.ms)} °C <small>${r.ms < 250 ? 'low: more risk of quench cracking and retained austenite' : 'the quench must reach well below this'}</small>`, cls: r.ms < 250 ? 'warn' : '' });
      rows.push({ dt: 'Slowly cooled', dd: p.kind === 'hypereutectoid' ? `${f(p.pearlite * 100)}% pearlite, ${f(p.cementite * 100, 1)}% cementite <small>hypereutectoid</small>` : `${f(p.ferrite * 100)}% ferrite, ${f(p.pearlite * 100)}% pearlite <small>${p.kind === 'ferrite' ? 'all ferrite' : 'hypoeutectoid: lever rule below 727 °C'}</small>` });
      if (!r.valid) notes.push(['warn', 'The Andrews formulas and the hardness fit are for 0.1 to 0.6% carbon. Use the steel maker’s data outside this range.']);
      notes.push(['', 'Alloying elements change the transformation temperatures and the hardenability (how deep the steel hardens), not the hardness of the martensite.']);
      return () => {
        const H = 260, W = frame(H), L = 46, R = 12, T = 14, B = 32, x1 = 1.4, y0 = 200, y1 = 1000;
        const X = (c: number) => L + (c / x1) * (W - L - R), Y = (t: number) => H - B - ((t - y0) / (y1 - y0)) * (H - T - B);
        for (let c = 0; c <= x1 + 1e-9; c += 0.2) { el('line', { x1: X(c), x2: X(c), y1: T, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(c), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, String(+c.toFixed(1))); }
        for (let t = y0; t <= y1; t += 200) { el('line', { x1: L, x2: W - R, y1: Y(t), y2: Y(t), stroke: 'var(--rd-line)' }); if (Y(t) < H - B - 6) el('text', { x: L - 4, y: Y(t) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, String(t)); }
        axisTitles(W, H, L, R, T, B, 'carbon, mass %', 'temperature, °C');
        const cs = Array.from({ length: 40 }, (_, k) => (FE_C.eutectoid * k) / 39), ch = Array.from({ length: 20 }, (_, k) => FE_C.eutectoid + ((x1 - FE_C.eutectoid) * k) / 19);
        el('polygon', { points: [...cs.map((c) => `${X(c)},${Y(a3Binary(c))}`), ...ch.map((c) => `${X(c)},${Y(Math.min(acmBinary(c), y1))}`), `${X(x1)},${Y(y1)}`, `${X(0)},${Y(y1)}`].join(' '), fill: 'var(--rd-warn)', 'fill-opacity': 0.12 });
        line(cs.map((c) => [X(c), Y(a3Binary(c))]), 'var(--rd-ink)', 1.6);
        line(ch.map((c) => [X(c), Y(acmBinary(c))]), 'var(--rd-ink)', 1.6);
        line([[X(FE_C.alphaMax), Y(FE_C.A1)], [X(x1), Y(FE_C.A1)]], 'var(--rd-ink)', 1.6);
        txt(X(0.55), Y(930), 'austenite γ', 'var(--rd-ink)', 'middle');
        txt(X(0.12), Y(760), 'α + γ', 'var(--rd-ink)', 'middle');
        txt(X(1.12), Y(760), 'γ + Fe₃C', 'var(--rd-ink)', 'middle');
        txt(X(0.3), Y(640), 'ferrite + pearlite', 'var(--rd-muted)', 'middle');
        txt(X(1.1), Y(640), 'pearlite + Fe₃C', 'var(--rd-muted)', 'middle');
        const c = Math.min(s.C, x1);
        line([[X(c), Y(y0)], [X(c), Y(y1)]], 'var(--rd-accent)', 1.4, '4 3');
        // the Andrews points only inside their range of validity
        for (const [t, n, a] of (r.valid ? [[r.ac3, 'Ac3', 'start'], [r.ac1, 'Ac1', 'start'], [r.ms, 'Ms', 'start']] : []) as [number, string, string][]) {
          if (t < y0 || t > y1) continue;
          el('circle', { cx: X(c), cy: Y(t), r: 4, fill: 'var(--rd-panel)', stroke: 'var(--rd-accent)', 'stroke-width': 2 });
          const right = X(c) < W - R - 60;
          txt(right ? X(c) + 7 : X(c) - 7, Y(t) + (n === 'Ac1' ? 12 : -4), `${n} ${f(t)}`, 'var(--rd-accent)', right ? a : 'end');
        }
        if (r.valid && r.ms >= y0 + 70 && r.ms <= y1 - 20) txt(X(c) + (X(c) < W - R - 60 ? 7 : -7), Y(r.ms) + 16, 'martensite below', 'var(--rd-muted)', X(c) < W - R - 60 ? 'start' : 'end');
      };
    }

    // ---- tempering ----
    function runTemp(rows: Row[], notes: [string, string][]) {
      const T = num('tT'), t = num('tt'), C = num('cc') || 20;
      if (!(T > 0 && T < 760 && t > 0)) { notes.push(['bad', 'Enter the temper temperature (below 760 °C) and its time.']); return null; }
      const exposures = [['e1T', 'e1t'], ['e2T', 'e2t']].map(([a, b]) => ({ T: num(a), t: num(b) })).filter((e) => e.T > 0 && e.t > 0);
      const margin = readFactor(field('mT').value, 0);
      const r = tempering({ T, t, C, exposures, margin: margin ?? undefined });
      const over = margin !== null && exposures.length > 0 && r.worst > r.limit;
      rows.push({ dt: 'Temper after the exposures', dd: `P = ${f(r.P)} <small>was ${f(r.P0)} · equivalent to ${hrs(r.tTotal)} at ${f(T)} °C, ${r.dP < 1 ? 'no change' : `+${f(r.dP)}`}</small>`, primary: true, cls: margin === null || !exposures.length ? '' : over ? 'bad' : 'ok' });
      r.ex.forEach((e, k) => rows.push({ dt: `Exposure ${k + 1}: ${f(e.T)} °C for ${hrs(e.t)}`, dd: `P = ${f(e.P)} <small>${e.tEq < 1 / 3600 ? 'no effect on the temper' : `the same as ${hrs(e.tEq)} at ${f(T)} °C`}</small>`, cls: margin !== null && e.P > r.limit ? 'bad' : '' }));
      if (margin === null) { rows.push({ dt: 'Hottest allowed exposure', dd: '<small>needs margin below the temper</small>' }); notes.push(['warn', awaitingMessage(['margin below the temper'], 'whether the later heat stays clear of the temper')]); }
      else {
        const tRef = r.ex.length ? r.ex.reduce((a, e) => (e.P > a.P ? e : a)).t : t;
        rows.push({ dt: 'Hottest allowed exposure', dd: `${f(hjTemp(r.limit, tRef, C))} °C for ${hrs(tRef)} <small>the temper made ${f(margin)} °C colder: P ${f(r.limit)}</small>` });
      }
      if (over) notes.push(['bad', 'An exposure has a higher parameter than the limit. It tempers the steel further: the hardness and strength fall below what the temper gave. Change the exposure, or temper and test again.']);
      notes.push(['', 'Below approximately 0.6 of the temper parameter, an exposure has no measurable effect. Near and above it, the effect is the same as more time at the temper temperature.']);
      return () => {
        const H = 250, W = frame(H), L = 46, R = 12, T0 = 14, B = 32, x0 = -2, x1 = 3;
        const all = [T, ...exposures.map((e) => e.T)];
        const yMin = Math.max(0, Math.floor((Math.min(...all) - 50) / 100) * 100), yMax = Math.min(800, Math.ceil((Math.max(...all, hjTemp(r.P0, 10 ** x0, C)) + 20) / 100) * 100);
        const X = (h: number) => L + ((Math.log10(h) - x0) / (x1 - x0)) * (W - L - R), Y = (c: number) => H - B - ((c - yMin) / (yMax - yMin)) * (H - T0 - B);
        for (let e = x0; e <= x1; e++) { el('line', { x1: X(10 ** e), x2: X(10 ** e), y1: T0, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(10 ** e), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, e >= 0 ? String(10 ** e) : pow(e)); }
        const sy = nice(yMax - yMin);
        for (let c = yMin; c <= yMax; c += sy) { el('line', { x1: L, x2: W - R, y1: Y(c), y2: Y(c), stroke: 'var(--rd-line)' }); if (Y(c) < H - B - 6) el('text', { x: L - 4, y: Y(c) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, String(c)); }
        axisTitles(W, H, L, R, T0, B, 'time, h', 'temperature, °C');
        const hs = Array.from({ length: 50 }, (_, k) => 10 ** (x0 + ((x1 - x0) * k) / 49));
        const iso = (P: number) => hs.map((h): [number, number] => [X(h), Y(Math.min(Math.max(hjTemp(P, h, C), yMin), yMax))]);
        line(iso(r.P0), 'var(--rd-blue)', 2.2);
        if (margin !== null) line(iso(r.limit), 'var(--rd-accent)', 1.6, '5 3');
        const pt = (h: number, c: number, col: string, fill = 'var(--rd-panel)') => { if (h >= 10 ** x0 && h <= 10 ** x1 && c >= yMin && c <= yMax) el('circle', { cx: X(h), cy: Y(c), r: 5, fill, stroke: col, 'stroke-width': 2 }); };
        pt(t, T, 'var(--rd-blue)', 'var(--rd-blue)');
        r.ex.forEach((e) => pt(e.t, e.T, margin !== null && e.P > r.limit ? 'var(--rd-accent)' : 'var(--rd-ink)'));
        txt(W - R - 4, T0 + 10, margin !== null ? 'solid: the temper · dashed: the limit' : 'solid: the same effect as the temper', 'var(--rd-ink)', 'end');
      };
    }

    // ---- diffusion ----
    function runDiff(rows: Row[], notes: [string, string][]) {
      const D0 = num('D0'), Q = num('Q') * 1e3, Tc = num('dT'), h = num('dt'), rem = num('rem') / 100;
      if (!(D0 > 0 && Q >= 0 && Tc > -273 && h > 0 && rem > 0 && rem < 1)) { notes.push(['bad', 'Enter D₀, Q, the temperature, the time and a criterion between 0 and 100%.']); return null; }
      const D = diffusivity(D0, Q, Tc), t = h * 3600, r = diffusionDepth({ D, t, remain: rem });
      const xa = readFactor(field('xa').value, 0);
      const cls = xa === null || xa === 0 ? '' : r.depth * 1e3 <= xa ? 'ok' : 'bad';
      rows.push({ dt: 'Depth', dd: `${f(r.depth * 1e3, r.depth < 1e-3 ? 3 : 2)} mm <small>where ${f(rem * 100)}% of the surface change remains${xa ? ` · allowed ${f(xa, 3)} mm` : ''}</small>`, primary: true, cls });
      rows.push({ dt: 'Diffusion coefficient', dd: `${sci(D)} m²/s <small>at ${f(Tc)} °C · √(Dt) = ${f(r.L * 1e3, 3)} mm</small>` });
      if (xa === null || xa === 0) { rows.push({ dt: 'Time to the allowed depth', dd: '<small>needs allowed depth</small>' }); notes.push(['warn', awaitingMessage(['allowed depth'], 'whether the depth is acceptable and the time to reach it', true)]); }
      else rows.push({ dt: 'Time to the allowed depth', dd: `${hrs(diffusionTime(xa * 1e-3, D, rem) / 3600)} <small>at ${f(Tc)} °C</small>`, cls });
      rows.push({ dt: 'Twice the depth needs', dd: `${hrs(4 * h)} <small>depth grows with the square root of time</small>` });
      if (field('sp').value === 'h') notes.push(['warn', 'This is the lattice value for pure iron. Traps in high-strength steel (dislocations, carbides, grain boundaries) make the effective value 100 to 10 000 times smaller, so a bake takes much longer than this suggests.']);
      notes.push(['', 'A semi-infinite solid: valid while the depth is small against the thickness. In a thin wall, both surfaces change and the profiles meet.']);
      return () => {
        const H = 250, W = frame(H), L = 46, R = 12, T = 14, B = 32;
        const xMax = Math.max(r.depth * 2.2, xa ? xa * 1.3e-3 : 0) * 1e3;
        const X = (x: number) => L + (x / xMax) * (W - L - R), Y = (v: number) => H - B - v * (H - T - B);
        const sx = nice(xMax);
        for (let x = 0; x <= xMax + 1e-12; x += sx) { el('line', { x1: X(x), x2: X(x), y1: T, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(x), y: H - B + 13, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, String(+x.toPrecision(3))); }
        for (let v = 0; v <= 1.0001; v += 0.25) { el('line', { x1: L, x2: W - R, y1: Y(v), y2: Y(v), stroke: 'var(--rd-line)' }); if (Y(v) < H - B - 6) el('text', { x: L - 4, y: Y(v) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, `${v * 100}%`); }
        axisTitles(W, H, L, R, T, B, 'depth, mm', 'change left');
        const xs = Array.from({ length: 60 }, (_, k) => (xMax * k) / 59);
        for (const [k, c, w, dash] of [[0.25, 'var(--rd-blue)', 1.3, '4 3'], [1, 'var(--rd-accent)', 2.4, ''], [4, 'var(--rd-blue)', 1.3, '4 3']] as [number, string, number, string][]) {
          const L2 = Math.sqrt(D * t * k);
          line(xs.map((x) => [X(x), Y(erfc((x * 1e-3) / (2 * L2)))]), c, w, dash);
        }
        line([[L, Y(rem)], [W - R, Y(rem)]], 'var(--rd-muted)', 1, '2 3');
        if (xa) { line([[X(xa), T], [X(xa), H - B]], 'var(--rd-ok)', 1.6, '6 3'); txt(X(xa) + 4, T + 22, 'allowed', 'var(--rd-ok)'); }
        el('circle', { cx: X(r.depth * 1e3), cy: Y(rem), r: 5, fill: 'var(--rd-panel)', stroke: 'var(--rd-ink)', 'stroke-width': 2 });
        txt(W - R - 4, T + 10, `solid: ${hrs(h)} · dashed: ¼ and 4 ×`, 'var(--rd-ink)', 'end');
      };
    }

    const RUN: Record<string, typeof runFec> = { fec: runFec, temp: runTemp, diff: runDiff };
    const CAPS: Record<string, string> = {
      fec: 'The steel corner of the iron–carbon diagram (binary). The dashed line is your carbon content; the points are the Ac1, Ac3 and Ms of your composition.',
      temp: 'Combinations of time and temperature with the same effect as the temper (solid), and the limit with your margin (dashed). Points: the temper and each exposure.',
      diff: 'Fraction of the surface change in concentration left against depth, for your time (solid) and a quarter and four times that time (dashed).',
    };
    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    // a preset fills D0 and Q
    field('sp').addEventListener('change', () => {
      const d = diffusant(field('sp').value);
      if (d) { field('D0').value = String(d.D0); field('Q').value = String(d.Q / 1e3); }
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    wireWorkedExample({
      root, onLoad: run, factorFields: ['mT', 'xa'],
      note: 'Worked-example criteria loaded: 25 °C below the temper, 0.08 mm allowed decarburisation',
      values: { C: '0.46', Mn: '0.75', Si: '0.22', Ni: '0.55', Cr: '1.05', Mo: '1.0', V: '0.08',
        tT: '565', tt: '4', e1T: '160', e1t: '6', e2T: '540', e2t: '2', cc: '20', mT: '25',
        sp: 'cg', D0: '2.3e-5', Q: '148', dT: '900', dt: '1', rem: '10', xa: '0.08' },
    });
    run();
  });
</script>
