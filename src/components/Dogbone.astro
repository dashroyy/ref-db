---
// The tensile test of a propellant. Left: a dogbone specimen, held by its tabs; the strain comes from the crosshead
// travel over an effective gauge length that includes part of the transitions. Right: the stress–strain curve of a
// filled propellant, which bends over as the binder pulls away from the filler (dewetting), reaches its maximum stress
// σm at εm, and breaks at εb. Schematic.
const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', hot = 'var(--rd-accent)', blue = 'var(--rd-blue)';
const yc = 96;
const outline = `M14,72 L54,72 C66,72 66,88 76,88 L144,88 C154,88 154,72 166,72 L206,72 L206,120 L166,120 C154,120 154,104 144,104 L76,104 C66,104 66,120 54,120 L14,120 Z`;
const O = { x: 254, y: 178 }; // origin of the stress–strain axes
const curve = `M${O.x},${O.y} C272,126 289,92 314,77 S338,65 344,66 S368,73 382,86`;
---

<figure class="viz dgb">
  <p class="viz-title">The tensile test</p>
  <svg viewBox="0 0 440 214" role="img" aria-labelledby="dgb-desc" style="max-width: 640px; margin: 0 auto;">
    <desc id="dgb-desc">
      Left: a dogbone specimen, wide tabs at each end held in grips and a narrow gauge section in the middle, pulled
      apart by the test machine. A dimension below it marks the effective gauge length, which is longer than the
      parallel part of the gauge section because the transitions also stretch. Right: a stress–strain curve that rises
      steeply, bends over, reaches its highest stress, falls a little and ends where the specimen breaks. The highest
      stress is sigma m at the strain epsilon m; the break is at epsilon b. The bend is labelled dewetting: the binder
      pulls away from the filler particles.
    </desc>
    <defs>
      <marker id="dgb-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill={ink}></path></marker>
      <marker id="dgb-b" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" fill={muted}></path></marker>
    </defs>
    <!-- the specimen -->
    <rect x="14" y="68" width="30" height="56" fill="var(--rd-steel)" fill-opacity="0.55" stroke={muted}></rect>
    <rect x="176" y="68" width="30" height="56" fill="var(--rd-steel)" fill-opacity="0.55" stroke={muted}></rect>
    <path d={outline} fill="var(--rd-propellant)" fill-opacity="0.45" stroke={ink} stroke-width="1.8"></path>
    <line x1="14" y1={yc} x2="3" y2={yc} stroke={ink} stroke-width="2" marker-end="url(#dgb-a)"></line>
    <line x1="206" y1={yc} x2="217" y2={yc} stroke={ink} stroke-width="2" marker-end="url(#dgb-a)"></line>
    <text x="29" y="60" text-anchor="middle" font-size="10" fill={muted}>grip</text>
    <text x="191" y="60" text-anchor="middle" font-size="10" fill={muted}>grip</text>
    <text x="110" y="80" text-anchor="middle" font-size="10" fill={ink}>gauge section</text>
    <line x1="66" y1="124" x2="66" y2="146" stroke={muted}></line>
    <line x1="154" y1="124" x2="154" y2="146" stroke={muted}></line>
    <line x1="66" y1="141" x2="154" y2="141" stroke={muted} marker-start="url(#dgb-b)" marker-end="url(#dgb-b)"></line>
    <text x="110" y="160" text-anchor="middle" font-size="11" fill={ink}>effective gauge length</text>
    <text x="110" y="175" text-anchor="middle" font-size="10" fill={muted}>the strain is the crosshead</text>
    <text x="110" y="189" text-anchor="middle" font-size="10" fill={muted}>travel over this length</text>
    <!-- the stress–strain curve -->
    <line x1={O.x} y1={O.y} x2={O.x} y2="34" stroke={ink} stroke-width="1.4"></line>
    <line x1={O.x} y1={O.y} x2="432" y2={O.y} stroke={ink} stroke-width="1.4"></line>
    <text x={O.x} y="26" font-size="10" fill={ink}>stress</text>
    <text x="432" y={O.y + 26} text-anchor="end" font-size="10" fill={ink}>strain</text>
    <line x1={O.x} y1="65.5" x2="344" y2="65.5" stroke={muted} stroke-dasharray="3 3"></line>
    <line x1="344" y1="65.5" x2="344" y2={O.y} stroke={muted} stroke-dasharray="3 3"></line>
    <line x1="382" y1="86" x2="382" y2={O.y} stroke={muted} stroke-dasharray="3 3"></line>
    <path d={curve} fill="none" stroke={hot} stroke-width="2.6"></path>
    <circle cx="344" cy="65.5" r="3.5" fill={hot}></circle>
    <path d="M378,82 L386,90 M378,90 L386,82" stroke={hot} stroke-width="1.8"></path>
    <text x={O.x - 5} y="69" text-anchor="end" font-size="11" fill={ink}>σ<tspan font-size="8" dy="3">m</tspan></text>
    <text x="344" y={O.y + 13} text-anchor="middle" font-size="11" fill={ink}>ε<tspan font-size="8" dy="3">m</tspan></text>
    <text x="382" y={O.y + 13} text-anchor="middle" font-size="11" fill={ink}>ε<tspan font-size="8" dy="3">b</tspan></text>
    <line x1="296" y1="120" x2="309" y2="84" stroke={blue}></line>
    {['dewetting:', 'the binder', 'pulls off', 'the filler'].map((t, k) => <text x="264" y={131 + 13 * k} font-size="10" fill={blue}>{t}</text>)}
  </svg>
  <figcaption>
    Left: a dogbone specimen of the kind that the JANNAF test methods use. The machine pulls the tabs, and the strain is
    the crosshead travel over an effective gauge length that includes part of the transitions. Right: the curve of a
    filled propellant bends over as the binder pulls away from the filler (dewetting), reaches its maximum stress
    σ<sub>m</sub> at the strain ε<sub>m</sub>, and breaks at ε<sub>b</sub>. Schematic.
  </figcaption>
</figure>
